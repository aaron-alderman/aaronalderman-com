process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process atlas.seen.save:
  port state.get { key = "seen" } → seen
  port text.join { values = $seen; separator = "\n" } → text
  port storage.write { key = "worldwright.atlas.seen.v1"; value = $text } → saved
  port state.set { key = "saved"; value = $saved.ok } → _
