process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process atlas.pin.mode:
  port state.get { key = "mobileClick" } → binding
  when $binding:
    port browser.cancel { id = $binding } → _
  port state.set { key = "mobileClick"; value = null } → _
  port browser.mediaQuery { query = "(max-width: 760px)" } → small
  when $small:
    port browser.on {
      ref = "document";
      event = "click";
      delegate = ".atlas-pin";
      preventDefault = true;
      query = "atlas.pin.preview"
    } → binding
    port state.set { key = "mobileClick"; value = $binding } → _
