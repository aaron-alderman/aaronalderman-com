process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process atlas.journey.resume:
  call atlas.seen.load
  port dom.exists { selector = "[data-atlas-current]" } → isPlace
  when $isPlace:
    port dom.attribute { selector = "[data-atlas-current]"; name = "data-atlas-current" } → current
    when includes($data.ids, $current):
      call atlas.seen.mark
      port dom.hidden { selector = "#atlas-visit-note"; value = false } → _
      port state.get { key = "saved" } → saved
      port dom.text {
        selector = "#atlas-visit-note";
        text = if(
          $saved,
          "✓ Seen on your map. Your visit is remembered in this browser.",
          "Your browser couldn’t save this visit. You can still explore every place."
        )
      } → _
  port dom.exists { selector = "#atlas-memory" } → onAtlas
  when $onAtlas:
    call atlas.seen.paint
