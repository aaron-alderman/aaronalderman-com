process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process atlas.seen.mark:
  port state.get { key = "seen" } → seen
  let candidate = append($seen, list($current))
  call atlas.seen.clean
  port state.set { key = "seen"; value = $clean } → _
  call atlas.seen.save
