process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process stylesheet.catalog:
  let cssCataloguePath = "source/stylesheets/contract.values.rel"
  port file.copy { path = $cssCataloguePath } → _
  port file.read { path = $cssCataloguePath } → cssCatalogueText
  port static.read { text = $cssCatalogueText } → cssCatalogue
  assert eq($cssCatalogue.protocol, "worldwright/css-ownership/1")
    otherwise "CSS-005: Unsupported stylesheet catalogue."
  let result = $cssCatalogue
