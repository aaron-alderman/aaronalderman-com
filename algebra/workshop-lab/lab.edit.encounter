process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lab.edit:
  assert includes(list("title", "web-label"), $eventInput.kind)
    otherwise "LAB-E001: Choose a story-title or web-label edit."
  port kernel.invoke { query = "ec.run"; input = { candidate = $eventInput.candidate } } → labCurrent
  let labMatches = filter(
    $labCurrent,
    "labP",
    eq($labP.output.type, if(eq($eventInput.kind, "title"), "Page", "WebLink"))
  )
  assert eq(count($labMatches), 1)
    otherwise "LAB-E002: The edit needs one current, derived projection. Reopen the example."
  port kernel.invoke {
    query = "ec.patch";
    input = {
      candidate = $eventInput.candidate;
      projection = at($labMatches, 0);
      field = if(eq($eventInput.kind, "title"), "P.title", "N.label");
      value = $eventInput.value
    }
  } → labPatched
  let result = $labPatched
