process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lab.snapshot:
  port kernel.invoke { query = "ec.run"; input = { candidate = $eventInput.candidate } } → labProjections
  fold $labProjections as labP; labRendered starts list():
    let input = $labP.output.tree
    call projection.serialize
    yield append($labRendered, list({ projection = $labP; html = $result })) → labRendered
  let result = { rendered = $labRendered }
