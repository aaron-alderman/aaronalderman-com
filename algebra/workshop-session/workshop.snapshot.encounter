process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process workshop.snapshot:
  let candidate = $eventInput.candidate
  port kernel.invoke { query = "lab.snapshot"; input = { candidate = $candidate } } → measured
  let panels = $measured.rendered
  let page = at(filter($panels, "panel", eq($panel.projection.output.type, "Page")), 0)
  let web = at(filter($panels, "panel", eq($panel.projection.output.type, "WebLink")), 0)
  let result = {
    candidate = $candidate;
    revision = $eventInput.revision;
    receipt = $eventInput.receipt;
    title = at($page.projection.output.values, "P.title");
    webLabel = at($web.projection.output.values, "W.text");
    panels = $panels;
    sources = {
      facts = $candidate.inputs.factText;
      encounter = $candidate.inputs.codeText;
      contracts = $candidate.inputs.contractText
    }
  }
