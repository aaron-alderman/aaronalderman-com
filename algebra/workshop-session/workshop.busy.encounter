process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process workshop.busy:
  port browser.select { selector = "form input,form button[type=\"submit\"]" } → controls
  each $controls as control:
    port browser.write { ref = $control.ref; name = "disabled"; value = $busy } → _
  port browser.attribute { ref = ".flow"; name = "aria-busy"; value = $busy } → _
