process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process workshop.source:
  port state.get { key = "workshop" } → snapshot
  port state.get { key = "sourceHighlight" } → sourceHighlight
  port browser.property { ref = "#source-file"; name = "value" } → key
  port text.split { value = at($snapshot.sources, $key); pattern = "\\r?\\n" } → lines
  fold $lines as line; rendered starts { index = 0; nodes = list() }:
    yield {
    index = add($rendered.index, 1);
    nodes = append(
      $rendered.nodes,
      list(
        {
          tag = "span";
          attrs = {
            class = concat(
              "source-line",
              if(
                and(
                  $sourceHighlight,
                  eq(at($sourceHighlight, "file"), $key),
                  eq(at($sourceHighlight, "line"), add($rendered.index, 1))
                ),
                " highlight",
                ""
              )
            )
          };
          children = list(or($line, " "))
        }
      )
    )
  } → rendered
  let input = $rendered.nodes
  call projection.serialize
  let markup = $result
  port browser.content { ref = "#source-code"; html = $markup } → _
