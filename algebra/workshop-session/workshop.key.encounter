process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process workshop.key:
  let key = $eventInput.event.key
  let tabs = list("source", "pure", "process", "html", "receipt")
  let current = at($eventInput.matched.attributes, "data-tab")
  fold range(5) as n; index starts 0:
    yield if(eq(at($tabs, add($n, -1)), $current), add($n, -1), $index) → index
  let move = includes(list("ArrowRight", "ArrowLeft", "Home", "End"), $key)
  when $move:
    port number.calculate { operation = "add"; values = list($index, if(eq($key, "ArrowRight"), 1, 4)) } → index
    port number.calculate { operation = "remainder"; values = list($index, 5) } → index
    let index = if(eq($key, "Home"), 0, if(eq($key, "End"), 4, $index))
    port kernel.invoke { query = "workshop.selectTab"; input = { tab = at($tabs, $index); focus = true } } → result
