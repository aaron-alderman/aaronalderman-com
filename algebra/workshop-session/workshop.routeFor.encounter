process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process workshop.routeFor:
  let snapshot = $eventInput.snapshot
  let kind = $eventInput.kind
  let panel = if(
    eq($kind, "title"),
    at(filter($snapshot.panels, "p", eq($p.projection.output.type, "Page")), 0),
    at(filter($snapshot.panels, "p", eq($p.projection.output.type, "WebLink")), 0)
  )
  let route = at(
    filter(
      $panel.projection.edits,
      "edit",
      eq($edit.field, if(eq($kind, "title"), "P.title", "N.label"))
    ),
    0
  )
  let result = $route.destination
