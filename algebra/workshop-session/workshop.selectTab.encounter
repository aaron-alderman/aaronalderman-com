process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process workshop.selectTab:
  let tab = $eventInput.tab
  assert includes(list("source", "pure", "process", "html", "receipt"), $tab)
    otherwise "WORKSHOP-TAB: Unknown tab."
  port state.set { key = "activeTab"; value = $tab } → _
  port browser.select { selector = "[data-tab]" } → tabs
  each $tabs as button:
    let selected = eq(at($button.attributes, "data-tab"), $tab)
    port browser.attribute { ref = $button.ref; name = "aria-selected"; value = $selected } → _
    port browser.write { ref = $button.ref; name = "tabIndex"; value = if($selected, 0, -1) } → _
  port browser.select { selector = "[role=\"tabpanel\"]" } → panels
  each $panels as panel:
    port browser.write {
      ref = $panel.ref;
      name = "hidden";
      value = not(eq(at($panel.attributes, "id"), concat("panel-", $tab)))
    } → _
  when or($eventInput.focus, false):
    port browser.focus { ref = concat("#tab-", $tab) } → _
