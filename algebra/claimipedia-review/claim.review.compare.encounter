process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process claim.review.compare:
  fold $eventInput.configuration.methods as method; results starts list():
    port kernel.invoke {
      query = "claim.review.method";
      input = {
        method = $method;
        evidence = $eventInput.configuration.evidence;
        selected = $eventInput.selected
      }
    } → review
    yield append($results, list($review)) → result
