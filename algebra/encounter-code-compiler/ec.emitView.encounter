process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process ec.emitView:
  let ecEmitView = $eventInput.view
  let result = list(
    {
      port = "kernel.invoke";
      args = {
        query = "ec.argument";
        input = { type = $ecEmitView.sourceType; value = $ecEmitView.source }
      };
      into = "ecSourceCarrier"
    },
    { let = "bindings"; value = { source = concat(at(" $", 1), "ecSourceCarrier") } },
    { let = "ecViewValues"; value = $ecEmitView.fields.values },
    {
      port = "kernel.invoke";
      args = {
        query = "ec.check";
        input = { type = $ecEmitView.type; values = concat(at(" $", 1), "ecViewValues") }
      };
      into = "ecChecked"
    },
    {
      let = "result";
      value = {
        id = $ecEmitView.id;
        type = $ecEmitView.type;
        values = concat(at(" $", 1), "ecViewValues")
      }
    }
  )
