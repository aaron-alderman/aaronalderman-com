process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process ec.complete:
  port kernel.invoke { query = "ec.schema"; input = { type = $eventInput.type } } → ecCompleteSchema
  assert every(
    $ecCompleteSchema.slots,
    "ecS",
    or(
      eq($ecS.cardinality, "optional"),
      some($eventInput.fields, "ecF", eq($ecF.name, $ecS.name))
    )
  )
    otherwise "EC-T026: The definition does not supply every required field of its declared type."
  let result = true
