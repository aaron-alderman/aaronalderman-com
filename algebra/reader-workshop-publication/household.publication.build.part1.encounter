process-module "temple/surface-process-module/1"

process household.publication.build.part1:
  call publication.stewardship.view
  let stewardshipLinks = $result
  let snapshots = list()
  port file.copy { path = "algebra/reader-models.process.values.rel" } → _
  port file.read { path = "algebra/reader-models.process.values.rel" } → sourceText
  let snapshots = append(
    $snapshots,
    list(
      {
        tag = "details";
        attrs = { class = "hh-source" };
        children = list(
          {
            tag = "summary";
            attrs = {  };
            children = list("algebra/reader-models.process.values.rel")
          },
          {
            tag = "p";
            attrs = { class = "hh-small" };
            children = list(
              {
                tag = "a";
                attrs = { href = "../../../build-receipt.values.rel" };
                children = list("Build receipt and exact source hashes")
              }
            )
          },
          {
            tag = "pre";
            attrs = {  };
            children = list({ tag = "code"; attrs = {  }; children = list($sourceText) })
          }
        )
      }
    )
  )
  port file.copy { path = "algebra/reader-activities.process.values.rel" } → _
  port file.read { path = "algebra/reader-activities.process.values.rel" } → sourceText
