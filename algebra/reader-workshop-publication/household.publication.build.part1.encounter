          },
          {
            tag = "pre";
            attrs = {  };
            children = list({ tag = "code"; attrs = {  }; children = list($sourceText) })
          }
        )
      }
    )
  )
  port file.copy { path = "source/reader/activities.values.rel" } → _
  port file.read { path = "source/reader/activities.values.rel" } → sourceText
  let snapshots = append(
    $snapshots,
    list(
