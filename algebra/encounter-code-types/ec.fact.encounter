process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process ec.fact:
  let ecFactId = $eventInput.id
  let ecFactType = $eventInput.type
  port kernel.invoke { query = "ec.referenceType"; input = { id = $ecFactId } } → ecObservedType
  assert eq($ecObservedType, $ecFactType)
    otherwise "EC-T010: This reference does not satisfy the required interface."
  port kernel.invoke { query = "ec.schema"; input = { type = $ecFactType } } → ecFactSchema
  port record.entries { value = at($factIndex.objects, $ecFactId) } → ecFactFields
  assert every(
    $ecFactFields,
    "ecF",
    or(eq(at($ecF, 0), "isa"), some($ecFactSchema.slots, "ecS", eq($ecS.name, at($ecF, 0))))
  )
    otherwise "EC-T018: The authored fact has fields outside its closed type."
  fold $ecFactSchema.slots as ecFactSlot; ecFactValues starts {  }:
    let ecRawValues = objects($ecFactId, $ecFactSlot.name)
    assert or(
      eq($ecFactSlot.cardinality, "many"),
      or(
        eq(count($ecRawValues), 1),
        and(eq($ecFactSlot.cardinality, "optional"), eq(count($ecRawValues), 0))
      )
    )
      otherwise "EC-T019: The authored field has the wrong cardinality."
    when eq($ecFactSlot.storage, "entries"):
      fold $ecRawValues as ecEntryId; ecDecodedEntries starts list():
        port kernel.invoke { query = "ec.fact"; input = { id = $ecEntryId; type = $ecFactSlot.entryType } } → ecEntryCarrier
        yield append($ecDecodedEntries, list(at($ecEntryCarrier.values, $ecFactSlot.entryField))) → ecRawValues
    let ecNextValue = if(eq($ecFactSlot.cardinality, "many"), $ecRawValues, at($ecRawValues, 0))
    when or(not(eq(count($ecRawValues), 0)), eq($ecFactSlot.cardinality, "many")):
      port record.put { record = $ecFactValues; key = $ecFactSlot.name; value = $ecNextValue } → ecFactValues
    yield $ecFactValues → ecFactValues
  port kernel.invoke { query = "ec.check"; input = { type = $ecFactType; values = $ecFactValues } } → _
  let result = { id = $ecFactId; type = $ecFactType; values = $ecFactValues }
