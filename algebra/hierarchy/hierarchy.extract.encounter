process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process hierarchy.extract:
  fold $hEvidence.bindings as hBinding; hRows starts list():
    let hExtracted = list()
    let surfaceWritePath = $hBinding.file
    call assurance.surface.register
    port file.copy { path = $hBinding.file } → _
    when eq($hBinding.kind, "rel"):
      port file.read { path = $hBinding.file } → hRaw
      let eventInput = { text = $hRaw; binding = $hBinding }
      call hierarchy.parse
      let hExtracted = $result
    yield append($hRows, $hExtracted) → hRows
  port value.encode { value = { protocol = "worldwright/extracted-bindings/1"; rows = $hRows } } → hJSON
  port file.write { path = "inspection/bindings.values.rel"; text = $hJSON } → _
