        },
        {
          tag = "nav";
          attrs = { "aria-label" = "Complete project catalogue"; class = "identity-directory-grid" };
          children = list(
            map(
              $identityCatalogue.items,
              "project",
              {
                tag = "a";
                attrs = { href = $project.href };
                children = list(
                  { tag = "strong"; attrs = {  }; children = list($project.name) },
                  { tag = "span"; attrs = {  }; children = list($project.status) }
                )
