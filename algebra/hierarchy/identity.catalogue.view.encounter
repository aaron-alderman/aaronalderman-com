    {
      tag = "details";
      attrs = { class = "identity-directory"; id = "all-projects" };
      children = list(
        {
          tag = "summary";
          attrs = {  };
          children = list("All projects · the complete catalogue")
        },
        {
          tag = "p";
          attrs = {  };
          children = list(
            "This perspective is one way into the work. Every project remains available here, with its original purpose and development status."
