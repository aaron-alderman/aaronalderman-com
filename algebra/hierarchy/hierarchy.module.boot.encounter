process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process hierarchy.module.boot:
  call hierarchy.module.context
  port browser.on {
    ref = "#module-query";
    event = "change";
    query = "hierarchy.module.select";
    input = {  }
  } → _
  port digest.sha256 { text = $selectedModule.sourceText } → moduleHash
  port browser.write {
    ref = "#module-hash";
    name = "textContent";
    value = concat("Exact module SHA-256 ", $moduleHash)
  } → _
  port digest.sha256 { text = $selectedModule.authorText } → authorHash
  port browser.write {
    ref = "#module-author-hash";
    name = "textContent";
    value = concat("Authoritative Encounter SHA-256 ", $authorHash)
  } → _
  call hierarchy.module.select
