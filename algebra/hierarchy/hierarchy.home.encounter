process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process hierarchy.home:
  call hierarchy.load
  let identityCatalogue = $hCatalogue
  let identityKey = one($homeIdentity, "key")
  call identity.catalogue.view
  let result = {
    tag = "div";
    attrs = {
      class = "hierarchy-home identity-catalogue";
      id = "microsites";
      "data-perspective" = one($homeIdentity, "key");
      role = "region";
      "aria-label" = one($homeIdentity, "catalogueIntro")
    };
    children = list($result)
  }
