process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process reader.model.weights:
  port number.parse { value = $eventInput.percent } → percent
  port number.calculate { operation = "divide"; values = list($percent, 100) } → weight
  port number.calculate { operation = "multiply"; values = list(6, $weight) } → delta
  port number.calculate { operation = "add"; values = list(2, $delta) } → a
  port number.calculate { operation = "subtract"; values = list(8, $delta) } → b
  let result = { a = $a; b = $b }
