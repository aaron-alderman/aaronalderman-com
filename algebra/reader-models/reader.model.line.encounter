process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process reader.model.line:
  fold $eventInput.samples as sample; path starts "":
    port number.calculate { operation = "multiply"; values = list($sample.t, 39) } → x
    port number.calculate { operation = "add"; values = list(25, $x) } → x
    port number.calculate { operation = "multiply"; values = list(at($sample, $eventInput.coordinate), 135) } → y
    port number.calculate { operation = "subtract"; values = list(215, $y) } → y
    port number.format { value = $x; digits = 2 } → x
    port number.format { value = $y; digits = 2 } → y
    yield concat($path, if(eq($path, ""), "M", " L"), $x, ",", $y) → result
