process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process reader.model.memory:
  let coupling = if($eventInput.coupled, 0.6, 0)
  fold range(400) as iteration; memory starts { x = 1; h = 1.2; samples = list({ t = 0; x = 1; h = 1.2 }) }:
    port number.calculate { operation = "multiply"; values = list($coupling, $memory.h) } → cx
    port number.calculate { operation = "subtract"; values = list($cx, $memory.x) } → dx
    port number.calculate { operation = "multiply"; values = list(-0.8, $memory.h) } → decay
    port number.calculate { operation = "multiply"; values = list($coupling, $memory.x) } → ch
    port number.calculate { operation = "add"; values = list($decay, $ch) } → dh
    port number.calculate { operation = "multiply"; values = list(0.02, $dx) } → dx
    port number.calculate { operation = "multiply"; values = list(0.02, $dh) } → dh
    port number.calculate { operation = "add"; values = list($memory.x, $dx) } → x
    port number.calculate { operation = "add"; values = list($memory.h, $dh) } → h
    port number.calculate { operation = "multiply"; values = list($iteration, 0.02) } → time
    port number.calculate { operation = "remainder"; values = list($iteration, 4) } → remainder
    yield {
    x = $x;
    h = $h;
    samples = if(
      eq($remainder, 0),
      append($memory.samples, list({ t = $time; x = $x; h = $h })),
      $memory.samples
    )
  } → memory
  let result = $memory.samples
