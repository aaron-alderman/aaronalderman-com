process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process reader.model.calibration:
  port number.parse { value = $eventInput.angle } → angle
  port number.calculate { operation = "multiply"; values = list($angle, 0.017453292519943295) } → radians
  port number.calculate { operation = "sin"; values = list($radians) } → sine
  port number.calculate { operation = "multiply"; values = list($sine, 100) } → scaled
  port number.calculate { operation = "round"; values = list($scaled) } → rounded
  port number.calculate { operation = "divide"; values = list($rounded, 100) } → result
