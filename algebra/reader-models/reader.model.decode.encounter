process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process reader.model.decode:
  fold $eventInput.bits as bit; sum starts 0:
    yield add($sum, $bit) → sum
  port number.calculate { operation = "greaterEqual"; values = list($sum, 2) } → majority
  let result = if($majority, 1, 0)
