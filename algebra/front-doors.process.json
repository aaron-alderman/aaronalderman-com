    "frontdoors.capabilities": [
      {
        "each": [
          "subjects",
          "isa",
          "CapabilitySet"
        ],
        "as": "capability",
        "steps": [
          {
            "when": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$capability",
                  "slug"
                ],
                "encounter"
              ]
            ],
            "then": [
              {
                "port": "json.parse",
                "args": {
                  "text": [
                    "one",
                    "$capability",
                    "icon"
                  ]
                },
                "into": "capabilityIcon"
              },
              {
                "port": "json.parse",
                "args": {
                  "text": [
                    "one",
                    "$capability",
                    "paragraphs"
                  ]
                },
                "into": "paragraphs"
              },
              {
                "port": "json.parse",
                "args": {
                  "text": [
                    "one",
                    "$capability",
                    "links"
                  ]
                },
                "into": "links"
              },
              {
                "let": "input",
                "value": {
                  "tag": "html",
                  "attrs": {
                    "lang": "en"
                  },
                  "children": [
                    "list",
                    {
                      "tag": "head",
                      "attrs": {},
                      "children": [
                        "list",
                        {
