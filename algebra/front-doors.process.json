                "port": "file.write",
                "args": {
                  "path": [
                    "concat",
                    [
                      "one",
                      "$capability",
                      "href"
                    ],
                    "index.html"
                  ],
                  "text": [
                    "concat",
                    "<!doctype html>\n",
                    "$result"
                  ]
                },
                "into": "_"
              }
            ]
          }
        ]
