                            "list"
                          ]
                        },
                        {
                          "tag": "meta",
                          "attrs": {
                            "property": "og:url",
                            "content": [
                              "concat",
                              "https://aaronalderman.com/",
                              [
                                "one",
                                "$capability",
                                "href"
                              ]
                            ]
                          },
                          "children": [
                            "list"
                          ]
                        }
