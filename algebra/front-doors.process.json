{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "frontdoors.home": [
      {
        "let": "result",
        "value": {
          "tag": "nav",
          "attrs": {
            "class": "hero-microsites",
            "id": "microsites",
            "aria-label": "Microsites"
          },
          "children": [
            "list",
            {
              "tag": "p",
              "attrs": {
                "class": "eyebrow"
              },
              "children": [
                "list",
                "Explore the worlds"
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "microsite-menu"
              },
              "children": [
                "list",
                [
                  "map",
                  [
                    "subjects",
                    "isa",
                    "PublishedMicrosite"
                  ],
                  "world",
                  {
                    "tag": "a",
                    "attrs": {
                      "class": "microsite-link",
                      "href": [
                        "one",
                        "$world",
                        "href"
                      ],
                      "data-world": [
                        "one",
                        "$world",
                        "light"
                      ]
                    },
                    "children": [
                      "list",
                      {
                        "tag": "span",
                        "attrs": {
                          "class": "world-symbol",
                          "aria-hidden": "true"
                        },
                        "children": [
                          "list",
                          [
                            "one",
                            "$world",
                            "symbol"
                          ]
                        ]
                      },
                      {
                        "tag": "strong",
                        "attrs": {},
                        "children": [
                          "list",
                          [
                            "one",
                            "$world",
                            "name"
                          ]
                        ]
                      },
                      {
                        "tag": "small",
                        "attrs": {},
                        "children": [
                          "list",
                          [
                            "one",
                            "$world",
                            "note"
                          ]
                        ]
                      }
                    ]
                  }
                ]
              ]
            }
          ]
        }
      }
    ],
    "frontdoors.claimipedia": [
      {
        "call": "claimipedia.build"
      }
    ]
  }
}
