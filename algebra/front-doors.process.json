                            "content": "width=device-width, initial-scale=1"
                          },
                          "children": [
                            "list"
                          ]
                        },
                        {
                          "tag": "title",
                          "attrs": {},
                          "children": [
                            "list",
                            [
                              "concat",
                              [
                                "one",
                                "$capability",
                                "name"
                              ],
                              " — Aaron Alderman"
                            ]
                          ]
                        },
                        {
                          "tag": "meta",
                          "attrs": {
                            "name": "description",
                            "content": [
                              "one",
                              "$capability",
                              "description"
                            ]
                          },
                          "children": [
                            "list"
                          ]
                        },
                        {
                          "tag": "link",
                          "attrs": {
                            "rel": "canonical",
                            "href": [
                              "concat",
                              "https://aaronalderman.com/",
                              [
                                "one",
                                "$capability",
                                "href"
                              ]
                            ]
                          },
                          "children": [
                            "list"
                          ]
                        },
                        {
                          "tag": "link",
                          "attrs": {
                            "rel": "stylesheet",
                            "href": "../expedition.css?v=capabilities-2"
                          },
                          "children": [
                            "list"
                          ]
                        },
                        {
                          "tag": "meta",
                          "attrs": {
                            "property": "og:title",
                            "content": [
                              "one",
                              "$capability",
                              "name"
                            ]
                          },
                          "children": [
                            "list"
                          ]
                        },
                        {
