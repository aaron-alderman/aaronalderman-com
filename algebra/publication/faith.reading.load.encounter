process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process faith.reading.load:
  port file.copy { path = "source/faith/reading.values.rel" } → _
  port file.read { path = "source/faith/reading.values.rel" } → faithReadingText
  port static.read { text = $faithReadingText } → faithReading
  each $faithReading.sources as faithSource:
    let surfaceWritePath = $faithSource.path
    call assurance.surface.register
    port file.copy { path = $faithSource.path } → _
