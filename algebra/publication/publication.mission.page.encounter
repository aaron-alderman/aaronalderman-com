process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process publication.mission.page:
  call publication.mission
  let body = $result
  let prefix = "../"
  let pageTitle = "The mission — Aaron Alderman"
  let description = "I believe we can build a civilisation in which growing intelligence gives people greater freedom to live, understand, create, and care."
  let canonical = "https://aaronalderman.com/mission/"
  let light = "home"
  call publication.document
  let surfaceWritePath = "mission/index.html"
  call assurance.surface.register
  port file.write { path = "mission/index.html"; text = $result } → _
