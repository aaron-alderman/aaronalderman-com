process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process identity.reading.context:
  call identity.journey.nav
  let journeyNav = $result
  let result = {
    tag = "aside";
    attrs = {
      class = "identity-reading-context";
      "data-journey-identity" = one($journeyIdentity, "key")
    };
    children = list(
      {
        tag = "p";
        attrs = { class = "eyebrow" };
        children = list(concat("READING AS ", one($journeyIdentity, "label")))
      },
      { tag = "p"; attrs = {  }; children = list(one($journeyIdentity, "readingPrompt")) },
      $journeyNav,
      {
        tag = "p";
        attrs = {  };
        children = list(
          "The underlying reading and source evidence are shared. ",
          {
            tag = "a";
            attrs = {
              href = concat(one("site", "origin"), one($readingPlace, "route"));
              "data-shared-exit" = "true"
            };
            children = list("Open the shared version ↗")
          }
        )
      }
    )
  }
