process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process identity.journey.nav:
  let result = {
    tag = "nav";
    attrs = { class = "identity-journey-nav"; "aria-label" = "This identity" };
    children = list(
      {
        tag = "a";
        attrs = { href = one($journeyIdentity, "homeHref") };
        children = list(concat("← ", one($journeyIdentity, "label"), " / Home"))
      },
      {
        tag = "a";
        attrs = { href = one($journeyIdentity, "threadsHref") };
        children = list("Threads")
      },
      {
        tag = "a";
        attrs = { href = one($journeyIdentity, "atlasHref") };
        children = list("Map")
      },
      {
        tag = "a";
        attrs = { href = one($journeyIdentity, "questionWorldHref") };
        children = list("Questions")
      }
    )
  }
