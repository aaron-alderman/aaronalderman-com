{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "microsite.return.styles": [
      {
        "let": "cssPlan",
        "value": {
          "imports": [
            "list"
          ],
          "tokens": [
            "list"
          ],
          "rules": [
            "list",
            {
              "id": "return.base",
              "selector": ".microsite-return",
              "context": null,
              "declarations": [
                "list",
                {
                  "property": "position",
                  "value": "fixed"
                },
                {
                  "property": "right",
                  "value": "calc(16px + env(safe-area-inset-right, 0px))"
                },
                {
                  "property": "bottom",
                  "value": "calc(16px + env(safe-area-inset-bottom, 0px))"
                },
                {
                  "property": "z-index",
                  "value": "40"
                },
                {
                  "property": "display",
                  "value": "inline-flex"
                },
                {
                  "property": "align-items",
                  "value": "center"
                },
                {
                  "property": "gap",
                  "value": "8px"
                },
                {
                  "property": "min-height",
                  "value": "44px"
                },
                {
                  "property": "max-width",
                  "value": "calc(100vw - 32px)"
                },
                {
                  "property": "box-sizing",
                  "value": "border-box"
                },
                {
                  "property": "padding",
                  "value": "11px 16px"
                },
                {
                  "property": "border",
                  "value": "1px solid #dec18a99"
                },
                {
                  "property": "border-radius",
                  "value": "999px"
                },
                {
                  "property": "background",
                  "value": "#101b2af5"
                },
                {
                  "property": "color",
                  "value": "#f6ecda"
                },
                {
                  "property": "box-shadow",
                  "value": "0 5px 24px #0005"
                },
                {
                  "property": "font",
                  "value": "500 13px/1.35 system-ui,sans-serif"
                },
                {
                  "property": "letter-spacing",
                  "value": ".01em"
                },
                {
                  "property": "text-decoration",
                  "value": "none"
                },
                {
                  "property": "text-transform",
                  "value": "none"
                },
                {
                  "property": "transition",
                  "value": "background .2s ease,border-color .2s ease,transform .2s ease"
                }
              ]
            },
            {
              "id": "return.hover",
              "selector": ".microsite-return:hover,.microsite-return:focus-visible",
              "context": null,
              "declarations": [
                "list",
                {
                  "property": "background",
                  "value": "#22334a"
                },
                {
                  "property": "border-color",
                  "value": "#f0d597"
                },
                {
                  "property": "color",
                  "value": "#fff5df"
                },
                {
                  "property": "transform",
                  "value": "translateY(-2px)"
                },
                {
                  "property": "text-decoration",
                  "value": "none"
                }
              ]
            },
            {
              "id": "return.focus",
              "selector": ".microsite-return:focus-visible",
              "context": null,
              "declarations": [
                "list",
                {
                  "property": "outline",
                  "value": "2px solid #f0d597"
                },
                {
                  "property": "outline-offset",
                  "value": "4px"
                }
              ]
            },
            {
              "id": "return.space",
              "selector": "body",
              "context": null,
              "declarations": [
                "list",
                {
                  "property": "padding-bottom",
                  "value": "80px"
                }
              ]
            },
            {
              "id": "return.reduce",
              "selector": ".microsite-return",
              "context": "(prefers-reduced-motion: reduce)",
              "declarations": [
                "list",
                {
                  "property": "transition",
                  "value": "none"
                },
                {
                  "property": "transform",
                  "value": "none !important"
                }
              ]
            },
            {
              "id": "return.print",
              "selector": ".microsite-return",
              "context": " print",
              "declarations": [
                "list",
                {
                  "property": "display",
                  "value": "none"
                }
              ]
            }
          ]
        }
      },
      {
        "call": "css.renderPlan"
      },
      {
        "port": "file.write",
        "args": {
          "path": "assets/microsite-return.css",
          "text": "$css"
        },
        "into": "_"
      }
    ],
    "microsite.return.project": [
      {
        "let": "returnDocument",
        "value": [
          "one",
          "$msDocument",
          "path"
        ]
      },
      {
        "when": [
          "includes",
          [
            "list",
            "temple/index.html",
            "temple/films/index.html",
            "sourcery/index.html",
            "sourcery/films/index.html"
          ],
          "$returnDocument"
        ],
        "then": [
          {
            "let": "returnMarkup",
            "value": "$result"
          },
          {
            "let": "returnPrefix",
            "value": [
              "if",
              [
                "includes",
                "$returnDocument",
                "/films/"
              ],
              "../../",
              "../"
            ]
          },
          {
            "let": "input",
            "value": {
              "tag": "link",
              "attrs": {
                "rel": "stylesheet",
                "href": [
                  "concat",
                  "$returnPrefix",
                  "assets/microsite-return.css?v=return-1"
                ]
              },
              "children": [
                "list"
              ]
            }
          },
          {
            "call": "html.serialize"
          },
          {
            "let": "returnHead",
            "value": [
              "concat",
              "$result",
              "\n"
            ]
          },
          {
            "let": "input",
            "value": {
              "tag": "a",
              "attrs": {
                "id": "microsite-return",
                "class": "microsite-return",
                "href": [
                  "concat",
                  "$returnPrefix",
                  "index.html#microsites"
                ],
                "aria-label": "Back to Aaron Alderman’s main website"
              },
              "children": [
                "list",
                {
                  "tag": "span",
                  "attrs": {
                    "aria-hidden": "true"
                  },
                  "children": [
                    "list",
                    "←"
                  ]
                },
                {
                  "tag": "span",
                  "attrs": {},
                  "children": [
                    "list",
                    "Back to Aaron Alderman"
                  ]
                }
              ]
            }
          },
          {
            "call": "html.serialize"
          },
          {
            "let": "returnBody",
            "value": [
              "concat",
              "\n",
              "$result",
              "\n"
            ]
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$returnMarkup",
              "search": "</head>",
              "replacement": [
                "concat",
                "$returnHead",
                "</head>"
              ]
            },
            "into": "returnMarkup"
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$returnMarkup",
              "search": "</body>",
              "replacement": [
                "concat",
                "$returnBody",
                "</body>"
              ]
            },
            "into": "result"
          }
        ]
      }
    ]
  }
}
