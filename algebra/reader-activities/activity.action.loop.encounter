process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process activity.action.loop:
  let button = $eventInput.button
  let value = $eventInput.value
  port state.set { key = "loopRunning"; value = true } → _
  port clock.read {  } → clock
  port state.set { key = "loopStart"; value = $clock.monotonic } → _
  port browser.write { ref = "[data-demo=\"loop\"]"; name = "disabled"; value = true } → _
  port browser.write { ref = "[data-demo=\"loop-reset\"]"; name = "disabled"; value = true } → _
  port browser.attribute { ref = "[data-demo=\"loop\"]"; name = "aria-pressed"; value = true } → _
  port browser.write {
    ref = "#loop-readout";
    name = "textContent";
    value = "Following the frame around the path…"
  } → _
  port browser.frame { query = "activity.loop.frame"; input = {  } } → _
