process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process activity.calculations:
  port browser.select { selector = ".calculation-detail" } → details
  each $details as detail:
    port browser.relative { ref = $detail.ref; relation = "query"; selector = ".equation-note" } → equation
    port browser.write { ref = $detail.ref; name = "hidden"; value = $equation.hidden } → _
