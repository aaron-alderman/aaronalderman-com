process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process activity.action.garden-mode:
  let button = $eventInput.button
  let value = $eventInput.value
  port browser.select { selector = "[data-world=\"garden-mode\"]" } → buttons
  each $buttons as choice:
    port browser.attribute {
      ref = $choice.ref;
      name = "aria-pressed";
      value = eq($choice.ref.handle, $button.ref.handle)
    } → _
  port state.set { key = "mode"; value = $value } → _
  let mode = $value
  port browser.attribute { ref = ".world-encounter"; name = "data-mode"; value = $mode } → _
  port browser.write { ref = "#garden-limit"; name = "max"; value = if(eq($mode, "positive"), "4", "8") } → _
  let value = if(eq($mode, "positive"), "1", "4")
  port browser.write { ref = "#garden-limit"; name = "value"; value = $value } → _
  port browser.write { ref = "#garden-equation"; name = "hidden"; value = not(eq($mode, "positive")) } → _
  port browser.write {
    ref = "#garden-rule-copy";
    name = "textContent";
    value = if(
      eq($mode, "positive"),
      "Strength of the link (c) =",
      "Keep pairs whose two numbers add up to at most"
    )
  } → _
  call activity.garden
