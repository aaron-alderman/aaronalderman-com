process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process activity.standard.boot:
  port state.set { key = "quiet"; value = false } → _
  port state.set { key = "revisionOpen"; value = false } → _
  port state.set { key = "gate"; value = false } → _
  port state.set { key = "memoryHidden"; value = false } → _
  port state.set { key = "enriched"; value = false } → _
  port state.set { key = "loopRunning"; value = false } → _
  port state.set { key = "step"; value = 0 } → _
  port state.set { key = "bits"; value = list(0, 0, 0) } → _
  port state.set { key = "original"; value = 0 } → _
  port state.set { key = "mode"; value = "budget" } → _
  port state.set { key = "coupled"; value = true } → _
  port state.set { key = "origin"; value = "a" } → _
  port browser.location {  } → location
  port text.slice { value = $location.hash; start = 1 } → id
  let id = or($id, "observation")
  port record.get { record = $data.activities; key = $id } → activity
  assert $activity
    otherwise "READER-PLACE: Unknown activity."
  port state.set { key = "activity"; value = $activity } → _
  port browser.attribute { ref = "body"; name = "data-activity"; value = $activity.id } → _
  port browser.title { value = concat($activity.title, " — Aaron Alderman") } → _
  let input = $activity.tree
  call projection.serialize
  port browser.content { ref = "#activity"; html = $result } → _
  let input = { tag = "p"; attrs = {  }; children = list($activity.instruction) }
  call projection.serialize
  let markup = $result
  port browser.content { ref = "#activity-help"; html = $markup } → _
  port browser.select { selector = ".encounter-label" } → labels
  each $labels as label:
    port browser.write { ref = $label.ref; name = "textContent"; value = $activity.title } → _
  when $activity.note:
    port browser.select { selector = ".demo-note,.world-note" } → notes
    each $notes as note:
      port browser.write { ref = $note.ref; name = "textContent"; value = $activity.note } → _
  port browser.select { selector = ".equation-note" } → equations
  each $equations as equation:
    port browser.property { ref = $equation.ref; name = "outerHTML" } → equationHTML
    let componentText = $equationHTML
    let componentFragment = true
    let componentStyles = {}
    let componentSubstitutions = {}
    call projection.compileComponent
    let input = { tag = "details"; attrs = { class = "calculation-detail" }; children = list({ tag = "summary"; attrs = {}; children = list("See the calculation") }, $result) }
    call projection.serialize
    port browser.replace { ref = $equation.ref; html = $result } → _
  call activity.calculations
  port browser.environment {  } → environment
  port state.set { key = "motion"; value = not($environment.reduced) } → _
  port browser.attribute { ref = "body"; name = "data-motion"; value = if($environment.reduced, "paused", "on") } → _
  port browser.write {
    ref = "#motion-toggle";
    name = "textContent";
    value = if($environment.reduced, "Reduced motion", "Motion on")
  } → _
  port state.get { key = "activityBound" } → activityBound
  when not($activityBound):
    port browser.on {
      ref = "#activity-source";
      event = "click";
      query = "activity.source.backdrop";
      input = {  }
    } → _
    port browser.on {
      ref = "document";
      event = "click";
      query = "activity.source";
      input = {  };
      delegate = "[data-source]"
    } → _
    port browser.on {
      ref = "#activity-source-close";
      event = "click";
      query = "activity.source.close";
      input = {  }
    } → _
    port browser.on {
      ref = "document";
      event = "click";
      query = "activity.click";
      input = {  };
      delegate = "button[data-world],button[data-encounter],button[data-demo]"
    } → _
    port browser.on {
      ref = "document";
      event = "input";
      query = "activity.input";
      input = {  };
      delegate = "input[type=range]"
    } → _
    port browser.on { ref = "window"; event = "hashchange"; query = "activity.boot"; input = {  } } → _
    port browser.on { ref = "#motion-toggle"; event = "click"; query = "activity.motion"; input = {  } } → _
    port state.set { key = "activityBound"; value = true } → _
  port storage.read { key = "worldwright-motion" } → preference
  port browser.environment {  } → environment
  let motion = and(not($environment.reduced), not(eq($preference.value, "paused")))
  port state.set { key = "motion"; value = $motion } → _
  port browser.write { ref = "#motion-toggle"; name = "disabled"; value = $environment.reduced } → _
  port browser.attribute { ref = "body"; name = "data-motion"; value = if($motion, "on", "paused") } → _
  port browser.write {
    ref = "#motion-toggle";
    name = "textContent";
    value = if($environment.reduced, "Reduced motion", if($motion, "Motion on", "Motion paused"))
  } → _
