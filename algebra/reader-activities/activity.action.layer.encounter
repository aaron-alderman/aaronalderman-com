process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process activity.action.layer:
  let button = $eventInput.button
  let value = $eventInput.value
  port browser.select { selector = "[data-encounter=\"layer\"]" } → buttons
  each $buttons as choice:
    port browser.attribute {
      ref = $choice.ref;
      name = "aria-pressed";
      value = eq($choice.ref.handle, $button.ref.handle)
    } → _
  port browser.attribute { ref = ".art-panel"; name = "data-layer"; value = $value } → _
  port browser.write { ref = "#layer-conditions"; name = "hidden"; value = eq($value, "surface") } → _
  port browser.write { ref = "#layer-limits"; name = "hidden"; value = not(eq($value, "limits")) } → _
