process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process activity.action.door:
  let button = $eventInput.button
  let value = $eventInput.value
  port browser.select { selector = "[data-encounter=\"door\"]" } → buttons
  each $buttons as choice:
    port browser.attribute {
      ref = $choice.ref;
      name = "aria-pressed";
      value = eq($choice.ref.handle, $button.ref.handle)
    } → _
  port browser.write {
    ref = "#door-answer";
    name = "textContent";
    value = at(
      {
        can = "Capability: a draft exists. Producing it has not established permission to send it.";
        may = "Permission: the people and authority involved still need to be identified. Availability of a button is not that authority.";
        should = "Responsibility: consider timing, consequences and the people affected. Permission alone does not decide whether sending is wise."
      },
      $value
    )
  } → _
