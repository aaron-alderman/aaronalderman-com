process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process household.chart.select:
  port number.parse { value = $eventInput.matched.value } → n
  port number.calculate { operation = "min"; values = list(12, $n) } → hn195
  port number.calculate { operation = "max"; values = list(1, $hn195) } → hn194
  port state.set { key = "hh-period"; value = $hn194 } → hp193
  port kernel.invoke { query = "household.render"; input = {  } } → hq196
