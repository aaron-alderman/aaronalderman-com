process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process activity.action.original-bit:
  let button = $eventInput.button
  let value = $eventInput.value
  port number.parse { value = $value } → bit
  port state.set { key = "original"; value = $bit } → _
  let original = $bit
  port state.set { key = "bits"; value = list($bit, $bit, $bit) } → _
  let bits = list($bit, $bit, $bit)
  port browser.select { selector = "[data-world=\"original-bit\"]" } → buttons
  each $buttons as choice:
    port browser.attribute {
      ref = $choice.ref;
      name = "aria-pressed";
      value = eq($choice.ref.handle, $button.ref.handle)
    } → _
  call activity.code
