process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process household.click:
  let id = at($eventInput.matched.attributes, "id")
  port state.get { key = "hh-period" } → period
  when eq($id, "hh-reset"):
    port state.set { key = "hh-overrides"; value = list() } → hp172
    port kernel.invoke { query = "household.rebuild"; input = {  } } → hq173
  when includes(list("hh-prev", "hh-next"), $id):
    port number.calculate { operation = "add"; values = list($period, if(eq($id, "hh-next"), 1, -1)) } → hn177
    port number.calculate { operation = "min"; values = list(12, $hn177) } → hn176
    port number.calculate { operation = "max"; values = list(1, $hn176) } → hn175
    port state.set { key = "hh-period"; value = $hn175 } → hp174
    port kernel.invoke { query = "household.render"; input = {  } } → hq178
  let selected = at($eventInput.matched.attributes, "data-hh-period")
  when $selected:
    port number.parse { value = $selected } → n
    port state.set { key = "hh-period"; value = $n } → hp179
    port kernel.invoke { query = "household.render"; input = {  } } → hq180
