process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process encounter.demo.change:
  port kernel.invoke { query = "ec.run"; input = { candidate = $eventInput.candidate } } → before
  let pages = filter($before, "item", eq($item.output.type, "Page"))
  assert eq(count($pages), 1)
    otherwise "Encounter requires one current Page projection."
  port kernel.invoke {
    query = "ec.patch";
    input = {
      candidate = $eventInput.candidate;
      projection = at($pages, 0);
      field = "P.title";
      value = $eventInput.value
    }
  } → result
