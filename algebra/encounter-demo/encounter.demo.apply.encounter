process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process encounter.demo.apply:
  port state.get { key = "candidate" } → candidate
  port browser.property { ref = "#encounter-title"; name = "value" } → proposed
  try:
    port kernel.invoke {
      query = "encounter.demo.change";
      input = { candidate = $candidate; value = $proposed }
    } → change
    port state.set { key = "candidate"; value = $change.candidate } → _
    port state.set {
      key = "notice";
      value = "Accepted for this session. The story and the row changed; the web menu kept its own label."
    } → _
    port state.set { key = "selection"; value = "facts" } → _
  catch fault:
    port state.set { key = "notice"; value = concat("Refused. ", at($fault, "message")) } → _
  port kernel.invoke { query = "encounter.demo.render"; input = {  } } → result
