process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process reader.hashLink:
  port browser.dialog { ref = "#reader-dialog"; open = false } → _
  port state.get { key = "current" } → current
  when eq(at($eventInput.matched.attributes, "href"), concat("#", $current)):
    call reader.route
