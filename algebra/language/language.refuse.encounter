process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process language.refuse:
  let state = {
    module = $state.module;
    subject = $state.subject;
    seen = $state.seen;
    facts = $state.facts;
    origins = $state.origins;
    ok = false;
    diagnostic = {
      code = $code;
      phase = "language";
      boundary = "encounter-rel/1";
      summary = $summary;
      correction = $correction;
      span = $span;
      check = "node --test bootstrap/language.test.cjs"
    }
  }
