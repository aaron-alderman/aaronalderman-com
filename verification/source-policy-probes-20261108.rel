("audit", "evidenceFamily", "Same-session local implementation and verification; no independent security review or fresh rendered-browser qualification")
("audit.meta-refresh", "status", "CLOSED: actual admitted browser port refuses before the DOM setter")
("audit.meta-refresh", "scope", "Mock DOM observation, not a claim of rendered-browser or navigation testing")
("audit.regexp", "status", "CLOSED: isolated worker terminated at Encounter-owned deadline; guest try/catch cannot swallow it")
("audit.regexp", "elapsedMs", "1006")
("audit.regexp", "workerRecovery", "PASS")
("audit.regexp", "rawFallback", "CLOSED: public registry methods refuse without isolated transport; synchronous regex observations exist only in the private pinned-policy interpreter")
("audit.facts-accessor", "status", "CLOSED: descriptor checks refuse the fact accessor without invoking it")
("audit.capabilities", "status", "PASS: diagnostic REL receipts and raw models convey no admission authority")
("bootstrap/encounter-admission.cjs", "status", "Forwarding or read-only Encounter wrapper; former native compiler/checker removed")
("bootstrap/encounter-syntax.cjs", "status", "Forwarding or read-only Encounter wrapper; former native compiler/checker removed")
("audit.compiler-basis", "status", "CLOSED: Encounter compares the claimed basis to the private loaded compiler identity, not to the caller claim itself")
("audit.generated-intake", "status", "CLOSED: source policy refuses generated outputs, migration and retired dependency roots as authoring inputs")
