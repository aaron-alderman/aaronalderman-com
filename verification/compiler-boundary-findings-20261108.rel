// Local source and mechanism audit. Findings remain open; not a security certificate.
("audit.20261108", "scope", "Canonical website compiler, admission, selected sources, native basis and browser effect boundary; no runtime implementation changed")
("audit.20261108", "status", "OPEN findings; zero JSON and passing regression checks do not establish absence of backdoors")
("audit.20261108", "evidenceFamily", "Same-agent local source review and bounded mechanism probes; no independent or fresh rendered-browser verification")
("audit.20261108", "inventory", "verification/compiler-boundary-inventory-20261108.rel")
("audit.20261108", "probeEvidence", "verification/compiler-boundary-probes-20261108.rel")
("audit.20261108", "reproduceProbes", "node verification/compiler-boundary-audit.cjs --probes")
("audit.20261108", "reproduceInventory", "node verification/compiler-boundary-audit.cjs --inventory")
("audit.20261108", "selectedEncounterFiles", "305")
("audit.20261108", "selectedEncounterQueries", "470")
("audit.20261108", "backendAdmittedQueries", "100")
("audit.20261108", "backendEntries", "publication.local; publication.seal")
("audit.20261108", "nativeTrustedFiles", "36: 13 first-party foundation files and 23 vendored parser files")
("audit.20261108", "nativeOutsidePublicationBasis", "6 regression test files, 1 audit probe file and serve.mjs")
("audit.20261108", "staticResources", "1304 declarations: 302 behaviour aliases, 374 values, 14 fact sources, 614 historical snapshot assets; three additional Encounter modules are directly selected")
("audit.20261108", "jsonFiles", "0 in active worktree including local outputs")
("audit.20261108", "sourceHashCheck", "All 36 current native basis file hashes match the stored canonical execution receipt")
("audit.20261108", "programmeAuthority", "Actual Encounter text is parsed natively, encoded into typed REL, decoded, linked, validated and lowered natively, then executed by the native seed through an opaque handle")
("audit.20261108", "staticAuthority", "Native REL syntax/value validation and fact ownership checks; domain-specific cardinality and reference checks occur in Encounter programmes during composition, not in a general pre-composition domain-schema admission pass")
("audit.20261108", "nativePolicy", "Native arities, operator meanings, binding restrictions, effect checks, child pure-effect list, phase limits, path rules, artifact formats and markup-execution ceiling remain policy-bearing trusted code")
("audit.20261108", "notSelfHosted", "The operative generic Encounter compiler and admission checker are native JavaScript. Encounter lowering/admission programmes also exist but do not implement the outer front-door checker")
("audit.20261108", "rawKernelBoundary", "temple-seed.cjs still exports createKernel with raw evaluate/run APIs to native callers. These are not granted as Encounter raw-model ports. The sole-front-door guarantee applies to the declared host/wrapper, not arbitrary native Node callers")
("audit.20261108", "architectureConclusion", "This is Encounter-authored application behaviour over a substantial trusted native compiler/admission foundation. It is not an Encounter-implemented compiler/admission stack")

("audit.finding.meta-refresh", "priority", "P2")
("audit.finding.meta-refresh", "status", "OPEN; native effect-policy bypass reproduced")
("audit.finding.meta-refresh", "source", "bootstrap/markup-ceiling.cjs:19; bootstrap/markup-ceiling.cjs:47; bootstrap/ports/browser-effects.cjs:127")
("audit.finding.meta-refresh", "finding", "External meta refresh is refused in static HTML, but an admitted browser.attribute programme can set content to an external refresh URL and then set http-equiv to refresh. The mutation check never applies the static meta-refresh rule")
("audit.finding.meta-refresh", "witness", "Actual Encounter hydration and admission followed by the real browser.attribute mechanism; mock DOM setter received both unsafe attribute writes")
("audit.finding.meta-refresh", "limit", "No browser navigation or arbitrary JavaScript execution was demonstrated; this is a confirmed inconsistency at the native DOM setter boundary")
("audit.finding.meta-refresh", "requiredClosure", "Apply one equivalent refresh policy to insertion and mutation, or deny refresh-related meta mutations; verify in a real browser when tooling is available")

("audit.finding.native-budget", "priority", "P2")
("audit.finding.native-budget", "status", "OPEN; native work exceeds step-budget protection")
("audit.finding.native-budget", "source", "bootstrap/ports/value.cjs:33; bootstrap/ports/browser-effects.cjs:86; bootstrap/temple-seed.cjs:99")
("audit.finding.native-budget", "finding", "An admitted text.matches call with pattern ^(a+)+$ and 30 a characters followed by ! did not complete within a 1000 ms isolated-child timeout despite a 100-step kernel limit. The short baseline completed in four kernel steps")
("audit.finding.native-budget", "impact", "Native regex backtracking can block the Node host or browser event loop without consuming corresponding kernel ticks. Step limits are not wall-clock or memory limits")
("audit.finding.native-budget", "requiredClosure", "Constrain or separately interrupt native regex work; evaluate compatibility with existing language and contract patterns before changing the mechanism")

("audit.finding.facts-accessor", "priority", "P3")
("audit.finding.facts-accessor", "status", "OPEN; public native data-argument hardening gap reproduced")
("audit.finding.facts-accessor", "source", "bootstrap/rel-values.cjs:36; bootstrap/encounter-admission.cjs:133")
("audit.finding.facts-accessor", "finding", "rel.print directly reads fact properties. A getter on facts[0].s executed before front.run refused the supplied facts for lacking an admitted fact indexer")
("audit.finding.facts-accessor", "scope", "Requires hostile JavaScript caller objects. Canonical REL file parsing and browser packet decoding produce own-data records, so this probe is not evidence of an on-site remote execution path")
("audit.finding.facts-accessor", "requiredClosure", "Validate own-data fact array and record descriptors before reading values, or explicitly restrict this native API to trusted caller objects")

("audit.assumption.native-load-identity", "status", "Unclosed provenance assumption; source review, no exploit reproduced")
("audit.assumption.native-load-identity", "source", "bootstrap/local.cjs:6; bootstrap/local.cjs:84; bootstrap/local.cjs:100")
("audit.assumption.native-load-identity", "finding", "Native modules are required before their on-disk source hashes are sampled. The final recheck detects changes after sampling, but does not attest that the sampled bytes were the ones already loaded by Node")
("audit.assumption.native-load-identity", "scope", "Requires a native load-time filesystem race or a compromised native process. Current files match the stored receipt; no mismatch was observed in the canonical output")

("audit.closed-checks", "modelIntake", "No public raw model, expression-object or serialized receipt import found in createFrontDoor; forged, copied and cross-instance handles are refused")
("audit.closed-checks", "effectScope", "Every included programme branch is checked; child programmes hydrate actual Encounter and use a separate pure model while sharing their caller's kernel budget")
("audit.closed-checks", "sourceOrigin", "Published Encounter/resource fetches compare strict UTF-8 source identities before hydration or decoding; source metadata alone cannot confer authority")
("audit.closed-checks", "artifactEntry", "Generic issued runtimes and matching SRI are required for script artifacts; static SVG/XML uses the separate inert XML observer; raw old model bridges are absent from the active host")
("audit.closed-checks", "locality", "No commit, push, deployment, new site feature, remote probe or network submission performed")
("audit.closed-checks", "limitation", "These checks cover inspected entry points and concrete probes. They do not prove universal safety, adversarial-OS isolation, or browser behaviour that was not observed")
("audit.closed-checks", "regressionRerun", "35 existing checks passed on 2026-11-08; the three new counterexample probes also reproduced. Existing checks do not cover these open gaps")
("audit.closed-checks", "documentationCorrection", "README test invocation corrected to enumerate actual .test.cjs files; node --test bootstrap fails as a directory entry under the installed Node 24 runner")
("audit.current-revision", "supersededBy", "verification/source-policy-publication-audit-20261108.rel")
("audit.current-revision", "scope", "Findings above describe the earlier native-policy revision. Current source-owned replacement and closure evidence are recorded separately; historical counterexamples are retained unchanged")
