("qa.static", "evidence", "../../deliverables/growing-up-in-the-way-of-jesus/common-projection-qa/release-15/observations.rel")
("qa.static", "states", "620")
("qa.static", "screenshots", "1240")
("qa.static", "scope", "All 310 routes at 1440x1000 and 390x844, top and footer, scripts disabled for static comparison; no document-width overflow. Interactive tests are separate.")
("qa.static", "comparison", "../../deliverables/growing-up-in-the-way-of-jesus/common-projection-qa/release-15/comparison.rel")
("qa.static", "review", "Geometry is unchanged outside the intentionally expanded design guide. Updated assurance/owner labels and progressive-image raster differences were reviewed; final settled images were separately captured.")
("qa.interactive", "evidence", "../../deliverables/growing-up-in-the-way-of-jesus/common-projection-qa/interactive-release-15/observations.rel")
("qa.interactive", "workshopConfirmation", "../../deliverables/growing-up-in-the-way-of-jesus/common-projection-qa/interactive-workshop-confirmed-15/observations.rel")
("qa.interactive", "scope", "All 11 reading-page theme switches at both widths; mouse and keyboard; homepage identity switching; atlas; reader navigation/search; workshop edits, source and literal injection; Claimipedia, Sourcery, Temple and inspection; all 40 activity components.")
("qa.interactive", "confirmedCases", "78")
("qa.interactive", "result", "PASS after confirming the two workshop cases with the bounded 90-second wait.")
("qa.interactive", "retainedInitialFinding", "The original 20-second workshop update waits expired while the live UI was still checking the changes. Both widths subsequently completed the same edits and literal-injection checks without browser errors. Original failure evidence is retained.")
("qa.reading", "evidence", "../../deliverables/growing-up-in-the-way-of-jesus/common-reading-release-15/observations.rel")
("qa.reading", "scope", "Full overlapping scroll captures of guide, series, article, Dad Threads and Dad essay at both widths; open source and component disclosures; fixed cross, card insets, keyboard focus and unchanged dark footer after all four themes.")
("qa.reading", "settledImageFinding", "The guide cover was captured before raster paint in one scroll frame. A separate main-preview capture explicitly awaited image.decode and confirms the visible 1536x1024 cover. Series and article images were confirmed the same way.")
("qa.reading", "embeddedActivity", "The main-preview reader activity frame was explicitly awaited until mounted, checked for errors and visually reviewed.")
