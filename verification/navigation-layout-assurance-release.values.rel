("v114", "type", "Entry")
("v114", "key", "boundary")
("v115", "type", "String")
("v115", "scalar", "Lexical source checks target redundant personal home-return controls, orphan return stylesheets and explicit inline body bottom reservations. They do not certify arbitrary CSS, computed geometry, duplicate navigation intent, runtime states or visual fitness. Every page retains an open browser-evidence requirement. Registered CSS is checked for unconditional body padding-bottom/margin-bottom in positive supported units. Shorthands, variables, fractional values below one unit, selector groups, cascade and other stylesheet patterns remain outside this check.")
("v114", "value", "v115")
