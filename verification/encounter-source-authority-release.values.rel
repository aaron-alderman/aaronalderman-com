("v85", "type", "String")
("v85", "scalar", "# Authoritative shared Markdown, lexer and formatting processes.\n# JSON is generated by the selected Encounter process frontend.\n# The compiler lowers into the existing algebra and kernel.\nprocess-module \"temple/surface-process-module/1\"\nprofile \"encounter/shared-source-module/2\"\n\nprocess sp.role:\n  let v = at($eventInput, \"text\")\n  let language = at($eventInput, \"language\")\n  let role = \"plain\"\n  when eq($language, \"javascript\"):\n    when eq(at($eventInput, \"category\"), \"comment\"):\n      let role = \"comment\"\n    port value.describe { value = at($eventInput, \"keyword\") } → keywordType\n    when and(eq(at($keywordType, \"type\"), \"string\"), not(eq(at($eventInput, \"keyword\"), \"\"))):\n      let role = \"keyword\"\n    fold at($spPolicy, \"javascriptRoles\") as rule; role starts $role:\n      when includes(at($rule, \"kinds\"), at($eventInput, \"kind\")):\n        let role = at($rule, \"role\")\n      yield $role → role\n  when not(eq($language, \"javascript\")):\n    port text.slice { value = $v; start = 0; end = 1 } → first\n    port text.matches { value = $v; pattern = \"^\\\\s*$\" } → white\n    when not($white):\n      when eq($first, \"\\\"\"):\n        let role = \"string\"\n        when eq($language, \"json\"):\n          port text.matches { value = at($eventInput, \"tail\"); pattern = \"^\\\\s*:\" } → key\n          when $key:\n            let role = \"property\"\n        when eq($language, \"rel\"):\n          when eq(at($eventInput, \"atom\"), 0):\n            let role = \"identity\"\n          when eq(at($eventInput, \"atom\"), 1):\n            let role = \"predicate\"\n      when and(not(eq($first, \"\\\"\")), includes(list(\"true\", \"false\"), $v)):\n        let role = \"boolean\"\n      when eq($v, \"null\"):\n        let role = \"keyword\"\n      port text.matches { value = $v; pattern = \"^-?[0-9]\" } → number\n      when $number:\n        let role = \"number\"\n      port text.matches { value = $v; pattern = \"^(?://|#)\" } → comment\n      when $comment:\n        let role = \"comment\"\n      when and(\n        includes(list(\"encounter\", \"temple\", \"process\"), $language),\n        not(or($comment, eq($first, \"\\\"\"), $number))\n      ):\n        port text.matches { value = $v; pattern = \"^[A-Za-z_]\" } → name\n        when and($name, eq($role, \"plain\")):\n          let role = if(includes(at($spPolicy, \"keywords\"), $v), \"keyword\", \"identifier\")\n        when includes(list(\"@\", at($spPolicy, \"referenceSigil\")), $first):\n          let role = \"reference\"\n      when includes(at($spPolicy, \"punctuation\"), $v):\n        let role = \"punctuation\"\n      when includes(at($spPolicy, \"operators\"), $v):\n        let role = \"operator\"\n  when or(\n    and(\n      eq($language, \"rel\"),\n      eq(at($eventInput, \"atom\"), 2),\n      includes(at($spPolicy, \"typePredicates\"), at($eventInput, \"predicate\")),\n      eq($role, \"string\")\n    ),\n    and(\n      includes(list(\"encounter\", \"temple\"), $language),\n      at($eventInput, \"typeExpected\"),\n      includes(list(\"string\", \"identifier\"), $role)\n    )\n  ):\n    let role = \"type\"\n  when eq($language, \"markdown\"):\n    let role = \"plain\"\n    port text.matches { value = $v; pattern = \"^(?:#{1,6}|\\\\*\\\\*)\" } → mdHeading\n    when $mdHeading:\n      let role = \"keyword\"\n    port text.matches { value = $v; pattern = \"^`|^~~~\" } → mdCode\n    when $mdCode:\n      let role = \"string\"\n    port text.matches { value = $v; pattern = \"^\\\\[\" } → mdLink\n    when $mdLink:\n      let role = \"reference\"\n    port text.matches { value = $v; pattern = \"^(?:\\\\||[-+>] |\\\\*)\" } → mdPunctuation\n    when $mdPunctuation:\n      let role = \"operator\"\n  let result = $role\n\nprocess sp.scan:\n  let text = at($eventInput, \"text\")\n  let language = at($eventInput, \"language\")\n  port kernel.invoke { query = \"source.split\"; input = { text = $text; language = $language } } → lexed\n  let parts = at($lexed, \"parts\")\n  let withinLimit = at($lexed, \"withinLimit\")\n  let segments = list({ start = 0; end = count($text); text = $text; role = \"plain\" })\n  when $withinLimit:\n    fold $parts as part; scan starts {\n      offset = 0;\n      segments = list();\n      atom = 0;\n      predicate = null;\n      typeNext = false;\n      previous = null;\n      declaration = null\n    }:\n      let start = at($scan, \"offset\")\n      let end = add($start, count($part))\n      let segments = at($scan, \"segments\")\n      let atom = at($scan, \"atom\")\n      when eq($part, \"(\"):\n        let atom = 0\n      port text.slice { value = $text; start = $end; end = count($text) } → tail\n      port kernel.invoke {\n        query = \"sp.role\";\n        input = {\n          text = $part;\n          language = $language;\n          tail = $tail;\n          atom = $atom;\n          predicate = at($scan, \"predicate\");\n          typeExpected = at($scan, \"typeNext\")\n        }\n      } → role\n      when not(eq(count($part), 0)):\n        let segments = append($segments, list({ start = $start; end = $end; text = $part; role = $role }))\n      port text.slice { value = $part; start = 0; end = 1 } → first\n      when eq($first, \"\\\"\"):\n        let atom = add($atom, 1)\n      let predicate = at($scan, \"predicate\")\n      let typeNext = at($scan, \"typeNext\")\n      let previous = at($scan, \"previous\")\n      let declaration = at($scan, \"declaration\")\n      when and(eq($language, \"rel\"), eq(at($scan, \"atom\"), 1), eq($first, \"\\\"\")):\n        try:\n          port json.parse { text = $part } → predicate\n        catch predicateFault:\n          let predicate = null\n      port text.matches { value = $part; pattern = \"[\\\\r\\\\n]\" } → lineBreak\n      port text.matches { value = $part; pattern = \"^\\\\s*$\" } → space\n      when $lineBreak:\n        let typeNext = false\n        let previous = null\n        let declaration = null\n      when and(not($space), not(eq($role, \"comment\"))):\n        when and(eq($previous, null), eq($role, \"keyword\"), eq($part, \"given\")):\n          let declaration = \"given\"\n        let typeNext = and(\n          includes(list(\"encounter\", \"temple\"), $language),\n          eq($role, \"keyword\"),\n          or(\n            includes(at(at($spPolicy, \"typeIntroducers\"), $language), $part),\n            and(eq($part, \"as\"), or(eq($previous, \"show\"), eq($declaration, \"given\")))\n          )\n        )\n        let previous = $part\n      yield {\n      offset = $end;\n      segments = $segments;\n      atom = $atom;\n      predicate = $predicate;\n      typeNext = $typeNext;\n      previous = $previous;\n      declaration = $declaration\n    } → scan\n    let segments = at($scan, \"segments\")\n  let result = {\n    segments = $segments;\n    diagnostic = if($withinLimit, null, \"SP-LIMIT: Exact text retained without token decoration.\")\n  }\n\nprocess sp.observed:\n  let text = at($eventInput, \"text\")\n  let observed = at($eventInput, \"observed\")\n  assert and(\n    eq(at($observed, \"units\"), \"utf16\"),\n    eq(at($observed, \"sha256\"), at($eventInput, \"sha256\")),\n    isArray(at($observed, \"tokens\"))\n  )\n    otherwise \"SP-OBSERVATION: Token observations belong to a different source basis.\"\n  assert includes(\n    range(add(at($spPolicy, \"maxParts\"), 1)),\n    add(count(at($observed, \"tokens\")), 1)\n  )\n    otherwise \"SP-LIMIT: Too many observed tokens.\"\n  fold at($observed, \"tokens\") as token; scan starts { offset = 0; segments = list() }:\n    let start = at($token, \"start\")\n    let end = at($token, \"end\")\n    port text.slice { value = $text; start = 0; end = $start } → prefix\n    port text.slice { value = $text; start = 0; end = $end } → endPrefix\n    assert and(eq(count($prefix), $start), eq(count($endPrefix), $end))\n      otherwise \"SP-RANGE: Token endpoint is outside the exact UTF-16 source.\"\n    port text.slice { value = $text; start = at($scan, \"offset\"); end = $start } → gap\n    port text.slice { value = $text; start = $start; end = $end } → raw\n    assert and(\n      eq(add(at($scan, \"offset\"), count($gap)), $start),\n      eq(add($start, count($raw)), $end)\n    )\n      otherwise \"SP-OVERLAP: Token observations are reversed or overlap.\"\n    let segments = at($scan, \"segments\")\n    when not(eq(count($gap), 0)):\n      let segments = append(\n        $segments,\n        list({ start = at($scan, \"offset\"); end = $start; text = $gap; role = \"plain\" })\n      )\n    port kernel.invoke {\n      query = \"sp.role\";\n      input = {\n        text = $raw;\n        language = \"javascript\";\n        category = at($token, \"category\");\n        kind = at($token, \"kind\");\n        keyword = at($token, \"keyword\")\n      }\n    } → role\n    when not(eq(count($raw), 0)):\n      let segments = append($segments, list({ start = $start; end = $end; text = $raw; role = $role }))\n    yield { offset = $end; segments = $segments } → scan\n  port text.slice { value = $text; start = at($scan, \"offset\"); end = count($text) } → tail\n  let result = at($scan, \"segments\")\n  when not(eq(count($tail), 0)):\n    let result = append(\n      $result,\n      list({ start = at($scan, \"offset\"); end = count($text); text = $tail; role = \"plain\" })\n    )\n\nprocess sp.clip:\n  let text = at($eventInput, \"text\")\n  let clipStart = at(at($eventInput, \"clip\"), \"start\")\n  let clipEnd = at(at($eventInput, \"clip\"), \"end\")\n  port text.slice { value = $text; start = 0; end = $clipStart } → startPrefix\n  port text.slice { value = $text; start = 0; end = $clipEnd } → endPrefix\n  port text.slice { value = $text; start = $clipStart; end = $clipEnd } → expected\n  assert and(\n    eq(count($startPrefix), $clipStart),\n    eq(count($endPrefix), $clipEnd),\n    eq(add($clipStart, count($expected)), $clipEnd)\n  )\n    otherwise \"SP-CLIP: Invalid source fragment coordinates.\"\n  fold at($eventInput, \"segments\") as segment; clipped starts list():\n    port text.slice { value = $startPrefix; start = 0; end = at($segment, \"start\") } → commonStart\n    let start = add(add($clipStart, at($segment, \"start\")), concat(\"-\", count($commonStart)))\n    port text.slice { value = $endPrefix; start = 0; end = at($segment, \"end\") } → commonEnd\n    let end = count($commonEnd)\n    port text.slice { value = $text; start = $start; end = $end } → piece\n    let next = $clipped\n    when not(eq(count($piece), 0)):\n      let next = append(\n        $clipped,\n        list({ start = $start; end = $end; text = $piece; role = at($segment, \"role\") })\n      )\n    yield $next → clipped\n  let joined = fold($clipped, \"segment\", \"joined\", \"\", concat($joined, at($segment, \"text\")))\n  assert eq($joined, $expected)\n    otherwise \"SP-COVERAGE: Presentation must preserve the exact source fragment.\"\n  port text.split { value = $startPrefix; pattern = \"\\\\r\\\\n|\\\\r|\\\\n\" } → prefixLines\n  let result = { segments = $clipped; text = $expected; firstLine = count($prefixLines) }\n\nprocess sp.line:\n  let result = {\n    tag = \"span\";\n    attrs = {\n      class = concat(\n        \"sp-line\",\n        if(eq(at($eventInput, \"number\"), at($eventInput, \"selectedLine\")), \" highlight\", \"\")\n      );\n      \"data-line\" = concat(at($eventInput, \"number\"))\n    };\n    children = at($eventInput, \"children\")\n  }\n\nprocess sp.render:\n  let selectedLine = at($eventInput, \"selectedLine\")\n  fold at($eventInput, \"segments\") as segment; layout starts { number = at($eventInput, \"firstLine\"); lines = list(); pending = list() }:\n    assert includes(at($spPolicy, \"roles\"), at($segment, \"role\"))\n      otherwise \"SP-ROLE: Unknown presentation role.\"\n    port text.split { value = at($segment, \"text\"); pattern = \"(\\\\r\\\\n|\\\\n|\\\\r)\" } → pieces\n    fold $pieces as piece; line starts $layout:\n      let number = at($line, \"number\")\n      let lines = at($line, \"lines\")\n      let pending = at($line, \"pending\")\n      port text.matches { value = $piece; pattern = \"^(?:\\\\r\\\\n|\\\\n|\\\\r)$\" } → newline\n      when $newline:\n        port kernel.invoke {\n          query = \"sp.line\";\n          input = { number = $number; selectedLine = $selectedLine; children = $pending }\n        } → lineTree\n        let lines = append($lines, list($lineTree, $piece))\n        let number = add($number, 1)\n        let pending = list()\n      when and(not($newline), not(eq($piece, \"\"))):\n        let pending = append(\n          $pending,\n          list(\n            {\n              tag = \"span\";\n              attrs = { class = concat(\"sp-token sp-\", at($segment, \"role\")) };\n              children = list($piece)\n            }\n          )\n        )\n      yield { number = $number; lines = $lines; pending = $pending } → nextLayout\n    yield $nextLayout → layout\n  port kernel.invoke {\n    query = \"sp.line\";\n    input = {\n      number = at($layout, \"number\");\n      selectedLine = $selectedLine;\n      children = at($layout, \"pending\")\n    }\n  } → lastLine\n  let result = {\n    tag = \"code\";\n    attrs = {\n      class = \"sp-code\";\n      \"data-theme\" = at($eventInput, \"theme\");\n      \"data-numbered\" = if(at($eventInput, \"lineNumbers\"), \"true\", \"false\");\n      tabindex = \"0\"\n    };\n    children = append(at($layout, \"lines\"), list($lastLine))\n  }\n\nprocess sp.present:\n  port kernel.invoke { query = \"s01.portable\"; input = { value = $eventInput; ancestors = list() } } → portable\n  assert $portable\n    otherwise \"SP-INPUT: Presentation requires finite own-data.\"\n  let text = at($eventInput, \"text\")\n  port value.describe { value = $text } → type\n  assert eq(at($type, \"type\"), \"string\")\n    otherwise \"SP-INPUT: Exact source text is required.\"\n  port digest.sha256 { text = $text } → hash\n  assert eq($hash, at($eventInput, \"expectedHash\"))\n    otherwise \"SP-BASIS: Source hash mismatch.\"\n  let file = at($eventInput, \"file\")\n  let fileAlias = at(at($spPolicy, \"fileAliases\"), $file)\n  when $fileAlias:\n    let file = $fileAlias\n  let language = at($eventInput, \"language\")\n  let theme = at($eventInput, \"theme\")\n  assert includes(at($spPolicy, \"themesAllowed\"), $theme)\n    otherwise \"SP-THEME: Unknown theme.\"\n  when eq($language, \"auto\"):\n    let language = \"plain\"\n    fold at($spPolicy, \"fileProfiles\") as profile; language starts $language:\n      port text.matches { value = $file; pattern = at($profile, \"pattern\") } → matches\n      when $matches:\n        let language = at($profile, \"language\")\n      yield $language → language\n  let reason = null\n  let segments = list({ start = 0; end = count($text); text = $text; role = \"plain\" })\n  port text.slice { value = $text; start = 0; end = at($spPolicy, \"maxCodeUnits\") } → bounded\n  let bounded = eq(count($bounded), count($text))\n  when not($bounded):\n    let reason = \"SP-LIMIT: Source retained as plain text at this presentation bound.\"\n  when and(\n    $bounded,\n    includes(list(\"json\", \"rel\", \"encounter\", \"temple\", \"process\", \"markdown\"), $language)\n  ):\n    port kernel.invoke { query = \"sp.scan\"; input = { text = $text; language = $language } } → scanned\n    let segments = at($scanned, \"segments\")\n    let reason = at($scanned, \"diagnostic\")\n  when and($bounded, eq($language, \"javascript\")):\n    when at($eventInput, \"observed\"):\n      port kernel.invoke {\n        query = \"sp.observed\";\n        input = { text = $text; sha256 = $hash; observed = at($eventInput, \"observed\") }\n      } → segments\n    when not(at($eventInput, \"observed\")):\n      let reason = \"SP-UNBOUND: JavaScript token observations are unavailable; exact text retained.\"\n  let clip = at($eventInput, \"clip\")\n  when not($clip):\n    let clip = { start = 0; end = count($text) }\n  port kernel.invoke { query = \"sp.clip\"; input = { text = $text; clip = $clip; segments = $segments } } → clipped\n  port kernel.invoke {\n    query = \"sp.render\";\n    input = {\n      segments = at($clipped, \"segments\");\n      theme = $theme;\n      lineNumbers = at($eventInput, \"lineNumbers\");\n      selectedLine = at($eventInput, \"selectedLine\");\n      firstLine = at($clipped, \"firstLine\")\n    }\n  } → tree\n  let result = {\n    protocol = \"encounter/source-presentation/1\";\n    ok = true;\n    sourceHash = $hash;\n    units = \"utf16\";\n    language = $language;\n    assurance = \"lexical-presentation-only\";\n    diagnostic = $reason;\n    text = at($clipped, \"text\");\n    segments = at($clipped, \"segments\");\n    tree = $tree;\n    origin = at($eventInput, \"origin\");\n    profile = at($spPolicy, \"protocol\")\n  }\n\nprocess sp.expression:\n  let value = at($eventInput, \"value\")\n  let depth = at($eventInput, \"depth\")\n  when eq($depth, null):\n    let depth = 0\n  assert includes(range(65), add($depth, 1))\n    otherwise \"SP-DEPTH: Expression presentation exceeds its declared bound.\"\n  port value.describe { value = $value } → type\n  let indent = fold(range($depth), \"unused\", \"indent\", \"\", concat($indent, \"  \"))\n  let childIndent = concat($indent, \"  \")\n  let text = \"\"\n  when at($type, \"array\"):\n    let op = at($value, 0)\n    fold range(count($value)) as oneIndex; args starts list():\n      when not(eq($oneIndex, 1)):\n        port kernel.invoke {\n          query = \"sp.expression\";\n          input = { value = at($value, add($oneIndex, -1)); depth = add($depth, 1) }\n        } → arg\n        let args = append($args, list($arg))\n      yield $args → args\n    port text.join { values = $args; separator = \", \" } → inlineArgs\n    let text = concat($op, \"(\", $inlineArgs, \")\")\n    port text.matches { value = $text; pattern = \"[\\\\s\\\\S]{89}|\\\\n\" } → wide\n    when $wide:\n      port text.join { values = $args; separator = concat(\",\\n\", $childIndent) } → multilineArgs\n      let text = concat($op, \"(\\n\", $childIndent, $multilineArgs, \"\\n\", $indent, \")\")\n    when eq(count($value), 0):\n      let text = \"[]\"\n  when and(eq(at($type, \"type\"), \"object\"), not(at($type, \"null\")), not(at($type, \"array\"))):\n    port record.entries { value = $value } → entries\n    fold $entries as entry; fields starts list():\n      port kernel.invoke { query = \"sp.expression\"; input = { value = at($entry, 1); depth = add($depth, 1) } } → field\n      port text.matches { value = at($entry, 0); pattern = \"^[A-Za-z_][A-Za-z0-9_]*$\" } → plainKey\n      let fieldKey = at($entry, 0)\n      when not($plainKey):\n        port json.stringify { value = at($entry, 0) } → fieldKey\n      let fields = append($fields, list(concat($fieldKey, \" = \", $field)))\n      yield $fields → fields\n    port text.join { values = $fields; separator = \"; \" } → inlineFields\n    let text = concat(\"{ \", $inlineFields, \" }\")\n    port text.matches { value = $text; pattern = \"[\\\\s\\\\S]{89}|\\\\n\" } → wide\n    when $wide:\n      port text.join { values = $fields; separator = concat(\";\\n\", $childIndent) } → multilineFields\n      let text = concat(\"{\\n\", $childIndent, $multilineFields, \"\\n\", $indent, \"}\")\n  when eq(at($type, \"type\"), \"string\"):\n    port text.slice { value = $value; start = 0; end = 1 } → first\n    let text = $value\n    when not(eq($first, at($spPolicy, \"referenceSigil\"))):\n      port json.stringify { value = $value } → text\n  when or(at($type, \"null\"), includes(list(\"number\", \"boolean\"), at($type, \"type\"))):\n    port value.string { value = $value } → text\n  let result = $text\n\nprocess sp.programme:\n  let programme = at($eventInput, \"programme\")\n  let depth = at($eventInput, \"depth\")\n  assert and(isArray($programme), includes(range(65), add($depth, 1)))\n    otherwise \"SP-PROGRAMME: A bounded process array is required.\"\n  let indent = fold(range($depth), \"unused\", \"indent\", \"\", concat($indent, \"  \"))\n  fold $programme as statement; listing starts \"\":\n    port kernel.invoke {\n      query = \"sp.statement\";\n      input = { statement = $statement; indent = $indent; depth = $depth }\n    } → line\n    let listing = concat($listing, if(eq($listing, \"\"), \"\", \"\\n\"), $line)\n    yield $listing → listing\n  let result = $listing\n\nprocess sp.statement:\n  let st = at($eventInput, \"statement\")\n  let indent = at($eventInput, \"indent\")\n  let depth = at($eventInput, \"depth\")\n  port record.entries { value = $st } → fields\n  let keys = map($fields, \"field\", at($field, 0))\n  let done = false\n  let text = \"\"\n  when includes($keys, \"let\"):\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"value\"); depth = $depth } } → v\n    let text = concat($indent, \"let \", at($st, \"let\"), \" = \", $v)\n    let done = true\n  when and(not($done), includes($keys, \"assert\")):\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"assert\"); depth = $depth } } → v\n    port json.stringify { value = at($st, \"message\") } → message\n    let text = concat($indent, \"assert \", $v, \"\\n\", $indent, \"  otherwise \", $message)\n    let done = true\n  when and(not($done), includes($keys, \"port\")):\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"args\"); depth = $depth } } → v\n    let text = concat($indent, \"port \", at($st, \"port\"), \" \", $v, \" → \", at($st, \"into\"))\n    let done = true\n  when and(not($done), includes($keys, \"call\")):\n    let text = concat($indent, \"call \", at($st, \"call\"))\n    let done = true\n  when and(not($done), includes($keys, \"when\")):\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"when\"); depth = $depth } } → v\n    port kernel.invoke {\n      query = \"sp.programme\";\n      input = { programme = at($st, \"then\"); depth = add($depth, 1) }\n    } → body\n    let text = concat($indent, \"when \", $v, \":\\n\", $body)\n    let done = true\n  when and(not($done), includes($keys, \"fold\")):\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"fold\"); depth = $depth } } → v\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"initial\"); depth = $depth } } → initial\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"yield\"); depth = $depth } } → yield\n    port kernel.invoke {\n      query = \"sp.programme\";\n      input = { programme = at($st, \"steps\"); depth = add($depth, 1) }\n    } → body\n    let text = concat(\n      $indent,\n      \"fold \",\n      $v,\n      \" as \",\n      at($st, \"as\"),\n      \"; \",\n      at($st, \"accumulator\"),\n      \" starts \",\n      $initial,\n      \":\\n\",\n      if(eq($body, \"\"), \"\", concat($body, \"\\n\")),\n      $indent,\n      \"  yield \",\n      $yield,\n      \" → \",\n      at($st, \"into\")\n    )\n    let done = true\n  when and(not($done), includes($keys, \"each\")):\n    port kernel.invoke { query = \"sp.expression\"; input = { value = at($st, \"each\"); depth = $depth } } → v\n    port kernel.invoke {\n      query = \"sp.programme\";\n      input = { programme = at($st, \"steps\"); depth = add($depth, 1) }\n    } → body\n    let text = concat($indent, \"each \", $v, \" as \", at($st, \"as\"), \":\\n\", $body)\n    let done = true\n  when and(not($done), includes($keys, \"try\")):\n    port kernel.invoke {\n      query = \"sp.programme\";\n      input = { programme = at($st, \"try\"); depth = add($depth, 1) }\n    } → tryBody\n    port kernel.invoke {\n      query = \"sp.programme\";\n      input = { programme = at($st, \"catch\"); depth = add($depth, 1) }\n    } → catchBody\n    let text = concat(\n      $indent,\n      \"try:\\n\",\n      $tryBody,\n      \"\\n\",\n      $indent,\n      \"catch \",\n      at($st, \"error\"),\n      \":\\n\",\n      $catchBody\n    )\n    let done = true\n  when not($done):\n    port kernel.invoke { query = \"sp.expression\"; input = { value = $st; depth = $depth } } → v\n    let text = concat($indent, $v)\n  let result = $text\n\nprocess sp.listing:\n  port kernel.invoke {\n    query = \"sp.programme\";\n    input = { programme = at($eventInput, \"programme\"); depth = 0 }\n  } → text\n  let result = {\n    text = $text;\n    scope = \"generated-process-definition\";\n    origin = at($eventInput, \"origin\");\n    limitations = list(\n      \"Generated notation, not original source characters.\",\n      \"No branch is marked executed; no change authority is created.\"\n    )\n  }\n\nprocess sp.style:\n  call sp.stylePlan\n  let cssPlan = $result\n  call css.renderPlan\n\nprocess sp.outline:\n  fold at($eventInput, \"nodes\") as node; text starts \"\":\n    yield concat(\n    $text,\n    if(eq($text, \"\"), \"\", \"\\n\\n\"),\n    at($node, \"order\"),\n    \". \",\n    at($node, \"kind\"),\n    \" · \",\n    at($node, \"label\"),\n    \"\\n\",\n    at($node, \"pointer\"),\n    \"\\n\",\n    at($node, \"detail\")\n  ) → text\n  let result = {\n    text = $text;\n    language = \"process\";\n    scope = \"generated-process-outline\";\n    origin = at($eventInput, \"origin\")\n  }\n\nprocess sp.metadata:\n  port kernel.invoke { query = \"s01.portable\"; input = { value = $eventInput; ancestors = list() } } → portable\n  assert $portable\n    otherwise \"SP-INPUT: Metadata requires finite own-data.\"\n  let subject = at($eventInput, \"subject\")\n  port value.describe { value = at($eventInput, \"record\") } → recordType\n  assert and(at($recordType, \"plain\"), not(at($recordType, \"array\")))\n    otherwise \"SP-METADATA: A typed record is required.\"\n  port value.describe { value = $subject } → subjectType\n  assert and(eq(at($subjectType, \"type\"), \"string\"), not(eq($subject, \"\")))\n    otherwise \"SP-METADATA: An explicit subject identity is required.\"\n  port record.entries { value = at($eventInput, \"record\") } → entries\n  fold $entries as entry; facts starts list():\n    when not(eq(at($entry, 0), \"text\")):\n      let values = if(isArray(at($entry, 1)), at($entry, 1), list(at($entry, 1)))\n      fold $values as value; facts starts $facts:\n        let facts = append($facts, list({ s = $subject; p = at($entry, 0); o = $value; pol = \"is\" }))\n        yield $facts → facts\n    yield $facts → facts\n  let sourceFacts = $facts\n  let format = \"rel\"\n  call source.encode\n  let text = $result\n  port digest.sha256 { text = $text } → hash\n  port kernel.invoke {\n    query = \"sp.present\";\n    input = {\n      text = $text;\n      file = \"generated-typed-projection.rel\";\n      language = \"rel\";\n      expectedHash = $hash;\n      theme = at($eventInput, \"theme\");\n      lineNumbers = false;\n      selectedLine = null;\n      origin = at($eventInput, \"origin\")\n    }\n  } → presentation\n  let result = { scope = \"generated-typed-projection\"; facts = $facts; presentation = $presentation }\n\nprocess sp.stylePlan:\n  let tokens = list()\n  let rules = at($spPolicy, \"layoutRules\")\n  fold at($spPolicy, \"themes\") as theme; palette starts { tokens = $tokens; rules = $rules }:\n    port record.entries { value = at($theme, \"roles\") } → roles\n    let tokens = at($palette, \"tokens\")\n    let rules = at($palette, \"rules\")\n    fold $roles as role; themeState starts { tokens = $tokens; rules = $rules }:\n      let name = concat(\"sp-\", at($theme, \"id\"), \"-\", at($role, 0))\n      let tokens = append(\n        at($themeState, \"tokens\"),\n        list({ id = $name; name = $name; value = at($role, 1) })\n      )\n      let rules = append(\n        at($themeState, \"rules\"),\n        list(\n          {\n            selector = concat(\".sp-code[data-theme=\\\"\", at($theme, \"id\"), \"\\\"] .sp-\", at($role, 0));\n            context = null;\n            declarations = list({ property = \"color\"; value = concat(\"var(--\", $name, \")\") })\n          }\n        )\n      )\n      yield { tokens = $tokens; rules = $rules } → themeState\n    yield $themeState → palette\n  let cssPlan = { imports = list(); tokens = at($palette, \"tokens\"); rules = at($palette, \"rules\") }\n  let result = $cssPlan\n\nprocess source.split:\n  let text = at($eventInput, \"text\")\n  let language = at($eventInput, \"language\")\n  let jsonPattern = fold(\n    at($lexPolicy, \"jsonPatternPath\"),\n    \"pathPart\",\n    \"owner\",\n    $lexGrammar,\n    at($owner, $pathPart)\n  )\n  port text.slice { value = $jsonPattern; start = 1; end = add(count($jsonPattern), -1) } → jsonInner\n  let pattern = $jsonPattern\n  when eq($language, \"rel\"):\n    let pattern = concat(\"(\", $jsonInner, \"|[()]|//[^\\\\r\\\\n]*)\")\n  when includes(list(\"encounter\", \"temple\", \"process\"), $language):\n    let pattern = concat(\n      \"(\",\n      at($lexPolicy, \"identifierPattern\"),\n      \"|\",\n      $jsonInner,\n      \"|#[^\\\\r\\\\n]*|[()=;]|→|[^\\\\S\\\\r\\\\n]+)\"\n    )\n  when eq($language, \"markdown\"):\n    let pattern = $lexPolicy.markdownPattern\n  port text.split { value = $text; pattern = $pattern } → parts\n  let withinLimit = includes(range(add(at($lexPolicy, \"maxParts\"), 1)), add(count($parts), 1))\n  let result = { parts = $parts; withinLimit = $withinLimit }\n\nprocess source.lex:\n  let text = at($eventInput, \"text\")\n  port text.slice { value = $text; start = 0; end = at($lexPolicy, \"maxCodeUnits\") } → bounded\n  let sizeOk = eq(count($bounded), count($text))\n  let tokens = list()\n  let withinLimit = false\n  when $sizeOk:\n    port kernel.invoke {\n      query = \"source.split\";\n      input = { text = $text; language = at($eventInput, \"language\") }\n    } → split\n    let withinLimit = at($split, \"withinLimit\")\n    when $withinLimit:\n      fold at($split, \"parts\") as part; state starts { offset = 0; tokens = list() }:\n        port text.split { value = $part; pattern = \"(\\\\r\\\\n|\\\\n|\\\\r)\" } → pieces\n        fold $pieces as piece; inner starts $state:\n          let offset = at($inner, \"offset\")\n          let end = add($offset, count($piece))\n          let tokens = at($inner, \"tokens\")\n          when not(eq($piece, \"\")):\n            let tokens = append($tokens, list({ text = $piece; start = $offset; end = $end }))\n          yield { offset = $end; tokens = $tokens } → state\n        yield $state → state\n      let tokens = at($state, \"tokens\")\n  let countOk = includes(range(add(at($lexPolicy, \"maxParts\"), 1)), add(count($tokens), 1))\n  let result = {\n    tokens = $tokens;\n    withinLimit = and($sizeOk, $withinLimit, $countOk);\n    diagnostic = if(\n      and($sizeOk, $withinLimit, $countOk),\n      null,\n      \"SP-LIMIT: Exact lexical source exceeds its bound.\"\n    )\n  }\n\nprocess s01.portable:\n  port value.describe { value = at($eventInput, \"value\") } → d\n  let yes = or(\n    at($d, \"null\"),\n    eq(at($d, \"type\"), \"string\"),\n    eq(at($d, \"type\"), \"boolean\"),\n    at($d, \"finite\")\n  )\n  when and(\n    not($yes),\n    at($d, \"dataOnly\"),\n    or(at($d, \"plain\"), and(at($d, \"array\"), at($d, \"dense\"))),\n    not(\n      includes(\n        if(isArray(at($eventInput, \"ancestors\")), at($eventInput, \"ancestors\"), list()),\n        at($eventInput, \"value\")\n      )\n    )\n  ):\n    port record.entries { value = at($eventInput, \"value\") } → es\n    fold $es as e; ok starts true:\n      port kernel.invoke {\n        query = \"s01.portable\";\n        input = {\n          value = at($e, 1);\n          ancestors = append(at($eventInput, \"ancestors\"), list(at($eventInput, \"value\")))\n        }\n      } → child\n      yield and($ok, $child) → yes\n  let result = $yes\n\nprocess md.inline:\n  port text.split { value = $eventInput.text; pattern = $lexPolicy.markdownPattern } → mdTokens\n  fold $mdTokens as mdToken; mdNodes starts list():\n    let mdNode = $mdToken\n    port text.matches { value = $mdToken; pattern = \"^\\\\*\\\\*[^*]+\\\\*\\\\*$\" } → mdStrong\n    when $mdStrong:\n      port text.slice { value = $mdToken; start = 2; end = add(count($mdToken), -2) } → mdLabel\n      let mdNode = { tag = \"strong\"; attrs = {  }; children = list($mdLabel) }\n    port text.matches { value = $mdToken; pattern = \"^\\\\*[^*]+\\\\*$\" } → mdEm\n    when $mdEm:\n      port text.slice { value = $mdToken; start = 1; end = add(count($mdToken), -1) } → mdLabel\n      let mdNode = { tag = \"em\"; attrs = {  }; children = list($mdLabel) }\n    port text.matches { value = $mdToken; pattern = \"^`[^`]+`$\" } → mdCode\n    when $mdCode:\n      port text.slice { value = $mdToken; start = 1; end = add(count($mdToken), -1) } → mdLabel\n      let mdNode = { tag = \"code\"; attrs = {  }; children = list($mdLabel) }\n    port text.matches { value = $mdToken; pattern = \"^\\\\[[^\\\\]]+\\\\]\\\\([^)]+\\\\)$\" } → mdLink\n    when $mdLink:\n      port text.indexOf { value = $mdToken; search = \"](\" } → mdAt\n      port text.slice { value = $mdToken; start = 1; end = $mdAt } → mdLabel\n      port text.slice { value = $mdToken; start = add($mdAt, 2); end = add(count($mdToken), -1) } → mdTarget\n      port text.matches { value = $mdTarget; pattern = \"^https?://[^\\\\s<>]+$\" } → mdSafe\n      let mdNode = if(\n        $mdSafe,\n        {\n          tag = \"a\";\n          attrs = { href = $mdTarget; rel = \"noreferrer\" };\n          children = list($mdLabel)\n        },\n        {\n          tag = \"span\";\n          attrs = {\n            class = \"md-source-link\";\n            title = concat(\"Source-relative link; target is not bundled: \", $mdTarget)\n          };\n          children = list(\n            $mdLabel,\n            { tag = \"small\"; attrs = {  }; children = list(concat(\" [source: \", $mdTarget, \"]\")) }\n          )\n        }\n      )\n    port text.matches { value = $mdToken; pattern = \"^  \\\\r?\\\\n$\" } → mdBreak\n    when $mdBreak:\n      let mdNode = { tag = \"br\"; attrs = {  }; children = list() }\n    let mdNodes = append($mdNodes, list($mdNode))\n    yield $mdNodes → mdNodes\n  let result = $mdNodes\n\nprocess md.block:\n  let mdLines = $eventInput.lines\n  let mdKind = $eventInput.kind\n  let mdTree = null\n  port text.join { values = $mdLines; separator = \"\\n\" } → mdText\n  when eq($mdKind, \"paragraph\"):\n    port kernel.invoke { query = \"md.inline\"; input = { text = $mdText } } → mdInline\n    let mdTree = { tag = \"p\"; attrs = {  }; children = $mdInline }\n  when eq($mdKind, \"heading\"):\n    port text.split { value = $mdText; pattern = \"^(#{1,6}) +\" } → mdHeadingParts\n    port kernel.invoke { query = \"md.inline\"; input = { text = at($mdHeadingParts, 2) } } → mdInline\n    let mdTree = { tag = concat(\"h\", count(at($mdHeadingParts, 1))); attrs = {  }; children = $mdInline }\n  when eq($mdKind, \"code\"):\n    port digest.sha256 { text = $mdText } → mdHash\n    port kernel.invoke {\n      query = \"sp.present\";\n      input = {\n        text = $mdText;\n        language = if(\n          includes(list(\"json\", \"rel\", \"process\", \"encounter\", \"temple\"), $eventInput.language),\n          $eventInput.language,\n          \"text\"\n        );\n        file = \"markdown-fence\";\n        theme = \"dark\";\n        expectedHash = $mdHash;\n        lineNumbers = false;\n        selectedLine = null;\n        origin = { scope = \"Markdown fenced code projection\" }\n      }\n    } → mdCodeView\n    let mdTree = { tag = \"pre\"; attrs = { class = \"md-code\" }; children = list($mdCodeView.tree) }\n  when eq($mdKind, \"quote\"):\n    port text.replaceAll { value = $mdText; search = \"> \"; replacement = \"\" } → mdText\n    port kernel.invoke { query = \"md.inline\"; input = { text = $mdText } } → mdInline\n    let mdTree = { tag = \"blockquote\"; attrs = {  }; children = $mdInline }\n  when includes(list(\"ul\", \"ol\"), $mdKind):\n    fold $mdLines as mdLine; mdItems starts list():\n      port text.split { value = $mdLine; pattern = \"^\\\\s*(?:[-+*]|[0-9]+\\\\.) +\" } → mdListParts\n      port kernel.invoke { query = \"md.inline\"; input = { text = at($mdListParts, 1) } } → mdInline\n      let mdItems = append($mdItems, list({ tag = \"li\"; attrs = {  }; children = $mdInline }))\n      yield $mdItems → mdItems\n    let mdTree = { tag = $mdKind; attrs = {  }; children = $mdItems }\n  when eq($mdKind, \"table\"):\n    fold range(count($mdLines)) as mdI; mdRows starts list():\n      let mdLine = at($mdLines, add($mdI, -1))\n      port text.matches { value = $mdLine; pattern = \"^\\\\s*\\\\|?[: \\\\-|]+\\\\|[: \\\\-|]*$\" } → mdSeparator\n      when not($mdSeparator):\n        port text.trim { value = $mdLine } → mdLine\n        port text.slice { value = $mdLine; start = 1; end = add(count($mdLine), -1) } → mdLine\n        port text.split { value = $mdLine; pattern = \"\\\\|\" } → mdCells\n        fold $mdCells as mdCell; mdCellViews starts list():\n          port text.trim { value = $mdCell } → mdCell\n          port kernel.invoke { query = \"md.inline\"; input = { text = $mdCell } } → mdInline\n          let mdCellViews = append(\n            $mdCellViews,\n            list(\n              {\n                tag = if(eq($mdI, 1), \"th\", \"td\");\n                attrs = if(eq($mdI, 1), { scope = \"col\" }, {  });\n                children = $mdInline\n              }\n            )\n          )\n          yield $mdCellViews → mdCellViews\n        let mdRows = append($mdRows, list({ tag = \"tr\"; attrs = {  }; children = $mdCellViews }))\n      yield $mdRows → mdRows\n    let mdTree = {\n      tag = \"div\";\n      attrs = { class = \"md-table-wrap\" };\n      children = list(\n        {\n          tag = \"table\";\n          attrs = {  };\n          children = list({ tag = \"tbody\"; attrs = {  }; children = $mdRows })\n        }\n      )\n    }\n  let result = $mdTree\n\nprocess md.preview:\n  let mdInput = $eventInput.text\n  assert includes(range(160001), add(count($mdInput), 1))\n    otherwise \"MD-BOUND: Document exceeds the shared source bound.\"\n  port text.split { value = $mdInput; pattern = \"\\\\r?\\\\n\" } → mdLines\n  assert includes(range(2001), add(count($mdLines), 1))\n    otherwise \"MD-LINES: Preview exceeds 2000 lines.\"\n  fold append($mdLines, list(\"\")) as mdLine; mdState starts { nodes = list(); lines = list(); kind = \"\"; fence = \"\"; language = \"\" }:\n    let mdNodes = $mdState.nodes\n    let mdPending = $mdState.lines\n    let mdKind = $mdState.kind\n    let mdFence = $mdState.fence\n    let mdWasFence = not(eq($mdFence, \"\"))\n    let mdLanguage = $mdState.language\n    let mdNext = \"paragraph\"\n    let mdSkip = false\n    port text.matches { value = $mdLine; pattern = \"^\\\\s*$\" } → mdBlank\n    when $mdBlank:\n      let mdNext = \"\"\n    when true:\n      port text.matches { value = $mdLine; pattern = \"^#{1,6} +\" } → mdMatch\n      when $mdMatch:\n        let mdNext = \"heading\"\n    when true:\n      port text.matches { value = $mdLine; pattern = \"^\\\\s*\\\\|.*\\\\|\\\\s*$\" } → mdMatch\n      when $mdMatch:\n        let mdNext = \"table\"\n    when true:\n      port text.matches { value = $mdLine; pattern = \"^\\\\s*[-+*] +\" } → mdMatch\n      when $mdMatch:\n        let mdNext = \"ul\"\n    when true:\n      port text.matches { value = $mdLine; pattern = \"^\\\\s*[0-9]+\\\\. +\" } → mdMatch\n      when $mdMatch:\n        let mdNext = \"ol\"\n    when true:\n      port text.matches { value = $mdLine; pattern = \"^> ?\" } → mdMatch\n      when $mdMatch:\n        let mdNext = \"quote\"\n    port text.matches { value = $mdLine; pattern = \"^(?:```|~~~)\" } → mdMarker\n    when not(eq($mdFence, \"\")):\n      let mdNext = \"code\"\n      port text.slice { value = $mdLine; start = 0; end = 3 } → mdPrefix\n      when eq($mdPrefix, $mdFence):\n        let mdNext = \"\"\n        let mdFence = \"\"\n        let mdSkip = true\n    when and($mdMarker, not($mdWasFence)):\n      port text.slice { value = $mdLine; start = 0; end = 3 } → mdFence\n      port text.slice { value = $mdLine; start = 3; end = count($mdLine) } → mdLanguage\n      port text.trim { value = $mdLanguage } → mdLanguage\n      let mdNext = \"code\"\n      let mdSkip = true\n    when and(not(eq($mdNext, $mdKind)), not(eq($mdKind, \"\"))):\n      port kernel.invoke {\n        query = \"md.block\";\n        input = { lines = $mdPending; kind = $mdKind; language = $mdLanguage }\n      } → mdBlock\n      let mdNodes = append($mdNodes, list($mdBlock))\n      let mdPending = list()\n    when and(not(eq($mdNext, \"\")), not($mdSkip)):\n      let mdPending = append($mdPending, list($mdLine))\n    when eq($mdNext, \"heading\"):\n      port kernel.invoke { query = \"md.block\"; input = { lines = $mdPending; kind = \"heading\" } } → mdBlock\n      let mdNodes = append($mdNodes, list($mdBlock))\n      let mdPending = list()\n      let mdNext = \"\"\n    yield {\n    nodes = $mdNodes;\n    lines = $mdPending;\n    kind = $mdNext;\n    fence = $mdFence;\n    language = $mdLanguage\n  } → mdState\n  when not(eq($mdState.kind, \"\")):\n    port kernel.invoke {\n      query = \"md.block\";\n      input = { lines = $mdState.lines; kind = $mdState.kind; language = $mdState.language }\n    } → mdBlock\n    let mdState = { nodes = append($mdState.nodes, list($mdBlock)) }\n  let result = { tag = \"article\"; attrs = { class = \"markdown-preview\" }; children = $mdState.nodes }\n\nprocess sp.structure:\n  let structureDepth = $eventInput.depth\n  assert includes(range(65), add($structureDepth, 1))\n    otherwise \"SP-STRUCTURE: Programme nesting exceeds its declared bound.\"\n  fold range(count($eventInput.programme)) as structureI; structureRows starts list():\n    let structureStatement = at($eventInput.programme, add($structureI, -1))\n    port record.entries { value = $structureStatement } → structureFields\n    let structureKeys = map($structureFields, \"structureField\", at($structureField, 0))\n    let structureForms = filter(\n      list(\"let\", \"assert\", \"port\", \"call\", \"when\", \"fold\", \"each\", \"try\"),\n      \"structureForm\",\n      includes($structureKeys, $structureForm)\n    )\n    assert eq(count($structureForms), 1)\n      otherwise \"SP-STRUCTURE: Exactly one supported statement form is required.\"\n    let structurePointer = concat($eventInput.pointer, \"/\", add($structureI, -1))\n    let structureRows = append(\n      $structureRows,\n      list({ form = at($structureForms, 0); pointer = $structurePointer })\n    )\n    fold list(\"then\", \"steps\", \"try\", \"catch\") as structureChild; structureChildren starts $structureRows:\n      when includes($structureKeys, $structureChild):\n        port kernel.invoke {\n          query = \"sp.structure\";\n          input = {\n            programme = at($structureStatement, $structureChild);\n            pointer = concat($structurePointer, \"/\", $structureChild);\n            depth = add($structureDepth, 1)\n          }\n        } → structureNested\n        let structureChildren = append($structureChildren, $structureNested)\n      yield $structureChildren → structureRows\n    yield $structureRows → structureRows\n  let result = $structureRows\n\nprocess sp.moduleView:\n  let moduleValue = $eventInput.module\n  assert eq($moduleValue.protocol, \"temple/surface-process-module/1\")\n    otherwise \"SP-MODULE: A surface-process module is required.\"\n  port record.entries { value = $moduleValue.queries } → moduleEntries\n  let moduleMatches = filter($moduleEntries, \"moduleEntry\", eq(at($moduleEntry, 0), $eventInput.name))\n  assert eq(count($moduleMatches), 1)\n    otherwise \"SP-MODULE: The selected query does not exist.\"\n  let moduleName = $eventInput.name\n  let moduleProgramme = at(at($moduleMatches, 0), 1)\n  let modulePointer = concat(\"/queries/\", $moduleName)\n  port kernel.invoke { query = \"sp.programme\"; input = { programme = $moduleProgramme; depth = 1 } } → moduleText\n  port kernel.invoke {\n    query = \"sp.structure\";\n    input = { programme = $moduleProgramme; pointer = $modulePointer; depth = 0 }\n  } → moduleStatements\n  let result = {\n    name = $moduleName;\n    text = concat(\"process \", $moduleName, \":\\n\", $moduleText);\n    pointer = $modulePointer;\n    statements = $moduleStatements;\n    forms = distinct(map($moduleStatements, \"moduleStatement\", $moduleStatement.form));\n    scope = \"generated-readable-projection; JSON remains authoritative\"\n  }\n\n")
