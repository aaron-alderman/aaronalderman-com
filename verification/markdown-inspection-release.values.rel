mdLine\",\n                  \"pattern\": \"^\\\\s*[-+*] +\"\n                },\n                \"into\": \"mdMatch\"\n              },\n              {\n                \"when\": \"$mdMatch\",\n                \"then\": [\n                  {\n                    \"let\": \"mdNext\",\n                    \"value\": \"ul\"\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"when\": true,\n            \"then\": [\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$mdLine\",\n                  \"pattern\": \"^\\\\s*[0-9]+\\\\. +\"\n                },\n                \"into\": \"mdMatch\"\n              },\n              {\n                \"when\": \"$mdMatch\",\n                \"then\": [\n                  {\n                    \"let\": \"mdNext\",\n                    \"value\": \"ol\"\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"when\": true,\n            \"then\": [\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$mdLine\",\n                  \"pattern\": \"^> ?\"\n                },\n                \"into\": \"mdMatch\"\n              },\n              {\n                \"when\": \"$mdMatch\",\n                \"then\": [\n                  {\n                    \"let\": \"mdNext\",\n                    \"value\": \"quote\"\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"port\": \"text.matches\",\n            \"args\": {\n              \"value\": \"$mdLine\",\n              \"pattern\": \"^(?:```|~~~)\"\n            },\n            \"into\": \"mdMarker\"\n          },\n          {\n            \"when\": [\n              \"not\",\n              [\n                \"eq\",\n                \"$mdFence\",\n                \"\"\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"mdNext\",\n                \"value\": \"code\"\n              },\n              {\n                \"port\": \"text.slice\",\n                \"args\": {\n                  \"value\": \"$mdLine\",\n                  \"start\": 0,\n                  \"end\": 3\n                },\n                \"into\": \"mdPrefix\"\n              },\n              {\n                \"when\": [\n                  \"eq\",\n                  \"$mdPrefix\",\n                  \"$mdFence\"\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"mdNext\",\n                    \"value\": \"\"\n                  },\n                  {\n                    \"let\": \"mdFence\",\n                    \"value\": \"\"\n                  },\n                  {\n                    \"let\": \"mdSkip\",\n                    \"value\": true\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"when\": [\n              \"and\",\n              \"$mdMarker\",\n              [\n                \"not\",\n                \"$mdWasFence\"\n              ]\n            ],\n            \"then\": [\n              {\n                \"port\": \"text.slice\",\n                \"args\": {\n                  \"value\": \"$mdLine\",\n                  \"start\": 0,\n                  \"end\": 3\n                },\n                \"into\": \"mdFence\"\n              },\n              {\n                \"port\": \"text.slice\",\n                \"args\": {\n                  \"value\": \"$mdLine\",\n                  \"start\": 3,\n                  \"end\": [\n                    \"count\",\n                    \"$mdLine\"\n                  ]\n                },\n                \"into\": \"mdLanguage\"\n              },\n              {\n                \"port\": \"text.trim\",\n                \"args\": {\n                  \"value\": \"$mdLanguage\"\n                },\n                \"into\": \"mdLanguage\"\n              },\n              {\n                \"let\": \"mdNext\",\n                \"value\": \"code\"\n              },\n              {\n                \"let\": \"mdSkip\",\n                \"value\": true\n              }\n            ]\n          },\n          {\n            \"when\": [\n              \"and\",\n              [\n                \"not\",\n                [\n                  \"eq\",\n                  \"$mdNext\",\n                  \"$mdKind\"\n                ]\n              ],\n              [\n                \"not\",\n                [\n                  \"eq\",\n                  \"$mdKind\",\n                  \"\"\n                ]\n              ]\n            ],\n            \"then\": [\n              {\n                \"port\": \"kernel.invoke\",\n                \"args\": {\n                  \"query\": \"md.block\",\n                  \"input\": {\n                    \"lines\": \"$mdPending\",\n                    \"kind\": \"$mdKind\",\n                    \"language\": \"$mdLanguage\"\n                  }\n                },\n                \"into\": \"mdBlock\"\n              },\n              {\n                \"let\": \"mdNodes\",\n                \"value\": [\n                  \"append\",\n                  \"$mdNodes\",\n                  [\n                    \"list\",\n                    \"$mdBlock\"\n                  ]\n                ]\n              },\n              {\n                \"let\": \"mdPending\",\n                \"value\": [\n                  \"list\"\n                ]\n              }\n            ]\n          },\n          {\n            \"when\": [\n              \"and\",\n              [\n                \"not\",\n                [\n                  \"eq\",\n                  \"$mdNext\",\n                  \"\"\n                ]\n              ],\n              [\n                \"not\",\n                \"$mdSkip\"\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"mdPending\",\n                \"value\": [\n                  \"append\",\n                  \"$mdPending\",\n                  [\n                    \"list\",\n                    \"$mdLine\"\n                  ]\n                ]\n              }\n            ]\n          },\n          {\n            \"when\": [\n              \"eq\",\n              \"$mdNext\",\n              \"heading\"\n            ],\n            \"then\": [\n              {\n                \"port\": \"kernel.invoke\",\n                \"args\": {\n                  \"query\": \"md.block\",\n                  \"input\": {\n                    \"lines\": \"$mdPending\",\n                    \"kind\": \"heading\"\n                  }\n                },\n                \"into\": \"mdBlock\"\n              },\n              {\n                \"let\": \"mdNodes\",\n                \"value\": [\n                  \"append\",\n                  \"$mdNodes\",\n                  [\n                    \"list\",\n                    \"$mdBlock\"\n                  ]\n                ]\n              },\n              {\n                \"let\": \"mdPending\",\n                \"value\": [\n                  \"list\"\n                ]\n              },\n              {\n                \"let\": \"mdNext\",\n                \"value\": \"\"\n              }\n            ]\n          }\n        ],\n        \"yield\": {\n          \"nodes\": \"$mdNodes\",\n          \"lines\": \"$mdPending\",\n          \"kind\": \"$mdNext\",\n          \"fence\": \"$mdFence\",\n          \"language\": \"$mdLanguage\"\n        },\n        \"into\": \"mdState\"\n      },\n      {\n        \"when\": [\n          \"not\",\n          [\n            \"eq\",\n            \"$mdState.kind\",\n            \"\"\n          ]\n        ],\n        \"then\": [\n          {\n            \"port\": \"kernel.invoke\",\n            \"args\": {\n              \"query\": \"md.block\",\n              \"input\": {\n                \"lines\": \"$mdState.lines\",\n                \"kind\": \"$mdState.kind\",\n                \"language\": \"$mdState.language\"\n              }\n            },\n            \"into\": \"mdBlock\"\n          },\n          {\n            \"let\": \"mdState\",\n            \"value\": {\n              \"nodes\": [\n                \"append\",\n                \"$mdState.nodes\",\n                [\n                  \"list\",\n                  \"$mdBlock\"\n                ]\n              ]\n            }\n          }\n        ]\n      },\n      {\n        \"let\": \"result\",\n        \"value\": {\n          \"tag\": \"article\",\n          \"attrs\": {\n            \"class\": \"markdown-preview\"\n          },\n          \"children\": \"$mdState.nodes\"\n        }\n      }\n    ]\n  }\n}\n")
