               ]\n                ],\n                \"span\"\n              ]\n            },\n            {\n              \"port\": \"text.slice\",\n              \"args\": {\n                \"value\": \"$sourceDocument.text\",\n                \"start\": 0,\n                \"end\": \"$sourceInsertion.endOffset\"\n              },\n              \"into\": \"sourcePrefix\"\n            },\n            {\n              \"port\": \"text.slice\",\n              \"args\": {\n                \"value\": \"$sourceDocument.text\",\n                \"start\": \"$sourceInsertion.endOffset\",\n                \"end\": [\n                  \"count\",\n                  \"$sourceDocument.text\"\n                ]\n              },\n              \"into\": \"sourceSuffix\"\n            },\n            {\n              \"let\": \"result\",\n              \"value\": [\n                \"concat\",\n                \"$sourcePrefix\",\n                \"\\n\",\n                \"$sourceReplacement\",\n                \"$sourceSuffix\"\n              ]\n            }\n          ]\n        }\n      ],\n      \"source.jsonSpan\": [\n        {\n          \"port\": \"json.parse\",\n          \"args\": {\n            \"text\": \"$jsonSourceText\"\n          },\n          \"into\": \"jsonSpanValue\"\n        },\n        {\n          \"fold\": \"$jsonSourcePath\",\n          \"as\": \"jsonPointerPart\",\n          \"accumulator\": \"jsonPointer\",\n          \"initial\": {\n            \"node\": \"$jsonSpanValue\",\n            \"path\": [\n              \"list\"\n            ]\n          },\n          \"steps\": [\n            {\n              \"port\": \"value.describe\",\n              \"args\": {\n                \"value\": \"$jsonPointer.node\"\n              },\n              \"into\": \"jsonPointerType\"\n            },\n            {\n              \"port\": \"value.string\",\n              \"args\": {\n                \"value\": \"$jsonPointerPart\"\n              },\n              \"into\": \"jsonCanonicalPart\"\n            },\n            {\n              \"when\": \"$jsonPointerType.array\",\n              \"then\": [\n                {\n                  \"port\": \"json.parse\",\n                  \"args\": {\n                    \"text\": \"$jsonCanonicalPart\"\n                  },\n                  \"into\": \"jsonCanonicalPart\"\n                }\n              ]\n            }\n          ],\n          \"yield\": {\n            \"node\": [\n              \"at\",\n              \"$jsonPointer.node\",\n              \"$jsonPointerPart\"\n            ],\n            \"path\": [\n              \"append\",\n              \"$jsonPointer.path\",\n              [\n                \"list\",\n                \"$jsonCanonicalPart\"\n              ]\n            ]\n          },\n          \"into\": \"jsonPointer\"\n        },\n        {\n          \"let\": \"jsonSourcePath\",\n          \"value\": \"$jsonPointer.path\"\n        },\n        {\n          \"let\": \"jsonPointValue\",\n          \"value\": [\n            \"fold\",\n            \"$jsonSourcePath\",\n            \"jsonPointKey\",\n            \"jsonPointNode\",\n            \"$jsonSpanValue\",\n            [\n              \"at\",\n              \"$jsonPointNode\",\n              \"$jsonPointKey\"\n            ]\n          ]\n        },\n        {\n          \"port\": \"value.describe\",\n          \"args\": {\n            \"value\": \"$jsonPointValue\"\n          },\n          \"into\": \"jsonPointType\"\n        },\n        {\n          \"assert\": [\n            \"not\",\n            [\n              \"eq\",\n              \"$jsonPointType.type\",\n              \"undefined\"\n            ]\n          ],\n          \"message\": \"The source path is absent from the visible JSON.\"\n        },\n        {\n          \"port\": \"text.split\",\n          \"args\": {\n            \"value\": \"$jsonSourceText\",\n            \"pattern\": \"(\\\"(?:[^\\\"\\\\\\\\]|\\\\\\\\.)*\\\"|[\\\\[\\\\]{}:,]|-?(?:0|[1-9][0-9]*)(?:\\\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|true|false|null)\"\n          },\n          \"into\": \"jsonSpanParts\"\n        },\n        {\n          \"fold\": \"$jsonSpanParts\",\n          \"as\": \"jsonToken\",\n          \"accumulator\": \"jsonScan\",\n          \"initial\": {\n            \"offset\": 0,\n            \"stack\": [\n              \"list\"\n            ],\n            \"span\": null,\n            \"done\": false\n          },\n          \"steps\": [\n            {\n              \"let\": \"jsonSpanStack\",\n              \"value\": \"$jsonScan.stack\"\n            },\n            {\n              \"let\": \"jsonSpanFound\",\n              \"value\": \"$jsonScan.span\"\n            },\n            {\n              \"let\": \"jsonSpanDone\",\n              \"value\": \"$jsonScan.done\"\n            },\n            {\n              \"port\": \"text.matches\",\n              \"args\": {\n                \"value\": \"$jsonToken\",\n                \"pattern\": \"^\\\\s*$\"\n              },\n              \"into\": \"jsonSpanWhite\"\n            },\n            {\n              \"when\": [\n                \"and\",\n                [\n                  \"not\",\n                  \"$jsonSpanWhite\"\n                ],\n                [\n                  \"not\",\n                  \"$jsonSpanDone\"\n                ]\n              ],\n              \"then\": [\n                {\n                  \"let\": \"jsonFrame\",\n                  \"value\": [\n                    \"at\",\n                    \"$jsonSpanStack\",\n                    [\n                      \"add\",\n                      [\n                        \"count\",\n                        \"$jsonSpanStack\"\n                      ],\n                      -1\n                    ]\n                  ]\n                },\n                {\n                  \"let\": \"jsonIsClose\",\n                  \"value\": [\n                    \"includes\",\n                    [\n                      \"list\",\n                      \"}\",\n                      \"]\"\n                    ],\n                    \"$jsonToken\"\n                  ]\n                },\n                {\n                  \"let\": \"jsonIsOpen\",\n                  \"value\": [\n                    \"includes\",\n                    [\n                      \"list\",\n                      \"{\",\n                      \"[\"\n                    ],\n                    \"$jsonToken\"\n                  ]\n                },\n                {\n                  \"when\": \"$jsonIsClose\",\n                  \"then\": [\n                    {\n                      \"when\": [\n                        \"at\",\n                        \"$jsonFrame\",\n                        \"match\"\n                      ],\n                      \"then\": [\n                        {\n                          \"let\": \"jsonSpanFound\",\n                          \"value\": {\n                            \"offset\": \"$jsonSpanFound.offset\",\n                            \"endOffset\": [\n                              \"add\",\n                              \"$jsonScan.offset\",\n                              [\n                                \"count\",\n                                \"$jsonToken\"\n                              ]\n                            ]\n                          }\n                        },\n                        {\n                          \"let\": \"jsonSpanDone\",\n                          \"value\": false\n                        }\n                      ]\n                    },\n                    {\n                      \"let\": \"jsonSpanStack\",\n                      \"value\": [\n                        \"map\",\n                        [\n                          \"range\",\n                          [\n                            \"add\",\n                            [\n                              \"count\",\n                              \"$jsonSpanStack\"\n                            ],\n                            -1\n                          ]\n                        ],\n                        \"jsonDepth\",\n                        [\n                          \"at\",\n                          \"$jsonSpanStack\",\n                          [\n                            \"add\",\n                            \"$jsonDepth\",\n                            -1\n                          ]\n                        ]\n                      ]\n                    }\n                  ]\n                },\n                {\n                  \"when\": [\n                    \"eq\",\n                    \"$jsonToken\",\n                    \",\"\n                  ],\n                  \"then\": [\n                    {\n                      \"port\": \"record.put\",\n                      \"args\": {\n                        \"record\": \"$jsonFrame\",\n                        \"key\": \"phase\",\n                        \"value\": [\n                          \"if\",\n                          [\n                            \"eq\",\n                            \"$jsonFrame.type\",\n                            \"object\"\n                          ],\n                          \"key\",\n                          \"value\"\n                        ]\n                      },\n                      \"into\": \"jsonFrame\"\n                    },\n                    {\n                      \"port\": \"record.put\",\n                      \"args\": {\n                        \"record\": \"$jsonFrame\",\n                        \"key\": \"index\",\n                        \"value\": [\n                          \"add\",\n                          \"$jsonFrame.index\",\n                          1\n                        ]\n                      },\n                      \"into\": \"jsonFrame\"\n                    }\n                  ]\n                },\n                {\n                  \"when\": [\n                    \"eq\",\n                    \"$jsonToken\",\n                    \":\"\n                  ],\n                  \"then\": [\n                    {\n                      \"port\": \"record.put\",\n                      \"args\": {\n                        \"record\": \"$jsonFrame\",\n                        \"key\": \"phase\",\n                        \"value\": \"value\"\n                      },\n                      \"into\": \"jsonFrame\"\n                    }\n                  ]\n                },\n                {\n                  \"when\": [\n                    \"and\",\n                    [\n                      \"not\",\n                      \"$jsonIsClose\"\n                    ],\n                    [\n                      \"not\",\n                      [\n                        \"includes\",\n                        [\n                          \"list\",\n                          \",\",\n                          \":\"\n                        ],\n                        \"$jsonToken\"\n                      ]\n                    ]\n                  ],\n                  \"then\": [\n                    {\n                      \"let\": \"jsonIsKey\",\n                      \"value\": [\n                        \"and\",\n                        \"$jsonFrame\",\n                        [\n                          \"and\",\n                          [\n                            \"eq\",\n                            \"$jsonFrame.type\",\n                            \"object\"\n                          ],\n                          [\n                            \"eq\",\n                            \"$jsonFrame.phase\",\n                            \"key\"\n                          ]\n                        ]\n                      ]\n                    },\n                    {\n                      \"when\": \"$jsonIsKey\",\n                      \"then\": [\n                        {\n                          \"port\": \"json.parse\",\n                          \"args\": {\n                            \"text\": \"$jsonToken\"\n                          },\n                          \"into\": \"jsonFrameKey\"\n                        },\n                        {\n                          \"port\": \"record.put\",\n                          \"args\": {\n                            \"record\": \"$jsonFrame\",\n                            \"key\": \"key\",\n                            \"value\": \"$jsonFrameKey\"\n                          },\n                          \"into\": \"jsonFrame\"\n                        },\n                        {\n                          \"port\": \"record.put\",\n                          \"args\": {\n                            \"record\": \"$jsonFrame\",\n                            \"key\": \"phase\",\n                            \"value\": \"colon\"\n                          },\n                          \"into\": \"jsonFrame\"\n                        }\n                      ]\n                    },\n                    {\n                      \"when\": [\n                        \"not\",\n                        \"$jsonIsKey\"\n                      ],\n                      \"then\": [\n                        {\n                          \"let\": \"jsonValuePath\",\n                          \"value\": [\n                            \"if\",\n                            \"$jsonFrame\",\n                            [\n                              \"append\",\n                              \"$jsonFrame.path\",\n                              [\n                                \"list\",\n                                [\n                                  \"if\",\n                                  [\n                                    \"eq\",\n                                    \"$jsonFrame.type\",\n                                    \"array\"\n                                  ],\n                                  \"$jsonFrame.index\",\n                                  \"$jsonFrame.key\"\n                                ]\n                              ]\n                            ],\n                            [\n                              \"list\"\n                            ]\n                          ]\n                        },\n                        {\n                          \"let\": \"jsonPathMatches\",\n                          \"value\": [\n                            \"eq\",\n                            \"$jsonValuePath\",\n                            \"$jsonSourcePath\"\n                          ]\n                        },\n                        {\n                          \"when\": \"$jsonPathMatches\",\n                          \"then\": [\n                            {\n                              \"let\": \"jsonSpanFound\",\n                              \"value\": {\n                                \"offset\": \"$jsonScan.offset\",\n                                \"endOffset\": [\n                                  \"add\",\n                                  \"$jsonScan.offset\",\n                                  [\n                                    \"count\",\n                                    \"$jsonToken\"\n                                  ]\n                                ]\n                              }\n                            },\n                            {\n                              \"when\": [\n                                \"not\",\n                                \"$jsonIsOpen\"\n                              ],\n                              \"then\": [\n                                {\n                                  \"let\": \"jsonSpanDone\",\n                                  \"value\": false\n                                }\n                              ]\n                            }\n                          ]\n                        },\n                        {\n                          \"when\": \"$jsonIsOpen\",\n                          \"then\": [\n                            {\n                              \"let\": \"jsonNewFrame\",\n                              \"value\": {\n                                \"type\": [\n                                  \"if\",\n                                  [\n                                    \"eq\",\n                                    \"$jsonToken\",\n                                    \"{\"\n                                  ],\n                                  \"object\",\n                                  \"array\"\n                                ],\n                                \"path\": \"$jsonValuePath\",\n                                \"key\": null,\n                                \"index\": 0,\n                                \"phase\": [\n                                  \"if\",\n                                  [\n                                    \"eq\",\n                                    \"$jsonToken\",\n                                    \"{\"\n                                  ],\n                                  \"key\",\n                                  \"value\"\n                                ],\n                                \"match\": \"$jsonPathMatches\"\n                              }\n                            }\n                          ]\n                        }\n                      ]\n                    }\n                  ]\n                },\n                {\n                  \"when\": [\n                    \"and\",\n                    \"$jsonFrame\",\n                    [\n                      \"not\",\n                      \"$jsonIsClose\"\n                    ]\n                  ],\n                  \"then\": [\n                    {\n                      \"let\": \"jsonSpanStack\",\n                      \"value\": [\n                        \"map\",\n                        [\n                          \"range\",\n                          [\n                            \"count\",\n                            \"$jsonSpanStack\"\n                          ]\n                        ],\n                        \"jsonDepth\",\n                        [\n                          \"if\",\n                          [\n                            \"eq\",\n                            \"$jsonDepth\",\n                            [\n                              \"count\",\n                              \"$jsonSpanStack\"\n                            ]\n                          ],\n                          \"$jsonFrame\",\n                          [\n                            \"at\",\n                            \"$jsonSpanStack\",\n                            [\n                              \"add\",\n                              \"$jsonDepth\",\n                              -1\n                            ]\n                          ]\n                        ]\n                      ]\n                    }\n                  ]\n                },\n                {\n                  \"when\": \"$jsonIsOpen\",\n                  \"then\": [\n                    {\n                      \"let\": \"jsonSpanStack\",\n                      \"value\": [\n                        \"append\",\n                        \"$jsonSpanStack\",\n                        [\n                          \"list\",\n                          \"$jsonNewFrame\"\n                        ]\n                      ]\n                    }\n                  ]\n                }\n              ]\n            }\n          ],\n          \"yield\": {\n            \"offset\": [\n              \"add\",\n              \"$jsonScan.offset\",\n              [\n                \"count\",\n                \"$jsonToken\"\n              ]\n            ],\n            \"stack\": \"$jsonSpanStack\",\n            \"span\": \"$jsonSpanFound\",\n            \"done\": \"$jsonSpanDone\"\n    