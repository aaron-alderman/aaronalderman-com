("v34", "scalar", "{\n  \"protocol\": \"temple/surface-process-module/1\",\n  \"queries\": {\n    \"hierarchy.load\": [\n      {\n        \"port\": \"file.copy\",\n        \"args\": {\n          \"path\": \"source/hierarchy.values.rel\"\n        },\n        \"into\": \"_\"\n      },\n      {\n        \"port\": \"file.read\",\n        \"args\": {\n          \"path\": \"source/hierarchy.values.rel\"\n        },\n        \"into\": \"hText\"\n      },\n      {\n        \"port\": \"json.parse\",\n        \"args\": {\n          \"text\": \"$hText\"\n        },\n        \"into\": \"hCatalogue\"\n      },\n      {\n        \"port\": \"file.copy\",\n        \"args\": {\n          \"path\": \"source/hierarchy-evidence.values.rel\"\n        },\n        \"into\": \"_\"\n      },\n      {\n        \"port\": \"file.read\",\n        \"args\": {\n          \"path\": \"source/hierarchy-evidence.values.rel\"\n        },\n        \"into\": \"hText\"\n      },\n      {\n        \"port\": \"json.parse\",\n        \"args\": {\n          \"text\": \"$hText\"\n        },\n        \"into\": \"hEvidence\"\n      }\n    ],\n    \"hierarchy.parse\": [\n      {\n        \"port\": \"text.split\",\n        \"args\": {\n          \"value\": \"$eventInput.text\",\n          \"pattern\": \"\\\\r?\\\\n\"\n        },\n        \"into\": \"hExactLines\"\n      },\n      {\n        \"let\": \"text\",\n        \"value\": \"$eventInput.text\"\n      },\n      {\n        \"let\": \"file\",\n        \"value\": \"$eventInput.binding.file\"\n      },\n      {\n        \"call\": \"source.rel\"\n      },\n      {\n        \"let\": \"hParsed\",\n        \"value\": \"$result\"\n      },\n      {\n        \"assert\": \"$hParsed.ok\",\n        \"message\": \"HIERARCHY-001: Source declarations must parse through source.rel.\"\n      },\n      {\n        \"let\": \"hBinding\",\n        \"value\": \"$eventInput.binding\"\n      },\n      {\n        \"fold\": \"$hParsed.facts\",\n        \"as\": \"hFact\",\n        \"accumulator\": \"hScan\",\n        \"initial\": {\n          \"rows\": [\n            \"list\"\n          ],\n          \"index\": 0\n        },\n        \"steps\": [\n          {\n            \"assert\": [\n              \"includes\",\n              [\n                \"list\",\n                \"dependsOn\",\n                \"pack\"\n              ],\n              \"$hFact.p\"\n            ],\n            \"message\": \"HIERARCHY-002: Unsupported capability relation.\"\n          },\n          {\n            \"let\": \"hOrigin\",\n            \"value\": [\n              \"at\",\n              \"$hParsed.origins\",\n              \"$hScan.index\"\n            ]\n          },\n          {\n            \"let\": \"hSnapshotLine\",\n            \"value\": \"$hOrigin.span.line\"\n          },\n          {\n            \"let\": \"hOriginalLine\",\n            \"value\": [\n              \"at\",\n              \"$hBinding.lineMap\",\n              [\n                \"add\",\n                \"$hSnapshotLine\",\n                -1\n              ]\n            ]\n          },\n          {\n            \"port\": \"value.string\",\n            \"args\": {\n              \"value\": \"$hOriginalLine\"\n            },\n            \"into\": \"hLineText\"\n          },\n          {\n            \"port\": \"text.matches\",\n            \"args\": {\n              \"value\": \"$hLineText\",\n              \"pattern\": \"^[1-9][0-9]*$\"\n            },\n            \"into\": \"hLineValid\"\n          },\n          {\n            \"assert\": \"$hLineValid\",\n            \"message\": \"HIERARCHY-003: Missing or invalid source line binding.\"\n          },\n          {\n            \"assert\": [\n              \"eq\",\n              [\n                \"at\",\n                \"$hExactLines\",\n                [\n                  \"add\",\n                  \"$hSnapshotLine\",\n                  -1\n                ]\n              ],\n              [\n                \"at\",\n                \"$hBinding.lines\",\n                [\n                  \"add\",\n                  \"$hSnapshotLine\",\n                  -1\n                ]\n              ]\n            ],\n            \"message\": \"HIERARCHY-004: Snapshot and original line receipt disagree.\"\n          }\n        ],\n        \"yield\": {\n          \"rows\": [\n            \"append\",\n            \"$hScan.rows\",\n            [\n              \"list\",\n              {\n                \"item\": \"$hBinding.item\",\n                \"binding\": \"$hBinding.id\",\n                \"subject\": \"$hFact.s\",\n                \"relation\": \"$hFact.p\",\n                \"target\": \"$hFact.o\",\n                \"line\": \"$hOriginalLine\",\n                \"snapshotLine\": \"$hSnapshotLine\",\n                \"text\": [\n                  \"at\",\n                  \"$hBinding.lines\",\n                  [\n                    \"add\",\n                    \"$hSnapshotLine\",\n                    -1\n                  ]\n                ]\n              }\n            ]\n          ],\n          \"index\": [\n            \"add\",\n            \"$hScan.index\",\n            1\n          ]\n        },\n        \"into\": \"hScan\"\n      },\n      {\n        \"let\": \"result\",\n        \"value\": \"$hScan.rows\"\n      }\n    ],\n    \"hierarchy.shared\": [\n      {\n        \"let\": \"hRelation\",\n        \"value\": \"$eventInput.relation\"\n      },\n      {\n        \"let\": \"hTarget\",\n        \"value\": \"$eventInput.target\"\n      },\n      {\n        \"let\": \"hMatches\",\n        \"value\": [\n          \"filter\",\n          \"$eventInput.rows\",\n          \"hMatch\",\n          [\n            \"and\",\n            [\n              \"eq\",\n              \"$hMatch.relation\",\n              \"$hRelation\"\n            ],\n            [\n              \"eq\",\n              \"$hMatch.target\",\n              \"$hTarget\"\n            ]\n          ]\n        ]\n      },\n      {\n        \"fold\": \"$hMatches\",\n        \"as\": \"hMatch\",\n        \"accumulator\": \"hPeers\",\n        \"initial\": [\n          \"list\"\n        ],\n        \"steps\": [],\n        \"yield\": [\n          \"if\",\n          [\n            \"includes\",\n            \"$hPeers\",\n            \"$hMatch.item\"\n          ],\n          \"$hPeers\",\n          [\n            \"append\",\n            \"$hPeers\",\n            [\n              \"list\",\n              \"$hMatch.item\"\n            ]\n          ]\n        ],\n        \"into\": \"hPeers\"\n      },\n      {\n        \"let\": \"result\",\n        \"value\": \"$hPeers\"\n      }\n    ],\n    \"hierarchy.extract\": [\n      {\n        \"fold\": \"$hEvidence.bindings\",\n        \"as\": \"hBinding\",\n        \"accumulator\": \"hRows\",\n        \"initial\": [\n          \"list\"\n        ],\n        \"steps\": [\n          {\n            \"let\": \"hExtracted\",\n            \"value\": [\n              \"list\"\n            ]\n          },\n          {\n            \"port\": \"file.copy\",\n            \"args\": {\n              \"path\": \"$hBinding.file\"\n            },\n            \"into\": \"_\"\n          },\n          {\n            \"when\": [\n              \"eq\",\n              \"$hBinding.kind\",\n              \"rel\"\n            ],\n            \"then\": [\n              {\n                \"port\": \"file.read\",\n                \"args\": {\n                  \"path\": \"$hBinding.file\"\n                },\n                \"into\": \"hRaw\"\n              },\n              {\n                \"let\": \"eventInput\",\n                \"value\": {\n                  \"text\": \"$hRaw\",\n                  \"binding\": \"$hBinding\"\n                }\n              },\n              {\n                \"call\": \"hierarchy.parse\"\n              },\n              {\n                \"let\": \"hExtracted\",\n                \"value\": \"$result\"\n              }\n            ]\n          }\n        ],\n        \"yield\": [\n          \"append\",\n          \"$hRows\",\n          \"$hExtracted\"\n        ],\n        \"into\": \"hRows\"\n      },\n      {\n        \"port\": \"json.stringify\",\n        \"args\": {\n          \"value\": {\n            \"protocol\": \"worldwright/extracted-bindings/1\",\n            \"rows\": \"$hRows\"\n          }\n        },\n        \"into\": \"hJSON\"\n      },\n      {\n        \"port\": \"file.write\",\n        \"args\": {\n          \"path\": \"inspection/bindings.values.rel\",\n          \"text\": \"$hJSON\"\n        },\n        \"into\": \"_\"\n      }\n    ],\n    \"hierarchy.viewer.boot\": [\n      {\n        \"let\": \"spPolicy\",\n        \"value\": \"$data.presentation.spPolicy\"\n      },\n      {\n        \"let\": \"spGrammar\",\n        \"value\": \"$data.presentation.spGrammar\"\n      },\n      {\n        \"let\": \"lexPolicy\",\n        \"value\": \"$data.presentation.lexPolicy\"\n      },\n      {\n        \"let\": \"lexGrammar\",\n        \"value\": \"$data.presentation.lexGrammar\"\n      },\n      {\n        \"call\": \"sp.style\"\n      },\n      {\n        \"port\": \"browser.write\",\n        \"args\": {\n          \"ref\": \"#hierarchy-source-style\",\n          \"name\": \"textContent\",\n          \"value\": \"$result\"\n        },\n        \"into\": \"_\"\n      },\n      {\n        \"port\": \"browser.property\",\n        \"args\": {\n          \"ref\": \"#hierarchy-source\",\n          \"name\": \"textContent\"\n        },\n        \"into\": \"hSource\"\n      },\n      {\n        \"port\": \"browser.property\",\n        \"args\": {\n          \"ref\": \"#hierarchy-language\",\n          \"name\": \"value\"\n        },\n        \"into\": \"hLanguage\"\n      },\n      {\n        \"when\": [\n          \"eq\",\n          \"$hLanguage\",\n          \"markdown\"\n        ],\n        \"then\": [\n          {\n            \"port\": \"kernel.invoke\",\n            \"args\":