("v20", "scalar", "{\n  \"protocol\": \"temple/surface-process-module/1\",\n  \"queries\": {\n    \"sp.role\": [\n      {\n        \"let\": \"v\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"text\"\n        ]\n      },\n      {\n        \"let\": \"language\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"language\"\n        ]\n      },\n      {\n        \"let\": \"role\",\n        \"value\": \"plain\"\n      },\n      {\n        \"when\": [\n          \"eq\",\n          \"$language\",\n          \"javascript\"\n        ],\n        \"then\": [\n          {\n            \"when\": [\n              \"eq\",\n              [\n                \"at\",\n                \"$eventInput\",\n                \"category\"\n              ],\n              \"comment\"\n            ],\n            \"then\": [\n              {\n                \"let\": \"role\",\n                \"value\": \"comment\"\n              }\n            ]\n          },\n          {\n            \"port\": \"value.describe\",\n            \"args\": {\n              \"value\": [\n                \"at\",\n                \"$eventInput\",\n                \"keyword\"\n              ]\n            },\n            \"into\": \"keywordType\"\n          },\n          {\n            \"when\": [\n              \"and\",\n              [\n                \"eq\",\n                [\n                  \"at\",\n                  \"$keywordType\",\n                  \"type\"\n                ],\n                \"string\"\n              ],\n              [\n                \"not\",\n                [\n                  \"eq\",\n                  [\n                    \"at\",\n                    \"$eventInput\",\n                    \"keyword\"\n                  ],\n                  \"\"\n                ]\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"role\",\n                \"value\": \"keyword\"\n              }\n            ]\n          },\n          {\n            \"fold\": [\n              \"at\",\n              \"$spPolicy\",\n              \"javascriptRoles\"\n            ],\n            \"as\": \"rule\",\n            \"accumulator\": \"role\",\n            \"initial\": \"$role\",\n            \"steps\": [\n              {\n                \"when\": [\n                  \"includes\",\n                  [\n                    \"at\",\n                    \"$rule\",\n                    \"kinds\"\n                  ],\n                  [\n                    \"at\",\n                    \"$eventInput\",\n                    \"kind\"\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": [\n                      \"at\",\n                      \"$rule\",\n                      \"role\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"yield\": \"$role\",\n            \"into\": \"role\"\n          }\n        ]\n      },\n      {\n        \"when\": [\n          \"not\",\n          [\n            \"eq\",\n            \"$language\",\n            \"javascript\"\n          ]\n        ],\n        \"then\": [\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$v\",\n              \"start\": 0,\n              \"end\": 1\n            },\n            \"into\": \"first\"\n          },\n          {\n            \"port\": \"text.matches\",\n            \"args\": {\n              \"value\": \"$v\",\n              \"pattern\": \"^\\\\s*$\"\n            },\n            \"into\": \"white\"\n          },\n          {\n            \"when\": [\n              \"not\",\n              \"$white\"\n            ],\n            \"then\": [\n              {\n                \"when\": [\n                  \"eq\",\n                  \"$first\",\n                  \"\\\"\"\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": \"string\"\n                  },\n                  {\n                    \"when\": [\n                      \"eq\",\n                      \"$language\",\n                      \"json\"\n                    ],\n                    \"then\": [\n                      {\n                        \"port\": \"text.matches\",\n                        \"args\": {\n                          \"value\": [\n                            \"at\",\n                            \"$eventInput\",\n                            \"tail\"\n                          ],\n                          \"pattern\": \"^\\\\s*:\"\n                        },\n                        \"into\": \"key\"\n                      },\n                      {\n                        \"when\": \"$key\",\n                        \"then\": [\n                          {\n                            \"let\": \"role\",\n                            \"value\": \"property\"\n                          }\n                        ]\n                      }\n                    ]\n                  },\n                  {\n                    \"when\": [\n                      \"eq\",\n                      \"$language\",\n                      \"rel\"\n                    ],\n                    \"then\": [\n                      {\n                        \"when\": [\n                          \"eq\",\n                          [\n                            \"at\",\n                            \"$eventInput\",\n                            \"atom\"\n                          ],\n                          0\n                        ],\n                        \"then\": [\n                          {\n                            \"let\": \"role\",\n                            \"value\": \"identity\"\n                          }\n                        ]\n                      },\n                      {\n                        \"when\": [\n                          \"eq\",\n                          [\n                            \"at\",\n                            \"$eventInput\",\n                            \"atom\"\n                          ],\n                          1\n                        ],\n                        \"then\": [\n                          {\n                            \"let\": \"role\",\n                            \"value\": \"predicate\"\n                          }\n                        ]\n                      }\n                    ]\n                  }\n                ]\n              },\n              {\n                \"when\": [\n                  \"and\",\n                  [\n                    \"not\",\n                    [\n                      \"eq\",\n                      \"$first\",\n                      \"\\\"\"\n                    ]\n                  ],\n                  [\n                    \"includes\",\n                    [\n                      \"list\",\n                      \"true\",\n                      \"false\"\n                    ],\n                    \"$v\"\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": \"boolean\"\n                  }\n                ]\n              },\n              {\n                \"when\": [\n                  \"eq\",\n                  \"$v\",\n                  \"null\"\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": \"keyword\"\n                  }\n                ]\n              },\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$v\",\n                  \"pattern\": \"^-?[0-9]\"\n                },\n                \"into\": \"number\"\n              },\n              {\n                \"when\": \"$number\",\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": \"number\"\n                  }\n                ]\n              },\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$v\",\n                  \"pattern\": \"^(?://|#)\"\n                },\n                \"into\": \"comment\"\n              },\n              {\n                \"when\": \"$comment\",\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": \"comment\"\n                  }\n                ]\n              },\n              {\n                \"when\": [\n                  \"and\",\n                  [\n                    \"includes\",\n                    [\n                      \"list\",\n                      \"encounter\",\n                      \"temple\",\n                      \"process\"\n                    ],\n                    \"$language\"\n                  ],\n                  [\n                    \"not\",\n                    [\n                      \"or\",\n                      \"$comment\",\n                      [\n                        \"eq\",\n                        \"$first\",\n                        \"\\\"\"\n                      ],\n                      \"$number\"\n                    ]\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"port\": \"text.matches\",\n                    \"args\": {\n                      \"value\": \"$v\",\n                      \"pattern\": \"^[A-Za-z_]\"\n                    },\n                    \"into\": \"name\"\n                  },\n                  {\n                    \"when\": [\n                      \"and\",\n                      \"$name\",\n                      [\n                        \"eq\",\n                        \"$role\",\n                        \"plain\"\n                      ]\n                    ],\n                    \"then\": [\n                      {\n                        \"let\": \"role\",\n                        \"value\": [\n                          \"if\",\n                          [\n                            \"includes\",\n                            [\n                              \"at\",\n                              \"$spPolicy\",\n                              \"keywords\"\n                            ],\n                            \"$v\"\n                          ],\n                          \"keyword\",\n                          \"identifier\"\n                        ]\n                      }\n                    ]\n                  },\n                  {\n                    \"when\": [\n                      \"includes\",\n                      [\n                        \"list\",\n                        \"@\",\n                        [\n                          \"at\",\n                          \"$spPolicy\",\n                          \"referenceSigil\"\n                        ]\n                      ],\n                      \"$first\"\n                    ],\n                    \"then\": [\n                      {\n                        \"let\": \"role\",\n                        \"value\": \"reference\"\n                      }\n                    ]\n                  }\n                ]\n              },\n              {\n                \"when\": [\n                  \"includes\",\n                  [\n                    \"at\",\n                    \"$spPolicy\",\n                    \"punctuation\"\n                  ],\n                  \"$v\"\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": \"punctuation\"\n                  }\n                ]\n              },\n              {\n                \"when\": [\n                  \"includes\",\n                  [\n                    \"at\",\n                    \"$spPolicy\",\n                    \"operators\"\n                  ],\n                  \"$v\"\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"role\",\n                    \"value\": \"operator\"\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      },\n      {\n        \"when\": [\n          \"or\",\n          [\n            \"and\",\n            [\n              \"eq\",\n              \"$language\",\n              \"rel\"\n            ],\n            [\n              \"eq\",\n              [\n                \"at\",\n                \"$eventInput\",\n                \"atom\"\n              ],\n              2\n            ],\n            [\n              \"includes\",\n              [\n                \"at\",\n                \"$spPolicy\",\n                \"typePredicates\"\n              ],\n              [\n                \"at\",\n                \"$eventInput\",\n                \"predicate\"\n              ]\n            ],\n            [\n              \"eq\",\n              \"$role\",\n              \"string\"\n            ]\n          ],\n          [\n            \"and\",\n            [\n              \"includes\",\n              [\n                \"list\",\n                \"encounter\",\n                \"temple\"\n              ],\n              \"$language\"\n            ],\n            [\n              \"at\",\n              \"$eventInput\",\n              \"typeExpected\"\n            ],\n            [\n              \"includes\",\n              [\n                \"list\",\n                \"string\",\n                \"identifier\"\n              ],\n              \"$role\"\n            ]\n          ]\n        ],\n        \"then\": [\n          {\n            \"let\": \"role\",\n            \"value\": \"type\"\n          }\n        ]\n      },\n      {\n        \"when\": [\n          \"eq\",\n          \"$language\",\n          \"markdown\"\n        ],\n        \"then\": [\n          {\n            \"let\": \"role\",\n            \"value\": \"plain\"\n          },\n          {\n            \"port\": \"text.matches\",\n            \"args\": {\n              \"value\": \"$v\",\n              \"pattern\": \"^(?:#{1,6}|\\\\*\\\\*)\"\n            },\n            \"into\": \"mdHeading\"\n          },\n          {\n            \"when\": \"$mdHeading\",\n            \"then\": [\n              {\n                \"let\": \"role\",\n                \"value\": \"keyword\"\n              }\n            ]\n          },\n          {\n            \"port\": \"text.matches\",\n            \"args\": {\n              \"value\": \"$v\",\n              \"pattern\": \"^`|^~~~\"\n            },\n            \"into\": \"mdCode\"\n          },\n          {\n            \"when\": \"$mdCode\",\n            \"then\": [\n              {\n                \"let\": \"role\",\n                \"value\": \"string\"\n              }\n            ]\n          },\n          {\n            \"port\": \"text.matches\",\n            \"args\": {\n              \"value\": \"$v\",\n              \"pattern\": \"^\\\\[\"\n            },\n            \"into\": \"mdLink\"\n          },\n          {\n            \"when\": \"$mdLink\",\n            \"then\": [\n              {\n                \"let\": \"role\",\n                \"value\": \"reference\"\n              }\n            ]\n          },\n          {\n            \"port\": \"text.matches\",\n            \"args\": {\n              \"value\": \"$v\",\n              \"pattern\": \"^(?:\\\\||[-+>] |\\\\*)\"\n            },\n            \"into\": \"mdPunctuation\"\n          },\n          {\n            \"when\": \"$mdPunctuation\",\n            \"then\": [\n              {\n                \"let\": \"role\",\n                \"value\": \"operator\"\n              }\n            ]\n          }\n        ]\n      },\n      {\n        \"let\": \"result\",\n        \"value\": \"$role\"\n      }\n    ],\n    \"sp.scan\": [\n      {\n        \"let\": \"text\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"text\"\n        ]\n      },\n      {\n        \"let\": \"language\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"language\"\n        ]\n      },\n      {\n        \"port\": \"kernel.invoke\",\n        \"args\": {\n          \"query\": \"source.split\",\n          \"input\": {\n            \"text\": \"$text\",\n            \"language\": \"$language\"\n          }\n        },\n        \"into\": \"lexed\"\n      },\n      {\n        \"let\": \"parts\",\n        \"value\": [\n          \"at\",\n          \"$lexed\",\n          \"parts\"\n        ]\n      },\n      {\n        \"let\": \"withinLimit\",\n        \"value\": [\n          \"at\",\n          \"$lexed\",\n          \"withinLimit\"\n        ]\n      },\n      {\n        \"let\": \"segments\",\n        \"value\": [\n          \"list\",\n          {\n            \"start\": 0,\n            \"end\": [\n              \"count\",\n              \"$text\"\n            ],\n            \"text\": \"$text\",\n            \"role\": \"plain\"\n          }\n        ]\n      },\n      {\n        \"when\": \"$withinLimit\",\n        \"then\": [\n          {\n            \"fold\": \"$parts\",\n            \"as\": \"part\",\n            \"accumulator\": \"scan\",\n            \"initial\": {\n              \"offset\": 0,\n              \"segments\": [\n                \"list\"\n              ],\n              \"atom\": 0,\n              \"predicate\": null,\n              \"typeNext\": false,\n              \"previous\": null,\n              \"declaration\": null\n            },\n            \"steps\": [\n              {\n                \"let\": \"start\",\n                \"value\": [\n                  \"at\",\n                  \"$scan\",\n                  \"offset\"\n                ]\n              },\n              {\n                \"let\": \"end\",\n                \"value\": [\n                  \"add\",\n                  \"$start\",\n                  [\n                    \"count\",\n                    \"$part\"\n                  ]\n                ]\n              },\n              {\n                \"let\": \"segments\",\n                \"value\": [\n                  \"at\",\n                  \"$scan\",\n                  \"segments\"\n                ]\n              },\n              {\n                \"let\": \"atom\",\n                \"value\": [\n                  \"at\",\n                  \"$scan\",\n                  \"atom\"\n                ]\n              },\n              {\n                \"when\": [\n                  \"eq\",\n                  \"$part\",\n                  \"(\"\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"atom\",\n                    \"value\": 0\n                  }\n                ]\n              },\n              {\n                \"port\": \"text.slice\",\n                \"args\": {\n                  \"value\": \"$text\",\n                  \"start\": \"$end\",\n                  \"end\": [\n                    \"count\",\n                    \"$text\"\n                  ]\n                },\n                \"into\": \"tail\"\n              },\n              {\n                \"port\": \"kernel.invoke\",\n                \"args\": {\n                  \"query\": \"sp.role\",\n                  \"input\": {\n                    \"text\": \"$part\",\n                    \"language\": \"$language\",\n                    \"tail\": \"$tail\",\n                    \"atom\": \"$atom\",\n                    \"predicate\": [\n                      \"at\",\n                      \"$scan\",\n                      \"predicate\"\n                    ],\n                    \"typeExpected\": [\n                      \"at\",\n                      \"$scan\",\n                      \"typeNext\"\n                    ]\n                  }\n                },\n                \"into\": \"role\"\n              },\n              {\n                \"when\": [\n                  \"not\",\n                  [\n                    \"eq\",\n                    [\n                      \"count\",\n                      \"$part\"\n                    ],\n                    0\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"segments\",\n                    \"value\": [\n                      \"append\",\n                      \"$segments\",\n                      [\n                        \"list\",\n                        {\n                          \"start\": \"$start\",\n                          \"end\": \"$end\",\n                          \"text\": \"$part\",\n                          \"role\": \"$role\"\n                        }\n                      ]\n                    ]\n                  }\n                ]\n              },\n              {\n                \"port\": \"text.slice\",\n                \"args\": {\n                  \"value\": \"$part\",\n                  \"start\": 0,\n                  \"end\": 1\n                },\n                \"into\": \"first\"\n              },\n              {\n                \"when\": [\n                  \"eq\",\n                  \"$first\",\n                  \"\\\"\"\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"atom\",\n                    \"value\": [\n                      \"add\",\n                      \"$atom\",\n                      1\n                    ]\n                  }\n                ]\n              },\n              {\n                \"let\": \"predicate\",\n                \"value\": [\n                  \"at\",\n                  \"$scan\",\n                  \"predicate\"\n                ]\n              },\n              {\n                \"let\": \"typeNext\",\n                \"value\": [\n                  \"at\",\n                  \"$scan\",\n                  \"typeNext\"\n                ]\n              },\n              {\n                \"let\": \"previous\",\n                \"value\": [\n                  \"at\",\n                  \"$scan\",\n                  \"previous\"\n                ]\n              },\n              {\n                \"let\": \"declaration\",\n                \"value\": [\n                  \"at\",\n                  \"$scan\",\n                  \"declaration\"\n                ]\n              },\n              {\n                \"when\": [\n                  \"and\",\n                  [\n                    \"eq\",\n                    \"$language\",\n                    \"rel\"\n                  ],\n                  [\n                    \"eq\",\n                    [\n                      \"at\",\n                      \"$scan\",\n                      \"atom\"\n                    ],\n                    1\n                  ],\n                  [\n                    \"eq\",\n                    \"$first\",\n                    \"\\\"\"\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"try\": [\n                      {\n                        \"port\": \"json.parse\",\n                        \"args\": {\n                          \"text\": \"$part\"\n                        },\n                        \"into\": \"predicate\"\n                      }\n                    ],\n                    \"error\": \"predicateFault\",\n                    \"catch\": [\n                      {\n                        \"let\": \"predicate\",\n                        \"value\": null\n                      }\n                    ]\n                  }\n                ]\n              },\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$part\",\n                  \"pattern\": \"[\\\\r\\\\n]\"\n                },\n                \"into\": \"lineBreak\"\n              },\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$part\",\n                  \"pattern\": \"^\\\\s*$\"\n                },\n                \"into\": \"space\"\n              },\n              {\n                \"when\": \"$lineBreak\",\n                \"then\": [\n                  {\n                    \"let\": \"typeNext\",\n                    \"value\": false\n                  },\n                  {\n                    \"let\": \"previous\",\n                    \"value\": null\n                  },\n                  {\n                    \"let\": \"declaration\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"when\": [\n                  \"and\",\n                  [\n                    \"not\",\n                    \"$space\"\n                  ],\n                  [\n                    \"not\",\n                    [\n                      \"eq\",\n                      \"$role\",\n                      \"comment\"\n                    ]\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"when\": [\n                      \"and\",\n                      [\n                        \"eq\",\n                        \"$previous\",\n                        null\n                      ],\n                      [\n                        \"eq\",\n                        \"$role\",\n                        \"keyword\"\n                      ],\n                      [\n                        \"eq\",\n                        \"$part\",\n                        \"given\"\n                      ]\n                    ],\n                    \"then\": [\n                      {\n                        \"let\": \"declaration\",\n                        \"value\": \"given\"\n                      }\n                    ]\n                  },\n                  {\n                    \"let\": \"typeNext\",\n                    \"value\": [\n                      \"and\",\n                      [\n                        \"includes\",\n                        [\n                          \"list\",\n                          \"encounter\",\n                          \"temple\"\n                        ],\n                        \"$language\"\n                      ],\n                      [\n                        \"eq\",\n                        \"$role\",\n                        \"keyword\"\n                      ],\n                      [\n                        \"or\",\n                        [\n                          \"includes\",\n                          [\n                            \"at\",\n                            [\n                              \"at\",\n                              \"$spPolicy\",\n                              \"typeIntroducers\"\n                            ],\n                            \"$language\"\n                          ],\n                          \"$part\"\n                        ],\n                        [\n                          \"and\",\n                          [\n                            \"eq\",\n                            \"$part\",\n                            \"as\"\n                          ],\n                          [\n                            \"or\",\n                            [\n                              \"eq\",\n                              \"$previous\",\n                              \"show\"\n                            ],\n                            [\n                              \"eq\",\n                              \"$declaration\",\n                              \"given\"\n                            ]\n                          ]\n                        ]\n                      ]\n                    ]\n                  },\n                  {\n                    \"let\": \"previous\",\n                    \"value\": \"$part\"\n                  }\n                ]\n              }\n            ],\n            \"yield\": {\n              \"offset\": \"$end\",\n              \"segments\": \"$segments\",\n              \"atom\": \"$atom\",\n              \"predicate\": \"$predicate\",\n              \"typeNext\": \"$typeNext\",\n              \"previous\": \"$previous\",\n              \"declaration\": \"$declaration\"\n            },\n            \"into\": \"scan\"\n          },\n          {\n            \"let\": \"segments\",\n            \"value\": [\n              \"at\",\n              \"$scan\",\n              \"segments\"\n            ]\n          }\n        ]\n      },\n      {\n        \"let\": \"result\",\n        \"value\": {\n          \"segments\": \"$segments\",\n          \"diagnostic\": [\n            \"if\",\n            \"$withinLimit\",\n            null,\n            \"SP-LIMIT: Exact text retained without token decoration.\"\n          ]\n        }\n      }\n    ],\n    \"sp.observed\": [\n      {\n        \"let\": \"text\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"text\"\n        ]\n      },\n      {\n        \"let\": \"observed\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"observed\"\n        ]\n      },\n      {\n        \"assert\": [\n          \"and\",\n          [\n            \"eq\",\n            [\n              \"at\",\n              \"$observed\",\n              \"units\"\n            ],\n            \"utf16\"\n          ],\n          [\n            \"eq\",\n            [\n              \"at\",\n              \"$observed\",\n              \"sha256\"\n            ],\n            [\n              \"at\",\n              \"$eventInput\",\n              \"sha256\"\n            ]\n          ],\n          [\n            \"isArray\",\n            [\n              \"at\",\n              \"$observed\",\n              \"tokens\"\n            ]\n          ]\n        ],\n        \"message\": \"SP-OBSERVATION: Token observations belong to a different source basis.\"\n      },\n      {\n        \"assert\": [\n          \"includes\",\n          [\n            \"range\",\n            [\n              \"add\",\n              [\n                \"at\",\n                \"$spPolicy\",\n                \"maxParts\"\n              ],\n              1\n            ]\n          ],\n          [\n            \"add\",\n            [\n              \"count\",\n              [\n                \"at\",\n                \"$observed\",\n                \"tokens\"\n              ]\n            ],\n            1\n          ]\n        ],\n        \"message\": \"SP-LIMIT: Too many observed tokens.\"\n      },\n      {\n        \"fold\": [\n          \"at\",\n          \"$observed\",\n          \"tokens\"\n        ],\n        \"as\": \"token\",\n        \"accumulator\": \"scan\",\n        \"initial\": {\n          \"offset\": 0,\n          \"segments\": [\n            \"list\"\n          ]\n        },\n        \"steps\": [\n          {\n            \"let\": \"start\",\n            \"value\": [\n              \"at\",\n              \"$token\",\n              \"start\"\n            ]\n          },\n          {\n            \"let\": \"end\",\n            \"value\": [\n              \"at\",\n              \"$token\",\n              \"end\"\n            ]\n          },\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$text\",\n              \"start\": 0,\n              \"end\": \"$start\"\n            },\n            \"into\": \"prefix\"\n          },\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$text\",\n              \"start\": 0,\n              \"end\": \"$end\"\n            },\n            \"into\": \"endPrefix\"\n          },\n          {\n            \"assert\": [\n              \"and\",\n              [\n                \"eq\",\n                [\n                  \"count\",\n                  \"$prefix\"\n                ],\n                \"$start\"\n              ],\n              [\n                \"eq\",\n                [\n                  \"count\",\n                  \"$endPrefix\"\n                ],\n                \"$end\"\n              ]\n            ],\n            \"message\": \"SP-RANGE: Token endpoint is outside the exact UTF-16 source.\"\n          },\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$text\",\n              \"start\": [\n                \"at\",\n                \"$scan\",\n                \"offset\"\n              ],\n              \"end\": \"$start\"\n            },\n            \"into\": \"gap\"\n          },\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$text\",\n              \"start\": \"$start\",\n              \"end\": \"$end\"\n            },\n            \"into\": \"raw\"\n          },\n          {\n            \"assert\": [\n              \"and\",\n              [\n                \"eq\",\n                [\n                  \"add\",\n                  [\n                    \"at\",\n                    \"$scan\",\n                    \"offset\"\n                  ],\n                  [\n                    \"count\",\n                    \"$gap\"\n                  ]\n                ],\n                \"$start\"\n              ],\n              [\n                \"eq\",\n                [\n                  \"add\",\n                  \"$start\",\n                  [\n                    \"count\",\n                    \"$raw\"\n                  ]\n                ],\n                \"$end\"\n              ]\n            ],\n            \"message\": \"SP-OVERLAP: Token observations are reversed or overlap.\"\n          },\n          {\n            \"let\": \"segments\",\n            \"value\": [\n              \"at\",\n              \"$scan\",\n              \"segments\"\n            ]\n          },\n          {\n            \"when\": [\n              \"not\",\n              [\n                \"eq\",\n                [\n                  \"count\",\n                  \"$gap\"\n                ],\n                0\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"segments\",\n                \"value\": [\n                  \"append\",\n                  \"$segments\",\n                  [\n                    \"list\",\n                    {\n                      \"start\": [\n                        \"at\",\n                        \"$scan\",\n                        \"offset\"\n                      ],\n                      \"end\": \"$start\",\n                      \"text\": \"$gap\",\n                      \"role\": \"plain\"\n                    }\n                  ]\n                ]\n              }\n            ]\n          },\n          {\n            \"port\": \"kernel.invoke\",\n            \"args\": {\n              \"query\": \"sp.role\",\n              \"input\": {\n                \"text\": \"$raw\",\n                \"language\": \"javascript\",\n                \"category\": [\n                  \"at\",\n                  \"$token\",\n                  \"category\"\n                ],\n                \"kind\": [\n                  \"at\",\n                  \"$token\",\n                  \"kind\"\n                ],\n                \"keyword\": [\n                  \"at\",\n                  \"$token\",\n                  \"keyword\"\n                ]\n              }\n            },\n            \"into\": \"role\"\n          },\n          {\n            \"when\": [\n              \"not\",\n              [\n                \"eq\",\n                [\n                  \"count\",\n                  \"$raw\"\n                ],\n                0\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"segments\",\n                \"value\": [\n                  \"append\",\n                  \"$segments\",\n                  [\n                    \"list\",\n                    {\n                      \"start\": \"$start\",\n                      \"end\": \"$end\",\n                      \"text\": \"$raw\",\n                      \"role\": \"$role\"\n                    }\n                  ]\n                ]\n              }\n            ]\n          }\n        ],\n        \"yield\": {\n          \"offset\": \"$end\",\n          \"segments\": \"$segments\"\n        },\n        \"into\": \"scan\"\n      },\n      {\n        \"port\": \"text.slice\",\n        \"args\": {\n          \"value\": \"$text\",\n          \"start\": [\n            \"at\",\n            \"$scan\",\n            \"offset\"\n          ],\n          \"end\": [\n            \"count\",\n            \"$text\"\n          ]\n        },\n        \"into\": \"tail\"\n      },\n      {\n        \"let\": \"result\",\n        \"value\": [\n          \"at\",\n          \"$scan\",\n          \"segments\"\n        ]\n      },\n      {\n        \"when\": [\n          \"not\",\n          [\n            \"eq\",\n            [\n              \"count\",\n              \"$tail\"\n            ],\n            0\n          ]\n        ],\n        \"then\": [\n          {\n            \"let\": \"result\",\n            \"value\": [\n              \"append\",\n              \"$result\",\n              [\n                \"list\",\n                {\n                  \"start\": [\n                    \"at\",\n                    \"$scan\",\n                    \"offset\"\n                  ],\n                  \"end\": [\n                    \"count\",\n                    \"$text\"\n                  ],\n                  \"text\": \"$tail\",\n                  \"role\": \"plain\"\n                }\n              ]\n            ]\n          }\n        ]\n      }\n    ],\n    \"sp.clip\": [\n      {\n        \"let\": \"text\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"text\"\n        ]\n      },\n      {\n        \"let\": \"clipStart\",\n        \"value\": [\n          \"at\",\n          [\n            \"at\",\n            \"$eventInput\",\n            \"clip\"\n          ],\n          \"start\"\n        ]\n      },\n      {\n        \"let\": \"clipEnd\",\n        \"value\": [\n          \"at\",\n          [\n            \"at\",\n            \"$eventInput\",\n            \"clip\"\n          ],\n          \"end\"\n        ]\n      },\n      {\n        \"port\": \"text.slice\",\n        \"args\": {\n          \"value\": \"$text\",\n          \"start\": 0,\n          \"end\": \"$clipStart\"\n        },\n        \"into\": \"startPrefix\"\n      },\n      {\n        \"port\": \"text.slice\",\n        \"args\": {\n          \"value\": \"$text\",\n          \"start\": 0,\n          \"end\": \"$clipEnd\"\n        },\n        \"into\": \"endPrefix\"\n      },\n      {\n        \"port\": \"text.slice\",\n        \"args\": {\n          \"value\": \"$text\",\n          \"start\": \"$clipStart\",\n          \"end\": \"$clipEnd\"\n        },\n        \"into\": \"expected\"\n      },\n      {\n        \"assert\": [\n          \"and\",\n          [\n            \"eq\",\n            [\n              \"count\",\n              \"$startPrefix\"\n            ],\n            \"$clipStart\"\n          ],\n          [\n            \"eq\",\n            [\n              \"count\",\n              \"$endPrefix\"\n            ],\n            \"$clipEnd\"\n          ],\n          [\n            \"eq\",\n            [\n              \"add\",\n              \"$clipStart\",\n              [\n                \"count\",\n                \"$expected\"\n              ]\n            ],\n            \"$clipEnd\"\n          ]\n        ],\n        \"message\": \"SP-CLIP: Invalid source fragment coordinates.\"\n      },\n      {\n        \"fold\": [\n          \"at\",\n          \"$eventInput\",\n          \"segments\"\n        ],\n        \"as\": \"segment\",\n        \"accumulator\": \"clipped\",\n        \"initial\": [\n          \"list\"\n        ],\n        \"steps\": [\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$startPrefix\",\n              \"start\": 0,\n              \"end\": [\n                \"at\",\n                \"$segment\",\n                \"start\"\n              ]\n            },\n            \"into\": \"commonStart\"\n          },\n          {\n            \"let\": \"start\",\n            \"value\": [\n              \"add\",\n              [\n                \"add\",\n                \"$clipStart\",\n                [\n                  \"at\",\n                  \"$segment\",\n                  \"start\"\n                ]\n              ],\n              [\n                \"concat\",\n                \"-\",\n                [\n                  \"count\",\n                  \"$commonStart\"\n                ]\n              ]\n            ]\n          },\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$endPrefix\",\n              \"start\": 0,\n              \"end\": [\n                \"at\",\n                \"$segment\",\n                \"end\"\n              ]\n            },\n            \"into\": \"commonEnd\"\n          },\n          {\n            \"let\": \"end\",\n            \"value\": [\n              \"count\",\n              \"$commonEnd\"\n            ]\n          },\n          {\n            \"port\": \"text.slice\",\n            \"args\": {\n              \"value\": \"$text\",\n              \"start\": \"$start\",\n              \"end\": \"$end\"\n            },\n            \"into\": \"piece\"\n          },\n          {\n            \"let\": \"next\",\n            \"value\": \"$clipped\"\n          },\n          {\n            \"when\": [\n              \"not\",\n              [\n                \"eq\",\n                [\n                  \"count\",\n                  \"$piece\"\n                ],\n                0\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"next\",\n                \"value\": [\n                  \"append\",\n                  \"$clipped\",\n                  [\n                    \"list\",\n                    {\n                      \"start\": \"$start\",\n                      \"end\": \"$end\",\n                      \"text\": \"$piece\",\n                      \"role\": [\n                        \"at\",\n                        \"$segment\",\n                        \"role\"\n                      ]\n                    }\n                  ]\n                ]\n              }\n            ]\n          }\n        ],\n        \"yield\": \"$next\",\n        \"into\": \"clipped\"\n      },\n      {\n        \"let\": \"joined\",\n        \"value\": [\n          \"fold\",\n          \"$clipped\",\n          \"segment\",\n          \"joined\",\n          \"\",\n          [\n            \"concat\",\n            \"$joined\",\n            [\n              \"at\",\n              \"$segment\",\n              \"text\"\n            ]\n          ]\n        ]\n      },\n      {\n        \"assert\": [\n          \"eq\",\n          \"$joined\",\n          \"$expected\"\n        ],\n        \"message\": \"SP-COVERAGE: Presentation must preserve the exact source fragment.\"\n      },\n      {\n        \"port\": \"text.split\",\n        \"args\": {\n          \"value\": \"$startPrefix\",\n          \"pattern\": \"\\\\r\\\\n|\\\\r|\\\\n\"\n        },\n        \"into\": \"prefixLines\"\n      },\n      {\n        \"let\": \"result\",\n        \"value\": {\n          \"segments\": \"$clipped\",\n          \"text\": \"$expected\",\n          \"firstLine\": [\n            \"count\",\n            \"$prefixLines\"\n          ]\n        }\n      }\n    ],\n    \"sp.line\": [\n      {\n        \"let\": \"result\",\n        \"value\": {\n          \"tag\": \"span\",\n          \"attrs\": {\n            \"class\": [\n              \"concat\",\n              \"sp-line\",\n              [\n                \"if\",\n                [\n                  \"eq\",\n                  [\n                    \"at\",\n                    \"$eventInput\",\n                    \"number\"\n                  ],\n                  [\n                    \"at\",\n                    \"$eventInput\",\n                    \"selectedLine\"\n                  ]\n                ],\n                \" highlight\",\n                \"\"\n              ]\n            ],\n            \"data-line\": [\n              \"concat\",\n              [\n                \"at\",\n                \"$eventInput\",\n                \"number\"\n              ]\n            ]\n          },\n          \"children\": [\n            \"at\",\n            \"$eventInput\",\n            \"children\"\n          ]\n        }\n      }\n    ],\n    \"sp.render\": [\n      {\n        \"let\": \"selectedLine\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"selectedLine\"\n        ]\n      },\n      {\n        \"fold\": [\n          \"at\",\n          \"$eventInput\",\n          \"segments\"\n        ],\n        \"as\": \"segment\",\n        \"accumulator\": \"layout\",\n        \"initial\": {\n          \"number\": [\n            \"at\",\n            \"$eventInput\",\n            \"firstLine\"\n          ],\n          \"lines\": [\n            \"list\"\n          ],\n          \"pending\": [\n            \"list\"\n          ]\n        },\n        \"steps\": [\n          {\n            \"assert\": [\n              \"includes\",\n              [\n                \"at\",\n                \"$spPolicy\",\n                \"roles\"\n              ],\n              [\n                \"at\",\n                \"$segment\",\n                \"role\"\n              ]\n            ],\n            \"message\": \"SP-ROLE: Unknown presentation role.\"\n          },\n          {\n            \"port\": \"text.split\",\n            \"args\": {\n              \"value\": [\n                \"at\",\n                \"$segment\",\n                \"text\"\n              ],\n              \"pattern\": \"(\\\\r\\\\n|\\\\n|\\\\r)\"\n            },\n            \"into\": \"pieces\"\n          },\n          {\n            \"fold\": \"$pieces\",\n            \"as\": \"piece\",\n            \"accumulator\": \"line\",\n            \"initial\": \"$layout\",\n            \"steps\": [\n              {\n                \"let\": \"number\",\n                \"value\": [\n                  \"at\",\n                  \"$line\",\n                  \"number\"\n                ]\n              },\n              {\n                \"let\": \"lines\",\n                \"value\": [\n                  \"at\",\n                  \"$line\",\n                  \"lines\"\n                ]\n              },\n              {\n                \"let\": \"pending\",\n                \"value\": [\n                  \"at\",\n                  \"$line\",\n                  \"pending\"\n                ]\n              },\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$piece\",\n                  \"pattern\": \"^(?:\\\\r\\\\n|\\\\n|\\\\r)$\"\n                },\n                \"into\": \"newline\"\n              },\n              {\n                \"when\": \"$newline\",\n                \"then\": [\n                  {\n                    \"port\": \"kernel.invoke\",\n                    \"args\": {\n                      \"query\": \"sp.line\",\n                      \"input\": {\n                        \"number\": \"$number\",\n                        \"selectedLine\": \"$selectedLine\",\n                        \"children\": \"$pending\"\n                      }\n                    },\n                    \"into\": \"lineTree\"\n                  },\n                  {\n                    \"let\": \"lines\",\n                    \"value\": [\n                      \"append\",\n                      \"$lines\",\n                      [\n                        \"list\",\n                        \"$lineTree\",\n                        \"$piece\"\n                      ]\n                    ]\n                  },\n                  {\n                    \"let\": \"number\",\n                    \"value\": [\n                      \"add\",\n                      \"$number\",\n                      1\n                    ]\n                  },\n                  {\n                    \"let\": \"pending\",\n                    \"value\": [\n                      \"list\"\n                    ]\n                  }\n                ]\n              },\n              {\n                \"when\": [\n                  \"and\",\n                  [\n                    \"not\",\n                    \"$newline\"\n                  ],\n                  [\n                    \"not\",\n                    [\n                      \"eq\",\n                      \"$piece\",\n                      \"\"\n                    ]\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"pending\",\n                    \"value\": [\n                      \"append\",\n                      \"$pending\",\n                      [\n                        \"list\",\n                        {\n                          \"tag\": \"span\",\n                          \"attrs\": {\n                            \"class\": [\n                              \"concat\",\n                              \"sp-token sp-\",\n                              [\n                                \"at\",\n                                \"$segment\",\n                                \"role\"\n                              ]\n                            ]\n                          },\n                          \"children\": [\n                            \"list\",\n                            \"$piece\"\n                          ]\n                        }\n                      ]\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"yield\": {\n              \"number\": \"$number\",\n              \"lines\": \"$lines\",\n              \"pending\": \"$pending\"\n            },\n            \"into\": \"nextLayout\"\n          }\n        ],\n        \"yield\": \"$nextLayout\",\n        \"into\": \"layout\"\n      },\n      {\n        \"port\": \"kernel.invoke\",\n        \"args\": {\n          \"query\": \"sp.line\",\n          \"input\": {\n            \"number\": [\n              \"at\",\n              \"$layout\",\n              \"number\"\n            ],\n            \"selectedLine\": \"$selectedLine\",\n            \"children\": [\n              \"at\",\n              \"$layout\",\n              \"pending\"\n            ]\n          }\n        },\n        \"into\": \"lastLine\"\n      },\n      {\n        \"let\": \"result\",\n        \"value\": {\n          \"tag\": \"code\",\n          \"attrs\": {\n            \"class\": \"sp-code\",\n            \"data-theme\": [\n              \"at\",\n              \"$eventInput\",\n              \"theme\"\n            ],\n            \"data-numbered\": [\n              \"if\",\n              [\n                \"at\",\n                \"$eventInput\",\n                \"lineNumbers\"\n              ],\n              \"true\",\n              \"false\"\n            ],\n            \"tabindex\": \"0\"\n          },\n          \"children\": [\n            \"append\",\n            [\n              \"at\",\n              \"$layout\",\n              \"lines\"\n            ],\n            [\n              \"list\",\n              \"$lastLine\"\n            ]\n          ]\n        }\n      }\n    ],\n    \"sp.present\": [\n      {\n        \"port\": \"kernel.invoke\",\n        \"args\": {\n          \"query\": \"s01.portable\",\n          \"input\": {\n            \"value\": \"$eventInput\",\n            \"ancestors\": [\n              \"list\"\n            ]\n          }\n        },\n        \"into\": \"portable\"\n      },\n      {\n        \"assert\": \"$portable\",\n        \"message\": \"SP-INPUT: Presentation requires finite own-data.\"\n      },\n      {\n        \"let\": \"text\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"text\"\n        ]\n      },\n      {\n        \"port\": \"value.describe\",\n        \"args\": {\n          \"value\": \"$text\"\n        },\n        \"into\": \"type\"\n      },\n      {\n        \"assert\": [\n          \"eq\",\n          [\n            \"at\",\n            \"$type\",\n            \"type\"\n          ],\n          \"string\"\n        ],\n        \"message\": \"SP-INPUT: Exact source text is required.\"\n      },\n      {\n        \"port\": \"digest.sha256\",\n        \"args\": {\n          \"text\": \"$text\"\n        },\n        \"into\": \"hash\"\n      },\n      {\n        \"assert\": [\n          \"eq\",\n          \"$hash\",\n          [\n            \"at\",\n            \"$eventInput\",\n            \"expectedHash\"\n          ]\n        ],\n        \"message\": \"SP-BASIS: Source hash mismatch.\"\n      },\n      {\n        \"let\": \"file\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"file\"\n        ]\n      },\n      {\n        \"let\": \"fileAlias\",\n        \"value\": [\n          \"at\",\n          [\n            \"at\",\n            \"$spPolicy\",\n            \"fileAliases\"\n          ],\n          \"$file\"\n        ]\n      },\n      {\n        \"when\": \"$fileAlias\",\n        \"then\": [\n          {\n            \"let\": \"file\",\n            \"value\": \"$fileAlias\"\n          }\n        ]\n      },\n      {\n        \"let\": \"language\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"language\"\n        ]\n      },\n      {\n        \"let\": \"theme\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"theme\"\n        ]\n      },\n      {\n        \"assert\": [\n          \"includes\",\n          [\n            \"at\",\n            \"$spPolicy\",\n            \"themesAllowed\"\n          ],\n          \"$theme\"\n        ],\n        \"message\": \"SP-THEME: Unknown theme.\"\n      },\n      {\n        \"when\": [\n          \"eq\",\n          \"$language\",\n          \"auto\"\n        ],\n        \"then\": [\n          {\n            \"let\": \"language\",\n            \"value\": \"plain\"\n          },\n          {\n            \"fold\": [\n              \"at\",\n              \"$spPolicy\",\n              \"fileProfiles\"\n            ],\n            \"as\": \"profile\",\n            \"accumulator\": \"language\",\n            \"initial\": \"$language\",\n            \"steps\": [\n              {\n                \"port\": \"text.matches\",\n                \"args\": {\n                  \"value\": \"$file\",\n                  \"pattern\": [\n                    \"at\",\n                    \"$profile\",\n                    \"pattern\"\n                  ]\n                },\n                \"into\": \"matches\"\n              },\n              {\n                \"when\": \"$matches\",\n                \"then\": [\n                  {\n                    \"let\": \"language\",\n                    \"value\": [\n                      \"at\",\n                      \"$profile\",\n                      \"language\"\n                    ]\n                  }\n                ]\n              }\n            ],\n            \"yield\": \"$language\",\n            \"into\": \"language\"\n          }\n        ]\n      },\n      {\n        \"let\": \"reason\",\n        \"value\": null\n      },\n      {\n        \"let\": \"segments\",\n        \"value\": [\n          \"list\",\n          {\n            \"start\": 0,\n            \"end\": [\n              \"count\",\n              \"$text\"\n            ],\n            \"text\": \"$text\",\n            \"role\": \"plain\"\n          }\n        ]\n      },\n      {\n        \"port\": \"text.slice\",\n        \"args\": {\n          \"value\": \"$text\",\n          \"start\": 0,\n          \"end\": [\n            \"at\",\n            \"$spPolicy\",\n            \"maxCodeUnits\"\n          ]\n        },\n        \"into\": \"bounded\"\n      },\n      {\n        \"let\": \"bounded\",\n        \"value\": [\n          \"eq\",\n          [\n            \"count\",\n            \"$bounded\"\n          ],\n          [\n            \"count\",\n            \"$text\"\n          ]\n        ]\n      },\n      {\n        \"when\": [\n          \"not\",\n          \"$bounded\"\n        ],\n        \"then\": [\n          {\n            \"let\": \"reason\",\n            \"value\": \"SP-LIMIT: Source retained as plain text at this presentation bound.\"\n          }\n        ]\n      },\n      {\n        \"when\": [\n          \"and\",\n          \"$bounded\",\n          [\n            \"includes\",\n            [\n              \"list\",\n              \"json\",\n              \"rel\",\n              \"encounter\",\n              \"temple\",\n              \"process\",\n              \"markdown\"\n            ],\n            \"$language\"\n          ]\n        ],\n        \"then\": [\n          {\n            \"port\": \"kernel.invoke\",\n            \"args\": {\n              \"query\": \"sp.scan\",\n              \"input\": {\n                \"text\": \"$text\",\n                \"language\": \"$language\"\n              }\n            },\n            \"into\": \"scanned\"\n          },\n          {\n            \"let\": \"segments\",\n            \"value\": [\n              \"at\",\n              \"$scanned\",\n              \"segments\"\n            ]\n          },\n          {\n            \"let\": \"reason\",\n            \"value\": [\n              \"at\",\n              \"$scanned\",\n              \"diagnostic\"\n            ]\n          }\n        ]\n      },\n      {\n        \"when\": [\n          \"and\",\n          \"$bounded\",\n          [\n            \"eq\",\n            \"$language\",\n            \"javascript\"\n          ]\n        ],\n        \"then\": [\n          {\n            \"when\": [\n              \"at\",\n              \"$eventInput\",\n              \"observed\"\n            ],\n            \"then\": [\n              {\n                \"port\": \"kernel.invoke\",\n                \"args\": {\n                  \"query\": \"sp.observed\",\n                  \"input\": {\n                    \"text\": \"$text\",\n                    \"sha256\": \"$hash\",\n                    \"observed\": [\n                      \"at\",\n                      \"$eventInput\",\n                      \"observed\"\n                    ]\n                  }\n                },\n                \"into\": \"segments\"\n              }\n            ]\n          },\n          {\n            \"when\": [\n              \"not\",\n              [\n                \"at\",\n                \"$eventInput\",\n                \"observed\"\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"reason\",\n                \"value\": \"SP-UNBOUND: JavaScript token observations are unavailable; exact text retained.\"\n              }\n            ]\n          }\n        ]\n      },\n      {\n        \"let\": \"clip\",\n        \"value\": [\n          \"at\",\n          \"$eventInput\",\n          \"clip\"\n        ]\n      },\n      {\n        \"when\": [\n          \"not\",\n          \"$clip\"\n        ],\n        \"then\": [\n          {\n            \"let\": \"clip\",\n            \"value\": {\n              \"start\": 0,\n              \"end\": [\n                \"count\",\n                \"$text\"\n              ]\n            }\n          }\n        ]\n      },\n      {\n        \"port\": \"kernel.invoke\",\n        \"args\": {\n          \"query\": \"sp.clip\",\n          \"input\": {\n            \"text\": \"$text\",\n            \"clip\": \"$clip\",\n            \"segments\": \"$segments\"\n          }\n        },\n        \"into\": \"clipped\"\n      },\n      {\n        \"port\": \"kernel.invoke\",\n        \"args\": {\n          \"query\": \"sp.render\",\n          \"input\": {\n            \"segments\": [\n              \"at\",\n              \"$clipped\",\n              \"segments\"\n            ],\n            \"theme\": \"$theme\",\n            \"lineNumbers\": [\n              \"at\",\n              \"$eventInput\",\n              \"lineNumbers\"\n            ],\n            \"selectedLine\": [\n              \"at\",\n              \"$eventInput\",\n              \"selectedLine\"\n            ],\n            \"firstLine\": [\n              \"at\",\n              \"$clipped\",\n              \"firstLine\"\n            ]\n          }\n        },\n        \"into\": \"tree\"\n      },\n      {\n        \"let\": \"result\",\n        \"value\": {\n          \"protocol\": \"encounter/source-presentation/1\",\n          \"ok\": true,\n          \"sourceHash\": \"$hash\",\n          \"units\": \"utf16\",\n          \"language\": \"$language\",\n          \"assurance\": \"lexical-presentation-only\",\n          \"diagnostic\": \"$reason\",\n          \"text\": [\n            \"at\",\n            \"$clipped\",\n            \"text\"\n          ],\n          \"segments\": [\n            \"a