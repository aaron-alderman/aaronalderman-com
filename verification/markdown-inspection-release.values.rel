    {\n          \"when\": [\n            \"includes\",\n            [\n              \"list\",\n              \"process\",\n              \"json\"\n            ],\n            \"$sourceFormat\"\n          ],\n          \"then\": [\n            {\n              \"try\": [\n                {\n                  \"port\": \"json.parse\",\n                  \"args\": {\n                    \"text\": \"$sourceText\"\n                  },\n                  \"into\": \"sourceJson\"\n                },\n                {\n                  \"let\": \"sourceResult\",\n                  \"value\": {\n                    \"ok\": true,\n                    \"facts\": [\n                      \"list\"\n                    ],\n                    \"origins\": [\n                      \"list\"\n                    ],\n                    \"module\": \"$sourceFile\",\n                    \"json\": \"$sourceJson\",\n                    \"diagnostic\": null\n                  }\n                }\n              ],\n              \"error\": \"sourceJsonError\",\n              \"catch\": [\n                {\n                  \"let\": \"sourceResult\",\n                  \"value\": {\n                    \"ok\": false,\n                    \"facts\": [\n                      \"list\"\n                    ],\n                    \"origins\": [\n                      \"list\"\n                    ],\n                    \"module\": \"$sourceFile\",\n                    \"diagnostic\": {\n                      \"code\": \"ENCOUNTER-SOURCE-002\",\n                      \"summary\": \"$sourceJsonError.message\",\n                      \"span\": {\n                        \"file\": \"$sourceFile\",\n                        \"line\": 1,\n                        \"column\": 1\n                      },\n                      \"correction\": \"Correct the JSON source and try again.\"\n                    }\n                  }\n                }\n              ]\n            }\n          ]\n  