       ]\n          },\n          {\n            \"when\": [\n              \"and\",\n              [\n                \"not\",\n                [\n                  \"eq\",\n                  \"$mdNext\",\n                  \"$mdKind\"\n                ]\n              ],\n              [\n                \"not\",\n                [\n                  \"eq\",\n                  \"$mdKind\",\n                  \"\"\n                ]\n              ]\n            ],\n            \"then\": [\n              {\n                \"port\": \"kernel.invoke\",\n                \"args\": {\n                  \"query\": \"md.block\",\n                  \"input\": {\n                    \"lines\": \"$mdPending\",\n                    \"kind\": \"$mdKind\",\n                    \"language\": \"$mdLanguage\"\n                  }\n                },\n                \"into\": \"mdBlock\"\n              },\n              {\n                \"let\": \"mdNodes\",\n                \"value\": [\n                  \"append\",\n                  \"$mdNodes\",\n                  [\n                    \"list\",\n                    \"$mdBlock\"\n                  ]\n                ]\n              },\n              {\n                \"let\": \"mdPending\",\n                \"value\": [\n                  \"list\"\n                ]\n              }\n            ]\n          },\n          {\n            \"when\": [\n              \"and\",\n              [\n                \"not\",\n                [\n                  \"eq\",\n                  \"$mdNext\",\n                  \"\"\n                ]\n              ],\n              [\n                \"not\",\n                \"$mdSkip\"\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"mdPending\",\n                \"value\": [\n                  \"append\",\n                  \"$mdPending\",\n                  [\n                    \"list\",\n                    \"$mdLine\"\n      