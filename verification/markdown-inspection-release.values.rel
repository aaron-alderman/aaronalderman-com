                 ]\n                          }\n                        ]\n                      }\n                    ]\n                  ]\n                }\n              ]\n            }\n          ]\n        }\n      }\n    ],\n    \"hierarchy.inspect.build\": [\n      {\n        \"let\": \"hItemRows\",\n        \"value\": [\n          \"filter\",\n          \"$hRows\",\n          \"hRow\",\n          [\n            \"eq\",\n            \"$hRow.item\",\n            \"$hItem.id\"\n          ]\n        ]\n      },\n      {\n        \"let\": \"hItemBindings\",\n        \"value\": [\n          \"filter\",\n          \"$hEvidence.bindings\",\n          \"hBinding\",\n          [\n            \"eq\",\n            \"$hBinding.item\",\n            \"$hItem.id\"\n          ]\n        ]\n      },\n      {\n        \"let\": \"hCapabilityViews\",\n        \"value\": [\n          \"list\"\n        ]\n      },\n      {\n        \"let\": \"hSeen\",\n        \"value\": [\n          \"list\"\n        ]\n      },\n      {\n        \"fold\": \"$hItemRows\",\n        \"as\": \"hRow\",\n        \"accumulator\": \"hCardScan\",\n        \"initial\": {\n          \"views\": [\n            \"list\"\n          ],\n          \"seen\": [\n            \"list\"\n          ]\n        },\n        \"steps\": [\n          {\n            \"let\": \"hCapabilityViews\",\n            \"value\": \"$hCardScan.views\"\n          },\n          {\n            \"let\": \"hSeen\",\n            \"value\": \"$hCardScan.seen\"\n          },\n          {\n            \"let\": \"hKey\",\n            \"value\": [\n              \"concat\",\n              \"$hRow.relation\",\n              \":\",\n              \"$hRow.target\"\n            ]\n          },\n          {\n            \"when\": [\n              \"not\",\n              [\n                \"includes\",\n                \"$hSeen\",\n                \"$hKey\"\n              ]\n            ],\n            \"then\": [\n              {\n                \"let\": \"hSeen\",\n                \"value\": [\n                  \"append\",\n                  \"$hSeen\",\n                  [\n                    \"list\",\n                    \"$hKey\"\n                  ]\n                ]\n              },\n              {\n                \"let\": \"eventInput\",\n                \"value\": {\n                  \"rows\": \"$hRows\",\n                  \"relation\": \"$hRow.relation\",\n                  \"target\": \"$hRow.target\"\n                }\n              },\n              {\n                \"call\": \"hierarchy.shared\"\n              },\n              {\n                \"let\": \"hPeers\",\n                \"value\": \"$result\"\n              },\n              {\n                \"when\": [\n                  \"not\",\n                  [\n                    \"includes\",\n                    [\n                      \"list\",\n                      0,\n                      1\n                    ],\n                    [\n                      \"count\",\n                      \"$hPeers\"\n                    ]\n                  ]\n                ],\n                \"then\": [\n                  {\n                    \"let\": \"hWitnesses\",\n                    \"value\": [\n                      \"filter\",\n                      \"$hRows\",\n                      \"hWitness\",\n                      [\n                        \"and\",\n                        [\n                          \"eq\",\n                          \"$hWitness.relation\",\n                          \"$hRow.relation\"\n                        ],\n                        [\n                          \"eq\",\n                          \"$hWitness.target\",\n                          \"$hRow.target\"\n                        ]\n                      ]\n                    ]\n                  },\n                  {\n                    \"let\": \"hCapabilityViews\",\n                    \"value\": [\n                     