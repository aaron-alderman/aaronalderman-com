("v48", "scalar", "(\"site\", \"isa\", \"PersonalExpedition\")\n(\"site\", \"name\", \"Aaron Alderman\")\n(\"site\", \"headline\", \"Inside the mind of a modern-day sourcerer.\")\n(\"site\", \"description\", \"Physics, faith, machines, and the work of remembering care. Explore Aaron Alderman’s ideas, experiments and unfinished questions.\")\n(\"site\", \"origin\", \"https://aaronalderman.com/\")\n(\"site\", \"image\", \"assets/sourcerer-threshold.png\")\n(\"site\", \"imageAlt\", \"An imagined stone doorway opens onto an observatory, branching paths and a golden sea.\")\n(\"territory.unseen\", \"isa\", \"Territory\")\n(\"territory.unseen\", \"name\", \"The unseen\")\n(\"territory.unseen\", \"question\", \"What would let you tell the difference?\")\n(\"territory.unseen\", \"note\", \"From a hidden distinction to a record someone else can check.\")\n(\"territory.unseen\", \"light\", \"unseen\")\n(\"territory.unseen\", \"place\", \"place.observation\")\n(\"territory.unseen\", \"place\", \"place.return\")\n(\"territory.unseen\", \"place\", \"place.instrument\")\n(\"territory.unseen\", \"place\", \"place.calibration\")\n(\"territory.unseen\", \"place\", \"place.replay\")\n(\"territory.unseen\", \"place\", \"place.monster\")\n(\"territory.unseen\", \"place\", \"place.possibility\")\n(\"territory.unseen\", \"place\", \"place.reachable\")\n(\"territory.unseen\", \"place\", \"place.memory\")\n(\"territory.unseen\", \"place\", \"place.erasure\")\n(\"territory.unseen\", \"place\", \"place.tiling\")\n(\"territory.unseen\", \"place\", \"place.code\")\n(\"territory.unseen\", \"place\", \"place.laboratory\")\n(\"territory.unseen\", \"place\", \"place.cost\")\n(\"territory.unseen\", \"place\", \"place.cosmos\")\n(\"territory.unseen\", \"place\", \"place.scale\")\n(\"territory.human\", \"isa\", \"Territory\")\n(\"territory.human\", \"name\", \"The human\")\n(\"territory.human\", \"question\", \"What have you stopped noticing?\")\n(\"territory.human\", \"note\", \"Personal witness, unfamiliar reflections, and the work of making contact.\")\n(\"territory.human\", \"light\", \"human\")\n(\"territory.human\", \"place\", \"place.personal\")\n(\"territory.human\", \"place\", \"place.care\")\n(\"territory.human\", \"place\", \"place.contact\")\n(\"territory.human\", \"place\", \"place.listening\")\n(\"territory.human\", \"place\", \"place.discomfort\")\n(\"territory.human\", \"place\", \"place.water\")\n(\"territory.human\", \"place\", \"place.attention\")\n(\"territory.human\", \"place\", \"place.will\")\n(\"territory.human\", \"place\", \"place.stone\")\n(\"territory.human\", \"place\", \"place.preservation\")\n(\"territory.boundary\", \"isa\", \"Territory\")\n(\"territory.boundary\", \"name\", \"The boundary\")\n(\"territory.boundary\", \"question\", \"What does responsible power make room for?\")\n(\"territory.boundary\", \"note\", \"Agency, delegation, representations, and the freedom to revise.\")\n(\"territory.boundary\", \"light\", \"boundary\")\n(\"territory.boundary\", \"place\", \"place.kenosis\")\n(\"territory.boundary\", \"place\", \"place.restraint\")\n(\"territory.boundary\", \"place\", \"place.permission\")\n(\"territory.boundary\", \"place\", \"place.sourcery\")\n(\"territory.boundary\", \"place\", \"place.representation\")\n(\"territory.boundary\", \"place\", \"place.revision\")\n(\"territory.boundary\", \"place\", \"place.workshop\")\n(\"territory.boundary\", \"place\", \"place.coexistence\")\n(\"territory.boundary\", \"place\", \"place.weights\")\n(\"territory.boundary\", \"place\", \"place.hiddenness\")\n(\"territory.boundary\", \"place\", \"place.hope\")\n(\"territory.boundary\", \"place\", \"place.texts\")\n(\"territory.boundary\", \"place\", \"place.commons\")\n(\"territory.boundary\", \"place\", \"place.closedpath\")\n(\"place.observation\", \"isa\", \"Place\")\n(\"place.observation\", \"slug\", \"observation\")\n(\"place.observation\", \"route\", \"places/observation.html\")\n(\"place.observation\", \"title\", \"What did the measurement miss?\")\n(\"place.observation\", \"lead\", \"Two different things can look the same through one kind of measurement.\")\n(\"place.observation\", \"region\", \"Observation\")\n(\"place.observation\", \"chapter\", \"01\")\n(\"place.observation\", \"source\", \"note.frontier\")\n(\"place.observation\", \"light\", \"unseen\")\n(\"place.observation\", \"paragraph\", \"Imagine two repeating signals that reach the same height. A measuring tool that keeps only their heights may report the same result, even if the signals rise and fall at different times.\")\n(\"place.observation\", \"paragraph\", \"Try the two views beside this story. The extra timing reference reveals a difference the first view left out. The drawing explains an idea; it is not a recording from an experiment.\")\n(\"place.observation\", \"fullParagraph\", \"Sometimes the next discovery begins by preserving a distinction the instrument discarded. More data from the same narrow view may never reveal it.\")\n(\"place.observation\", \"fullParagraph\", \"Choose a different way of looking. What becomes visible?\")\n(\"place.observation\", \"word\", \"word.phase\")\n(\"place.observation\", \"word\", \"word.detector\")\n(\"place.observation\", \"instruction\", \"Switch between the views. Look for a difference the first view misses.\")\n(\"place.observation\", \"choice\", \"place.observation.choice.0\")\n(\"place.observation.choice.0\", \"destination\", \"place.return\")\n(\"place.observation.choice.0\", \"label\", \"Can something return changed?\")\n(\"place.observation.choice.0\", \"kind\", \"Follow the research\")\n(\"place.observation\", \"choice\", \"place.observation.choice.1\")\n(\"place.observation.choice.1\", \"destination\", \"place.contact\")\n(\"place.observation.choice.1\", \"label\", \"Does this happen between people?\")\n(\"place.observation.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.observation\", \"choice\", \"place.observation.choice.2\")\n(\"place.observation.choice.2\", \"destination\", \"place.monster\")\n(\"place.observation.choice.2\", \"label\", \"What would reveal the Monster?\")\n(\"place.observation.choice.2\", \"kind\", \"Follow the research\")\n(\"place.observation\", \"choice\", \"place.observation.choice.3\")\n(\"place.observation.choice.3\", \"destination\", \"place.possibility\")\n(\"place.observation.choice.3\", \"label\", \"Before a reading, what can coexist?\")\n(\"place.observation.choice.3\", \"kind\", \"A path into the wider world\")\n(\"place.return\", \"isa\", \"Place\")\n(\"place.return\", \"slug\", \"return\")\n(\"place.return\", \"route\", \"places/return.html\")\n(\"place.return\", \"title\", \"Back where you started. Something has changed.\")\n(\"place.return\", \"lead\", \"You can come back to the same place with something facing a different way.\")\n(\"place.return\", \"region\", \"The return\")\n(\"place.return\", \"chapter\", \"02\")\n(\"place.return\", \"source\", \"note.invariant\")\n(\"place.return\", \"light\", \"unseen\")\n(\"place.return\", \"paragraph\", \"Follow the little arrow around the loop. It returns to its starting place, but points in a different direction. The path has left a change that the final location alone does not describe.\")\n(\"place.return\", \"paragraph\", \"Mathematicians call this kind of change after a closed journey holonomy. The next question is practical: could a measuring tool notice the change? The personal path offers a separate association with change in a life.\")\n(\"place.return\", \"fullParagraph\", \"Transport around a loop can return a state with a different orientation, even when the local comparison was preserved. The mathematical question is called holonomy.\")\n(\"place.return\", \"fullParagraph\", \"The next question is practical: would your instrument notice?\")\n(\"place.return\", \"word\", \"word.holonomy\")\n(\"place.return\", \"instruction\", \"Choose “Go round the loop.” Watch which way the little arrow points when it comes back.\")\n(\"place.return\", \"choice\", \"place.return.choice.0\")\n(\"place.return.choice.0\", \"destination\", \"place.instrument\")\n(\"place.return.choice.0\", \"label\", \"Build a way to see it\")\n(\"place.return.choice.0\", \"kind\", \"Follow the research\")\n(\"place.return\", \"choice\", \"place.return.choice.1\")\n(\"place.return.choice.1\", \"destination\", \"place.personal\")\n(\"place.return.choice.1\", \"label\", \"What remains when relationships change?\")\n(\"place.return.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.return\", \"choice\", \"place.return.choice.2\")\n(\"place.return.choice.2\", \"destination\", \"place.observation\")\n(\"place.return.choice.2\", \"label\", \"Look again at the measurement\")\n(\"place.return.choice.2\", \"kind\", \"Another way back\")\n(\"place.instrument\", \"isa\", \"Place\")\n(\"place.instrument\", \"slug\", \"instrument\")\n(\"place.instrument\", \"route\", \"places/instrument.html\")\n(\"place.instrument\", \"title\", \"The change can be real. The detector can miss it.\")\n(\"place.instrument\", \"lead\", \"A measuring tool can miss a change that another tool would reveal.\")\n(\"place.instrument\", \"region\", \"The instrument\")\n(\"place.instrument\", \"chapter\", \"03\")\n(\"place.instrument\", \"source\", \"note.detector\")\n(\"place.instrument\", \"light\", \"unseen\")\n(\"place.instrument\", \"paragraph\", \"In the research example, one measurement gives the same answer while part of the mathematical system changes. Measuring several related quantities together can reveal more.\")\n(\"place.instrument\", \"paragraph\", \"This works only if the measurements reach the changing part and are checked against a known reference. The research includes a computer experiment. A physical device would need its own tests.\")\n(\"place.instrument\", \"fullParagraph\", \"In the finite corpus example, one measured response stays unchanged while a hidden two-dimensional plane makes a quarter-turn. A calibrated matrix measurement can recover the moving projector.\")\n(\"place.instrument\", \"fullParagraph\", \"The corpus develops this into a four-mode virtual instrument. Physical acquisition is a separate next step.\")\n(\"place.instrument\", \"word\", \"word.calibration\")\n(\"place.instrument\", \"word\", \"word.model\")\n(\"place.instrument\", \"instruction\", \"Switch between the views. The added reference shows where each signal is in its cycle.\")\n(\"place.instrument\", \"choice\", \"place.instrument.choice.0\")\n(\"place.instrument.choice.0\", \"destination\", \"place.calibration\")\n(\"place.instrument.choice.0\", \"label\", \"Who calibrated the richer view?\")\n(\"place.instrument.choice.0\", \"kind\", \"Look more closely\")\n(\"place.instrument\", \"choice\", \"place.instrument.choice.1\")\n(\"place.instrument.choice.1\", \"destination\", \"place.return\")\n(\"place.instrument.choice.1\", \"label\", \"Return to the fork\")\n(\"place.instrument.choice.1\", \"kind\", \"Another way back\")\n(\"place.instrument\", \"choice\", \"place.instrument.choice.2\")\n(\"place.instrument.choice.2\", \"destination\", \"place.sourcery\")\n(\"place.instrument.choice.2\", \"label\", \"How do you preserve what a model knows?\")\n(\"place.instrument.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.instrument\", \"choice\", \"place.instrument.choice.3\")\n(\"place.instrument.choice.3\", \"destination\", \"place.monster\")\n(\"place.instrument.choice.3\", \"label\", \"Try a different detector problem\")\n(\"place.instrument.choice.3\", \"kind\", \"Follow the research\")\n(\"place.personal\", \"isa\", \"Place\")\n(\"place.personal\", \"slug\", \"personal\")\n(\"place.personal\", \"route\", \"places/personal.html\")\n(\"place.personal\", \"title\", \"I trusted the process.\")\n(\"place.personal\", \"lead\", \"A passage from Aaron’s own account.\")\n(\"place.personal\", \"region\", \"Love, separation and trust\")\n(\"place.personal\", \"chapter\", \"04\")\n(\"place.personal\", \"source\", \"note.personal\")\n(\"place.personal\", \"light\", \"human\")\n(\"place.personal\", \"paragraph\", \"I experienced my children becoming alienated from me. It broke my heart. My marriage suffered, and my wife left.\")\n(\"place.personal\", \"paragraph\", \"I took kenosis seriously. I trusted the process. Along the way, I had to remember to care. In the intensity of everything, it could become totalizing.\")\n(\"place.personal\", \"fullParagraph\", \"I experienced my children becoming alienated from me. It broke my heart. My marriage suffered, and my wife left.\")\n(\"place.personal\", \"fullParagraph\", \"I took kenosis seriously. I trusted the process. Along the way, I had to remember to care. In the intensity of everything, it could become totalizing.\")\n(\"place.personal\", \"word\", \"word.kenosis\")\n(\"place.personal\", \"word\", \"word.totalizing\")\n(\"place.personal\", \"personal\", \"true\")\n(\"place.personal\", \"choice\", \"place.personal.choice.0\")\n(\"place.personal.choice.0\", \"destination\", \"place.kenosis\")\n(\"place.personal.choice.0\", \"label\", \"What did kenosis mean to me?\")\n(\"place.personal.choice.0\", \"kind\", \"Follow the concept\")\n(\"place.personal\", \"choice\", \"place.personal.choice.1\")\n(\"place.personal.choice.1\", \"destination\", \"place.care\")\n(\"place.personal.choice.1\", \"label\", \"Remember to care\")\n(\"place.personal.choice.1\", \"kind\", \"Stay with the human question\")\n(\"place.personal\", \"choice\", \"place.personal.choice.2\")\n(\"place.personal.choice.2\", \"destination\", \"place.return\")\n(\"place.personal.choice.2\", \"label\", \"Return to the mathematical trail\")\n(\"place.personal.choice.2\", \"kind\", \"Another way back\")\n(\"place.care\", \"isa\", \"Place\")\n(\"place.care\", \"slug\", \"care\")\n(\"place.care\", \"route\", \"places/care.html\")\n(\"place.care\", \"title\", \"Remember to care.\")\n(\"place.care\", \"lead\", \"Who or what needs my attention here?\")\n(\"place.care\", \"region\", \"Care\")\n(\"place.care\", \"chapter\", \"05\")\n(\"place.care\", \"source\", \"note.personal\")\n(\"place.care\", \"light\", \"human\")\n(\"place.care\", \"paragraph\", \"When an idea takes up all our attention, we can lose sight of the people living with its consequences. Who is carrying a cost? What have I stopped noticing?\")\n(\"place.care\", \"paragraph\", \"Care might mean listening, offering protection, setting a boundary, or changing an explanation. You can stay with the question without having to produce a lesson or an answer.\")\n(\"place.care\", \"fullParagraph\", \"Who is carrying the cost? What have I stopped noticing?\")\n(\"place.care\", \"fullParagraph\", \"Care can mean attention, protection, a boundary, or the willingness to revise an explanation. These are questions I am still carrying.\")\n(\"place.care\", \"personal\", \"true\")\n(\"place.care\", \"choice\", \"place.care.choice.0\")\n(\"place.care.choice.0\", \"destination\", \"place.water\")\n(\"place.care.choice.0\", \"label\", \"Meet a horse with reservations\")\n(\"place.care.choice.0\", \"kind\", \"Reflective passage\")\n(\"place.care\", \"choice\", \"place.care.choice.1\")\n(\"place.care.choice.1\", \"destination\", \"place.contact\")\n(\"place.care.choice.1\", \"label\", \"When an explanation loses contact\")\n(\"place.care.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.care\", \"choice\", \"place.care.choice.2\")\n(\"place.care.choice.2\", \"destination\", \"place.kenosis\")\n(\"place.care.choice.2\", \"label\", \"When restraint needs to become protection\")\n(\"place.care.choice.2\", \"kind\", \"Follow responsibility\")\n(\"place.care\", \"choice\", \"place.care.choice.3\")\n(\"place.care.choice.3\", \"destination\", \"place.personal\")\n(\"place.care.choice.3\", \"label\", \"Stay with the personal account\")\n(\"place.care.choice.3\", \"kind\", \"Another way back\")\n(\"place.care\", \"choice\", \"place.care.choice.4\")\n(\"place.care.choice.4\", \"destination\", \"place.attention\")\n(\"place.care.choice.4\", \"label\", \"What comes into attention?\")\n(\"place.care.choice.4\", \"kind\", \"A path into the wider world\")\n(\"place.contact\", \"isa\", \"Place\")\n(\"place.contact\", \"slug\", \"contact\")\n(\"place.contact\", \"route\", \"places/contact.html\")\n(\"place.contact\", \"title\", \"Beautiful words. The wrong answer.\")\n(\"place.contact\", \"lead\", \"An answer can sound convincing while missing what someone meant.\")\n(\"place.contact\", \"region\", \"Contact & correction\")\n(\"place.contact\", \"chapter\", \"06\")\n(\"place.contact\", \"source\", \"note.contact\")\n(\"place.contact\", \"light\", \"human\")\n(\"place.contact\", \"paragraph\", \"In the recorded exchange, an explanation brought ideas from an earlier discussion into a different question. The words fitted together, but the explanation had lost touch with the person speaking.\")\n(\"place.contact\", \"paragraph\", \"The interpretation was withdrawn. The next inquiry began with the particular mistake: what had been misunderstood, and what would a more relevant answer do differently?\")\n(\"place.contact\", \"fullParagraph\", \"One inquiry began when a polished explanation imported an old framework into a different question. It sounded coherent. It had missed the person speaking.\")\n(\"place.contact\", \"fullParagraph\", \"The interpretation was withdrawn. The next inquiry began with the recognition of that failure, then used contrast cases and competing explanations to investigate it.\")\n(\"place.contact\", \"choice\", \"place.contact.choice.0\")\n(\"place.contact.choice.0\", \"destination\", \"place.listening\")\n(\"place.contact.choice.0\", \"label\", \"What was the person trying to do?\")\n(\"place.contact.choice.0\", \"kind\", \"Look more closely\")\n(\"place.contact\", \"choice\", \"place.contact.choice.1\")\n(\"place.contact.choice.1\", \"destination\", \"place.sourcery\")\n(\"place.contact.choice.1\", \"label\", \"What should a machine help us do?\")\n(\"place.contact.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.contact\", \"choice\", \"place.contact.choice.2\")\n(\"place.contact.choice.2\", \"destination\", \"place.care\")\n(\"place.contact.choice.2\", \"label\", \"Come back to care\")\n(\"place.contact.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.contact\", \"choice\", \"place.contact.choice.3\")\n(\"place.contact.choice.3\", \"destination\", \"place.observation\")\n(\"place.contact.choice.3\", \"label\", \"What else does a representation leave out?\")\n(\"place.contact.choice.3\", \"kind\", \"Ideas to compare\")\n(\"place.kenosis\", \"isa\", \"Place\")\n(\"place.kenosis\", \"slug\", \"kenosis\")\n(\"place.kenosis\", \"route\", \"places/kenosis.html\")\n(\"place.kenosis\", \"title\", \"If you could control everything, should you?\")\n(\"place.kenosis\", \"lead\", \"Being able to control something does not settle whether you should.\")\n(\"place.kenosis\", \"region\", \"Power & agency\")\n(\"place.kenosis\", \"chapter\", \"07\")\n(\"place.kenosis\", \"source\", \"note.kenosis\")\n(\"place.kenosis\", \"light\", \"boundary\")\n(\"place.kenosis\", \"paragraph\", \"Kenosis is a Christian word often translated as “self-emptying.” Here it means choosing to use power in ways that give others room to act, rather than taking over their choices.\")\n(\"place.kenosis\", \"paragraph\", \"Making room does not mean leaving people unprotected. If one person is taking away another’s freedom, care may require a boundary or an intervention. Ask whose freedom your restraint protects, and whose needs it may overlook.\")\n(\"place.kenosis\", \"paragraph\", \"This is a philosophical and theological argument. It is not a scientific rule or an instruction about your own relationships.\")\n(\"place.kenosis\", \"fullParagraph\", \"Kenosis asks how power can make room for another person’s agency. Restraint, trust and formation matter. So do protection and responsibility.\")\n(\"place.kenosis\", \"fullParagraph\", \"The difficult boundary is where restraint permits one person to destroy another’s effective agency. Care can require intervention.\")\n(\"place.kenosis\", \"word\", \"word.kenosis\")\n(\"place.kenosis\", \"word\", \"word.agency\")\n(\"place.kenosis\", \"choice\", \"place.kenosis.choice.0\")\n(\"place.kenosis.choice.0\", \"destination\", \"place.restraint\")\n(\"place.kenosis.choice.0\", \"label\", \"When does leaving room leave someone exposed?\")\n(\"place.kenosis.choice.0\", \"kind\", \"Look more closely\")\n(\"place.kenosis\", \"choice\", \"place.kenosis.choice.1\")\n(\"place.kenosis.choice.1\", \"destination\", \"place.care\")\n(\"place.kenosis.choice.1\", \"label\", \"Who is carrying the cost?\")\n(\"place.kenosis.choice.1\", \"kind\", \"Follow the human question\")\n(\"place.kenosis\", \"choice\", \"place.kenosis.choice.2\")\n(\"place.kenosis.choice.2\", \"destination\", \"place.sourcery\")\n(\"place.kenosis.choice.2\", \"label\", \"Build systems people can understand and direct\")\n(\"place.kenosis.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.kenosis\", \"choice\", \"place.kenosis.choice.3\")\n(\"place.kenosis.choice.3\", \"destination\", \"place.personal\")\n(\"place.kenosis.choice.3\", \"label\", \"Why I took this question seriously\")\n(\"place.kenosis.choice.3\", \"kind\", \"Personal account\")\n(\"place.kenosis\", \"choice\", \"place.kenosis.choice.4\")\n(\"place.kenosis.choice.4\", \"destination\", \"place.coexistence\")\n(\"place.kenosis.choice.4\", \"label\", \"Who lives with the consequences?\")\n(\"place.kenosis.choice.4\", \"kind\", \"A path into the wider world\")\n(\"place.sourcery\", \"isa\", \"Place\")\n(\"place.sourcery\", \"slug\", \"sourcery\")\n(\"place.sourcery\", \"route\", \"places/sourcery.html\")\n(\"place.sourcery\", \"title\", \"More help from machines. More say for people.\")\n(\"place.sourcery\", \"lead\", \"Let machines help with the work while people keep a meaningful say in what is made.\")\n(\"place.sourcery\", \"region\", \"Sourcery\")\n(\"place.sourcery\", \"chapter\", \"08\")\n(\"place.sourcery\", \"source\", \"note.authorship\")\n(\"place.sourcery\", \"light\", \"boundary\")\n(\"place.sourcery\", \"paragraph\", \"AI can help write software, suggest changes and run checks. People still decide what is worth making, who it serves and whether it is good.\")\n(\"place.sourcery\", \"paragraph\", \"The aim is to make a system’s workings understandable and changeable. You should be able to follow an idea back to its source and ask what was checked. The workshop lets you try this with two small edits.\")\n(\"place.sourcery\", \"fullParagraph\", \"The aim is to let AI take on more programming work while people retain expertise, taste, discretion and responsibility. People decide what is worth making, who it serves and whether the experience is good.\")\n(\"place.sourcery\", \"fullParagraph\", \"Open architecture should mean more than being handed source code. It should let you understand the decisions, follow a value to its source, challenge a rule and change the workings. The architecture should remain revisable.\")\n(\"place.sourcery\", \"fullParagraph\", \"Assurance should fit the consequences. A typed check, an automated test, a human review and independent verification are different kinds of evidence. We should say which happened, against which version, and what remains unknown.\")\n(\"place.sourcery\", \"fullParagraph\", \"AI can remain a collaborator throughout. The intention is to make expertise go further; any claim about productivity or jobs would need evidence of its own.\")\n(\"place.sourcery\", \"word\", \"word.authorship\")\n(\"place.sourcery\", \"choice\", \"place.sourcery.choice.0\")\n(\"place.sourcery.choice.0\", \"destination\", \"place.workshop\")\n(\"place.sourcery.choice.0\", \"label\", \"Try a change and follow its consequences\")\n(\"place.sourcery.choice.0\", \"kind\", \"Enter the workshop\")\n(\"place.sourcery\", \"choice\", \"place.sourcery.choice.1\")\n(\"place.sourcery.choice.1\", \"destination\", \"place.representation\")\n(\"place.sourcery.choice.1\", \"label\", \"What should a map tell us about its limits?\")\n(\"place.sourcery.choice.1\", \"kind\", \"Look more closely\")\n(\"place.sourcery\", \"choice\", \"place.sourcery.choice.2\")\n(\"place.sourcery.choice.2\", \"destination\", \"place.contact\")\n(\"place.sourcery.choice.2\", \"label\", \"What does the model fail to hear?\")\n(\"place.sourcery.choice.2\", \"kind\", \"Another way back\")\n(\"place.sourcery\", \"choice\", \"place.sourcery.choice.3\")\n(\"place.sourcery.choice.3\", \"destination\", \"place.kenosis\")\n(\"place.sourcery.choice.3\", \"label\", \"What should power leave alone?\")\n(\"place.sourcery.choice.3\", \"kind\", \"Ideas to compare\")\n(\"place.sourcery\", \"choice\", \"place.sourcery.choice.4\")\n(\"place.sourcery.choice.4\", \"destination\", \"place.care\")\n(\"place.sourcery.choice.4\", \"label\", \"Keep care in the loop\")\n(\"place.sourcery.choice.4\", \"kind\", \"Ideas to compare\")\n(\"place.monster\", \"isa\", \"Place\")\n(\"place.monster\", \"slug\", \"monster\")\n(\"place.monster\", \"route\", \"places/monster.html\")\n(\"place.monster\", \"title\", \"A matching number is only a clue.\")\n(\"place.monster\", \"lead\", \"A matching number is a clue. It does not identify the thing you found.\")\n(\"place.monster\", \"region\", \"The Monster trail\")\n(\"place.monster\", \"chapter\", \"09\")\n(\"place.monster\", \"source\", \"note.monster\")\n(\"place.monster\", \"light\", \"unseen\")\n(\"place.monster\", \"paragraph\", \"The research compares three mathematical structures. One broad measurement makes them look alike. A more detailed count gives three different answers: 744, 24 and 0.\")\n(\"place.monster\", \"paragraph\", \"Switch the view to see the counts. They separate these three chosen structures. They do not prove that a physical object contains the structure nicknamed the Monster.\")\n(\"place.monster\", \"fullParagraph\", \"Three rank-24 candidates share the same coarse thermal signature. Their weight-one current dimensions—744, 24 and 0—separate the declared E₈³, Leech and Moonshine family.\")\n(\"place.monster\", \"fullParagraph\", \"Even that is one gate on a longer path. The physical carrier, boundary algebra and exclusive detector prediction still have to be established.\")\n(\"place.monster\", \"word\", \"word.model\")\n(\"place.monster\", \"instruction\", \"Compare the broad view with the detailed count. Which view tells the three structures apart?\")\n(\"place.monster\", \"choice\", \"place.monster.choice.0\")\n(\"place.monster.choice.0\", \"destination\", \"place.replay\")\n(\"place.monster.choice.0\", \"label\", \"What record could tell the structures apart?\")\n(\"place.monster.choice.0\", \"kind\", \"Look more closely\")\n(\"place.monster\", \"choice\", \"place.monster.choice.1\")\n(\"place.monster.choice.1\", \"destination\", \"place.observation\")\n(\"place.monster.choice.1\", \"label\", \"Return to what the detector discards\")\n(\"place.monster.choice.1\", \"kind\", \"Another way back\")\n(\"place.monster\", \"choice\", \"place.monster.choice.2\")\n(\"place.monster.choice.2\", \"destination\", \"place.instrument\")\n(\"place.monster.choice.2\", \"label\", \"Explore the smaller experiment\")\n(\"place.monster.choice.2\", \"kind\", \"Follow the research\")\n(\"place.monster\", \"choice\", \"place.monster.choice.3\")\n(\"place.monster.choice.3\", \"destination\", \"place.sourcery\")\n(\"place.monster.choice.3\", \"label\", \"How could many people explore this together?\")\n(\"place.monster.choice.3\", \"kind\", \"Ideas to compare\")\n(\"place.calibration\", \"isa\", \"Place\")\n(\"place.calibration\", \"slug\", \"calibration\")\n(\"place.calibration\", \"route\", \"places/calibration.html\")\n(\"place.calibration\", \"title\", \"Before you trust the reading, check the ruler.\")\n(\"place.calibration\", \"lead\", \"Before trusting a number, check what the tool can measure.\")\n(\"place.calibration\", \"region\", \"The borrowed ruler\")\n(\"place.calibration\", \"chapter\", \"10\")\n(\"place.calibration\", \"source\", \"note.detector\")\n(\"place.calibration\", \"light\", \"unseen\")\n(\"place.calibration\", \"paragraph\", \"Three rulers can agree and still all be stretched. More readings help only when you know how the tools relate to what you are measuring.\")\n(\"place.calibration\", \"paragraph\", \"Move the measuring axis in the drawing. The same difference can be hidden from one direction and visible from another. This is a small example, separate from the larger research model.\")\n(\"place.calibration\", \"fullParagraph\", \"The hidden-plane example does not say that any collection of extra channels will reveal the answer. The ports must reach the relevant subspace, and their relationship to the system must be calibrated. More readings are useful only if you know what they are readings of.\")\n(\"place.calibration\", \"fullParagraph\", \"Imagine measuring a table with three rulers that all stretched in the same heat. Agreement would be reassuring. It would not supply the missing reference. This is an analogy for the question of access and calibration, not a further result of the finite model.\")\n(\"place.calibration\", \"fullParagraph\", \"Before asking what the system did, ask what the apparatus could distinguish. Which states would still look identical through these ports? A blank region on that map is a reason to design another measurement.\")\n(\"place.calibration\", \"word\", \"word.calibration\")\n(\"place.calibration\", \"pause\", \"What would remain invisible even if every reading agreed?\")\n(\"place.calibration\", \"instruction\", \"Move the slider. Watch how turning the measuring line changes the number.\")\n(\"place.calibration\", \"choice\", \"place.calibration.choice.0\")\n(\"place.calibration.choice.0\", \"destination\", \"place.instrument\")\n(\"place.calibration.choice.0\", \"label\", \"Return to the measuring tool\")\n(\"place.calibration.choice.0\", \"kind\", \"Follow the research\")\n(\"place.calibration\", \"choice\", \"place.calibration.choice.1\")\n(\"place.calibration.choice.1\", \"destination\", \"place.replay\")\n(\"place.calibration.choice.1\", \"label\", \"Let someone check the record\")\n(\"place.calibration.choice.1\", \"kind\", \"Follow the research\")\n(\"place.calibration\", \"choice\", \"place.calibration.choice.2\")\n(\"place.calibration.choice.2\", \"destination\", \"place.listening\")\n(\"place.calibration.choice.2\", \"label\", \"And when the instrument is a question?\")\n(\"place.calibration.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.replay\", \"isa\", \"Place\")\n(\"place.replay\", \"slug\", \"replay\")\n(\"place.replay\", \"route\", \"places/replay.html\")\n(\"place.replay\", \"title\", \"Can someone else check the result?\")\n(\"place.replay\", \"lead\", \"Keep enough of the method for someone else to check the result.\")\n(\"place.replay\", \"region\", \"The replay room\")\n(\"place.replay\", \"chapter\", \"11\")\n(\"place.replay\", \"source\", \"note.instrument\")\n(\"place.replay\", \"light\", \"unseen\")\n(\"place.replay\", \"paragraph\", \"A final number is hard to check on its own. The computer experiment also keeps its starting settings, several measurements and the results of comparison runs.\")\n(\"place.replay\", \"paragraph\", \"A separate checking program repeats the calculations from those saved settings. That checks the computer result. It does not replace a test with real equipment.\")\n(\"place.replay\", \"fullParagraph\", \"The four-mode virtual instrument retains more than a returned angle. Its record includes a complex return matrix, populations, loss, control work and the configuration that produced them. A separate verifier replays the saved configuration and checks those records.\")\n(\"place.replay\", \"fullParagraph\", \"The documented design crosses two model settings with four rates and three path controls: forward, reverse and fixed. Those comparisons make a more demanding question possible. Does the proposed effect survive the controls, and what changes when declared imperfections are included?\")\n(\"place.replay\", \"fullParagraph\", \"This room describes that recorded software experiment. It does not run it in your browser, and a successful numerical replay does not supply a physical apparatus. The next threshold remains an actual acquisition with its own calibration and uncertainties.\")\n(\"place.replay\", \"word\", \"word.replay\")\n(\"place.replay\", \"word\", \"word.control\")\n(\"place.replay\", \"pause\", \"What would another person need to discover that your result was wrong?\")\n(\"place.replay\", \"choice\", \"place.replay.choice.0\")\n(\"place.replay.choice.0\", \"destination\", \"place.monster\")\n(\"place.replay.choice.0\", \"label\", \"Ask a rival to disagree\")\n(\"place.replay.choice.0\", \"kind\", \"Follow the research\")\n(\"place.replay\", \"choice\", \"place.replay.choice.1\")\n(\"place.replay.choice.1\", \"destination\", \"place.representation\")\n(\"place.replay.choice.1\", \"label\", \"Keep the conditions attached\")\n(\"place.replay.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.replay\", \"choice\", \"place.replay.choice.2\")\n(\"place.replay.choice.2\", \"destination\", \"place.calibration\")\n(\"place.replay.choice.2\", \"label\", \"Check what the measuring tools can see\")\n(\"place.replay.choice.2\", \"kind\", \"Another way back\")\n(\"place.water\", \"isa\", \"Place\")\n(\"place.water\", \"slug\", \"water\")\n(\"place.water\", \"route\", \"places/water.html\")\n(\"place.water\", \"title\", \"The horse has a few questions.\")\n(\"place.water\", \"lead\", \"The guide offers a lesson. The horse has noticed something else.\")\n(\"place.water\", \"region\", \"The water’s edge\")\n(\"place.water\", \"chapter\", \"12\")\n(\"place.water\", \"source\", \"note.reflection\")\n(\"place.water\", \"light\", \"human\")\n(\"place.water\", \"paragraph\", \"The guide points at the water. The horse looks down. There is already a horse in there, and it seems to have strong opinions about the guide. Nobody mentioned a committee.\")\n(\"place.water\", \"paragraph\", \"Perhaps the next explanation can wait. What is the horse being invited into? The guide can look at the reflection too. You can read the little fable your own way—or just enjoy a horse declining a well-prepared presentation.\")\n(\"place.water\", \"fullParagraph\", \"The guide points at the water. The horse looks down. There is already a horse in there, and it appears to have strong opinions about the guide. Nobody mentioned a committee.\")\n(\"place.water\", \"fullParagraph\", \"Perhaps the next explanation can wait. In this little fable, the offered lesson has become an encounter with the person trying to offer it. The guide can inspect the water too. What looked like refusal might reveal something about the invitation.\")\n(\"place.water\", \"fullParagraph\", \"You are free to read the reflection differently—or simply enjoy a horse declining a very well-prepared presentation. The story has no access to your private reasons. It can offer a surface to look into, then leave you room to decide what you see.\")\n(\"place.water\", \"pause\", \"When you offer someone an answer, what else might they be encountering?\")\n(\"place.water\", \"choice\", \"place.water.choice.0\")\n(\"place.water.choice.0\", \"destination\", \"place.listening\")\n(\"place.water.choice.0\", \"label\", \"Put down the presentation\")\n(\"place.water.choice.0\", \"kind\", \"Reflective passage\")\n(\"place.water\", \"choice\", \"place.water.choice.1\")\n(\"place.water.choice.1\", \"destination\", \"place.discomfort\")\n(\"place.water.choice.1\", \"label\", \"Look at the inconvenient reflection\")\n(\"place.water.choice.1\", \"kind\", \"Reflective passage\")\n(\"place.water\", \"choice\", \"place.water.choice.2\")\n(\"place.water.choice.2\", \"destination\", \"place.care\")\n(\"place.water.choice.2\", \"label\", \"Sit by the water a while\")\n(\"place.water.choice.2\", \"kind\", \"Another way back\")\n(\"place.discomfort\", \"isa\", \"Place\")\n(\"place.discomfort\", \"slug\", \"discomfort\")\n(\"place.discomfort\", \"route\", \"places/discomfort.html\")\n(\"place.discomfort\", \"title\", \"Truth hurts. So can being wrong.\")\n(\"place.discomfort\", \"lead\", \"Feeling hurt does not tell us, by itself, which explanation is true.\")\n(\"place.discomfort\", \"region\", \"The inconvenient truth\")\n(\"place.discomfort\", \"chapter\", \"13\")\n(\"place.discomfort\", \"source\", \"note.reflection\")\n(\"place.discomfort\", \"light\", \"human\")\n(\"place.discomfort\", \"paragraph\", \"A fact can challenge an explanation we care about. So can a mistaken accusation. The discomfort alone cannot tell us which one we are facing.\")\n(\"place.discomfort\", \"paragraph\", \"Try separating what happened, what you think it means, and how it feels. Which part could you check with a source or a fresh question? You do not need to share a personal experience with this story.\")\n(\"place.discomfort\", \"fullParagraph\", \"Suppose a fact threatens an explanation you have worked hard to build. You can defend the explanation, discard it, or slow down enough to distinguish the record from what you have made it mean. None of those movements becomes correct simply because it feels difficult.\")\n(\"place.discomfort\", \"fullParagraph\", \"“Truth hurts” is Aaron’s originating phrase for this reflective territory. Here it becomes a question rather than a verdict. Discomfort might accompany an unwelcome fact, a mistaken accusation, an incomplete account, or the discovery that your own frame has become too small.\")\n(\"place.discomfort\", \"fullParagraph\", \"The invitation is to find a check outside the feeling: a source, a contrast case, a question you can ask again. You need not confess anything to the story. Carry the question privately, or leave it here.\")\n(\"place.discomfort\", \"pause\", \"Which part can you check without first deciding who was right?\")\n(\"place.discomfort\", \"choice\", \"place.discomfort.choice.0\")\n(\"place.discomfort.choice.0\", \"destination\", \"place.contact\")\n(\"place.discomfort.choice.0\", \"label\", \"See an explanation actually withdrawn\")\n(\"place.discomfort.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.discomfort\", \"choice\", \"place.discomfort.choice.1\")\n(\"place.discomfort.choice.1\", \"destination\", \"place.revision\")\n(\"place.discomfort.choice.1\", \"label\", \"Keep a way to change your mind\")\n(\"place.discomfort.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.discomfort\", \"choice\", \"place.discomfort.choice.2\")\n(\"place.discomfort.choice.2\", \"destination\", \"place.water\")\n(\"place.discomfort.choice.2\", \"label\", \"Visit the uncooperative horse\")\n(\"place.discomfort.choice.2\", \"kind\", \"Reflective passage\")\n(\"place.listening\", \"isa\", \"Place\")\n(\"place.listening\", \"slug\", \"listening\")\n(\"place.listening\", \"route\", \"places/listening.html\")\n(\"place.listening\", \"title\", \"What are they trying to do?\")\n(\"place.listening\", \"lead\", \"Before answering, ask what the other person is trying to do.\")\n(\"place.listening\", \"region\", \"The unasked question\")\n(\"place.listening\", \"chapter\", \"14\")\n(\"place.listening\", \"source\", \"note.contact\")\n(\"place.listening\", \"light\", \"human\")\n(\"place.listening\", \"paragraph\", \"Someone might be asking for a solution, testing an idea, telling you something difficult, or asking to be heard. A polished answer to a different request can still miss the point.\")\n(\"place.listening\", \"paragraph\", \"Try the conversation. You can choose another reply and see another possible response. It is a fictional example, not a test of your listening skills or a way to read someone’s mind.\")\n(\"place.listening\", \"fullParagraph\", \"In the recorded correction, the failure was more specific than an incorrect sentence. An earlier framework had captured a new inquiry. Shared conversation history was mistaken for continuity of subject. The response had stopped following the person who was speaking.\")\n(\"place.listening\", \"fullParagraph\", \"The successor inquiry proposes several alignments to examine: the subject, the speaker’s intention, the scale of the answer, the relevance of old context and the consequence of replying this way. These are candidate cues from a case, not a universal instrument for reading people.\")\n(\"place.listening\", \"fullParagraph\", \"Try the question on an ordinary encounter: is the person requesting a solution, testing an idea, telling you something, or asking to be heard? The answer remains theirs to correct. A useful first move can be an interpretation light enough to put down.\")\n(\"place.listening\", \"pause\", \"What would you ask if your favourite explanation were unavailable?\")\n(\"place.listening\", \"instruction\", \"Choose a reply, then read the possible response. You can try every reply.\")\n(\"place.listening\", \"choice\", \"place.listening.choice.0\")\n(\"place.listening.choice.0\", \"destination\", \"place.contact\")\n(\"place.listening.choice.0\", \"label\", \"Read the original mismatch\")\n(\"place.listening.choice.0\", \"kind\", \"Read a related account\")\n(\"place.listening\", \"choice\", \"place.listening.choice.1\")\n(\"place.listening.choice.1\", \"destination\", \"place.water\")\n(\"place.listening.choice.1\", \"label\", \"Hear from the horse\")\n(\"place.listening.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.listening\", \"choice\", \"place.listening.choice.2\")\n(\"place.listening.choice.2\", \"destination\", \"place.restraint\")\n(\"place.listening.choice.2\", \"label\", \"Leave room for an answer\")\n(\"place.listening.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.restraint\", \"isa\", \"Place\")\n(\"place.restraint\", \"slug\", \"restraint\")\n(\"place.restraint\", \"route\", \"places/restraint.html\")\n(\"place.restraint\", \"title\", \"Leaving room is still a choice.\")\n(\"place.restraint\", \"lead\", \"Holding back can give someone room. It can also leave someone exposed.\")\n(\"place.restraint\", \"region\", \"The open hand\")\n(\"place.restraint\", \"chapter\", \"15\")\n(\"place.restraint\", \"source\", \"note.kenosis\")\n(\"place.restraint\", \"light\", \"boundary\")\n(\"place.restraint\", \"paragraph\", \"The argument asks how power can help other people make real choices. Taking over every decision can remove the freedom we say we want to support.\")\n(\"place.restraint\", \"paragraph\", \"But holding back is not always helpful. If someone is taking away another person’s freedom, protection may be needed. Ask who gains room to act, and who is left carrying the cost.\")\n(\"place.restraint\", \"fullParagraph\", \"The kenotic argument treats power as something governed by love rather than exhausted by control. Making room for another agent is a positive commitment: their choices must be consequential enough to count as their own.\")\n(\"place.restraint\", \"fullParagraph\", \"That commitment is not an absolute rule against intervention. The same argument retains boundaries and responsibility for protection. If one agent is consuming another’s effective freedom, leaving the arrangement alone can preserve domination rather than make room for agency.\")\n(\"place.restraint\", \"fullParagraph\", \"This is a philosophical boundary to examine, not an instruction about your own situation. Ask whose room is growing, whose is shrinking, and what evidence would challenge the comfortable description of your choice.\")\n(\"place.restraint\", \"word\", \"word.agency\")\n(\"place.restraint\", \"word\", \"word.kenosis\")\n(\"place.restraint\", \"pause\", \"Whose freedom does this restraint make possible?\")\n(\"place.restraint\", \"choice\", \"place.restraint.choice.0\")\n(\"place.restraint.choice.0\", \"destination\", \"place.permission\")\n(\"place.restraint.choice.0\", \"label\", \"Distinguish three different questions\")\n(\"place.restraint.choice.0\", \"kind\", \"Conceptual connection\")\n(\"place.restraint\", \"choice\", \"place.restraint.choice.1\")\n(\"place.restraint.choice.1\", \"destination\", \"place.care\")\n(\"place.restraint.choice.1\", \"label\", \"Ask who carries the cost\")\n(\"place.restraint.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.restraint\", \"choice\", \"place.restraint.choice.2\")\n(\"place.restraint.choice.2\", \"destination\", \"place.kenosis\")\n(\"place.restraint.choice.2\", \"label\", \"Read the larger argument\")\n(\"place.restraint.choice.2\", \"kind\", \"Another way back\")\n(\"place.permission\", \"isa\", \"Place\")\n(\"place.permission\", \"slug\", \"permission\")\n(\"place.permission\", \"route\", \"places/permission.html\")\n(\"place.permission\", \"title\", \"I can. May I? Should I?\")\n(\"place.permission\", \"lead\", \"“Can I?”, “May I?” and “Should I?” are three different questions.\")\n(\"place.permission\", \"region\", \"Three doors\")\n(\"place.permission\", \"chapter\", \"16\")\n(\"place.permission\", \"source\", \"note.kenosis\")\n(\"place.permission\", \"light\", \"boundary\")\n(\"place.permission\", \"paragraph\", \"Being able to do something is about capability. Having permission is about who can authorize it. Deciding whether to do it also means considering the situation and its consequences.\")\n(\"place.permission\", \"paragraph\", \"Open the three doors. The example is a message that could change someone’s plans. No message is sent; the doors help you examine the decision.\")\n(\"place.permission\", \"fullParagraph\", \"Capability asks what an agent can bring about. Permission asks which actions are legitimate. Responsibility asks what the situation calls for among those possibilities. The kenotic synthesis separates these questions before developing its account of divine action.\")\n(\"place.permission\", \"fullParagraph\", \"The distinction also supplies an editorial question for machine delegation. A system may be able to generate a proposal, alter a record or carry out a plan. That ability alone cannot settle who should authorize the act or remain answerable for its consequences.\")\n(\"place.permission\", \"fullParagraph\", \"Notice where an interface makes these doors appear to be one door. A smooth path from suggestion to execution can conceal the moment at which another person’s judgment was needed. The design question is where to make that moment legible.\")\n(\"place.permission\", \"pause\", \"Which door have you been treating as if it opened the other two?\")\n(\"place.permission\", \"instruction\", \"Open each door. Each asks a different question about the same proposed action.\")\n(\"place.permission\", \"choice\", \"place.permission.choice.0\")\n(\"place.permission.choice.0\", \"destination\", \"place.sourcery\")\n(\"place.permission.choice.0\", \"label\", \"Take the question into a machine\")\n(\"place.permission.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.permission\", \"choice\", \"place.permission.choice.1\")\n(\"place.permission.choice.1\", \"destination\", \"place.representation\")\n(\"place.permission.choice.1\", \"label\", \"Inspect what the proposal carries\")\n(\"place.permission.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.permission\", \"choice\", \"place.permission.choice.2\")\n(\"place.permission.choice.2\", \"destination\", \"place.restraint\")\n(\"place.permission.choice.2\", \"label\", \"Return to the open hand\")\n(\"place.permission.choice.2\", \"kind\", \"Another way back\")\n(\"place.representation\", \"isa\", \"Place\")\n(\"place.representation\", \"slug\", \"representation\")\n(\"place.representation\", \"route\", \"places/representation.html\")\n(\"place.representation\", \"title\", \"Every map leaves something out.\")\n(\"place.representation\", \"lead\", \"A useful map leaves things out. We should be able to find out what.\")\n(\"place.representation\", \"region\", \"The mapmaker’s debt\")\n(\"place.representation\", \"chapter\", \"17\")\n(\"place.representation\", \"source\", \"note.sourcery\")\n(\"place.representation\", \"light\", \"boundary\")\n(\"place.representation\", \"paragraph\", \"A map makes some parts of the world easier to see. It also leaves out detail. A model, diagram or summary does the same.\")\n(\"place.representation\", \"paragraph\", \"Lift the layers of the map. Look for where the information came from, which assumptions it needs and what it cannot establish. A complete plan for an experiment does not prove that the experiment happened.\")\n(\"place.representation\", \"fullParagraph\", \"Programme algebra is a parallel representation of the corpus. Its declared purpose is to preserve structure, provenance and refused transformations in a compositional grammar. The prose sources retain their authority; a generated projection does not become an independently editable truth.\")\n(\"place.representation\", \"fullParagraph\", \"The source distinguishes several depths. Recording a document and its links is different from admitting a scientific transformation. A protocol can contain all required fields without the experiment ever having run. These differences need to survive the trip into a more convenient view.\")\n(\"place.representation\", \"fullParagraph\", \"Apply the same question to this expedition. A station is an authored reading, a passage is a proposed connection, and a field note describes its source and limit. Following a path does not prove the connection. This map owes you a way to see that distinction.\")\n(\"place.representation\", \"word\", \"word.representation\")\n(\"place.representation\", \"word\", \"word.assumption\")\n(\"place.representation\", \"pause\", \"What would become easier to misunderstand if this map looked authoritative?\")\n(\"place.representation\", \"instruction\", \"Open each layer to see what the map needs you to know.\")\n(\"place.representation\", \"choice\", \"place.representation.choice.0\")\n(\"place.representation.choice.0\", \"destination\", \"place.revision\")\n(\"place.representation.choice.0\", \"label\", \"Leave the correction visible\")\n(\"place.representation.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.representation\", \"choice\", \"place.representation.choice.1\")\n(\"place.representation.choice.1\", \"destination\", \"place.replay\")\n(\"place.representation.choice.1\", \"label\", \"Ask for the actual record\")\n(\"place.representation.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.representation\", \"choice\", \"place.representation.choice.2\")\n(\"place.representation.choice.2\", \"destination\", \"place.sourcery\")\n(\"place.representation.choice.2\", \"label\", \"Return to systems people can direct\")\n(\"place.representation.choice.2\", \"kind\", \"Another way back\")\n(\"place.representation\", \"choice\", \"place.representation.choice.3\")\n(\"place.representation.choice.3\", \"destination\", \"place.stone\")\n(\"place.representation.choice.3\", \"label\", \"Let an ordinary object open the map\")\n(\"place.representation.choice.3\", \"kind\", \"A path into the wider world\")\n(\"place.revision\", \"isa\", \"Place\")\n(\"place.revision\", \"slug\", \"revision\")\n(\"place.revision\", \"route\", \"places/revision.html\")\n(\"place.revision\", \"title\", \"Let the correction leave a seam.\")\n(\"place.revision\", \"lead\", \"When an explanation changes, leave a way to understand why.\")\n(\"place.revision\", \"region\", \"The visible seam\")\n(\"place.revision\", \"chapter\", \"18\")\n(\"place.revision\", \"source\", \"note.correction\")\n(\"place.revision\", \"light\", \"boundary\")\n(\"place.revision\", \"paragraph\", \"The collection keeps an earlier interpretation alongside the correction that withdrew it. That lets a reader see what went wrong and where the next inquiry began.\")\n(\"place.revision\", \"paragraph\", \"Open the correction. Keeping the change visible does not guarantee that every later claim is right. It gives someone else a better chance to question and check it.\")\n(\"place.revision\", \"fullParagraph\", \"The corpus retains the withdrawn cross-context interpretation as well as the inquiry that followed it. The predecessor imported physics into a different problem. Its withdrawal limits what readers should take from it; the successor begins again from the specific mismatch.\")\n(\"place.revision\", \"fullParagraph\", \"An immaculate story could smooth away that interruption. Keeping it visible makes another reading possible: the work did not become trustworthy by never losing contact. Here, a correction changed its direction. That is a particular retained event, not a guarantee about every later claim.\")\n(\"place.revision\", \"fullParagraph\", \"On returning to an earlier station, ask what you now read differently. The earlier scene has not secretly changed, and the site does not infer what you learned. The new perspective belongs to you. A route can finish with a more precise question.\")\n(\"place.revision\", \"pause\", \"What would you retain so a future reader could understand why you changed course?\")\n(\"place.revision\", \"instruction\", \"Open the correction to see why the earlier explanation was withdrawn.\")\n(\"place.revision\", \"choice\", \"place.revision.choice.0\")\n(\"place.revision.choice.0\", \"destination\", \"place.observation\")\n(\"place.revision.choice.0\", \"label\", \"Look at the first question again\")\n(\"place.revision.choice.0\", \"kind\", \"Another way back\")\n(\"place.revision\", \"choice\", \"place.revision.choice.1\")\n(\"place.revision.choice.1\", \"destination\", \"place.contact\")\n(\"place.revision.choice.1\", \"label\", \"Read the successor inquiry\")\n(\"place.revision.choice.1\", \"kind\", \"Read a related account\")\n(\"place.revision\", \"choice\", \"place.revision.choice.2\")\n(\"place.revision.choice.2\", \"destination\", \"place.discomfort\")\n(\"place.revision.choice.2\", \"label\", \"Stay with the discomfort\")\n(\"place.revision.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.workshop\", \"isa\", \"Place\")\n(\"place.workshop\", \"slug\", \"workshop\")\n(\"place.workshop\", \"route\", \"places/workshop.html\")\n(\"place.workshop\", \"title\", \"Can you follow a change?\")\n(\"place.workshop\", \"lead\", \"Change a title or label, then see exactly what follows.\")\n(\"place.workshop\", \"region\", \"The workshop\")\n(\"place.workshop\", \"chapter\", \"19\")\n(\"place.workshop\", \"source\", \"note.authorship\")\n(\"place.workshop\", \"light\", \"boundary\")\n(\"place.workshop\", \"paragraph\", \"One story appears in a menu, a row and a story page. Some words come from the same source. The menu also has its own label.\")\n(\"place.workshop\", \"paragraph\", \"Open the workshop and try changing each value. Watch which views change and which keep their wording. You can open the code if you want more detail. Your edits stay in that tab and reset when you reload.\")\n(\"place.workshop\", \"fullParagraph\", \"Start with a story called “What happened”. A web menu calls it “The story”; a row follows the original title. Change one of those values and see what follows—and what keeps its own wording.\")\n(\"place.workshop\", \"fullParagraph\", \"The living infographic opens the route from meaning to types, projections, contextual overlays, algebra and HTML. An edit returns to its declared source, then the checked process rebuilds and verifies the visible result.\")\n(\"place.workshop\", \"fullParagraph\", \"This is a small working example of a larger intention: remove unnecessary labour, preserve human authorship, and make the consequences understandable and the evidence inspectable. You can read its rules and source. General programme editing and a complete authoring environment remain future work.\")\n(\"place.workshop\", \"word\", \"word.source\")\n(\"place.workshop\", \"word\", \"word.projection\")\n(\"place.workshop\", \"word\", \"word.overlay\")\n(\"place.workshop\", \"experience\", \"{\\\"href\\\":\\\"workshop/index.html\\\",\\\"label\\\":\\\"Open the living infographic\\\",\\\"note\\\":\\\"Edit two real values. Inspect the source, algebra and generated HTML. Changes stay in your tab; reload to start again.\\\"}\")\n(\"place.workshop\", \"choice\", \"place.workshop.choice.0\")\n(\"place.workshop.choice.0\", \"destination\", \"place.sourcery\")\n(\"place.workshop.choice.0\", \"label\", \"What should the machine leave to us?\")\n(\"place.workshop.choice.0\", \"kind\", \"The product philosophy\")\n(\"place.workshop\", \"choice\", \"place.workshop.choice.1\")\n(\"place.workshop.choice.1\", \"destination\", \"place.contact\")\n(\"place.workshop.choice.1\", \"label\", \"What if a polished result misses the point?\")\n(\"place.workshop.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.workshop\", \"choice\", \"place.workshop.choice.2\")\n(\"place.workshop.choice.2\", \"destination\", \"place.care\")\n(\"place.workshop.choice.2\", \"label\", \"Who is this helping?\")\n(\"place.workshop.choice.2\", \"kind\", \"Another way back\")\n(\"place.workshop\", \"choice\", \"place.workshop.choice.3\")\n(\"place.workshop.choice.3\", \"destination\", \"place.commons\")\n(\"place.workshop.choice.3\", \"label\", \"Leave something another person can continue\")\n(\"place.workshop.choice.3\", \"kind\", \"A path into the wider world\")\n(\"place.possibility\", \"isa\", \"Place\")\n(\"place.possibility\", \"slug\", \"possibility\")\n(\"place.possibility\", \"route\", \"places/possibility.html\")\n(\"place.possibility\", \"title\", \"What can exist together?\")\n(\"place.possibility\", \"lead\", \"Some choices work together. Other combinations break a stated rule.\")\n(\"place.possibility\", \"region\", \"The garden\")\n(\"place.possibility\", \"chapter\", \"20\")\n(\"place.possibility\", \"source\", \"note.possibilities\")\n(\"place.possibility\", \"light\", \"unseen\")\n(\"place.possibility\", \"paragraph\", \"Start with a simple rule: the two numbers must add up to no more than four. Move the slider to change the limit. The lit pairs show which combinations meet it.\")\n(\"place.possibility\", \"paragraph\", \"The second view shows a small example from the mathematics of positive responses. Its formula is available if you want it. Neither view tells us which possible state will happen, or whether a real device can reach it.\")\n(\"place.possibility\", \"fullParagraph\", \"Begin with a small garden of states. Each state carries two quantities. Initially, the declared toy rule permits a total no greater than four. Change the rule and watch the available set change. Then try the positive-response view: the joint relation must also fit the two quantities that support it.\")\n(\"place.possibility\", \"fullParagraph\", \"The corpus starts its deeper explanation with admission and composition: which states, observables and responses can coexist positively on a declared carrier? Only after those conditions are specified does it ask how the admitted possibilities transform.\")\n(\"place.possibility\", \"fullParagraph\", \"Notice what the garden has not decided. A permitted state is not necessarily reachable from here, stable over time, preferred by anyone, or realized in the world. Keeping those questions apart makes room for a more exact next step.\")\n(\"place.possibility\", \"word\", \"word.admissibility\")\n(\"place.possibility\", \"word\", \"word.positive response\")\n(\"place.possibility\", \"pause\", \"What can exist together?\")\n(\"place.possibility\", \"instruction\", \"Move the slider to change the rule. Lit pairs meet the current rule. You can also try a second mathematical view.\")\n(\"place.possibility\", \"supplement\", \"note.frontier\")\n(\"place.possibility\", \"choice\", \"place.possibility.choice.0\")\n(\"place.possibility.choice.0\", \"destination\", \"place.reachable\")\n(\"place.possibility.choice.0\", \"label\", \"A path is another requirement\")\n(\"place.possibility.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.possibility\", \"choice\", \"place.possibility.choice.1\")\n(\"place.possibility.choice.1\", \"destination\", \"place.permission\")\n(\"place.possibility.choice.1\", \"label\", \"Who may choose?\")\n(\"place.possibility.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.possibility\", \"choice\", \"place.possibility.choice.2\")\n(\"place.possibility.choice.2\", \"destination\", \"place.tiling\")\n(\"place.possibility.choice.2\", \"label\", \"Let a pattern grow\")\n(\"place.possibility.choice.2\", \"kind\", \"Follow the research\")\n(\"place.reachable\", \"isa\", \"Place\")\n(\"place.reachable\", \"slug\", \"reachable\")\n(\"place.reachable\", \"route\", \"places/reachable.html\")\n(\"place.reachable\", \"title\", \"Possible. Permitted. Still out of reach.\")\n(\"place.reachable\", \"lead\", \"A place can be allowed and still have no available route from here.\")\n(\"place.reachable\", \"region\", \"The far gate\")\n(\"place.reachable\", \"chapter\", \"21\")\n(\"place.reachable\", \"source\", \"note.possibilities\")\n(\"place.reachable\", \"light\", \"unseen\")\n(\"place.reachable\", \"paragraph\", \"All three points in the drawing are allowed. At first, the available steps connect A to B, but not B to C. Add the missing step and C becomes reachable from A.\")\n(\"place.reachable\", \"paragraph\", \"The wider research makes this distinction carefully: being allowed, staying within the rules over time, and being reachable are different requirements. Drawing a desirable destination does not build the bridge.\")\n(\"place.reachable\", \"fullParagraph\", \"In the investigation framework, possibility, admissibility, viability and reachability are different regions. A state may satisfy the static constraints while no available sequence of controls can reach it from your starting point.\")\n(\"place.reachable\", \"fullParagraph\", \"A viable history must also remain within its conditions for the required duration. A beautiful endpoint drawn beyond a broken bridge does not supply the missing construction. Declaring a desired optimum cannot replace that bridge.\")\n(\"place.reachable\", \"fullParagraph\", \"The distinction travels usefully into making things. Name the start, the available actions, the constraints along the way and the evidence of arrival. That is an editorial use of the framework, not a proof that physical and human choices share one dynamics.\")\n(\"place.reachable\", \"word\", \"word.admissibility\")\n(\"place.reachable\", \"pause\", \"What can exist together?\")\n(\"place.reachable\", \"instruction\", \"Add the missing step. See which point you can reach from A.\")\n(\"place.reachable\", \"choice\", \"place.reachable.choice.0\")\n(\"place.reachable.choice.0\", \"destination\", \"place.possibility\")\n(\"place.reachable.choice.0\", \"label\", \"Look back at the allowed space\")\n(\"place.reachable.choice.0\", \"kind\", \"Another way back\")\n(\"place.reachable\", \"choice\", \"place.reachable.choice.1\")\n(\"place.reachable.choice.1\", \"destination\", \"place.laboratory\")\n(\"place.reachable.choice.1\", \"label\", \"Find a buildable next step\")\n(\"place.reachable.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.reachable\", \"choice\", \"place.reachable.choice.2\")\n(\"place.reachable.choice.2\", \"destination\", \"place.weights\")\n(\"place.reachable.choice.2\", \"label\", \"Ask what the destination is for\")\n(\"place.reachable.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.memory\", \"isa\", \"Place\")\n(\"place.memory\", \"slug\", \"memory\")\n(\"place.memory\", \"route\", \"places/memory.html\")\n(\"place.memory\", \"title\", \"Gone from the picture. Still in the motion.\")\n(\"place.memory\", \"lead\", \"Hiding part of a system does not necessarily stop it affecting the rest.\")\n(\"place.memory\", \"region\", \"The echo chamber\")\n(\"place.memory\", \"chapter\", \"22\")\n(\"place.memory\", \"source\", \"note.memory\")\n(\"place.memory\", \"light\", \"unseen\")\n(\"place.memory\", \"paragraph\", \"The example has two changing quantities that affect one another. Hide one line: the other line keeps the same path. Hiding the line changed the picture, not the calculation.\")\n(\"place.memory\", \"paragraph\", \"Now disconnect the link between them. This changes the calculation itself. The example helps explain how an unseen part can leave an effect over time. Some hidden parts leave no detectable effect; the next room explores that limit.\")\n(\"place.memory\", \"fullParagraph\", \"The finite linear result begins with visible and hidden coordinates that can affect one another. Solve out the hidden part and it can return as dependence on earlier visible states and on a hidden initial condition. The reduced equation remembers what its state list no longer displays.\")\n(\"place.memory\", \"fullParagraph\", \"The small instrument here integrates two coupled coordinates. You can hide one trace while the visible evolution still depends on both. Removing the coupling is a different intervention. These operations change different things.\")\n(\"place.memory\", \"fullParagraph\", \"This is a mathematical lesson with a boundary. Some hidden sectors are exactly invisible and dynamically decoupled from the record. Their absence does not force an accessible echo. The next room keeps that harder limit in view.\")\n(\"place.memory\", \"word\", \"word.model\")\n(\"place.memory\", \"word\", \"word.coupling\")\n(\"place.memory\", \"pause\", \"What remains when something disappears?\")\n(\"place.memory\", \"instruction\", \"First hide a line. Then disconnect the link. Compare what each action changes.\")\n(\"place.memory\", \"choice\", \"place.memory.choice.0\")\n(\"place.memory.choice.0\", \"destination\", \"place.erasure\")\n(\"place.memory.choice.0\", \"label\", \"What if no echo survives?\")\n(\"place.memory.choice.0\", \"kind\", \"Mathematical limit\")\n(\"place.memory\", \"choice\", \"place.memory.choice.1\")\n(\"place.memory.choice.1\", \"destination\", \"place.preservation\")\n(\"place.memory.choice.1\", \"label\", \"Follow a trace through time\")\n(\"place.memory.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.memory\", \"choice\", \"place.memory.choice.2\")\n(\"place.memory.choice.2\", \"destination\", \"place.return\")\n(\"place.memory.choice.2\", \"label\", \"Come back changed\")\n(\"place.memory.choice.2\", \"kind\", \"Related mathematical question\")\n(\"place.erasure\", \"isa\", \"Place\")\n(\"place.erasure\", \"slug\", \"erasure\")\n(\"place.erasure\", \"route\", \"places/erasure.html\")\n(\"place.erasure\", \"title\", \"A record can forget completely.\")\n(\"place.erasure\", \"lead\", \"Once a record leaves out a difference, that record may be unable to recover it.\")\n(\"place.erasure\", \"region\", \"The erased distinction\")\n(\"place.erasure\", \"chapter\", \"23\")\n(\"place.erasure\", \"source\", \"note.erasure\")\n(\"place.erasure\", \"light\", \"unseen\")\n(\"place.erasure\", \"paragraph\", \"The pairs 1 and 3, or 2 and 2, both add up to 4. If the only record is the sum, you cannot tell which pair it came from.\")\n(\"place.erasure\", \"paragraph\", \"Keep the first number as a second record and you can tell these pairs apart. That uses new information. It does not recover the answer from the sum alone.\")\n(\"place.erasure\", \"fullParagraph\", \"Take two labelled pairs: one and three, or two and two. A detector that keeps only their sum reports four for both. You cannot tell which pair occurred from that sum alone. Repeating the same arithmetic does not recover the missing label.\")\n(\"place.erasure\", \"fullParagraph\", \"Add a second record that retains the first coordinate and the pair becomes identifiable in this tiny declared family. You have enriched the record; you have not extracted the answer from the original sum.\")\n(\"place.erasure\", \"fullParagraph\", \"The corpus’s recovery boundary is strict: not every reduction leaves a recoverable remnant of everything it removes. A truthful account can finish by naming what the available theory cannot tell you. That limit is useful knowledge.\")\n(\"place.erasure\", \"word\", \"word.record\")\n(\"place.erasure\", \"pause\", \"What remains when something disappears?\")\n(\"place.erasure\", \"instruction\", \"Try both pairs. Then keep a second record and see what becomes clear.\")\n(\"place.erasure\", \"choice\", \"place.erasure.choice.0\")\n(\"place.erasure.choice.0\", \"destination\", \"place.memory\")\n(\"place.erasure.choice.0\", \"label\", \"Return to a surviving influence\")\n(\"place.erasure.choice.0\", \"kind\", \"Another way back\")\n(\"place.erasure\", \"choice\", \"place.erasure.choice.1\")\n(\"place.erasure.choice.1\", \"destination\", \"place.observation\")\n(\"place.erasure.choice.1\", \"label\", \"Ask the detector another question\")\n(\"place.erasure.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.erasure\", \"choice\", \"place.erasure.choice.2\")\n(\"place.erasure.choice.2\", \"destination\", \"place.closedpath\")\n(\"place.erasure.choice.2\", \"label\", \"Keep the limit on the map\")\n(\"place.erasure.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.attention\", \"isa\", \"Place\")\n(\"place.attention\", \"slug\", \"attention\")\n(\"place.attention\", \"route\", \"places/attention.html\")\n(\"place.attention\", \"title\", \"The same clearing. A different field of attention.\")\n(\"place.attention\", \"lead\", \"Looking closely at one thing can make its surroundings harder to notice.\")\n(\"place.attention\", \"region\", \"The living canopy\")\n(\"place.attention\", \"chapter\", \"24\")\n(\"place.attention\", \"source\", \"note.mind\")\n(\"place.attention\", \"light\", \"human\")\n(\"place.attention\", \"paragraph\", \"Try the two views of the clearing. One keeps several details visible. The other brings the leaf forward while the rest recedes.\")\n(\"place.attention\", \"paragraph\", \"This changes the drawing; it does not test your attention. The research separates noticing, choosing, awareness and action because explaining one does not automatically explain the others.\")\n(\"place.attention\", \"fullParagraph\", \"Change the canopy’s view. In one setting, one cluster is sharply available and the rest recedes. In another, the wider arrangement becomes legible. The illustration changes presentation; it does not measure your attention or assign you a type.\")\n(\"place.attention\", \"fullParagraph\", \"The functional atlas distinguishes readiness, sustained processing, vigilance, selective focus and divided allocation. It also separates these from conscious access, action and the experience of agency. A familiar word can compress several different operations.\")\n(\"place.attention\", \"fullParagraph\", \"The useful question is which transition is being explained, on which evidence, and what rival account remains. A diagram of a distributed system cannot by itself tell us what experience is. That unresolved join belongs in the clearing too.\")\n(\"place.attention\", \"word\", \"word.conscious access\")\n(\"place.attention\", \"pause\", \"What comes into attention?\")\n(\"place.attention\", \"instruction\", \"Try the broad view and the close view. Notice what each brings forward.\")\n(\"place.attention\", \"choice\", \"place.attention.choice.0\")\n(\"place.attention.choice.0\", \"destination\", \"place.will\")\n(\"place.attention.choice.0\", \"label\", \"Follow an intention toward action\")\n(\"place.attention.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.attention\", \"choice\", \"place.attention.choice.1\")\n(\"place.attention.choice.1\", \"destination\", \"place.listening\")\n(\"place.attention.choice.1\", \"label\", \"Turn toward another person\")\n(\"place.attention.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.attention\", \"choice\", \"place.attention.choice.2\")\n(\"place.attention.choice.2\", \"destination\", \"place.stone\")\n(\"place.attention.choice.2\", \"label\", \"Look closely at an ordinary thing\")\n(\"place.attention.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.will\", \"isa\", \"Place\")\n(\"place.will\", \"slug\", \"will\")\n(\"place.will\", \"route\", \"places/will.html\")\n(\"place.will\", \"title\", \"An intention is not yet an action.\")\n(\"place.will\", \"lead\", \"Choosing to act and carrying out an action are different parts of a story.\")\n(\"place.will\", \"region\", \"The unfinished intention\")\n(\"place.will\", \"chapter\", \"25\")\n(\"place.will\", \"source\", \"note.relations\")\n(\"place.will\", \"light\", \"human\")\n(\"place.will\", \"paragraph\", \"Open the links between getting ready, choosing, acting and receiving feedback. Each link raises a question about what connects the steps.\")\n(\"place.will\", \"paragraph\", \"A neat diagram can hide a gap in our understanding. The research marks uncertain or missing connections instead of treating every arrow as an established explanation of the brain.\")\n(\"place.will\", \"fullParagraph\", \"The relationship-first atlas treats connections as conditional objects. A relation names its source, target, needed inputs, evidence and limits. A possible sequence on paper is not proof that every link is present in a particular biological system.\")\n(\"place.will\", \"fullParagraph\", \"In this small sequence, readiness, selection, action and feedback each have a role. Open a join to see the question it carries. There is no score for how your own life follows the diagram; the display makes no observation of you.\")\n(\"place.will\", \"fullParagraph\", \"Negative and unknown relations matter as much as proposed positive ones. They prevent a smooth drawing from claiming a completed explanation. Asking where a process stops being understood can be a way of taking agency seriously.\")\n(\"place.will\", \"word\", \"word.feedback\")\n(\"place.will\", \"word\", \"word.agency\")\n(\"place.will\", \"pause\", \"What comes into attention?\")\n(\"place.will\", \"instruction\", \"Open each link to see what would be needed to explain it.\")\n(\"place.will\", \"choice\", \"place.will.choice.0\")\n(\"place.will.choice.0\", \"destination\", \"place.attention\")\n(\"place.will.choice.0\", \"label\", \"Return to the canopy\")\n(\"place.will.choice.0\", \"kind\", \"Another way back\")\n(\"place.will\", \"choice\", \"place.will.choice.1\")\n(\"place.will.choice.1\", \"destination\", \"place.coexistence\")\n(\"place.will.choice.1\", \"label\", \"Let intentions meet constraints\")\n(\"place.will.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.will\", \"choice\", \"place.will.choice.2\")\n(\"place.will.choice.2\", \"destination\", \"place.commons\")\n(\"place.will.choice.2\", \"label\", \"Invite another account\")\n(\"place.will.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.stone\", \"isa\", \"Place\")\n(\"place.stone\", \"slug\", \"stone\")\n(\"place.stone\", \"route\", \"places/stone.html\")\n(\"place.stone\", \"title\", \"One stone. Many histories.\")\n(\"place.stone\", \"lead\", \"A stone can tell several stories, and each needs a different kind of evidence.\")\n(\"place.stone\", \"region\", \"The house of stone\")\n(\"place.stone\", \"chapter\", \"26\")\n(\"place.stone\", \"source\", \"note.material\")\n(\"place.stone\", \"light\", \"human\")\n(\"place.stone\", \"paragraph\", \"Its minerals can help identify the material. Marks may help us ask how it was worked. Its location and surroundings can help us place it in a history.\")\n(\"place.stone\", \"paragraph\", \"Try those three views. The drawing is not a measured sample. It introduces a research approach that uses the pyramids to connect materials, making, preservation and historical evidence.\")\n(\"place.stone\", \"fullParagraph\", \"A stone in a monument is material, worked object and surviving record. Mineral assemblage, fracture, abrasion, transport, assembly and exposure constrain different parts of its history. None of those views is sufficient simply because it is detailed.\")\n(\"place.stone\", \"fullParagraph\", \"The material-history programme uses the pyramids as its named entry. It asks what sequences of selection, working, movement and preservation could leave the observed traces. Its register proposes research joins; it does not settle a monument’s history by drawing an attractive physical analogy.\")\n(\"place.stone\", \"fullParagraph\", \"The stone here is an illustration, not a measured sample. Move among its lenses: composition, working and context. Notice the different evidence each would need. A good question can cross scales without pretending to calculate an entire pyramid from first principles.\")\n(\"place.stone\", \"word\", \"word.provenance\")\n(\"place.stone\", \"pause\", \"How did this come to be here?\")\n(\"place.stone\", \"instruction\", \"Choose a view of the stone. Each asks for a different kind of evidence.\")\n(\"place.stone\", \"choice\", \"place.stone.choice.0\")\n(\"place.stone.choice.0\", \"destination\", \"place.preservation\")\n(\"place.stone.choice.0\", \"label\", \"Ask why this trace survived\")\n(\"place.stone.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.stone\", \"choice\", \"place.stone.choice.1\")\n(\"place.stone.choice.1\", \"destination\", \"place.tiling\")\n(\"place.stone.choice.1\", \"label\", \"Walk toward the patterned wall\")\n(\"place.stone.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.stone\", \"choice\", \"place.stone.choice.2\")\n(\"place.stone.choice.2\", \"destination\", \"place.laboratory\")\n(\"place.stone.choice.2\", \"label\", \"Bring an instrument to the question\")\n(\"place.stone.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.preservation\", \"isa\", \"Place\")\n(\"place.preservation\", \"slug\", \"preservation\")\n(\"place.preservation\", \"route\", \"places/preservation.html\")\n(\"place.preservation\", \"title\", \"What survives is not everything that happened.\")\n(\"place.preservation\", \"lead\", \"The evidence left today is only part of what happened.\")\n(\"place.preservation\", \"region\", \"The surviving trace\")\n(\"place.preservation\", \"chapter\", \"27\")\n(\"place.preservation\", \"source\", \"note.material\")\n(\"place.preservation\", \"light\", \"human\")\n(\"place.preservation\", \"paragraph\", \"A mark may be absent because a process never happened, because the mark was damaged later, or because the measuring tool missed it.\")\n(\"place.preservation\", \"paragraph\", \"Choose an explanation to see what it would need. Weathering, burial and later care can all change which traces survive. A claim about the past needs to account for those changes too.\")\n(\"place.preservation\", \"fullParagraph\", \"Exposure, burial, salts, disturbance and conservation can change which traces remain available. A missing mark may reflect an absent process, later loss, or a detector that cannot resolve it. Those explanations require different checks.\")\n(\"place.preservation\", \"fullParagraph\", \"The material-history programme therefore places preservation between transformation and present observation. An explanation should predict both the proposed working process and the distribution of evidence that could survive it.\")\n(\"place.preservation\", \"fullParagraph\", \"Try the record layers on the illustrative stone. The labels are questions for an investigation, not reconstructions of an actual sampled object. Holding that distinction lets curiosity remain generous while claims stay bounded.\")\n(\"place.preservation\", \"word\", \"word.preservation\")\n(\"place.preservation\", \"pause\", \"How did this come to be here?\")\n(\"place.preservation\", \"instruction\", \"Choose a reason a trace might be missing. Read what would need checking.\")\n(\"place.preservation\", \"choice\", \"place.preservation.choice.0\")\n(\"place.preservation.choice.0\", \"destination\", \"place.stone\")\n(\"place.preservation.choice.0\", \"label\", \"Return to the object\")\n(\"place.preservation.choice.0\", \"kind\", \"Another way back\")\n(\"place.preservation\", \"choice\", \"place.preservation.choice.1\")\n(\"place.preservation.choice.1\", \"destination\", \"place.erasure\")\n(\"place.preservation.choice.1\", \"label\", \"Ask what the record cannot recover\")\n(\"place.preservation.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.preservation\", \"choice\", \"place.preservation.choice.2\")\n(\"place.preservation.choice.2\", \"destination\", \"place.texts\")\n(\"place.preservation.choice.2\", \"label\", \"Enter the reading room\")\n(\"place.preservation.choice.2\", \"kind\", \"Optional historical crossing\")\n(\"place.tiling\", \"isa\", \"Place\")\n(\"place.tiling\", \"slug\", \"tiling\")\n(\"place.tiling\", \"route\", \"places/tiling.html\")\n(\"place.tiling\", \"title\", \"Grow a pattern. Keep count.\")\n(\"place.tiling\", \"lead\", \"A precise counting rule can connect patterns without making them the same thing.\")\n(\"place.tiling\", \"region\", \"The patterned wall\")\n(\"place.tiling\", \"chapter\", \"28\")\n(\"place.tiling\", \"source\", \"note.patterns\")\n(\"place.tiling\", \"light\", \"unseen\")\n(\"place.tiling\", \"paragraph\", \"Begin with the pair 1, 1. Each press applies the same rule: the first new number is twice the first old number plus the second; the second new number is the sum of the old pair.\")\n(\"place.tiling\", \"paragraph\", \"The research connects this rule to particular tiling patterns through several mathematical steps. The ornament here is decorative. The counter shows the exact small calculation.\")\n(\"place.tiling\", \"fullParagraph\", \"Start with the pair one, one. The declared action sends a pair to two times the first plus the second, and then the first plus the second. Each press applies the same integer matrix. Its counts grow while a precise relation remains available to inspect.\")\n(\"place.tiling\", \"fullParagraph\", \"The source connects this two-state Fibonacci/Penrose action to a particular girih count construction through a quotient, normalization and lattice embedding. Those intermediate operations carry the evidence. Sharing a golden number would not supply them.\")\n(\"place.tiling\", \"fullParagraph\", \"The rosette is decorative geometry, not a reconstruction of the historical artwork. The counter is the exact small calculation. Keeping ornament and result distinct allows both to be enjoyed on their own terms.\")\n(\"place.tiling\", \"word\", \"word.transformation\")\n(\"place.tiling\", \"word\", \"word.carrier\")\n(\"place.tiling\", \"pause\", \"What changes while the pattern holds?\")\n(\"place.tiling\", \"instruction\", \"Apply the rule one step at a time. Watch the two numbers. Reset to begin again.\")\n(\"place.tiling\", \"choice\", \"place.tiling.choice.0\")\n(\"place.tiling.choice.0\", \"destination\", \"place.code\")\n(\"place.tiling.choice.0\", \"label\", \"Ask what a pattern can repair\")\n(\"place.tiling.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.tiling\", \"choice\", \"place.tiling.choice.1\")\n(\"place.tiling.choice.1\", \"destination\", \"place.stone\")\n(\"place.tiling.choice.1\", \"label\", \"Return to its material setting\")\n(\"place.tiling.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.tiling\", \"choice\", \"place.tiling.choice.2\")\n(\"place.tiling.choice.2\", \"destination\", \"place.monster\")\n(\"place.tiling.choice.2\", \"label\", \"Visit the exceptional cabinet\")\n(\"place.tiling.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.code\", \"isa\", \"Place\")\n(\"place.code\", \"slug\", \"code\")\n(\"place.code\", \"route\", \"places/code.html\")\n(\"place.code\", \"title\", \"Can a message survive a mistake?\")\n(\"place.code\", \"lead\", \"Repeating a message can help repair a mistake, within a known limit.\")\n(\"place.code\", \"region\", \"The repair bench\")\n(\"place.code\", \"chapter\", \"29\")\n(\"place.code\", \"source\", \"note.codes\")\n(\"place.code\", \"light\", \"unseen\")\n(\"place.code\", \"paragraph\", \"To send zero, use 000. To send one, use 111. The reader of the message chooses whichever bit appears most often.\")\n(\"place.code\", \"paragraph\", \"Choose a starting bit, then flip one transmitted bit. The original is recovered. Flip two and the answer changes to the wrong original. This small example is different from the larger error-correcting code discussed in the research.\")\n(\"place.code\", \"fullParagraph\", \"This bench uses a deliberately small repetition code. The bit zero is represented by three zeros, and one by three ones. A majority decoder repairs one flipped bit. With two flips it confidently returns the wrong original bit.\")\n(\"place.code\", \"fullParagraph\", \"That is the whole declared example. It explains why redundancy, allowed words, distance and error assumptions matter. It is not the ternary Golay code studied in the source, and it supplies no bridge from a code to a physical or biological mechanism.\")\n(\"place.code\", \"fullParagraph\", \"The source’s arithmetic audit also retains an obstruction: a proposed intrinsic ordering does not follow from the named symmetry. A successful calculation and a failed promotion can live together in the same workshop.\")\n(\"place.code\", \"word\", \"word.code\")\n(\"place.code\", \"word\", \"word.bit\")\n(\"place.code\", \"pause\", \"What changes while the pattern holds?\")\n(\"place.code\", \"instruction\", \"Choose a starting bit: zero or one. Flip one of the three bits, then a second. Watch the decoded answer.\")\n(\"place.code\", \"choice\", \"place.code.choice.0\")\n(\"place.code.choice.0\", \"destination\", \"place.tiling\")\n(\"place.code.choice.0\", \"label\", \"Return to the transformation\")\n(\"place.code.choice.0\", \"kind\", \"Another way back\")\n(\"place.code\", \"choice\", \"place.code.choice.1\")\n(\"place.code.choice.1\", \"destination\", \"place.closedpath\")\n(\"place.code.choice.1\", \"label\", \"See why a proposed step failed\")\n(\"place.code.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.code\", \"choice\", \"place.code.choice.2\")\n(\"place.code.choice.2\", \"destination\", \"place.representation\")\n(\"place.code.choice.2\", \"label\", \"Lift the surface of a model\")\n(\"place.code.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.laboratory\", \"isa\", \"Place\")\n(\"place.laboratory\", \"slug\", \"laboratory\")\n(\"place.laboratory\", \"route\", \"places/laboratory.html\")\n(\"place.laboratory\", \"title\", \"How could we tell the explanations apart?\")\n(\"place.laboratory\", \"lead\", \"Choose a measurement that could tell competing explanations apart.\")\n(\"place.laboratory\", \"region\", \"The working laboratory\")\n(\"place.laboratory\", \"chapter\", \"30\")\n(\"place.laboratory\", \"source\", \"note.laboratory\")\n(\"place.laboratory\", \"light\", \"unseen\")\n(\"place.laboratory\", \"paragraph\", \"Two explanations may agree on one reading and disagree on another. A timing reference, a reversed path or a different waiting time can help reveal the difference.\")\n(\"place.laboratory\", \"paragraph\", \"Choose a check at the bench. These are proposed ways to test ideas, not measurements being collected here. Better tools can be useful even when the result agrees with existing physics.\")\n(\"place.laboratory\", \"fullParagraph\", \"The finesse pathway proposes controlled carriers, coherent transformations, independent references, multichannel records and adversarial inference. Its practical value is not conditional on discovering an anomaly. Better sensing and clearer mechanism identification can remain useful conventional results.\")\n(\"place.laboratory\", \"fullParagraph\", \"Choose a bench question. A reversible path, an added phase reference or a changed waiting time can expose different collisions between explanations. The proposed controls do not all answer the same question, and none is a substitute for a calibrated apparatus.\")\n(\"place.laboratory\", \"fullParagraph\", \"This is a design encounter. No acquisition runs behind the glass. The next evidence would include the physical carrier, nuisance envelope, raw records and a decision rule fixed before opening the result.\")\n(\"place.laboratory\", \"word\", \"word.control\")\n(\"place.laboratory\", \"word\", \"word.phase\")\n(\"place.laboratory\", \"pause\", \"What would make the explanations disagree?\")\n(\"place.laboratory\", \"instruction\", \"Choose a comparison to see which difference it could reveal.\")\n(\"place.laboratory\", \"choice\", \"place.laboratory.choice.0\")\n(\"place.laboratory.choice.0\", \"destination\", \"place.cost\")\n(\"place.laboratory.choice.0\", \"label\", \"Ask what the control costs\")\n(\"place.laboratory.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.laboratory\", \"choice\", \"place.laboratory.choice.1\")\n(\"place.laboratory.choice.1\", \"destination\", \"place.cosmos\")\n(\"place.laboratory.choice.1\", \"label\", \"Walk toward the observatories\")\n(\"place.laboratory.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.laboratory\", \"choice\", \"place.laboratory.choice.2\")\n(\"place.laboratory.choice.2\", \"destination\", \"place.replay\")\n(\"place.laboratory.choice.2\", \"label\", \"Keep the record inspectable\")\n(\"place.laboratory.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.cost\", \"isa\", \"Place\")\n(\"place.cost\", \"slug\", \"cost\")\n(\"place.cost\", \"route\", \"places/cost.html\")\n(\"place.cost\", \"title\", \"Slower can cost more.\")\n(\"place.cost\", \"lead\", \"Improving one part of a result can make another part worse.\")\n(\"place.cost\", \"region\", \"The control ledger\")\n(\"place.cost\", \"chapter\", \"31\")\n(\"place.cost\", \"source\", \"note.instrument\")\n(\"place.cost\", \"light\", \"unseen\")\n(\"place.cost\", \"paragraph\", \"In the reported computer experiment, slower movement reduces one kind of error but allows more of the signal to fade away. The best overall return among the four tested settings occurs at an intermediate speed.\")\n(\"place.cost\", \"paragraph\", \"Choose a setting and compare both numbers. These are saved results from that computer model. They are not measurements from a physical device or a best setting for every device.\")\n(\"place.cost\", \"fullParagraph\", \"The documented four-mode numerical experiment compares several loop rates. In its metered example, slowing the loop suppresses bright leakage while accumulated dissipation rises. The raw target overlap peaks at one of the tested intermediate rates.\")\n(\"place.cost\", \"fullParagraph\", \"The rate cards show reported values from that software record. They are not new browser measurements or a universal optimum for real devices. A survival-conditioned view and the raw return answer different questions; the lost part must not disappear from the account.\")\n(\"place.cost\", \"fullParagraph\", \"The wider frontier asks for work, heat, precision, preparation, sampling and verification costs as well as a desired state. What would count as success if every impressive result quietly discarded its expense?\")\n(\"place.cost\", \"word\", \"word.model\")\n(\"place.cost\", \"pause\", \"What would make the explanations disagree?\")\n(\"place.cost\", \"instruction\", \"Choose a setting. A larger number means a slower loop here. Compare how much signal returns with how much is lost.\")\n(\"place.cost\", \"choice\", \"place.cost.choice.0\")\n(\"place.cost.choice.0\", \"destination\", \"place.laboratory\")\n(\"place.cost.choice.0\", \"label\", \"Return to the bench\")\n(\"place.cost.choice.0\", \"kind\", \"Another way back\")\n(\"place.cost\", \"choice\", \"place.cost.choice.1\")\n(\"place.cost.choice.1\", \"destination\", \"place.weights\")\n(\"place.cost.choice.1\", \"label\", \"Ask who owns the tradeoff\")\n(\"place.cost.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.cost\", \"choice\", \"place.cost.choice.2\")\n(\"place.cost.choice.2\", \"destination\", \"place.scale\")\n(\"place.cost.choice.2\", \"label\", \"Change the scale of the account\")\n(\"place.cost.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.cosmos\", \"isa\", \"Place\")\n(\"place.cosmos\", \"slug\", \"cosmos\")\n(\"place.cosmos\", \"route\", \"places/cosmos.html\")\n(\"place.cosmos\", \"title\", \"A larger sky. An unfinished explanation.\")\n(\"place.cosmos\", \"lead\", \"A big question becomes more useful when we can name what is still missing.\")\n(\"place.cosmos\", \"region\", \"The unfinished observatory\")\n(\"place.cosmos\", \"chapter\", \"32\")\n(\"place.cosmos\", \"source\", \"note.cosmos\")\n(\"place.cosmos\", \"light\", \"unseen\")\n(\"place.cosmos\", \"paragraph\", \"Choose a window into gravity, particles or cosmic history. Each shows a different piece of work needed before the explanation can go further.\")\n(\"place.cosmos\", \"paragraph\", \"The sky is an illustration. These are open research questions, not discoveries already made. They can still help someone choose a calculation or observation worth trying.\")\n(\"place.cosmos\", \"fullParagraph\", \"The target map includes gravity and torsion, flavour and neutrino structure, joined cosmological likelihoods and continuum control. Each carries a different missing obligation. A shared word or symmetry cannot fill all of them.\")\n(\"place.cosmos\", \"fullParagraph\", \"Open a window to see the named gate. A gravity route may need new coefficient-selection structure; a cosmological claim needs one model with common parameters across different observations. The map records these boundaries rather than offering a simulated sky as their evidence.\")\n(\"place.cosmos\", \"fullParagraph\", \"An unfinished observatory can still be useful. It can tell us which calculation, observation or independent check would make a proposal more identifying—and which previously exhausted route should not be repeated without a new datum.\")\n(\"place.cosmos\", \"word\", \"word.cosmology\")\n(\"place.cosmos\", \"word\", \"word.model\")\n(\"place.cosmos\", \"pause\", \"How far does this explanation reach?\")\n(\"place.cosmos\", \"instruction\", \"Choose a research question. Read what would still be needed to answer it.\")\n(\"place.cosmos\", \"choice\", \"place.cosmos.choice.0\")\n(\"place.cosmos.choice.0\", \"destination\", \"place.scale\")\n(\"place.cosmos.choice.0\", \"label\", \"Look between the scales\")\n(\"place.cosmos.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.cosmos\", \"choice\", \"place.cosmos.choice.1\")\n(\"place.cosmos.choice.1\", \"destination\", \"place.laboratory\")\n(\"place.cosmos.choice.1\", \"label\", \"Return to a measurable question\")\n(\"place.cosmos.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.cosmos\", \"choice\", \"place.cosmos.choice.2\")\n(\"place.cosmos.choice.2\", \"destination\", \"place.hiddenness\")\n(\"place.cosmos.choice.2\", \"label\", \"Enter an optional reading\")\n(\"place.cosmos.choice.2\", \"kind\", \"Optional theological crossing\")\n(\"place.scale\", \"isa\", \"Place\")\n(\"place.scale\", \"slug\", \"scale\")\n(\"place.scale\", \"route\", \"places/scale.html\")\n(\"place.scale\", \"title\", \"Zoom out. What disappears?\")\n(\"place.scale\", \"lead\", \"A wider view can keep the total while losing where the parts were.\")\n(\"place.scale\", \"region\", \"The changing scale\")\n(\"place.scale\", \"chapter\", \"33\")\n(\"place.scale\", \"source\", \"note.costs\")\n(\"place.scale\", \"light\", \"unseen\")\n(\"place.scale\", \"paragraph\", \"The small grid has eight filled cells. Group them into larger blocks. The total stays eight, but the view no longer shows the arrangement inside each block.\")\n(\"place.scale\", \"paragraph\", \"A summary can be useful without preserving every detail. The research asks a harder question: which rules and measurements remain reliable when the scale changes? The grid is an example of information loss, not a proof about physics.\")\n(\"place.scale\", \"fullParagraph\", \"The illustration groups a fixed set of small cells into larger blocks. Totals remain available while the arrangement within each block is hidden. The view changes resolution; the underlying small pattern does not magically reorganize itself.\")\n(\"place.scale\", \"fullParagraph\", \"The research programme asks a harder version: whether admissibility, dynamics and identifying records remain consistent across declared scale maps. A finite calculation does not supply a regulator-, volume- or time-uniform theorem.\")\n(\"place.scale\", \"fullParagraph\", \"Follow the same quantity across the views. Then name one distinction you can no longer recover. A macro description can be useful without retaining every microscopic answer.\")\n(\"place.scale\", \"word\", \"word.coarse-graining\")\n(\"place.scale\", \"pause\", \"How far does this explanation reach?\")\n(\"place.scale\", \"instruction\", \"Combine the cells into bigger blocks. Look for what stays the same and what disappears.\")\n(\"place.scale\", \"choice\", \"place.scale.choice.0\")\n(\"place.scale.choice.0\", \"destination\", \"place.cosmos\")\n(\"place.scale.choice.0\", \"label\", \"Return to the larger claim\")\n(\"place.scale.choice.0\", \"kind\", \"Another way back\")\n(\"place.scale\", \"choice\", \"place.scale.choice.1\")\n(\"place.scale.choice.1\", \"destination\", \"place.erasure\")\n(\"place.scale.choice.1\", \"label\", \"Inspect the discarded distinction\")\n(\"place.scale.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.scale\", \"choice\", \"place.scale.choice.2\")\n(\"place.scale.choice.2\", \"destination\", \"place.attention\")\n(\"place.scale.choice.2\", \"label\", \"Change another kind of view\")\n(\"place.scale.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.coexistence\", \"isa\", \"Place\")\n(\"place.coexistence\", \"slug\", \"coexistence\")\n(\"place.coexistence\", \"route\", \"places/coexistence.html\")\n(\"place.coexistence\", \"title\", \"What changes when time is short?\")\n(\"place.coexistence\", \"lead\", \"Waiting has different costs when needs are more urgent.\")\n(\"place.coexistence\", \"region\", \"The crossing of paths\")\n(\"place.coexistence\", \"chapter\", \"34\")\n(\"place.coexistence\", \"source\", \"note.scenarios\")\n(\"place.coexistence\", \"light\", \"boundary\")\n(\"place.coexistence\", \"paragraph\", \"An earlier Worldwright project used an invented computer model to compare responses to a shared problem. In its reported tests, the overall ranking changed when the model’s urgency changed.\")\n(\"place.coexistence\", \"paragraph\", \"Open each part of the result. Every tested case still involved tradeoffs. The model has not been shown to predict real communities, so its rankings do not tell us what people should do.\")\n(\"place.coexistence\", \"fullParagraph\", \"The older Worldwright research programme studies authored synthetic interventions. Its landscape reports a conditional finding: with delivery failures disabled, the lower-urgency cells favor mediation in an aggregate diagnostic, while the higher-urgency cells favor immediate visible action.\")\n(\"place.coexistence\", \"fullParagraph\", \"The same source retains Pareto tradeoffs in every cell. A winning aggregate does not mean every coordinate improves. The mechanisms and their real-world calibration remain unidentified, so these results do not authorize humanitarian policy or explain a person’s circumstances.\")\n(\"place.coexistence\", \"fullParagraph\", \"Choose which part of the reported model result to inspect. The encounter changes the reading of an existing synthetic record; it does not rerun the model or tell you what a real community should do.\")\n(\"place.coexistence\", \"word\", \"word.synthetic model\")\n(\"place.coexistence\", \"word\", \"word.Pareto tradeoff\")\n(\"place.coexistence\", \"pause\", \"Who lives with the consequences?\")\n(\"place.coexistence\", \"instruction\", \"Open each part of the computer result. Keep its limits beside its ranking.\")\n(\"place.coexistence\", \"choice\", \"place.coexistence.choice.0\")\n(\"place.coexistence.choice.0\", \"destination\", \"place.weights\")\n(\"place.coexistence.choice.0\", \"label\", \"See how the overall score is made\")\n(\"place.coexistence.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.coexistence\", \"choice\", \"place.coexistence.choice.1\")\n(\"place.coexistence.choice.1\", \"destination\", \"place.care\")\n(\"place.coexistence.choice.1\", \"label\", \"Return to particular needs\")\n(\"place.coexistence.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.coexistence\", \"choice\", \"place.coexistence.choice.2\")\n(\"place.coexistence.choice.2\", \"destination\", \"place.commons\")\n(\"place.coexistence.choice.2\", \"label\", \"Keep the uncertainty available\")\n(\"place.coexistence.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.weights\", \"isa\", \"Place\")\n(\"place.weights\", \"slug\", \"weights\")\n(\"place.weights\", \"route\", \"places/weights.html\")\n(\"place.weights\", \"title\", \"Who decides what matters?\")\n(\"place.weights\", \"lead\", \"A score can change when we change what matters most.\")\n(\"place.weights\", \"region\", \"The weight of a choice\")\n(\"place.weights\", \"chapter\", \"35\")\n(\"place.weights\", \"source\", \"note.scenarios\")\n(\"place.weights\", \"light\", \"boundary\")\n(\"place.weights\", \"paragraph\", \"Imagine two plans. In this made-up example, A scores 8 for speed and 2 for thoroughness. B has the opposite scores. Move the slider to change how much speed should count.\")\n(\"place.weights\", \"paragraph\", \"The options stay the same while their ranking changes. The numbers are invented and describe no people. The example makes one question visible: who chose what the score should value?\")\n(\"place.weights\", \"fullParagraph\", \"Two toy options sit on this desk. One has more of the first quantity and less of the second; the other reverses that arrangement. Move the declared weight and watch the arithmetic ranking change. Neither option has changed its two coordinates.\")\n(\"place.weights\", \"fullParagraph\", \"These numbers are invented for the illustration and describe no people, outcomes or source dataset. Their role is to make aggregation inspectable. In the older Worldwright model, the landscape likewise distinguishes a diagnostic aggregate from moral or political authority.\")\n(\"place.weights\", \"fullParagraph\", \"A responsible account names its objective, whose judgment supplied it and which costs the score can conceal. It can also retain the alternatives when there is no agreed single ranking.\")\n(\"place.weights\", \"word\", \"word.weight\")\n(\"place.weights\", \"word\", \"word.tradeoff\")\n(\"place.weights\", \"pause\", \"Who lives with the consequences?\")\n(\"place.weights\", \"instruction\", \"Move the slider to change what the score values. The options themselves stay the same.\")\n(\"place.weights\", \"choice\", \"place.weights.choice.0\")\n(\"place.weights.choice.0\", \"destination\", \"place.coexistence\")\n(\"place.weights.choice.0\", \"label\", \"Return to the conditional result\")\n(\"place.weights.choice.0\", \"kind\", \"Another way back\")\n(\"place.weights\", \"choice\", \"place.weights.choice.1\")\n(\"place.weights.choice.1\", \"destination\", \"place.permission\")\n(\"place.weights.choice.1\", \"label\", \"Separate capability from responsibility\")\n(\"place.weights.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.weights\", \"choice\", \"place.weights.choice.2\")\n(\"place.weights.choice.2\", \"destination\", \"place.reachable\")\n(\"place.weights.choice.2\", \"label\", \"Ask whether the preferred option is reachable\")\n(\"place.weights.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.hiddenness\", \"isa\", \"Place\")\n(\"place.hiddenness\", \"slug\", \"hiddenness\")\n(\"place.hiddenness\", \"route\", \"places/hiddenness.html\")\n(\"place.hiddenness\", \"title\", \"Room for faith. Room for a question.\")\n(\"place.hiddenness\", \"lead\", \"This path explores a religious interpretation with its starting beliefs made clear.\")\n(\"place.hiddenness\", \"region\", \"The quiet horizon\")\n(\"place.hiddenness\", \"chapter\", \"36\")\n(\"place.hiddenness\", \"source\", \"note.meanings\")\n(\"place.hiddenness\", \"light\", \"boundary\")\n(\"place.hiddenness\", \"paragraph\", \"The source begins by assuming God exists. It then asks how a good God might make room for a world in which people have real choices.\")\n(\"place.hiddenness\", \"paragraph\", \"That reading does not explain away every case of suffering or absence. You can stay with the question, follow the Christian account of hope, or return to the scientific paths. They do not require this belief.\")\n(\"place.hiddenness\", \"fullParagraph\", \"The optional synthesis assumes that God exists, then adds claims about unsurpassable goodness, the integrity of creation and kenotic action. Those premises support a possible reading of a lawful world. They are not conclusions extracted from a detector or an algebra.\")\n(\"place.hiddenness\", \"fullParagraph\", \"Within that reading, making room for creaturely agency need not mean abandonment. Yet the account refuses to infer that every instance of hiddenness or non-intervention is justified. A general picture cannot settle the suffering of a particular person.\")\n(\"place.hiddenness\", \"fullParagraph\", \"You may stay with the question, continue into an explicitly Christian account of hope, or return to the scientific observatory. None of the scientific paths requires passing through this horizon.\")\n(\"place.hiddenness\", \"word\", \"word.theology\")\n(\"place.hiddenness\", \"word\", \"word.assumption\")\n(\"place.hiddenness\", \"pause\", \"What may we hope for?\")\n(\"place.hiddenness\", \"choice\", \"place.hiddenness.choice.0\")\n(\"place.hiddenness.choice.0\", \"destination\", \"place.hope\")\n(\"place.hiddenness.choice.0\", \"label\", \"Continue into the Christian reading\")\n(\"place.hiddenness.choice.0\", \"kind\", \"Optional continuation\")\n(\"place.hiddenness\", \"choice\", \"place.hiddenness.choice.1\")\n(\"place.hiddenness.choice.1\", \"destination\", \"place.texts\")\n(\"place.hiddenness.choice.1\", \"label\", \"Visit the reading room\")\n(\"place.hiddenness.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.hiddenness\", \"choice\", \"place.hiddenness.choice.2\")\n(\"place.hiddenness.choice.2\", \"destination\", \"place.cosmos\")\n(\"place.hiddenness.choice.2\", \"label\", \"Return to the observatory\")\n(\"place.hiddenness.choice.2\", \"kind\", \"Another way back\")\n(\"place.hope\", \"isa\", \"Place\")\n(\"place.hope\", \"slug\", \"hope\")\n(\"place.hope\", \"route\", \"places/hope.html\")\n(\"place.hope\", \"title\", \"Restoration without erasure.\")\n(\"place.hope\", \"lead\", \"Hope for restoration does not require calling suffering good.\")\n(\"place.hope\", \"region\", \"The light beyond\")\n(\"place.hope\", \"chapter\", \"37\")\n(\"place.hope\", \"source\", \"note.meanings\")\n(\"place.hope\", \"light\", \"boundary\")\n(\"place.hope\", \"paragraph\", \"In the source’s Christian reading, God enters human life and shares its cost. Resurrection names a hope that brokenness will not have the final word.\")\n(\"place.hope\", \"paragraph\", \"This is a statement of faith, not a result from physics. It does not ask you to say that your own losses were necessary or deserved. It offers a question about how hope might shape care, patience and honesty.\")\n(\"place.hope\", \"fullParagraph\", \"The synthesis’s Christian continuation speaks of incarnation as entering creaturely conditions, the cross as sharing their cost without domination, and resurrection as restoration beyond a broken present. These are theological commitments, not a physical mechanism or a forecast produced by this site.\")\n(\"place.hope\", \"fullParagraph\", \"Its image of restoration preserves the reality of the history being restored. The picture does not establish that a loss was necessary, deserved or beneficial. No visitor is asked to reinterpret their own suffering to fit it.\")\n(\"place.hope\", \"fullParagraph\", \"What might such hope ask of an inquirer? Patience, truthfulness, care with other people’s costs, hospitality to correction and the willingness to leave useful work for someone else. Those are invitations to practice, not evidence that the underlying assumptions have been proved.\")\n(\"place.hope\", \"word\", \"word.incarnation\")\n(\"place.hope\", \"word\", \"word.resurrection\")\n(\"place.hope\", \"pause\", \"What may we hope for?\")\n(\"place.hope\", \"choice\", \"place.hope.choice.0\")\n(\"place.hope.choice.0\", \"destination\", \"place.hiddenness\")\n(\"place.hope.choice.0\", \"label\", \"Return to the unresolved question\")\n(\"place.hope.choice.0\", \"kind\", \"Another way back\")\n(\"place.hope\", \"choice\", \"place.hope.choice.1\")\n(\"place.hope.choice.1\", \"destination\", \"place.care\")\n(\"place.hope.choice.1\", \"label\", \"Bring hope back to attention\")\n(\"place.hope.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.hope\", \"choice\", \"place.hope.choice.2\")\n(\"place.hope.choice.2\", \"destination\", \"place.commons\")\n(\"place.hope.choice.2\", \"label\", \"Leave useful work for another\")\n(\"place.hope.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.texts\", \"isa\", \"Place\")\n(\"place.texts\", \"slug\", \"texts\")\n(\"place.texts\", \"route\", \"places/texts.html\")\n(\"place.texts\", \"title\", \"A reading is not yet a prediction.\")\n(\"place.texts\", \"lead\", \"A reading that fits a text is not yet evidence that it predicted an event.\")\n(\"place.texts\", \"region\", \"The reading room\")\n(\"place.texts\", \"chapter\", \"38\")\n(\"place.texts\", \"source\", \"note.texts\")\n(\"place.texts\", \"light\", \"boundary\")\n(\"place.texts\", \"paragraph\", \"Start with the passage, when it was written and what it claims. Then ask what separate evidence there is for the event it describes.\")\n(\"place.texts\", \"paragraph\", \"The research keeps these questions apart. It also asks whether an interpretation works on cases that were not used to invent it. This room makes no forecast and gives no personal prophecy.\")\n(\"place.texts\", \"fullParagraph\", \"The prophetic-admissibility pilot distinguishes literary fit, a narrative’s own account of fulfilment, independently dated outcomes, held-out validation and theological attribution. Each is a different claim. An exact calculation at one rung cannot silently promote the reading to the next.\")\n(\"place.texts\", \"fullParagraph\", \"The catalogue deliberately includes uncertain candidacies and names traditions still outside its coverage. Membership means a passage deserves examination as future-directed language; it does not establish supernatural truth, fulfilment or predictive reliability.\")\n(\"place.texts\", \"fullParagraph\", \"Inspect the evidence questions on the desk. There are no dates to optimize toward, no forecast of your future and no personal reading. The aim is a disciplined encounter with interpretation and its alternatives.\")\n(\"place.texts\", \"word\", \"word.held-out test\")\n(\"place.texts\", \"pause\", \"What may we hope for?\")\n(\"place.texts\", \"instruction\", \"Open each kind of evidence. Notice why one does not automatically establish the next.\")\n(\"place.texts\", \"choice\", \"place.texts.choice.0\")\n(\"place.texts.choice.0\", \"destination\", \"place.hiddenness\")\n(\"place.texts.choice.0\", \"label\", \"Return to the optional horizon\")\n(\"place.texts.choice.0\", \"kind\", \"Another way back\")\n(\"place.texts\", \"choice\", \"place.texts.choice.1\")\n(\"place.texts.choice.1\", \"destination\", \"place.preservation\")\n(\"place.texts.choice.1\", \"label\", \"Think about a surviving witness\")\n(\"place.texts.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.texts\", \"choice\", \"place.texts.choice.2\")\n(\"place.texts.choice.2\", \"destination\", \"place.closedpath\")\n(\"place.texts.choice.2\", \"label\", \"Ask what a failed reading teaches\")\n(\"place.texts.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.commons\", \"isa\", \"Place\")\n(\"place.commons\", \"slug\", \"commons\")\n(\"place.commons\", \"route\", \"places/commons.html\")\n(\"place.commons\", \"title\", \"Someone else can change the question.\")\n(\"place.commons\", \"lead\", \"An outside reply can reveal a question we failed to ask ourselves.\")\n(\"place.commons\", \"region\", \"The unfinished commons\")\n(\"place.commons\", \"chapter\", \"39\")\n(\"place.commons\", \"source\", \"note.correspondence\")\n(\"place.commons\", \"light\", \"boundary\")\n(\"place.commons\", \"paragraph\", \"The correspondence record keeps an earlier assessment and the response that changed the discussion. It identifies whose view is whose. An exchange does not become agreement or independent verification.\")\n(\"place.commons\", \"paragraph\", \"Open the cards to see what helps another person check a contribution: the exact source, what was expected, what happened and what could be tried next. Nothing is sent from this page.\")\n(\"place.commons\", \"fullParagraph\", \"The correspondence lane retains exchanges as attributed history. In the OPH conversation, an external reply exposed a reciprocal burden: a corpus asking another programme about consciousness must also say where its own account stops.\")\n(\"place.commons\", \"fullParagraph\", \"The record preserves the initial assessment and the later response rather than making the first silently agree with the second. It does not turn the exchange into a joint paper, peer review or endorsement. The voices remain separately attributed.\")\n(\"place.commons\", \"fullParagraph\", \"Open the cards for what a useful contribution can carry: an exact question, the relevant source and version, what was expected, what happened, and the narrow conclusion. The site sends nothing on your behalf. A contribution begins as a proposal another person can inspect.\")\n(\"place.commons\", \"word\", \"word.independent verification\")\n(\"place.commons\", \"word\", \"word.evidence family\")\n(\"place.commons\", \"pause\", \"What can we leave for one another?\")\n(\"place.commons\", \"instruction\", \"Open the cards to see what helps someone else check a contribution.\")\n(\"place.commons\", \"supplement\", \"note.contribution\")\n(\"place.commons\", \"choice\", \"place.commons.choice.0\")\n(\"place.commons.choice.0\", \"destination\", \"place.closedpath\")\n(\"place.commons.choice.0\", \"label\", \"Leave the failed route visible\")\n(\"place.commons.choice.0\", \"kind\", \"Ideas to compare\")\n(\"place.commons\", \"choice\", \"place.commons.choice.1\")\n(\"place.commons.choice.1\", \"destination\", \"place.workshop\")\n(\"place.commons.choice.1\", \"label\", \"Try one bounded change\")\n(\"place.commons.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.commons\", \"choice\", \"place.commons.choice.2\")\n(\"place.commons.choice.2\", \"destination\", \"place.attention\")\n(\"place.commons.choice.2\", \"label\", \"Listen for the question you missed\")\n(\"place.commons.choice.2\", \"kind\", \"Ideas to compare\")\n(\"place.closedpath\", \"isa\", \"Place\")\n(\"place.closedpath\", \"slug\", \"closedpath\")\n(\"place.closedpath\", \"route\", \"places/closedpath.html\")\n(\"place.closedpath\", \"title\", \"A failed attempt can still help.\")\n(\"place.closedpath\", \"lead\", \"A failed attempt is useful when we can explain exactly what it rules out.\")\n(\"place.closedpath\", \"region\", \"The retained refusal\")\n(\"place.closedpath\", \"chapter\", \"40\")\n(\"place.closedpath\", \"source\", \"note.negatives\")\n(\"place.closedpath\", \"light\", \"boundary\")\n(\"place.closedpath\", \"paragraph\", \"Did the program break? Did a route fail under certain conditions? Was something proved impossible within a model? Or did the test simply lack enough information?\")\n(\"place.closedpath\", \"paragraph\", \"Choose a kind of failure. Each leaves different next steps available. Keeping those limits clear can save another person from repeating the same mistake.\")\n(\"place.closedpath\", \"fullParagraph\", \"The negative-results ledger distinguishes a software defect, an obstruction under stated assumptions, an exact no-go result and a test that lacked identifying information. “It failed” is too small a description to tell the next person what remains possible.\")\n(\"place.closedpath\", \"fullParagraph\", \"Each admitted negative record names the claim, adequacy of the test, active domain, evidence, allowed inference and stronger inference refused. It also names what new datum or changed assumption could reopen the route.\")\n(\"place.closedpath\", \"fullParagraph\", \"Examine a refusal here as a research object. Keeping a failed promotion visible can protect a correct smaller result from being discarded with it. Truthful limits make the world larger by showing where a different question can begin.\")\n(\"place.closedpath\", \"word\", \"word.no-go result\")\n(\"place.closedpath\", \"word\", \"word.scope\")\n(\"place.closedpath\", \"pause\", \"What can we leave for one another?\")\n(\"place.closedpath\", \"instruction\", \"Choose a kind of failure. Read what it rules out and what it leaves open.\")\n(\"place.closedpath\", \"choice\", \"place.closedpath.choice.0\")\n(\"place.closedpath.choice.0\", \"destination\", \"place.commons\")\n(\"place.closedpath.choice.0\", \"label\", \"Leave something others can check\")\n(\"place.closedpath.choice.0\", \"kind\", \"Another way back\")\n(\"place.closedpath\", \"choice\", \"place.closedpath.choice.1\")\n(\"place.closedpath.choice.1\", \"destination\", \"place.code\")\n(\"place.closedpath.choice.1\", \"label\", \"Return to the mathematical comparison\")\n(\"place.closedpath.choice.1\", \"kind\", \"Ideas to compare\")\n(\"place.closedpath\", \"choice\", \"place.closedpath.choice.2\")\n(\"place.closedpath.choice.2\", \"destination\", \"place.possibility\")\n(\"place.closedpath.choice.2\", \"label\", \"See what remains possible\")\n(\"place.closedpath.choice.2\", \"kind\", \"Ideas to compare\")\n(\"note.reflection\", \"isa\", \"SourceNote\")\n(\"note.reflection\", \"title\", \"Scenes for reflection\")\n(\"note.reflection\", \"originalTitle\", \"Reader recognition, truth and the water\")\n(\"note.reflection\", \"kind\", \"Authored reflective scene · composition proposal\")\n(\"note.reflection\", \"note\", \"These fictional encounters develop Aaron’s invitation to address the reader, allow humour and use the horse-and-water reflection image. They are assistant-authored composition proposals, not additional autobiography, psychological findings or advice about a particular relationship.\")\n(\"note.reflection\", \"paragraph\", \"An invented scene for reflection\")\n(\"note.reflection\", \"paragraph\", \"These scenes develop Aaron’s ideas about helping a reader recognize something for themselves. They do not add to his life story or assess the reader.\")\n(\"note.reflection\", \"href\", \"retained/library/reflection.txt\")\n(\"note.frontier\", \"isa\", \"SourceNote\")\n(\"note.frontier\", \"title\", \"What measurements miss\")\n(\"note.frontier\", \"originalTitle\", \"The admissibility frontier\")\n(\"note.frontier\", \"kind\", \"Current research synthesis\")\n(\"note.frontier\", \"note\", \"Experiments can erase phase, delay, boundary order, orientation and correlations. The programme asks which distinguishing records an apparatus could preserve. The physical identification of the proposed structures remains open.\")\n(\"note.frontier\", \"paragraph\", \"An overview of the current research\")\n(\"note.frontier\", \"paragraph\", \"Asks which differences our measurements leave out and how another measurement might reveal them. It does not identify a new physical theory as true.\")\n(\"note.frontier\", \"href\", \"retained/library/frontier.txt\")\n(\"note.invariant\", \"isa\", \"SourceNote\")\n(\"note.invariant\", \"title\", \"What stays comparable along a path\")\n(\"note.invariant\", \"originalTitle\", \"The locally invariant carrier and its mirror face\")\n(\"note.invariant\", \"kind\", \"Exact mathematical construction\")\n(\"note.invariant\", \"note\", \"Pointwise invariance, compatible transport and trivial global return are separate claims. A loop can preserve the comparison structure and still return the transported state changed. Physical carrier identification remains open.\")\n(\"note.invariant\", \"paragraph\", \"A mathematical result; the physical connection is still open\")\n(\"note.invariant\", \"paragraph\", \"Explains how a comparison can remain valid during a journey even when the final state changes. This does not identify the material system that nature uses.\")\n(\"note.invariant\", \"href\", \"retained/library/invariant.txt\")\n(\"note.detector\", \"isa\", \"SourceNote\")\n(\"note.detector\", \"title\", \"What a measuring tool can see\")\n(\"note.detector\", \"originalTitle\", \"Scalar impedance and dark holonomy\")\n(\"note.detector\", \"kind\", \"Finite model result\")\n(\"note.detector\", \"note\", \"In the finite witness, the scalar port e₄ is orthogonal to the moving dark plane. Its response is independent of the loop parameter. Full matrix residues recover the projector; a calibrated sufficiently ranked port set is needed experimentally.\")\n(\"note.detector\", \"paragraph\", \"A result in a specified mathematical model\")\n(\"note.detector\", \"paragraph\", \"One reading can miss a changing part of the model. Several well-chosen, checked measurements can reveal it. This is not yet a physical measurement.\")\n(\"note.detector\", \"href\", \"retained/library/detector.txt\")\n(\"note.instrument\", \"isa\", \"SourceNote\")\n(\"note.instrument\", \"title\", \"The recorded computer experiment\")\n(\"note.instrument\", \"originalTitle\", \"The four-mode virtual instrument\")\n(\"note.instrument\", \"kind\", \"Documented virtual experiment\")\n(\"note.instrument\", \"note\", \"The corpus documents a deterministic 24-run virtual experiment and replay certificate. Real-time I/O and physical hardware remain external. This website provides an explanatory illustration, not a replay of those calculations.\")\n(\"note.instrument\", \"paragraph\", \"A recorded computer experiment\")\n(\"note.instrument\", \"paragraph\", \"The source keeps a set of computer runs and a program for checking them. Real equipment and physical measurements are separate work.\")\n(\"note.instrument\", \"href\", \"retained/library/instrument.txt\")\n(\"note.contact\", \"isa\", \"SourceNote\")\n(\"note.contact\", \"title\", \"When an answer misses the question\")\n(\"note.contact\", \"originalTitle\", \"From felt mismatch to inspectable structure\")\n(\"note.contact\", \"kind\", \"Applied epistemology proposal\")\n(\"note.contact\", \"note\", \"The inquiry begins with a recognition that a response missed the point. It develops contrast cases and rival explanations, with prediction on fresh examples as the next test. It does not establish a universal model of tacit knowledge.\")\n(\"note.contact\", \"paragraph\", \"A proposal developed from one recorded mistake\")\n(\"note.contact\", \"paragraph\", \"Studies how an answer missed the speaker’s question. Its suggested checks still need testing in fresh cases.\")\n(\"note.contact\", \"href\", \"retained/library/contact.txt\")\n(\"note.correction\", \"isa\", \"SourceNote\")\n(\"note.correction\", \"title\", \"The withdrawn explanation\")\n(\"note.correction\", \"originalTitle\", \"The withdrawn cross-context interpretation\")\n(\"note.correction\", \"kind\", \"Retained correction\")\n(\"note.correction\", \"note\", \"Withdrawn on 19 October 2026 for importing an unrelated physics programme into the illegible-knowledge inquiry. Its proposed interpretation should not be treated as an established bridge.\")\n(\"note.correction\", \"paragraph\", \"An earlier interpretation that was withdrawn\")\n(\"note.correction\", \"paragraph\", \"The interpretation brought one research framework into a different question. It is kept so readers can see the mistake and the correction.\")\n(\"note.correction\", \"href\", \"retained/library/correction.txt\")\n(\"note.kenosis\", \"isa\", \"SourceNote\")\n(\"note.kenosis\", \"title\", \"Power, restraint and responsibility\")\n(\"note.kenosis\", \"originalTitle\", \"Kenotic governance and shared responsibility\")\n(\"note.kenosis\", \"kind\", \"Theological and philosophical argument\")\n(\"note.kenosis\", \"note\", \"Capability, moral permission and an obligation to exercise power are distinguished. Restraint must also be examined where one agent destroys another’s effective agency. The argument remains defeasible and is not a physical derivation.\")\n(\"note.kenosis\", \"paragraph\", \"A philosophical and theological argument\")\n(\"note.kenosis\", \"paragraph\", \"Distinguishes the ability to use power from permission and responsibility. It makes room for both restraint and protection. It is not a scientific law.\")\n(\"note.kenosis\", \"href\", \"retained/library/kenosis.txt\")\n(\"note.sourcery\", \"isa\", \"SourceNote\")\n(\"note.sourcery\", \"title\", \"Software that keeps its workings visible\")\n(\"note.sourcery\", \"originalTitle\", \"Programme algebra\")\n(\"note.sourcery\", \"kind\", \"Software and representation programme\")\n(\"note.sourcery\", \"note\", \"The science programme is expressed through the compositional grammar used by Sourcery. Typed objects preserve assumptions, evidence and refused transformations. A complete protocol does not establish that an experiment ran.\")\n(\"note.sourcery\", \"paragraph\", \"A software research programme\")\n(\"note.sourcery\", \"paragraph\", \"Explores how software descriptions can keep sources, assumptions and rejected changes visible. A complete description does not prove an experiment ran.\")\n(\"note.sourcery\", \"href\", \"retained/library/sourcery.txt\")\n(\"note.monster\", \"isa\", \"SourceNote\")\n(\"note.monster\", \"title\", \"Three mathematical structures compared\")\n(\"note.monster\", \"originalTitle\", \"The rank-24 detector ladder\")\n(\"note.monster\", \"kind\", \"Exact within a declared candidate family\")\n(\"note.monster\", \"note\", \"E₈³, Leech and Moonshine candidates share a coarse thermal signature. Their weight-one current dimensions are 744, 24 and 0. The three-way distinction is not an unrestricted uniqueness theorem or evidence that a physical system realizes the Monster.\")\n(\"note.monster\", \"paragraph\", \"A mathematical comparison of three chosen structures\")\n(\"note.monster\", \"paragraph\", \"A count distinguishes three named mathematical structures. It is not a proof about every possible structure or evidence of a physical Monster system.\")\n(\"note.monster\", \"href\", \"retained/library/monster.txt\")\n(\"note.personal\", \"isa\", \"SourceNote\")\n(\"note.personal\", \"title\", \"About Aaron’s personal account\")\n(\"note.personal\", \"originalTitle\", \"Aaron’s personal account\")\n(\"note.personal\", \"kind\", \"Author account · working draft\")\n(\"note.personal\", \"note\", \"Adapted from Aaron’s account in the originating conversation. These passages express his experience. They do not independently establish another family member’s perspective, intentions or a causal explanation of the family’s experience. Wording remains open to his revision.\")\n(\"note.personal\", \"paragraph\", \"Aaron’s account, in wording open to revision\")\n(\"note.personal\", \"paragraph\", \"This passage expresses Aaron’s experience. It does not establish what another family member thought or intended.\")\n(\"note.authorship\", \"isa\", \"SourceNote\")\n(\"note.authorship\", \"title\", \"People choosing; machines helping\")\n(\"note.authorship\", \"originalTitle\", \"Human authorship, assisted by AI\")\n(\"note.authorship\", \"kind\", \"Product philosophy · inspectable example\")\n(\"note.authorship\", \"note\", \"Developed with Aaron in the Encounter discussion: remove unnecessary labour, preserve human authorship, and make consequences and evidence inspectable. Autonomy, human taste and risk-appropriate assurance are design commitments. The accompanying example executes a bounded typed edit through the existing Temple kernel. Its checks do not establish independent verification, a complete authoring environment, employment outcomes or a measured productivity multiplier.\")\n(\"note.authorship\", \"paragraph\", \"A design philosophy with a small working example\")\n(\"note.authorship\", \"paragraph\", \"The workshop lets you edit two values and follow the results through the existing checking system. It is not a complete authoring environment or independent verification.\")\n(\"note.contribution\", \"isa\", \"SourceNote\")\n(\"note.contribution\", \"title\", \"How to offer a checkable contribution\")\n(\"note.contribution\", \"originalTitle\", \"Context Hub contribution contract\")\n(\"note.contribution\", \"kind\", \"Contribution proposal contract · no admission effect\")\n(\"note.contribution\", \"note\", \"Defines bounded attributable contributions, exact sources, evidence-family identity and a narrow conclusion. Inbox acceptance has no scientific or runtime admission effect. The reader does not submit a contribution or contact anyone.\")\n(\"note.contribution\", \"paragraph\", \"Guidance for offering a checkable contribution\")\n(\"note.contribution\", \"paragraph\", \"A useful proposal names its question, source and limits. Receiving a proposal does not make its claims true or authorize a system change.\")\n(\"note.contribution\", \"href\", \"retained/library/contribution.txt\")\n(\"note.possibilities\", \"isa\", \"SourceNote\")\n(\"note.possibilities\", \"title\", \"What is possible, allowed and reachable\")\n(\"note.possibilities\", \"originalTitle\", \"Dynatology: ontology and scope\")\n(\"note.possibilities\", \"kind\", \"Investigation framework · declared distinctions\")\n(\"note.possibilities\", \"note\", \"Distinguishes represented possibility, admissibility, viability, reachability, selection, realization and observation. This is a framework for investigations, not a physical theory. The garden is a small authored compatibility example.\")\n(\"note.possibilities\", \"paragraph\", \"A framework for asking research questions\")\n(\"note.possibilities\", \"paragraph\", \"Keeps “possible,” “allowed,” “reachable” and “observed” separate. The garden is a small example with visible rules.\")\n(\"note.possibilities\", \"href\", \"retained/library/possibilities.txt\")\n(\"note.memory\", \"isa\", \"SourceNote\")\n(\"note.memory\", \"title\", \"How the past can keep affecting a system\")\n(\"note.memory\", \"originalTitle\", \"Hidden elimination and the quadratic memory theorem\")\n(\"note.memory\", \"kind\", \"Exact finite-dimensional linear result\")\n(\"note.memory\", \"note\", \"Eliminating coupled hidden coordinates can produce a memory kernel and a term depending on their initial state. Autonomous closure requires an invariant detector kernel. The browser illustration is a two-coordinate Euler example, not a replay of the corpus certificate.\")\n(\"note.memory\", \"paragraph\", \"A mathematical result for specified linked quantities\")\n(\"note.memory\", \"paragraph\", \"Removing a quantity from an equation can leave an effect that depends on the past. The browser uses a smaller example to explain the idea.\")\n(\"note.memory\", \"href\", \"retained/library/memory.txt\")\n(\"note.erasure\", \"isa\", \"SourceNote\")\n(\"note.erasure\", \"title\", \"What a record cannot recover\")\n(\"note.erasure\", \"originalTitle\", \"No universal scar and the recovery boundary\")\n(\"note.erasure\", \"kind\", \"Exact information boundary · scoped recovery\")\n(\"note.erasure\", \"note\", \"States in the same detector fibre cannot be distinguished using only functions of that retained record. Recovery requires an additional distinguishing record or a richer theory. The dot-and-sum example is an authored finite illustration.\")\n(\"note.erasure\", \"paragraph\", \"A mathematical limit on what a record can tell us\")\n(\"note.erasure\", \"paragraph\", \"If two origins leave exactly the same record, that record alone cannot tell them apart. A second, different record can help.\")\n(\"note.erasure\", \"href\", \"retained/library/erasure.txt\")\n(\"note.mind\", \"isa\", \"SourceNote\")\n(\"note.mind\", \"title\", \"Attention, awareness, choice and action\")\n(\"note.mind\", \"originalTitle\", \"Attention, will and conscious access\")\n(\"note.mind\", \"kind\", \"Literature-grounded functional atlas · candidate joins\")\n(\"note.mind\", \"note\", \"Separates readiness, selection, conscious access, control, action and agency in distributed systems. Candidate biological joins retain their uncertainty. The canopy is an illustration of changing a view, not an attention test or a model of your brain.\")\n(\"note.mind\", \"paragraph\", \"A research overview with uncertain connections marked\")\n(\"note.mind\", \"paragraph\", \"Separates attention, awareness, choosing and acting. The drawings do not test the reader or provide a completed explanation of consciousness.\")\n(\"note.mind\", \"href\", \"retained/library/mind.txt\")\n(\"note.relations\", \"isa\", \"SourceNote\")\n(\"note.relations\", \"title\", \"What an arrow needs to explain\")\n(\"note.relations\", \"originalTitle\", \"Brain relationship algebra\")\n(\"note.relations\", \"kind\", \"Typed relationship proposal\")\n(\"note.relations\", \"note\", \"Makes conditional, negative and unresolved relationships explicit. A link needs its inputs and evidence; sequential, parallel and alternative compositions have different meanings. The intention scene is conceptual, not a diagnosis or a new neuroscience finding.\")\n(\"note.relations\", \"paragraph\", \"A proposal for describing connections carefully\")\n(\"note.relations\", \"paragraph\", \"Names what a connection needs and what evidence supports it. A drawn arrow is not proof that the connection exists in a brain.\")\n(\"note.relations\", \"href\", \"retained/library/relations.txt\")\n(\"note.material\", \"isa\", \"SourceNote\")\n(\"note.material\", \"title\", \"Investigating materials and their history\")\n(\"note.material\", \"originalTitle\", \"Physics to archaeology through the pyramids\")\n(\"note.material\", \"kind\", \"Proposed material-history decomposition\")\n(\"note.material\", \"note\", \"Connects named materials, transformations, preservation, measurements and historical inference while keeping their evidence separate. It does not derive archaeology from a symmetry group. The browser stone is illustrative and represents no sampled object.\")\n(\"note.material\", \"paragraph\", \"A proposed approach to material and historical evidence\")\n(\"note.material\", \"paragraph\", \"Connects materials, making, surviving traces and historical context. The drawing is not a measured archaeological sample.\")\n(\"note.material\", \"href\", \"retained/library/material.txt\")\n(\"note.patterns\", \"isa\", \"SourceNote\")\n(\"note.patterns\", \"title\", \"The exact counting relationship\")\n(\"note.patterns\", \"originalTitle\", \"Girih inflation and the index-two scar\")\n(\"note.patterns\", \"kind\", \"Exact transformation bridge · carrier identification open\")\n(\"note.patterns\", \"note\", \"The two-state matrix [[2,1],[1,1]] is exact in the declared Fibonacci/Penrose count action. The published girih construction reaches a related iterate through additional operations. The displayed counts do not reconstruct a historical tiling or establish a physical carrier.\")\n(\"note.patterns\", \"paragraph\", \"An exact counting relationship with limits\")\n(\"note.patterns\", \"paragraph\", \"Connects specific pattern rules through explicit mathematical steps. Similar numbers or shapes do not by themselves establish the same material or history.\")\n(\"note.patterns\", \"href\", \"retained/library/patterns.txt\")\n(\"note.codes\", \"isa\", \"SourceNote\")\n(\"note.codes\", \"title\", \"Checking a larger error-correcting code\")\n(\"note.codes\", \"originalTitle\", \"Golden–Golay integral encoder audit\")\n(\"note.codes\", \"kind\", \"Exact arithmetic audit · retained obstruction\")\n(\"note.codes\", \"note\", \"Recovers a bounded encoder but rejects an intrinsic equivariant ordering. The browser uses a separately declared three-bit repetition code to explain correction radius. It is not the ternary Golay code, a biological mechanism or a physical discovery.\")\n(\"note.codes\", \"paragraph\", \"A mathematical check that also rules out one proposed step\")\n(\"note.codes\", \"paragraph\", \"The source studies a larger code and a proposed ordering rule. The browser’s three-bit example is different and has its own small error limit.\")\n(\"note.codes\", \"href\", \"retained/library/codes.txt\")\n(\"note.laboratory\", \"isa\", \"SourceNote\")\n(\"note.laboratory\", \"title\", \"Plans for physical tests\")\n(\"note.laboratory\", \"originalTitle\", \"The finesse technology pathway\")\n(\"note.laboratory\", \"kind\", \"Experimental roadmap · proposed physical work\")\n(\"note.laboratory\", \"note\", \"Proposes controlled carriers, references, coherent records, nuisance checks and cross-carrier replication. Useful sensing or system-identification improvements can remain even if all anomalies receive conventional explanations. The bench is a design exercise, not acquired data.\")\n(\"note.laboratory\", \"paragraph\", \"A plan for physical tests\")\n(\"note.laboratory\", \"paragraph\", \"Describes possible equipment, comparisons and records. The browser does not collect experimental measurements.\")\n(\"note.laboratory\", \"href\", \"retained/library/laboratory.txt\")\n(\"note.costs\", \"isa\", \"SourceNote\")\n(\"note.costs\", \"title\", \"Costs and limits of a result\")\n(\"note.costs\", \"originalTitle\", \"Cost, backaction, scale and rare events\")\n(\"note.costs\", \"kind\", \"Process-frontier census · open research lanes\")\n(\"note.costs\", \"note\", \"Separates convergence from resource cost, conditioned trajectories from unconditional channels, and finite calculations from scale-uniform control. The rate table in the reader comes from the documented four-mode virtual experiment; it is numerical evidence in that authored model.\")\n(\"note.costs\", \"paragraph\", \"A map of research questions about costs and limits\")\n(\"note.costs\", \"paragraph\", \"Asks what a result costs, what measurement changes, and which conclusions survive a change of scale. Many questions remain open.\")\n(\"note.costs\", \"href\", \"retained/library/costs.txt\")\n(\"note.cosmos\", \"isa\", \"SourceNote\")\n(\"note.cosmos\", \"title\", \"Open questions about the universe\")\n(\"note.cosmos\", \"originalTitle\", \"Frontier physics target set\")\n(\"note.cosmos\", \"kind\", \"Maintained research target map · open gates\")\n(\"note.cosmos\", \"note\", \"The target map keeps physical identification, coefficient selection, common-parameter cosmology and continuum limits as distinct gates. A target or workflow priority is not confirmation of new physics. The observatory offers questions, not simulated observations.\")\n(\"note.cosmos\", \"paragraph\", \"A map of open questions in physics\")\n(\"note.cosmos\", \"paragraph\", \"Names work needed on gravity, particles and the universe. A place on this map is not evidence that a proposed explanation is correct.\")\n(\"note.cosmos\", \"href\", \"retained/library/cosmos.txt\")\n(\"note.scenarios\", \"isa\", \"SourceNote\")\n(\"note.scenarios\", \"title\", \"Results from an invented social model\")\n(\"note.scenarios\", \"originalTitle\", \"Worldwright research: current landscape\")\n(\"note.scenarios\", \"kind\", \"Authored synthetic intervention model · empirical calibration open\")\n(\"note.scenarios\", \"note\", \"The older research model is distinct from this storytelling product. Its frozen cells expose urgency-dependent aggregate rankings and Pareto tradeoffs under declared assumptions. Its mechanisms remain empirically unidentified; no policy, personal advice or moral authority follows from the rankings.\")\n(\"note.scenarios\", \"paragraph\", \"Results in an invented model; real-world testing is still needed\")\n(\"note.scenarios\", \"paragraph\", \"The reported ranking changes with urgency and with the chosen score. The model has not been shown to predict real communities or decide what is morally right.\")\n(\"note.scenarios\", \"href\", \"retained/library/scenarios.txt\")\n(\"note.meanings\", \"isa\", \"SourceNote\")\n(\"note.meanings\", \"title\", \"Optional religious interpretations\")\n(\"note.meanings\", \"originalTitle\", \"Optional endpoints, mythic readings and theology\")\n(\"note.meanings\", \"kind\", \"Optional interpretation · explicit theological assumptions\")\n(\"note.meanings\", \"note\", \"The theological reading explicitly assumes God exists, with further assumptions about goodness, creation and kenotic action. The Christian continuation is identified as such. Neither mathematics nor detector limits establish these assumptions, and suffering is not thereby justified.\")\n(\"note.meanings\", \"paragraph\", \"An optional religious interpretation\")\n(\"note.meanings\", \"paragraph\", \"Begins by assuming God exists and identifies its Christian continuation. It does not use mathematics to prove those beliefs or justify a person’s suffering.\")\n(\"note.meanings\", \"href\", \"retained/library/meanings.txt\")\n(\"note.texts\", \"isa\", \"SourceNote\")\n(\"note.texts\", \"title\", \"Testing interpretations of texts\")\n(\"note.texts\", \"originalTitle\", \"Prophetic admissibility\")\n(\"note.texts\", \"kind\", \"Historical and theological inference pilot · prediction ranking unidentified\")\n(\"note.texts\", \"note\", \"Separates literary fit, narrative fulfilment, dating, independent outcomes, held-out validation and theological attribution. Catalogue membership does not establish fulfilment. The encounter generates no dates, forecasts or personal prophecy; the bundled source describes a provisional research programme with its own limits.\")\n(\"note.texts\", \"paragraph\", \"A proposed way to test interpretations of texts\")\n(\"note.texts\", \"paragraph\", \"Separates a reading that fits a passage from an independently supported prediction. The encounter generates no dates or personal prophecy.\")\n(\"note.texts\", \"href\", \"retained/library/texts.txt\")\n(\"note.correspondence\", \"isa\", \"SourceNote\")\n(\"note.correspondence\", \"title\", \"A recorded exchange of views\")\n(\"note.correspondence\", \"originalTitle\", \"OPH and the Admissibility Frontier\")\n(\"note.correspondence\", \"kind\", \"Attributed conversation · no joint endorsement\")\n(\"note.correspondence\", \"note\", \"Records an external reply and the corpus response, including a correction about the limits of its own consciousness account. Editorial summaries remain the corpus’s interpretation. The reader does not invent dialogue or present correspondence as peer review.\")\n(\"note.correspondence\", \"paragraph\", \"A record of an exchange, with views separately attributed\")\n(\"note.correspondence\", \"paragraph\", \"Keeps an earlier assessment and a response that changed the discussion. It does not imply agreement, peer review or endorsement.\")\n(\"note.correspondence\", \"href\", \"retained/library/correspondence.txt\")\n(\"note.negatives\", \"isa\", \"SourceNote\")\n(\"note.negatives\", \"title\", \"Failures and what could reopen a question\")\n(\"note.negatives\", \"originalTitle\", \"Negative results and reopening ledger\")\n(\"note.negatives\", \"kind\", \"Scoped negative knowledge · explicit reopening conditions\")\n(\"note.negatives\", \"note\", \"Separates software defects, domain-dependent obstructions, no-go results and inadequate information. A negative result retains its exact claim, assumptions, evidence and cheapest reopening datum. A failed test does not justify an unrestricted impossibility claim.\")\n(\"note.negatives\", \"paragraph\", \"A record of failures with their limits kept clear\")\n(\"note.negatives\", \"paragraph\", \"Distinguishes a broken program, a failed route, a proof of impossibility under conditions, and a test with too little information. It also asks what could change the conclusion.\")\n(\"note.negatives\", \"href\", \"retained/library/negatives.txt\")\n(\"word.phase\", \"meaning\", \"Where a repeating signal is in its cycle: for example, whether it is rising or falling at a given moment.\")\n(\"word.detector\", \"meaning\", \"A tool or method that turns something happening into a record we can inspect.\")\n(\"word.holonomy\", \"meaning\", \"A change left after following a closed path. Returning to the same location does not always return everything to the same state.\")\n(\"word.calibration\", \"meaning\", \"Checking how a measuring tool’s readings relate to a known reference.\")\n(\"word.model\", \"meaning\", \"A simplified description used to explore a question. A result in the model needs further evidence before it describes the real world.\")\n(\"word.kenosis\", \"meaning\", \"A Christian term often translated as “self-emptying.” Here it means using power while making room for others to act.\")\n(\"word.agency\", \"meaning\", \"A person’s ability to make choices and have a meaningful effect on what happens.\")\n(\"word.authorship\", \"meaning\", \"Having a meaningful say in what is made, why it is made and how it is changed.\")\n(\"word.replay\", \"meaning\", \"Repeating a calculation from saved settings so its result can be checked.\")\n(\"word.control\", \"meaning\", \"A comparison designed to test whether an apparent effect could have another explanation.\")\n(\"word.representation\", \"meaning\", \"A view of something, such as a map, diagram, set of numbers or piece of text. Every view keeps some features and leaves others out.\")\n(\"word.assumption\", \"meaning\", \"Something an explanation takes as a starting point. A conclusion depends on the assumptions it needs.\")\n(\"word.source\", \"meaning\", \"Where a statement or displayed value comes from: for example, a document, a record or a piece of code.\")\n(\"word.projection\", \"meaning\", \"A particular view of the same thing. In the workshop, one story can appear as a page, a menu link or a row.\")\n(\"word.overlay\", \"meaning\", \"A local change to a view. In the workshop, the menu can use its own label while the story keeps its title.\")\n(\"word.admissibility\", \"meaning\", \"Whether something meets the stated rules or constraints. It does not mean that it will happen or that we can reach it.\")\n(\"word.positive response\", \"meaning\", \"A response described by a number table that gives zero or above for every direction you test. Here, that puts a limit on the shared term c. The formula is available under the calculation details.\")\n(\"word.coupling\", \"meaning\", \"A link through which two parts of a model can affect one another.\")\n(\"word.record\", \"meaning\", \"The information that was kept. A record may leave out differences that were present in the original event.\")\n(\"word.conscious access\", \"meaning\", \"Information becoming available for such things as reporting or deliberately using it. Explaining this does not by itself explain all experience.\")\n(\"word.feedback\", \"meaning\", \"Information about what happened returning to a system and potentially changing what happens next.\")\n(\"word.provenance\", \"meaning\", \"Where something came from and the history of how it reached us.\")\n(\"word.preservation\", \"meaning\", \"The processes that allow traces to survive, or that change and damage them over time.\")\n(\"word.transformation\", \"meaning\", \"A stated rule for changing one state, number pair or arrangement into another.\")\n(\"word.carrier\", \"meaning\", \"The particular thing being described by a model: for example, a set of numbers, a physical device or a system of relations. Shared mathematics does not make two carriers the same thing.\")\n(\"word.code\", \"meaning\", \"A rule for representing a message so that some errors can be detected or repaired.\")\n(\"word.bit\", \"meaning\", \"One binary digit: zero or one.\")\n(\"word.cosmology\", \"meaning\", \"The study of the universe’s large-scale structure and history.\")\n(\"word.coarse-graining\", \"meaning\", \"Combining small details into larger groups. This can preserve a total while losing information about the parts.\")\n(\"word.synthetic model\", \"meaning\", \"An invented model for exploring assumptions. Its outcomes are not observations of real people or communities.\")\n(\"word.Pareto tradeoff\", \"meaning\", \"A choice where improving one quantity comes with a loss in another. A single overall score can hide that loss.\")\n(\"word.weight\", \"meaning\", \"How much a quantity contributes to a combined score.\")\n(\"word.tradeoff\", \"meaning\", \"Gaining something while giving up something else.\")\n(\"word.theology\", \"meaning\", \"Thinking and arguments about God and religious belief. These may begin from beliefs that the reader does not share.\")\n(\"word.incarnation\", \"meaning\", \"In Christian belief, God entering human life in Jesus.\")\n(\"word.resurrection\", \"meaning\", \"In Christian belief, rising from death. Here it is part of an identified account of hope, not a result from physics.\")\n(\"word.held-out test\", \"meaning\", \"Trying a rule on examples that were not used to develop or choose it.\")\n(\"word.independent verification\", \"meaning\", \"A check that is genuinely separate from the work being checked. Repeating a claim or summarizing the same run is not an independent check.\")\n(\"word.evidence family\", \"meaning\", \"Records that come from the same underlying event or test. Several versions of one result are not several independent confirmations.\")\n(\"word.no-go result\", \"meaning\", \"A proof that a proposed route cannot work under stated conditions. It does not rule out every differently stated route.\")\n(\"word.scope\", \"meaning\", \"The particular question, conditions and range to which a claim applies.\")\n(\"word.totalizing\", \"meaning\", \"Taking over so much attention that other things become hard to notice.\")\n(\"entrance.observation\", \"isa\", \"Entrance\")\n(\"entrance.observation\", \"destination\", \"place.observation\")\n(\"entrance.observation\", \"name\", \"The unseen\")\n(\"entrance.observation\", \"question\", \"What can’t we see?\")\n(\"entrance.observation\", \"note\", \"Measurement, memory & the hidden distinction\")\n(\"entrance.observation\", \"number\", \"01\")\n(\"entrance.observation\", \"symbol\", \"◉\")\n(\"entrance.kenosis\", \"isa\", \"Entrance\")\n(\"entrance.kenosis\", \"destination\", \"place.kenosis\")\n(\"entrance.kenosis\", \"name\", \"The boundary\")\n(\"entrance.kenosis\", \"question\", \"What should power leave alone?\")\n(\"entrance.kenosis\", \"note\", \"Agency, faith & the limits of control\")\n(\"entrance.kenosis\", \"number\", \"02\")\n(\"entrance.kenosis\", \"symbol\", \"◇\")\n(\"entrance.care\", \"isa\", \"Entrance\")\n(\"entrance.care\", \"destination\", \"place.care\")\n(\"entrance.care\", \"name\", \"The human\")\n(\"entrance.care\", \"question\", \"How do you keep caring?\")\n(\"entrance.care\", \"note\", \"Love, intensity & finding contact again\")\n(\"entrance.care\", \"number\", \"03\")\n(\"entrance.care\", \"symbol\", \"✧\")\n(\"region.possibility\", \"isa\", \"Region\")\n(\"region.possibility\", \"name\", \"The garden of possibilities\")\n(\"region.possibility\", \"question\", \"What can exist together?\")\n(\"region.possibility\", \"light\", \"unseen\")\n(\"region.possibility\", \"place\", \"place.possibility\")\n(\"region.possibility\", \"place\", \"place.reachable\")\n(\"region.memory\", \"isa\", \"Region\")\n(\"region.memory\", \"name\", \"The echo chambers\")\n(\"region.memory\", \"question\", \"What remains when something disappears?\")\n(\"region.memory\", \"light\", \"unseen\")\n(\"region.memory\", \"place\", \"place.memory\")\n(\"region.memory\", \"place\", \"place.erasure\")\n(\"region.mind\", \"isa\", \"Region\")\n(\"region.mind\", \"name\", \"The living canopy\")\n(\"region.mind\", \"question\", \"What comes into attention?\")\n(\"region.mind\", \"light\", \"human\")\n(\"region.mind\", \"place\", \"place.attention\")\n(\"region.mind\", \"place\", \"place.will\")\n(\"region.material\", \"isa\", \"Region\")\n(\"region.material\", \"name\", \"The house of stone\")\n(\"region.material\", \"question\", \"How did this come to be here?\")\n(\"region.material\", \"light\", \"human\")\n(\"region.material\", \"place\", \"place.stone\")\n(\"region.material\", \"place\", \"place.preservation\")\n(\"region.pattern\", \"isa\", \"Region\")\n(\"region.pattern\", \"name\", \"The pattern workshop\")\n(\"region.pattern\", \"question\", \"What changes while the pattern holds?\")\n(\"region.pattern\", \"light\", \"unseen\")\n(\"region.pattern\", \"place\", \"place.tiling\")\n(\"region.pattern\", \"place\", \"place.code\")\n(\"region.laboratory\", \"isa\", \"Region\")\n(\"region.laboratory\", \"name\", \"The working laboratory\")\n(\"region.laboratory\", \"question\", \"What would make the explanations disagree?\")\n(\"region.laboratory\", \"light\", \"unseen\")\n(\"region.laboratory\", \"place\", \"place.laboratory\")\n(\"region.laboratory\", \"place\", \"place.cost\")\n(\"region.cosmos\", \"isa\", \"Region\")\n(\"region.cosmos\", \"name\", \"The unfinished observatories\")\n(\"region.cosmos\", \"question\", \"How far does this explanation reach?\")\n(\"region.cosmos\", \"light\", \"unseen\")\n(\"region.cosmos\", \"place\", \"place.cosmos\")\n(\"region.cosmos\", \"place\", \"place.scale\")\n(\"region.shared\", \"isa\", \"Region\")\n(\"region.shared\", \"name\", \"The crossing of paths\")\n(\"region.shared\", \"question\", \"Who lives with the consequences?\")\n(\"region.shared\", \"light\", \"boundary\")\n(\"region.shared\", \"place\", \"place.coexistence\")\n(\"region.shared\", \"place\", \"place.weights\")\n(\"region.meaning\", \"isa\", \"Region\")\n(\"region.meaning\", \"name\", \"The quiet horizon\")\n(\"region.meaning\", \"question\", \"What may we hope for?\")\n(\"region.meaning\", \"light\", \"boundary\")\n(\"region.meaning\", \"place\", \"place.hiddenness\")\n(\"region.meaning\", \"place\", \"place.hope\")\n(\"region.meaning\", \"place\", \"place.texts\")\n(\"region.commons\", \"isa\", \"Region\")\n(\"region.commons\", \"name\", \"The unfinished commons\")\n(\"region.commons\", \"question\", \"What can we leave for one another?\")\n(\"region.commons\", \"light\", \"boundary\")\n(\"region.commons\", \"place\", \"place.commons\")\n(\"region.commons\", \"place\", \"place.closedpath\")\n(\"file.retained/.nojekyll\", \"isa\", \"PublicationAsset\")\n(\"file.retained/.nojekyll\", \"path\", \"retained/.nojekyll\")\n(\"file.retained/app.js\", \"isa\", \"PublicationAsset\")\n(\"file.retained/app.js\", \"path\", \"retained/app.js\")\n(\"file.retained/assets/atlas-grid.svg\", \"isa\", \"PublicationAsset\")\n(\"file.retained/assets/atlas-grid.svg\", \"path\", \"retained/assets/atlas-grid.svg\")\n(\"file.retained/assets/mark.svg\", \"isa\", \"PublicationAsset\")\n(\"file.retained/assets/mark.svg\", \"path\", \"retained/assets/mark.svg\")\n(\"file.retained/assets/terrain.svg\", \"isa\", \"PublicationAsset\")\n(\"file.retained/assets/terrain.svg\", \"path\", \"retained/assets/terrain.svg\")\n(\"file.retained/CNAME\", \"isa\", \"PublicationAsset\")\n(\"file.retained/CNAME\", \"path\", \"retained/CNAME\")\n(\"file.retained/coverage.values.rel\", \"isa\", \"PublicationAsset\")\n(\"file.retained/coverage.values.rel\", \"path\", \"retained/coverage.values.rel\")\n(\"file.retained/enchantment.css\", \"isa\", \"PublicationAsset\")\n(\"file.retained/enchantment.css\", \"path\", \"retained/enchantment.css\")\n(\"file.retained/en