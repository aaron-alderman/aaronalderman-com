("v27", "scalar", "{\n  \"spPolicy\": {\n    \"protocol\": \"encounter/source-presentation-policy/1\",\n    \"status\": \"supplied-bootstrap-presentation-definition\",\n    \"roles\": [\n      \"plain\",\n      \"comment\",\n      \"keyword\",\n      \"string\",\n      \"property\",\n      \"number\",\n      \"boolean\",\n      \"reference\",\n      \"identifier\",\n      \"operator\",\n      \"punctuation\",\n      \"identity\",\n      \"predicate\",\n      \"type\"\n    ],\n    \"themesAllowed\": [\n      \"light\",\n      \"dark\"\n    ],\n    \"jsonPatternPath\": [\n      \"queries\",\n      \"source.jsonSpan\",\n      6,\n      \"args\",\n      \"pattern\"\n    ],\n    \"maxCodeUnits\": 160000,\n    \"maxParts\": 18000,\n    \"identifierPattern\": \"[@$]?[A-Za-z_][A-Za-z0-9_.-]*\",\n    \"keywords\": [\n      \"module\",\n      \"entity\",\n      \"view\",\n      \"of\",\n      \"isa\",\n      \"representation\",\n      \"given\",\n      \"as\",\n      \"require\",\n      \"equals\",\n      \"return\",\n      \"render\",\n      \"events\",\n      \"edit\",\n      \"through\",\n      \"here\",\n      \"in\",\n      \"show\",\n      \"each\",\n      \"run\",\n      \"arguments\",\n      \"let\",\n      \"assert\",\n      \"otherwise\",\n      \"port\",\n      \"call\",\n      \"when\",\n      \"fold\",\n      \"starts\",\n      \"yield\",\n      \"try\",\n      \"catch\",\n      \"type\",\n      \"valueType\",\n      \"expects\",\n      \"process-module\",\n      \"profile\",\n      \"process\"\n    ],\n    \"punctuation\": [\n      \"[\",\n      \"]\",\n      \"{\",\n      \"}\",\n      \":\",\n      \",\",\n      \"(\",\n      \")\",\n      \";\"\n    ],\n    \"operators\": [\n      \"=\",\n      \"→\",\n      \"-\"\n    ],\n    \"fileProfiles\": [\n      {\n        \"pattern\": \"\\\\.values.rel$\",\n        \"language\": \"json\"\n      },\n      {\n        \"pattern\": \"\\\\.rel$\",\n        \"language\": \"rel\"\n      },\n      {\n        \"pattern\": \"\\\\.encounter$\",\n        \"language\": \"encounter\"\n      },\n      {\n        \"pattern\": \"\\\\.temple$\",\n        \"language\": \"temple\"\n      },\n      {\n        \"pattern\": \"\\\\.(?:js|mjs|cjs)$\",\n        \"language\": \"javascript\"\n      },\n      {\n        \"pattern\": \"\\\\.(?:md|markdown)$\",\n        \"language\": \"markdown\"\n      }\n    ],\n    \"javascriptRoles\": [\n      {\n        \"role\": \"string\",\n        \"kinds\": [\n          \"string\",\n          \"template\",\n          \"`\"\n        ]\n      },\n      {\n        \"role\": \"number\",\n        \"kinds\": [\n          \"num\",\n          \"bigint\",\n          \"decimal\"\n        ]\n      },\n      {\n        \"role\": \"identifier\",\n        \"kinds\": [\n          \"name\",\n          \"privateId\"\n        ]\n      },\n      {\n        \"role\": \"punctuation\",\n        \"kinds\": [\n          \"(\",\n          \")\",\n          \"{\",\n          \"}\",\n          \"[\",\n          \"]\",\n          \",\",\n          \";\",\n          \":\",\n          \".\"\n        ]\n      },\n      {\n        \"role\": \"operator\",\n        \"kinds\": [\n          \"=\",\n          \"_=\",\n          \"==/!=/===/!==\",\n          \"+/-\",\n          \"*\",\n          \"/\",\n          \"%\",\n          \"**\",\n          \"++/--\",\n          \"!/~\",\n          \"=>\",\n          \"?\",\n          \"?.\",\n          \"??\",\n          \"||\",\n          \"&&\",\n          \"|\",\n          \"&\",\n          \"^\",\n          \"${\"\n        ]\n      },\n      {\n        \"role\": \"string\",\n        \"kinds\": [\n          \"regexp\"\n        ]\n      }\n    ],\n    \"themes\": [\n      {\n        \"id\": \"light\",\n        \"roles\": {\n          \"plain\": \"#20323f\",\n          \"comment\": \"#657166\",\n          \"keyword\": \"#754a91\",\n          \"string\": \"#196641\",\n          \"property\": \"#07596c\",\n          \"number\": \"#96501b\",\n          \"boolean\": \"#854c88\",\n          \"reference\": \"#6e4590\",\n          \"identifier\": \"#20323f\",\n          \"operator\": \"#7d431c\",\n          \"punctuation\": \"#52636a\",\n          \"identity\": \"#07596c\",\n          \"predicate\": \"#754a91\",\n          \"type\": \"#8c4b16\"\n        }\n      },\n      {\n        \"id\": \"dark\",\n        \"roles\": {\n          \"plain\": \"#d8e7e3\",\n          \"comment\": \"#94a99e\",\n          \"keyword\": \"#e6b6fa\",\n          \"string\": \"#b9e1a1\",\n          \"property\": \"#91dbe5\",\n          \"number\": \"#f6c394\",\n          \"boolean\": \"#e6b6fa\",\n          \"reference\": \"#f1d293\",\n          \"identifier\": \"#d8e7e3\",\n          \"operator\": \"#f6b5a4\",\n          \"punctuation\": \"#adc6c9\",\n          \"identity\": \"#91dbe5\",\n          \"predicate\": \"#e6b6fa\",\n          \"type\": \"#ffd38b\"\n        }\n      }\n    ],\n    \"layoutRules\": [\n      {\n        \"selector\": \".sp-code\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"display\",\n            \"value\": \"block\"\n          },\n          {\n            \"property\": \"font\",\n            \"value\": \"inherit\"\n          },\n          {\n            \"property\": \"white-space\",\n            \"value\": \"inherit\"\n          },\n          {\n            \"property\": \"counter-reset\",\n            \"value\": \"sp-line\"\n          }\n        ]\n      },\n      {\n        \"selector\": \".sp-code .sp-line\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"display\",\n            \"value\": \"inline\"\n          },\n          {\n            \"property\": \"padding\",\n            \"value\": \"0\"\n          },\n          {\n            \"property\": \"min-height\",\n            \"value\": \"0\"\n          }\n        ]\n      },\n      {\n        \"selector\": \".sp-code[data-numbered=\\\"true\\\"] .sp-line::before\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"content\",\n            \"value\": \"attr(data-line)\"\n          },\n          {\n            \"property\": \"display\",\n            \"value\": \"inline-block\"\n          },\n          {\n            \"property\": \"width\",\n            \"value\": \"3ch\"\n          },\n          {\n            \"property\": \"padding-right\",\n            \"value\": \"1.5ch\"\n          },\n          {\n            \"property\": \"text-align\",\n            \"value\": \"right\"\n          },\n          {\n            \"property\": \"opacity\",\n            \"value\": \".55\"\n          },\n          {\n            \"property\": \"user-select\",\n            \"value\": \"none\"\n          },\n          {\n            \"property\": \"font-size\",\n            \"value\": \".85em\"\n          }\n        ]\n      },\n      {\n        \"selector\": \".sp-code[data-numbered=\\\"false\\\"] .sp-line::before\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"content\",\n            \"value\": \"none\"\n          }\n        ]\n      },\n      {\n        \"selector\": \".sp-code .highlight\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"background\",\n            \"value\": \"#b98b3933\"\n          },\n          {\n            \"property\": \"outline\",\n            \"value\": \"1px solid #b98b3966\"\n          }\n        ]\n      },\n      {\n        \"selector\": \".sp-code .sp-comment\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"font-style\",\n            \"value\": \"italic\"\n          }\n        ]\n      },\n      {\n        \"selector\": \".sp-code:focus-visible\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"outline\",\n            \"value\": \"2px solid currentColor\"\n          },\n          {\n            \"property\": \"outline-offset\",\n            \"value\": \"4px\"\n          }\n        ]\n      },\n      {\n        \"selector\": \".sp-code .sp-type\",\n        \"context\": null,\n        \"declarations\": [\n          {\n            \"property\": \"font-weight\",\n            \"value\": \"600\"\n          }\n        ]\n      }\n    ],\n    \"referenceSigil\": \"$\",\n    \"fileAliases\": {\n      \"facts\": \"source/experiment/story.rel\",\n      \"encounter\": \"source/experiment/story.encounter\",\n      \"contracts\": \"source/experiment/contracts.rel\"\n    },\n    \"typeIntroducers\": {\n      \"encounter\": [\n        \"isa\",\n        \"representation\",\n        \"return\"\n      ],\n      \"temple\": [\n        \"isa\",\n        \"type\",\n        \"valueType\",\n        \"expects\"\n      ]\n    },\n    \"typePredicates\": [\n      \"isa\",\n      \"type\",\n      \"valueType\",\n      \"expects\",\n      \"A.accepts\"\n    ]\n  },\n  \"spGrammar\": {\n    \"protocol\": \"temple/surface-process-module/1\",\n    \"queries\": {\n      \"source.rel\": [\n        {\n          \"port\": \"text.split\",\n          \"args\": {\n            \"value\": \"$text\",\n            \"pattern\": \"(\\\\(\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\"\\\\s*,\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\"\\\\s*,\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\"(?:\\\\s*,\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\")?\\\\s*\\\\)|//[^\\\\r\\\\n]*)\"\n          },\n          \"into\": \"relPieces\"\n        },\n        {\n          \"fold\": \"$relPieces\",\n          \"as\": \"relPiece\",\n          \"accumulator\": \"relState\",\n          \"initial\": {\n            \"facts\": [\n              \"list\"\n            ],\n            \"origins\": [\n              \"list\"\n            ],\n            \"offset\": 0,\n            \"line\": 1,\n            \"column\": 1,\n            \"prefix\": \"\",\n            \"error\": null\n          },\n          \"steps\": [\n            {\n              \"let\": \"relFacts\",\n              \"value\": \"$relState.facts\"\n            },\n            {\n              \"let\": \"relOrigins\",\n              \"value\": \"$relState.origins\"\n            },\n            {\n              \"let\": \"relError\",\n              \"value\": \"$relState.error\"\n            },\n            {\n              \"port\": \"text.trim\",\n              \"args\": {\n                \"value\": \"$relPiece\"\n              },\n              \"into\": \"relTrim\"\n            },\n            {\n              \"when\": [\n                \"and\",\n                [\n                  \"not\",\n                  \"$relError\"\n                ],\n                [\n                  \"not\",\n                  [\n                    \"eq\",\n                    \"$relTrim\",\n                    \"\"\n                  ]\n                ]\n              ],\n              \"then\": [\n                {\n                  \"try\": [\n                    {\n                      \"port\": \"text.matches\",\n                      \"args\": {\n                        \"value\": \"$relTrim\",\n                        \"pattern\": \"^//\"\n                      },\n                      \"into\": \"relComment\"\n                    },\n                    {\n                      \"when\": \"$relComment\",\n                      \"then\": [\n                        {\n                          \"port\": \"text.trim\",\n                          \"args\": {\n                            \"value\": \"$relState.prefix\"\n                          },\n                          \"into\": \"relPrefix\"\n                        },\n                        {\n                          \"assert\": [\n                            \"eq\",\n                            \"$relPrefix\",\n                            \"\"\n                          ],\n                          \"message\": \"Use // comments on their own line.\"\n                        }\n                      ]\n                    },\n                    {\n                      \"when\": [\n                        \"not\",\n                        \"$relComment\"\n                      ],\n                      \"then\": [\n                        {\n                          \"port\": \"text.matches\",\n                          \"args\": {\n                            \"value\": \"$relPiece\",\n                            \"pattern\": \"^\\\\(\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\"\\\\s*,\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\"\\\\s*,\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\"(?:\\\\s*,\\\\s*\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\")?\\\\s*\\\\)$\"\n                          },\n                          \"into\": \"relTuple\"\n                        },\n                        {\n                          \"assert\": \"$relTuple\",\n                          \"message\": \"Expected a REL tuple: (\\\"thing\\\", \\\"field\\\", \\\"value\\\").\"\n                        },\n                        {\n                          \"port\": \"text.split\",\n                          \"args\": {\n                            \"value\": \"$relPiece\",\n                            \"pattern\": \"(\\\"(?:\\\\\\\\[\\\\s\\\\S]|[^\\\"\\\\\\\\])*\\\")\"\n                          },\n                          \"into\": \"relAtoms\"\n                        },\n                        {\n                          \"port\": \"json.parse\",\n                          \"args\": {\n                            \"text\": [\n                              \"at\",\n                              \"$relAtoms\",\n                              1\n                            ]\n                          },\n                          \"into\": \"relS\"\n                        },\n                        {\n                          \"port\": \"json.parse\",\n                          \"args\": {\n                            \"text\": [\n                              \"at\",\n                              \"$relAtoms\",\n                              3\n                            ]\n                          },\n                          \"into\": \"relP\"\n                        },\n                        {\n                          \"port\": \"json.parse\",\n                          \"args\": {\n                            \"text\": [\n                              \"at\",\n                              \"$relAtoms\",\n                              5\n                            ]\n                          },\n                          \"into\": \"relO\"\n                        },\n                        {\n                          \"let\": \"relPol\",\n                          \"value\": \"is\"\n                        },\n                        {\n                          \"when\": [\n                            \"eq\",\n                            [\n                              \"count\",\n                              \"$relAtoms\"\n                            ],\n                            9\n                          ],\n                          \"then\": [\n                            {\n                              \"port\": \"json.parse\",\n                              \"args\": {\n                                \"text\": [\n                                  \"at\",\n                                  \"$relAtoms\",\n                                  7\n                                ]\n                              },\n                              \"into\": \"relPol\"\n                            }\n                          ]\n                        },\n                        {\n                          \"assert\": [\n                            \"includes\",\n                            [\n                              \"list\",\n                              \"is\",\n                              \"is-not\"\n                            ],\n                            \"$relPol\"\n                          ],\n                          \"message\": \"Polarity must be is or is-not.\"\n                        },\n                        {\n                          \"let\": \"relValueStart\",\n                          \"value\": [\n                            \"add\",\n                            \"$relState.offset\",\n                            [\n                              \"fold\",\n                              [\n                                \"list\",\n                                0,\n                                1,\n                                2,\n                                3,\n                                4\n                              ],\n                              \"relPart\",\n                              \"relSize\",\n                              0,\n                              [\n                                \"add\",\n                                \"$relSize\",\n                                [\n                                  \"count\",\n                                  [\n                                    \"at\",\n                                    \"$relAtoms\",\n                                    \"$relPart\"\n                                  ]\n                                ]\n                              ]\n                            ]\n                          ]\n                        },\n                        {\n                          \"let\": \"relOrigins\",\n                          \"value\": [\n                            \"append\",\n                            \"$relOrigins\",\n                            [\n                              \"list\",\n                              {\n                                \"index\": [\n                                  \"count\",\n                                  \"$relFacts\"\n                                ],\n                                \"span\": {\n                                  \"file\": \"$file\",\n                                  \"line\": \"$relState.line\",\n                                  \"column\": \"$relState.column\",\n                                  \"offset\": \"$relState.offset\",\n                                  \"endOffset\": [\n                                    \"add\",\n                                    \"$relState.offset\",\n                                    [\n                                      \"count\",\n                                      \"$relPiece\"\n                                    ]\n                                  ],\n                                  \"valueStart\": \"$relValueStart\",\n                                  \"valueEnd\": [\n                                    \"add\",\n                                    \"$relValueStart\",\n                                    [\n                                      \"count\",\n                                      [\n                                        \"at\",\n                                        \"$relAtoms\",\n                                        5\n                                      ]\n                                    ]\n                                  ]\n                                }\n                              }\n                            ]\n                          ]\n                        },\n                        {\n                          \"let\": \"relFacts\",\n                          \"value\": [\n                            \"append\",\n                            \"$relFacts\",\n                            [\n                              \"list\",\n                              {\n                                \"s\": \"$relS\",\n                                \"p\": \"$relP\",\n                                \"o\": \"$relO\",\n                                \"pol\": \"$relPol\"\n                              }\n                            ]\n                          ]\n                        }\n                      ]\n                    }\n                  ],\n                  \"error\": \"relFault\",\n                  \"catch\": [\n                    {\n                      \"port\": \"text.indexOf\",\n                      \"args\": {\n                        \"value\": \"$relPiece\",\n                        \"search\": \"$relTrim\",\n                        \"from\": 0\n                      },\n                      \"into\": \"relProblemOffset\"\n                    },\n                    {\n                      \"port\": \"text.slice\",\n                      \"args\": {\n                        \"value\": \"$relPiece\",\n                        \"start\": 0,\n                        \"end\": \"$relProblemOffset\"\n                      },\n                      \"into\": \"relProblemPrefix\"\n                    },\n                    {\n                      \"port\": \"text.split\",\n                      \"args\": {\n                        \"value\": \"$relProblemPrefix\",\n                        \"pattern\": \"\\\\n\"\n                      },\n                      \"into\": \"relProblemLines\"\n                    },\n                    {\n                      \"let\": \"relError\",\n                      \"value\": {\n                        \"code\": \"ENCOUNTER-SOURCE-001\",\n                        \"summary\": \"$relFault.message\",\n                        \"span\": {\n                          \"file\": \"$file\",\n                          \"line\": [\n                            \"add\",\n                            \"$relState.line\",\n                            [\n                              \"add\",\n                              [\n                                \"count\",\n                                \"$relProblemLines\"\n                              ],\n                              -1\n                            ]\n                          ],\n                          \"column\": [\n                            \"if\",\n                            [\n                              \"eq\",\n                              [\n                                \"count\",\n                                \"$relProblemLines\"\n                              ],\n                              1\n                            ],\n                            [\n                              \"add\",\n                              \"$relState.column\",\n                              \"$relProblemOffset\"\n                            ],\n                            [\n                              \"add\",\n                              [\n                                \"count\",\n                                [\n                                  \"at\",\n                                  \"$relProblemLines\",\n                                  [\n                                    \"add\",\n                                    [\n                                      \"count\",\n                                      \"$relProblemLines\"\n                                    ],\n                                    -1\n                                  ]\n                                ]\n                              ],\n                              1\n                            ]\n                          ]\n                        },\n                        \"correction\": \"Correct this tuple, then try the file again.\"\n                      }\n                    }\n                  ]\n                }\n              ]\n            },\n            {\n              \"port\": \"text.split\",\n              \"args\": {\n                \"value\": \"$relPiece\",\n                \"pattern\": \"\\\\n\"\n              },\n              \"into\": \"relLines\"\n            }\n          ],\n          \"yield\": {\n            \"facts\": \"$relFacts\",\n            \"origins\": \"$relOrigins\",\n            \"offset\": [\n              \"add\",\n              \"$relState.offset\",\n              [\n                \"count\",\n                \"$relPiece\"\n              ]\n            ],\n            \"line\": [\n              \"add\",\n              \"$relState.line\",\n              [\n                \"add\",\n                [\n                  \"count\",\n                  \"$relLines\"\n                ],\n                -1\n              ]\n            ],\n            \"column\": [\n              \"if\",\n              [\n                \"eq\",\n                [\n                  \"count\",\n                  \"$relLines\"\n                ],\n                1\n              ],\n              [\n                \"add\",\n                \"$relState.column\",\n                [\n                  \"count\",\n                  \"$relPiece\"\n                ]\n              ],\n              [\n                \"add\",\n                [\n                  \"count\",\n                  [\n                    \"at\",\n                    \"$relLines\",\n                    [\n                      \"add\",\n                      [\n                        \"count\",\n                        \"$relLines\"\n                      ],\n                      -1\n                    ]\n                  ]\n                ],\n                1\n              ]\n            ],\n            \"prefix\": [\n              \"if\",\n              [\n                \"eq\",\n                [\n                  \"count\",\n                  \"$relLines\"\n                ],\n                1\n              ],\n              [\n                \"concat\",\n                \"$relState.prefix\",\n                \"$relPiece\"\n              ],\n              [\n                \"at\",\n                \"$relLines\",\n                [\n                  \"add\",\n                  [\n                    \"count\",\n                    \"$relLines\"\n                  ],\n                  -1\n                ]\n              ]\n            ],\n            \"error\": \"$relError\"\n          },\n          \"into\": \"relState\"\n        },\n        {\n          \"let\": \"result\",\n          \"value\": {\n            \"ok\": [\n              \"not\",\n              \"$relState.error\"\n            ],\n            \"facts\": [\n              \"if\",\n              \"$relState.error\",\n              [\n                \"list\"\n              ],\n              \"$relState.facts\"\n            ],\n            \"origins\": [\n              \"if\",\n              \"$relState.error\",\n              [\n                \"list\"\n              ],\n              \"$relState.origins\"\n            ],\n            \"module\": \"$file\",\n            \"diagnostic\": \"$relState.error\"\n          }\n        }\n      ],\n      \"source.compile\": [\n        {\n          \"port\": \"text.matches\",\n          \"args\": {\n            \"value\": \"$text\",\n            \"pattern\": \"^[\\\\s\\\\S]{0,524288}$\"\n          },\n          \"into\": \"sourceWithinLimit\"\n        },\n        {\n          \"assert\": \"$sourceWithinLimit\",\n          \"message\": \"ENCOUNTER-SOURCE-005: This editor tries files up to 524,288 characters. Download the buffer or split the source.\"\n        },\n        {\n          \"let\": \"sourceText\",\n          \"value\": \"$text\"\n        },\n        {\n          \"let\": \"sourceFile\",\n          \"value\": \"$file\"\n        },\n        {\n          \"let\": \"sourceFormat\",\n          \"value\": \"$format\"\n        },\n        {\n          \"let\": \"sourceResult\",\n          \"value\": null\n        },\n        {\n          \"when\": [\n            \"eq\",\n            \"$format\",\n            \"rel\"\n          ],\n          \"then\": [\n            {\n              \"call\": \"source.rel\"\n            },\n            {\n              \"let\": \"sourceResult\",\n              \"value\": \"$result\"\n            }\n          ]\n        },\n        {\n          \"when\": [\n            \"eq\",\n            \"$sourceFormat\",\n            \"temple\"\n          ],\n          \"then\": [\n            {\n              \"call\": \"language.compile\"\n            },\n            {\n              \"let\": \"sourceResult\",\n              \"value\": \"$result\"\n            },\n            {\n              \"when\": \"$sourceResult.ok\",\n              \"then\": [\n                {\n                  \"port\": \"text.split\",\n                  \"args\": {\n                    \"value\": \"$sourceText\",\n                    \"pattern\": \"\\\\n\"\n                  },\n                  \"into\": \"sourceLines\"\n                },\n                {\n                  \"fold\": \"$sourceLines\",\n                  \"as\": \"sourceLine\",\n                  \"accumulator\": \"sourceLocations\",\n                  \"initial\": {\n                    \"offset\": 0,\n                    \"locations\": [\n                      \"list\"\n                    ]\n                  },\n                  \"steps\": [\n                    {\n                      \"port\": \"text.matches\",\n                      \"args\": {\n                        \"value\": \"$sourceLine\",\n                        \"pattern\": \"\\\\r$\"\n                      },\n                      \"into\": \"sourceLineHasCR\"\n                    }\n                  ],\n                  \"yield\": {\n                    \"offset\": [\n                      \"add\",\n                      \"$sourceLocations.offset\",\n                      [\n                        \"add\",\n                        [\n                          \"count\",\n                          \"$sourceLine\"\n                        ],\n                        1\n                      ]\n                    ],\n                    \"locations\": [\n                      \"append\",\n                      \"$sourceLocations.locations\",\n                      [\n                        \"list\",\n                        {\n                          \"offset\": \"$sourceLocations.offset\",\n                          \"endOffset\": [\n                            \"add\",\n                            \"$sourceLocations.offset\",\n                            [\n                              \"add\",\n                              [\n                                \"count\",\n                                \"$sourceLine\"\n                              ],\n                              [\n                                \"if\",\n                                \"$sourceLineHasCR\",\n                                -1,\n                                0\n                              ]\n                            ]\n                          ]\n                        }\n                      ]\n                    ]\n                  },\n                  \"into\": \"sourceLocations\"\n                },\n                {\n                  \"let\": \"sourceOrigins\",\n                  \"value\": [\n                    \"map\",\n                    \"$sourceResult.origins\",\n                    \"sourceOrigin\",\n                    {\n                      \"index\": \"$sourceOrigin.index\",\n                      \"span\": {\n                        \"file\": \"$sourceFile\",\n                        \"line\": \"$sourceOrigin.span.line\",\n                        \"column\": \"$sourceOrigin.span.column\",\n                        \"offset\": [\n                          \"at\",\n                          [\n                            \"at\",\n                            \"$sourceLocations.locations\",\n                            [\n                              \"add\",\n                              \"$sourceOrigin.span.line\",\n                              -1\n                            ]\n                          ],\n                          \"offset\"\