("v7674", "entry", "v7681")
("v7681", "type", "Entry")
("v7681", "key", "boundary")
("v7682", "type", "String")
("v7682", "scalar", "Lexical source checks target redundant personal home-return controls, orphan return stylesheets and explicit inline body bottom reservations. They do not certify arbitrary CSS, computed geometry, duplicate navigation intent, runtime states or visual fitness. Per-route browser readings and their initial-state limits are recorded separately in assurance/rendered-layout.values.rel. Registered CSS is checked for unconditional body padding-bottom/margin-bottom in positive supported units. Shorthands, variables, fractional values below one unit, selector groups, cascade and other stylesheet patterns remain outside this check.")
("v7681", "value", "v7682")
