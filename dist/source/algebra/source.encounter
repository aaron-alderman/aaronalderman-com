# Authoritative Encounter source for source.
# JSON is generated by the selected process frontend.
# Executed through the existing lowering, admission and kernel.
# Source-owned after the batch correspondence gate.
process-module "temple/surface-process-module/1"
profile "encounter/module-batch/source/1"

process source.rel:
  port text.split {
    value = $text;
    pattern = "(\\(\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"\\s*,\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"\\s*,\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"(?:\\s*,\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\")?\\s*\\)|//[^\\r\\n]*)"
  } → relPieces
  fold $relPieces as relPiece; relState starts {
    facts = list();
    origins = list();
    offset = 0;
    line = 1;
    column = 1;
    prefix = "";
    error = null
  }:
    let relFacts = $relState.facts
    let relOrigins = $relState.origins
    let relError = $relState.error
    port text.trim { value = $relPiece } → relTrim
    when and(not($relError), not(eq($relTrim, ""))):
      try:
        port text.matches { value = $relTrim; pattern = "^//" } → relComment
        when $relComment:
          port text.trim { value = $relState.prefix } → relPrefix
          assert eq($relPrefix, "")
            otherwise "Use // comments on their own line."
        when not($relComment):
          port text.matches {
            value = $relPiece;
            pattern = "^\\(\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"\\s*,\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"\\s*,\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"(?:\\s*,\\s*\"(?:\\\\[\\s\\S]|[^\"\\\\])*\")?\\s*\\)$"
          } → relTuple
          assert $relTuple
            otherwise "Expected a REL tuple: (\"thing\", \"field\", \"value\")."
          port text.split { value = $relPiece; pattern = "(\"(?:\\\\[\\s\\S]|[^\"\\\\])*\")" } → relAtoms
          port json.parse { text = at($relAtoms, 1) } → relS
          port json.parse { text = at($relAtoms, 3) } → relP
          port json.parse { text = at($relAtoms, 5) } → relO
          let relPol = "is"
          when eq(count($relAtoms), 9):
            port json.parse { text = at($relAtoms, 7) } → relPol
          assert includes(list("is", "is-not"), $relPol)
            otherwise "Polarity must be is or is-not."
          let relValueStart = add(
            $relState.offset,
            fold(
              list(0, 1, 2, 3, 4),
              "relPart",
              "relSize",
              0,
              add($relSize, count(at($relAtoms, $relPart)))
            )
          )
          let relOrigins = append(
            $relOrigins,
            list(
              {
                index = count($relFacts);
                span = {
                  file = $file;
                  line = $relState.line;
                  column = $relState.column;
                  offset = $relState.offset;
                  endOffset = add($relState.offset, count($relPiece));
                  valueStart = $relValueStart;
                  valueEnd = add($relValueStart, count(at($relAtoms, 5)))
                }
              }
            )
          )
          let relFacts = append($relFacts, list({ s = $relS; p = $relP; o = $relO; pol = $relPol }))
      catch relFault:
        port text.indexOf { value = $relPiece; search = $relTrim; from = 0 } → relProblemOffset
        port text.slice { value = $relPiece; start = 0; end = $relProblemOffset } → relProblemPrefix
        port text.split { value = $relProblemPrefix; pattern = "\\n" } → relProblemLines
        let relError = {
          code = "ENCOUNTER-SOURCE-001";
          summary = $relFault.message;
          span = {
            file = $file;
            line = add($relState.line, add(count($relProblemLines), -1));
            column = if(
              eq(count($relProblemLines), 1),
              add($relState.column, $relProblemOffset),
              add(count(at($relProblemLines, add(count($relProblemLines), -1))), 1)
            )
          };
          correction = "Correct this tuple, then try the file again."
        }
    port text.split { value = $relPiece; pattern = "\\n" } → relLines
    yield {
    facts = $relFacts;
    origins = $relOrigins;
    offset = add($relState.offset, count($relPiece));
    line = add($relState.line, add(count($relLines), -1));
    column = if(
      eq(count($relLines), 1),
      add($relState.column, count($relPiece)),
      add(count(at($relLines, add(count($relLines), -1))), 1)
    );
    prefix = if(
      eq(count($relLines), 1),
      concat($relState.prefix, $relPiece),
      at($relLines, add(count($relLines), -1))
    );
    error = $relError
  } → relState
  let result = {
    ok = not($relState.error);
    facts = if($relState.error, list(), $relState.facts);
    origins = if($relState.error, list(), $relState.origins);
    module = $file;
    diagnostic = $relState.error
  }

process source.compile:
  port text.matches { value = $text; pattern = "^[\\s\\S]{0,524288}$" } → sourceWithinLimit
  assert $sourceWithinLimit
    otherwise "ENCOUNTER-SOURCE-005: This editor tries files up to 524,288 characters. Download the buffer or split the source."
  let sourceText = $text
  let sourceFile = $file
  let sourceFormat = $format
  let sourceResult = null
  when eq($format, "rel"):
    call source.rel
    let sourceResult = $result
  when eq($sourceFormat, "temple"):
    call language.compile
    let sourceResult = $result
    when $sourceResult.ok:
      port text.split { value = $sourceText; pattern = "\\n" } → sourceLines
      fold $sourceLines as sourceLine; sourceLocations starts { offset = 0; locations = list() }:
        port text.matches { value = $sourceLine; pattern = "\\r$" } → sourceLineHasCR
        yield {
        offset = add($sourceLocations.offset, add(count($sourceLine), 1));
        locations = append(
          $sourceLocations.locations,
          list(
            {
              offset = $sourceLocations.offset;
              endOffset = add($sourceLocations.offset, add(count($sourceLine), if($sourceLineHasCR, -1, 0)))
            }
          )
        )
      } → sourceLocations
      let sourceOrigins = map(
        $sourceResult.origins,
        "sourceOrigin",
        {
          index = $sourceOrigin.index;
          span = {
            file = $sourceFile;
            line = $sourceOrigin.span.line;
            column = $sourceOrigin.span.column;
            offset = at(at($sourceLocations.locations, add($sourceOrigin.span.line, -1)), "offset");
            endOffset = at(at($sourceLocations.locations, add($sourceOrigin.span.line, -1)), "endOffset");
            valueStart = at(at($sourceLocations.locations, add($sourceOrigin.span.line, -1)), "offset");
            valueEnd = at(at($sourceLocations.locations, add($sourceOrigin.span.line, -1)), "endOffset")
          }
        }
      )
      port record.put { record = $sourceResult; key = "origins"; value = $sourceOrigins } → sourceResult
  when includes(list("process", "json"), $sourceFormat):
    try:
      port json.parse { text = $sourceText } → sourceJson
      let sourceResult = {
        ok = true;
        facts = list();
        origins = list();
        module = $sourceFile;
        json = $sourceJson;
        diagnostic = null
      }
    catch sourceJsonError:
      let sourceResult = {
        ok = false;
        facts = list();
        origins = list();
        module = $sourceFile;
        diagnostic = {
          code = "ENCOUNTER-SOURCE-002";
          summary = $sourceJsonError.message;
          span = { file = $sourceFile; line = 1; column = 1 };
          correction = "Correct the JSON source and try again."
        }
      }
  assert $sourceResult
    otherwise "ENCOUNTER-SOURCE-003: This source is derived. Follow its inputs or make a separate example."
  port record.put { record = $sourceResult; key = "text"; value = $sourceText } → sourceResult
  port record.put { record = $sourceResult; key = "file"; value = $sourceFile } → sourceResult
  port record.put { record = $sourceResult; key = "format"; value = $sourceFormat } → sourceResult
  let result = $sourceResult

process source.encode:
  fold $sourceFacts as sourceFact; sourceRows starts list():
    port json.stringify { value = $sourceFact.s } → sourceS
    port json.stringify { value = $sourceFact.p } → sourceP
    port json.stringify { value = $sourceFact.o } → sourceO
    yield append(
    $sourceRows,
    list(
      if(
        eq($format, "temple"),
        concat("  ", $sourceFact.p, " ", $sourceO),
        concat(
          "(",
          $sourceS,
          ", ",
          $sourceP,
          ", ",
          $sourceO,
          if(eq($sourceFact.pol, "is-not"), ", \"is-not\"", ""),
          ")"
        )
      )
    )
  ) → sourceRows
  port text.join { values = $sourceRows; separator = "\n" } → result

process source.patch:
  let sourceMatches = filter(
    range(count($sourceDocument.facts)),
    "sourcePosition",
    and(
      eq(at(at($sourceDocument.facts, add($sourcePosition, -1)), "s"), $sourceSubject),
      eq(at(at($sourceDocument.facts, add($sourcePosition, -1)), "p"), $sourceProperty)
    )
  )
  let format = $sourceDocument.format
  let sourceFacts = map(
    $sourceValues,
    "sourceValue",
    { s = $sourceSubject; p = $sourceProperty; o = $sourceValue; pol = "is" }
  )
  call source.encode
  let sourceReplacement = $result
  fold $sourceMatches as sourcePosition; sourcePatch starts { end = 0; pieces = list(); first = true }:
    let sourceSpan = at(at($sourceDocument.origins, add($sourcePosition, -1)), "span")
    port text.slice { value = $sourceDocument.text; start = $sourcePatch.end; end = $sourceSpan.offset } → sourcePrefix
    yield {
    end = $sourceSpan.endOffset;
    pieces = append(
      $sourcePatch.pieces,
      list($sourcePrefix, if($sourcePatch.first, $sourceReplacement, ""))
    );
    first = false
  } → sourcePatch
  when not(eq(count($sourceMatches), 0)):
    port text.slice {
      value = $sourceDocument.text;
      start = $sourcePatch.end;
      end = count($sourceDocument.text)
    } → sourceSuffix
    port text.join { values = append($sourcePatch.pieces, list($sourceSuffix)); separator = "" } → result
  when eq(count($sourceMatches), 0):
    let sourceSubjectPositions = filter(
      range(count($sourceDocument.facts)),
      "sourcePosition",
      eq(at(at($sourceDocument.facts, add($sourcePosition, -1)), "s"), $sourceSubject)
    )
    assert not(eq(count($sourceSubjectPositions), 0))
      otherwise "ENCOUNTER-SOURCE-004: Open the file to add a new identity."
    let sourceInsertion = at(
      at(
        $sourceDocument.origins,
        add(at($sourceSubjectPositions, add(count($sourceSubjectPositions), -1)), -1)
      ),
      "span"
    )
    port text.slice { value = $sourceDocument.text; start = 0; end = $sourceInsertion.endOffset } → sourcePrefix
    port text.slice {
      value = $sourceDocument.text;
      start = $sourceInsertion.endOffset;
      end = count($sourceDocument.text)
    } → sourceSuffix
    let result = concat($sourcePrefix, "\n", $sourceReplacement, $sourceSuffix)

process source.jsonSpan:
  port json.parse { text = $jsonSourceText } → jsonSpanValue
  fold $jsonSourcePath as jsonPointerPart; jsonPointer starts { node = $jsonSpanValue; path = list() }:
    port value.describe { value = $jsonPointer.node } → jsonPointerType
    port value.string { value = $jsonPointerPart } → jsonCanonicalPart
    when $jsonPointerType.array:
      port json.parse { text = $jsonCanonicalPart } → jsonCanonicalPart
    yield {
    node = at($jsonPointer.node, $jsonPointerPart);
    path = append($jsonPointer.path, list($jsonCanonicalPart))
  } → jsonPointer
  let jsonSourcePath = $jsonPointer.path
  let jsonPointValue = fold(
    $jsonSourcePath,
    "jsonPointKey",
    "jsonPointNode",
    $jsonSpanValue,
    at($jsonPointNode, $jsonPointKey)
  )
  port value.describe { value = $jsonPointValue } → jsonPointType
  assert not(eq($jsonPointType.type, "undefined"))
    otherwise "The source path is absent from the visible JSON."
  port text.split {
    value = $jsonSourceText;
    pattern = "(\"(?:[^\"\\\\]|\\\\.)*\"|[\\[\\]{}:,]|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|true|false|null)"
  } → jsonSpanParts
  fold $jsonSpanParts as jsonToken; jsonScan starts { offset = 0; stack = list(); span = null; done = false }:
    let jsonSpanStack = $jsonScan.stack
    let jsonSpanFound = $jsonScan.span
    let jsonSpanDone = $jsonScan.done
    port text.matches { value = $jsonToken; pattern = "^\\s*$" } → jsonSpanWhite
    when and(not($jsonSpanWhite), not($jsonSpanDone)):
      let jsonFrame = at($jsonSpanStack, add(count($jsonSpanStack), -1))
      let jsonIsClose = includes(list("}", "]"), $jsonToken)
      let jsonIsOpen = includes(list("{", "["), $jsonToken)
      when $jsonIsClose:
        when at($jsonFrame, "match"):
          let jsonSpanFound = { offset = $jsonSpanFound.offset; endOffset = add($jsonScan.offset, count($jsonToken)) }
          let jsonSpanDone = false
        let jsonSpanStack = map(
          range(add(count($jsonSpanStack), -1)),
          "jsonDepth",
          at($jsonSpanStack, add($jsonDepth, -1))
        )
      when eq($jsonToken, ","):
        port record.put {
          record = $jsonFrame;
          key = "phase";
          value = if(eq($jsonFrame.type, "object"), "key", "value")
        } → jsonFrame
        port record.put { record = $jsonFrame; key = "index"; value = add($jsonFrame.index, 1) } → jsonFrame
      when eq($jsonToken, ":"):
        port record.put { record = $jsonFrame; key = "phase"; value = "value" } → jsonFrame
      when and(not($jsonIsClose), not(includes(list(",", ":"), $jsonToken))):
        let jsonIsKey = and($jsonFrame, and(eq($jsonFrame.type, "object"), eq($jsonFrame.phase, "key")))
        when $jsonIsKey:
          port json.parse { text = $jsonToken } → jsonFrameKey
          port record.put { record = $jsonFrame; key = "key"; value = $jsonFrameKey } → jsonFrame
          port record.put { record = $jsonFrame; key = "phase"; value = "colon" } → jsonFrame
        when not($jsonIsKey):
          let jsonValuePath = if(
            $jsonFrame,
            append(
              $jsonFrame.path,
              list(if(eq($jsonFrame.type, "array"), $jsonFrame.index, $jsonFrame.key))
            ),
            list()
          )
          let jsonPathMatches = eq($jsonValuePath, $jsonSourcePath)
          when $jsonPathMatches:
            let jsonSpanFound = { offset = $jsonScan.offset; endOffset = add($jsonScan.offset, count($jsonToken)) }
            when not($jsonIsOpen):
              let jsonSpanDone = false
          when $jsonIsOpen:
            let jsonNewFrame = {
              type = if(eq($jsonToken, "{"), "object", "array");
              path = $jsonValuePath;
              key = null;
              index = 0;
              phase = if(eq($jsonToken, "{"), "key", "value");
              match = $jsonPathMatches
            }
      when and($jsonFrame, not($jsonIsClose)):
        let jsonSpanStack = map(
          range(count($jsonSpanStack)),
          "jsonDepth",
          if(
            eq($jsonDepth, count($jsonSpanStack)),
            $jsonFrame,
            at($jsonSpanStack, add($jsonDepth, -1))
          )
        )
      when $jsonIsOpen:
        let jsonSpanStack = append($jsonSpanStack, list($jsonNewFrame))
    yield {
    offset = add($jsonScan.offset, count($jsonToken));
    stack = $jsonSpanStack;
    span = $jsonSpanFound;
    done = $jsonSpanDone
  } → jsonScan
  let result = $jsonScan.span

