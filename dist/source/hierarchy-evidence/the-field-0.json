      "secondOrder": "others-gain-a-safe-way-to-name-capacity",
      "thirdOrder": "the-coordinator-must-defend-the-staffing-rule-in-public",
      "uncertainty": "collective-process-may-be-too-slow-for-the-freezer"
    },
    {
      "id": "expose-publicly",
      "playerIntent": "force-fast-accountability",
      "firstOrder": "the-staffing-problem-becomes-visible",
      "secondOrder": "miras-private-request-is-exposed-without-consent",
      "thirdOrder": "future-workers-may-avoid-asking-for-help",
      "uncertainty": "public-pressure-may-still-secure-material-cover"
    },
    {
      "id": "decline-and-connect",
      "playerIntent": "set-a-boundary-without-abandoning-the-request",
      "firstOrder": "the-player-preserves-capacity-and-contacts-the-cooperative",
      "secondOrder": "miras-request-is-treated-as-a-request-not-a-command",
      "thirdOrder": "responsibility-moves-toward-a-shared-rota",
