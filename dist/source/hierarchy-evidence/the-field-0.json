    {
      "id": "leave-encounter",
      "playerIntent": "refuse-the-exercise",
      "firstOrder": "no-player-intervention-occurs",
      "secondOrder": "no-standing-is-lost-and-the-situation-continues",
      "thirdOrder": "the-prototype-records-no-retention-or-compliance-signal",
      "uncertainty": "the-worlds-later-outcome-is-not-shown"
