      "conversion",
      "compliance",
      "retention",
      "dependency",
      "disclosure",
      "offline-proof"
    ],
    "requiredPlayerOptions": [
      "ask",
      "wait",
      "share-responsibility",
      "set-boundary",
      "refuse",
      "leave"
    ]
  },
  "epistemicKinds": [
    "observation",
    "report",
    "inference",
    "dispute",
