// Explicit identity journeys and their editorial reading connections.
("identity.sourcerer", "threadsTitle", "Make the magic answerable.")
("identity.sourcerer", "threadsCopy", "How does an idea become something people can inspect, use and change? Follow observation into explanation, permission into action, and a mistake into repair.")
("identity.sourcerer", "threadsCardCopy", "Follow understanding, permission and repair.")
("identity.sourcerer", "mapTitle", "A map for making things answerable.")
("identity.sourcerer", "mapCopy", "Start where a system meets evidence, responsibility or repair. The highlighted places are invitations to investigate, not claims of scientific equivalence.")
("identity.sourcerer", "atlasCardCopy", "Find evidence, boundaries and ways to repair.")
("identity.sourcerer", "readingPrompt", "As a Sourcerer, ask what is observed, what permits the action, and what would let another person check or revise it.")
("identity.sourcerer", "homeRoute", "worlds/sourcerer/index.html")
("identity.sourcerer", "homeHref", "/worlds/sourcerer/index.html")
