// Reviewed identity decisions: declared intent, generated evidence and human review stay distinct.
("identity.decision.nav.routes", "isa", "IdentityDecision")
("identity.decision.nav.routes", "id", "nav.routes")
("identity.decision.nav.routes", "intent", "invariant")
("identity.decision.nav.routes", "label", "Shared-tool exits and explicit perspective changes")
("identity.decision.nav.routes", "reason", "The workshop and full-screen reader are shared tools. Identity journeys retain their own return links; leaving the lens is explicit.")
("identity.decision.nav.routes", "scope", "Shared workshop and reader destinations and exit wording; local journey return destinations remain identity-mapped.")
("identity.decision.nav.routes", "humanReview", "Automated structural evidence; editorial intent remains an explicit declaration.")
("identity.decision.metadata", "isa", "IdentityDecision")
("identity.decision.metadata", "id", "metadata")
("identity.decision.metadata", "intent", "identity")
("identity.decision.metadata", "label", "Identity URL and selected-world sharing metadata")
("identity.decision.metadata", "reason", "A shared link should describe the identity and destination it opens. The cross updates the title, sharing metadata and a link to the selected world.")
("identity.decision.metadata", "scope", "Canonical identity home, Threads, Map and Questions URLs, plus the cross’s selected-world permalink and metadata writers.")
("identity.decision.metadata", "humanReview", "Automated structural evidence; editorial intent remains an explicit declaration.")
("identity.decision.section.headings", "isa", "IdentityDecision")
("identity.decision.section.headings", "id", "section.headings")
("identity.decision.section.headings", "intent", "invariant")
("identity.decision.section.headings", "label", "Structural labels and complete-directory wording")
("identity.decision.section.headings", "reason", "Stable labels make the information architecture recognisable across perspectives. Curated headings, notes, membership and ordering remain identity-mapped.")
("identity.decision.section.headings", "scope", "Foundation & platform, Applications & programmes, Taking shape, Tools & workbenches, and the full-project directory.")
("identity.decision.section.headings", "humanReview", "Automated structural evidence; editorial intent remains an explicit declaration.")
("identity.decision.cards.style", "isa", "IdentityDecision")
("identity.decision.cards.style", "id", "cards.style")
("identity.decision.cards.style", "intent", "invariant")
("identity.decision.cards.style", "label", "Purpose pigment and selected braid behaviour")
("identity.decision.cards.style", "reason", "A purpose type keeps its colour meaning across identities. The fine metallic braid and slow glisten use the same keyboard and pointer grammar; surrounding surfaces inherit the identity palette.")
("identity.decision.cards.style", "scope", "Purpose-to-pigment bindings and shared hover/focus braid, reduced-motion and forced-colour rules; not identical background pixels.")
("identity.decision.cards.style", "humanReview", "Automated structural evidence; editorial intent remains an explicit declaration.")
("identity.decision.typography", "isa", "IdentityDecision")
("identity.decision.typography", "id", "typography")
("identity.decision.typography", "intent", "identity")
("identity.decision.typography", "label", "Display typography across each world")
("identity.decision.typography", "reason", "Each identity explicitly selects a display font stack. Shared prose and brand fonts remain stable; equal fallback fonts do not imply invariance.")
("identity.decision.typography", "scope", "Headings on identity home, Threads, Map and Questions pages; system fallback font availability is not certified.")
("identity.decision.typography", "humanReview", "Automated structural evidence; editorial intent remains an explicit declaration.")
("identity.decision.aesthetics", "isa", "IdentityDecision")
("identity.decision.aesthetics", "id", "aesthetics")
("identity.decision.aesthetics", "intent", "identity")
("identity.decision.aesthetics", "label", "Semantic brief, palette family and artwork assignments")
("identity.decision.aesthetics", "reason", "Each world owns a semantic brief and coordinated artwork and palette assignments. Automated checks verify those assignments; human review must still judge their fit.")
("identity.decision.aesthetics", "scope", "Declared briefs, world artwork bindings and the Questions palette family. Structural verification does not certify beauty, interpretation or semantic coherence.")
("identity.decision.aesthetics", "humanReview", "Required: semantic and visual fit remains a human judgment; this receipt verifies declared assignments.")
("identity.decision.footer", "isa", "IdentityDecision")
("identity.decision.footer", "id", "footer")
("identity.decision.footer", "intent", "invariant")
("identity.decision.footer", "label", "Common signature, footer copy and external destinations")
("identity.decision.footer", "reason", "All perspectives belong to the same person and share the same ownership, contact and stewardship destinations. Compact Map and full editorial footers retain their respective layouts.")
("identity.decision.footer", "scope", "Common footer text and external/assurance links within each page family. Local home return URLs are separately identity-mapped.")
("identity.decision.footer", "humanReview", "Automated structural evidence; editorial intent remains an explicit declaration.")
("identity.decision.questions.article", "isa", "IdentityDecision")
("identity.decision.questions.article", "id", "questions.article")
("identity.decision.questions.article", "intent", "identity")
("identity.decision.questions.article", "label", "Questions article, artwork and reflection destinations")
("identity.decision.questions.article", "reason", "Each identity asks a different leading question and supplies its own article, illustration and reflection links. Those links carry the perspective into the readings.")
("identity.decision.questions.article", "scope", "Identity Questions article text, hero artwork, active daylight palette and authored reflection destinations.")
("identity.decision.questions.article", "humanReview", "Automated structural evidence; editorial intent remains an explicit declaration.")
