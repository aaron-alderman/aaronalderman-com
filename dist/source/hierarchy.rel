("identity.sourcerer", "catalogueIntro", "The work through a Sourcerer’s eyes")
("identity.sourcerer", "catalogueNote", "How an idea becomes something people can inspect, use and change.")
("identity.collection.sourcerer.foundation", "isa", "IdentityCollection")
("identity.collection.sourcerer.foundation", "identity", "sourcerer")
("identity.collection.sourcerer.foundation", "title", "Make the rules visible.")
("identity.collection.sourcerer.foundation", "note", "Temple and Sourcery form the execution foundation and authoring platform beneath this ecosystem. I want power, permission and change to have an account people can inspect.")
("identity.collection.sourcerer.foundation", "image", "assets/identities/optimized/sourcerer-hero-v2.webp")
("identity.collection.sourcerer.foundation", "item", "temple")
("identity.card.sourcerer.temple", "note", "I want execution and change to remain inspectable.")
("identity.collection.sourcerer.foundation", "item", "sourcery")
("identity.card.sourcerer.sourcery", "note", "A shared process algebra for composing meaning and behaviour.")
("identity.collection.sourcerer.application", "isa", "IdentityCollection")
("identity.collection.sourcerer.application", "identity", "sourcerer")
("identity.collection.sourcerer.application", "title", "Put an explanation to the test.")
("identity.collection.sourcerer.application", "note", "Knowledge and scientific inquiry need more than a convincing answer: sources, disagreement and checks another person can repeat.")
("identity.collection.sourcerer.application", "image", "assets/identities/optimized/sourcerer-questions-v2.webp")
("identity.collection.sourcerer.application", "item", "claimipedia")
("identity.card.sourcerer.claimipedia", "note", "Keep an answer connected to its evidence and its objections.")
("identity.collection.sourcerer.application", "item", "relational-geometry")
("identity.card.sourcerer.relational-geometry", "note", "A concrete scientific programme with explicit models and reproducible checks.")
("identity.collection.sourcerer.progress", "isa", "IdentityCollection")
("identity.collection.sourcerer.progress", "identity", "sourcerer")
("identity.collection.sourcerer.progress", "title", "Build the next possibility.")
("identity.collection.sourcerer.progress", "note", "These projects are in development. Each explores a different setting for the same question: what should a system make possible, and how can people remain in charge?")
("identity.collection.sourcerer.progress", "image", "assets/identities/optimized/sourcerer-threads-v2.webp")
("identity.collection.sourcerer.progress", "item", "worldwright")
("identity.card.sourcerer.worldwright", "note", "Explore how story choices can compose into a continuing world.")
("identity.collection.sourcerer.progress", "item", "kingdom")
("identity.card.sourcerer.kingdom", "note", "Explore the structures of formation and shared life.")
("identity.collection.sourcerer.progress", "item", "simulation")
("identity.card.sourcerer.simulation", "note", "Make mechanisms and their possible consequences explicit.")
("identity.collection.sourcerer.progress", "item", "tradie")
("identity.card.sourcerer.tradie", "note", "Follow a commitment from enquiry into actual work.")
("identity.collection.sourcerer.progress", "item", "usewords")
("identity.card.sourcerer.usewords", "note", "Give what matters a structure people can question, develop and change.")
("identity.collection.sourcerer.progress", "item", "creator-studio")
("identity.card.sourcerer.creator-studio", "note", "Bring several creative forms into one developing workspace.")
("identity.collection.sourcerer.tool", "isa", "IdentityCollection")
("identity.collection.sourcerer.tool", "identity", "sourcerer")
("identity.collection.sourcerer.tool", "title", "Give the work a next step.")
("identity.collection.sourcerer.tool", "note", "Smaller tools for research, coordination and practice. Their stated maturity still matters; a working example and a complete product are different stages.")
("identity.collection.sourcerer.tool", "image", "assets/identities/optimized/sourcerer-threads-v2.webp")
("identity.collection.sourcerer.tool", "item", "encounter")
("identity.card.sourcerer.encounter", "note", "A small example of inspecting meaning and following change.")
("identity.collection.sourcerer.tool", "item", "mission-control")
("identity.card.sourcerer.mission-control", "note", "Coordinate agent-assisted research without hiding the work behind it.")
("identity.collection.sourcerer.tool", "item", "the-field")
("identity.card.sourcerer.the-field", "note", "Examine a bounded encounter without turning judgment into a score.")
("identity.collection.sourcerer.tool", "item", "supercrm")
("identity.card.sourcerer.supercrm", "note", "Keep people and obligations visible alongside coordinated work.")
("identity.collection.sourcerer.tool", "item", "timesheet")
("identity.card.sourcerer.timesheet", "note", "Give time and approval a traceable account.")
("identity.collection.sourcerer.tool", "item", "workgarden")
("identity.card.sourcerer.workgarden", "note", "Turn an unfinished task into a place and a next step.")
("identity.collection.sourcerer.tool", "item", "harborboard")
("identity.card.sourcerer.harborboard", "note", "See dependencies before changing a plan.")
("identity.collection.sourcerer.tool", "item", "relationship-manager")
("identity.card.sourcerer.relationship-manager", "note", "Keep boundaries and repair in view when assistance becomes complicated.")
("identity.christian", "catalogueIntro", "The work through a Christian’s eyes")
("identity.christian", "catalogueNote", "Faith becomes concrete in how I attend, share power and remain answerable.")
("identity.collection.christian.foundation", "isa", "IdentityCollection")
("identity.collection.christian.foundation", "identity", "christian")
("identity.collection.christian.foundation", "title", "Power needs an account of itself.")
("identity.collection.christian.foundation", "note", "The software beneath this work should make authority visible, leave room for refusal and preserve a path to correction. These are engineering commitments I want to bring into the way I serve.")
("identity.collection.christian.foundation", "image", "assets/identities/optimized/christian-hero-v2.webp")
("identity.collection.christian.foundation", "item", "temple")
("identity.card.christian.temple", "note", "Power should remain answerable for what it does.")
("identity.collection.christian.foundation", "item", "sourcery")
("identity.card.christian.sourcery", "note", "I want the systems I compose to make room for human judgment.")
("identity.collection.christian.application", "isa", "IdentityCollection")
("identity.collection.christian.application", "identity", "christian")
("identity.collection.christian.application", "title", "Let conviction meet a real situation.")
("identity.collection.christian.application", "note", "These are places to examine a choice, listen across disagreement and ask what care requires. They support reflection; they do not settle another person’s standing.")
("identity.collection.christian.application", "image", "assets/questions/open-workshop-daylight-v2.png")
("identity.collection.christian.application", "item", "the-field")
("identity.card.christian.the-field", "note", "Bring a question about following Jesus into one concrete encounter.")
("identity.collection.christian.application", "item", "relationship-manager")
("identity.card.christian.relationship-manager", "note", "Care may require a boundary, a refusal or repair.")
("identity.collection.christian.application", "item", "claimipedia")
("identity.card.christian.claimipedia", "note", "Hold a conviction with reasons others can examine.")
("identity.collection.christian.progress", "isa", "IdentityCollection")
("identity.collection.christian.progress", "identity", "christian")
("identity.collection.christian.progress", "title", "Imagine a more faithful shared life.")
("identity.collection.christian.progress", "note", "Work in development around formation, stories and the ways we learn to live together. I want these possibilities to remain open to correction by the people they affect.")
("identity.collection.christian.progress", "image", "assets/identities/optimized/christian-threads-v2.webp")
("identity.collection.christian.progress", "item", "kingdom")
("identity.card.christian.kingdom", "note", "The developing project most directly concerned with faith and formation.")
("identity.collection.christian.progress", "item", "worldwright")
("identity.card.christian.worldwright", "note", "Stories can make room for lives and choices beyond my own.")
("identity.collection.christian.progress", "item", "creator-studio")
("identity.card.christian.creator-studio", "note", "Explore how an idea might take a form another person can enter.")
("identity.collection.christian.tool", "isa", "IdentityCollection")
("identity.collection.christian.tool", "identity", "christian")
("identity.collection.christian.tool", "title", "Let care show up in the work.")
("identity.collection.christian.tool", "note", "Practical companions for attending to commitments, making time visible and following a change back to its reasons.")
("identity.collection.christian.tool", "image", "assets/identities/optimized/christian-threads-v2.webp")
("identity.collection.christian.tool", "item", "workgarden")
("identity.card.christian.workgarden", "note", "A commitment needs somewhere to live and a next action.")
("identity.collection.christian.tool", "item", "timesheet")
("identity.card.christian.timesheet", "note", "Time is part of what an undertaking asks of people.")
("identity.collection.christian.tool", "item", "encounter")
("identity.card.christian.encounter", "note", "Practise noticing what an interpretation and a change actually involve.")
("identity.dad", "catalogueIntro", "The work through Dad’s eyes")
("identity.dad", "catalogueNote", "Presence, growing room and the ordinary work of keeping a promise.")
("identity.collection.dad.foundation", "isa", "IdentityCollection")
("identity.collection.dad.foundation", "identity", "dad")
("identity.collection.dad.foundation", "title", "Tools should make room for people.")
("identity.collection.dad.foundation", "note", "I want technology to support care without taking over judgment. Clear permission, understandable behaviour and the possibility of repair matter to the things I choose to build.")
("identity.collection.dad.foundation", "image", "assets/identities/optimized/dad-hero-v2.webp")
("identity.collection.dad.foundation", "item", "temple")
("identity.card.dad.temple", "note", "I want the tools around us to stay within the authority people gave them.")
("identity.collection.dad.foundation", "item", "sourcery")
("identity.card.dad.sourcery", "note", "Understandable systems leave more room for my own attention.")
("identity.collection.dad.application", "isa", "IdentityCollection")
("identity.collection.dad.application", "identity", "dad")
("identity.collection.dad.application", "title", "Attend before trying to fix.")
("identity.collection.dad.application", "note", "Experiments in attention, boundaries and making time. I’m drawn to tools that help me notice the person and the commitments around a situation.")
("identity.collection.dad.application", "image", "assets/identities/optimized/dad-questions-v2.webp")
("identity.collection.dad.application", "item", "relationship-manager")
("identity.card.dad.relationship-manager", "note", "A place to think about listening, boundaries and repair.")
("identity.collection.dad.application", "item", "the-field")
("identity.card.dad.the-field", "note", "Slow down with a situation before deciding what somebody needs.")
("identity.collection.dad.application", "item", "workgarden")
("identity.card.dad.workgarden", "note", "Give an ordinary commitment a place and a next step.")
("identity.collection.dad.progress", "isa", "IdentityCollection")
("identity.collection.dad.progress", "identity", "dad")
("identity.collection.dad.progress", "title", "Leave room for wonder and growing.")
("identity.collection.dad.progress", "note", "Stories, creative play and shared formation are different ways of making room for a life beyond my own plans. These projects are still taking shape.")
("identity.collection.dad.progress", "image", "assets/identities/optimized/dad-threads-v2.webp")
("identity.collection.dad.progress", "item", "creator-studio")
("identity.card.dad.creator-studio", "note", "An idea could become a story, a drawing or something to explore together.")
("identity.collection.dad.progress", "item", "worldwright")
("identity.card.dad.worldwright", "note", "Make room for curiosity and more than one way through a story.")
("identity.collection.dad.progress", "item", "kingdom")
("identity.card.dad.kingdom", "note", "Consider the shape of formation and shared life as a developing inquiry.")
("identity.collection.dad.tool", "isa", "IdentityCollection")
("identity.collection.dad.tool", "identity", "dad")
("identity.collection.dad.tool", "title", "See what a promise will cost.")
("identity.collection.dad.tool", "note", "Making time and dependencies visible can help me notice a collision before somebody else has to carry its cost.")
("identity.collection.dad.tool", "image", "assets/identities/optimized/dad-threads-v2.webp")
("identity.collection.dad.tool", "item", "timesheet")
("identity.card.dad.timesheet", "note", "Notice what I am promising with my time.")
("identity.collection.dad.tool", "item", "harborboard")
("identity.card.dad.harborboard", "note", "See a clash of commitments before it becomes somebody else’s problem.")
("identity.author", "catalogueIntro", "The work through an Author’s eyes")
("identity.author", "catalogueNote", "Words make worlds. Worlds teach us what to notice.")
("identity.collection.author.foundation", "isa", "IdentityCollection")
("identity.collection.author.foundation", "identity", "author")
("identity.collection.author.foundation", "title", "Give an imagined world a coherent frame.")
("identity.collection.author.foundation", "note", "Temple and Sourcery provide an explicit way to describe behaviour and compose its parts. I’m interested in how that can support a world whose choices and changes remain understandable.")
("identity.collection.author.foundation", "image", "assets/identities/optimized/author-hero-v2.webp")
("identity.collection.author.foundation", "item", "temple")
("identity.card.author.temple", "note", "A world needs a dependable account of how its rules act.")
("identity.collection.author.foundation", "item", "sourcery")
("identity.card.author.sourcery", "note", "Compose the pieces of an interactive world in a common language.")
("identity.collection.author.application", "isa", "IdentityCollection")
("identity.collection.author.application", "identity", "author")
("identity.collection.author.application", "title", "Follow meaning into consequences.")
("identity.collection.author.application", "note", "A story asks people to believe, notice and choose. These examples help me examine an interpretation, an encounter or the evidence behind a real-world claim.")
("identity.collection.author.application", "image", "assets/identities/optimized/author-questions-v2.webp")
("identity.collection.author.application", "item", "encounter")
("identity.card.author.encounter", "note", "Look closely at meaning and what a revision changes.")
("identity.collection.author.application", "item", "the-field")
("identity.card.author.the-field", "note", "Explore a situation through choices, relationships and uncertainty.")
("identity.collection.author.application", "item", "claimipedia")
("identity.card.author.claimipedia", "note", "Distinguish an invented world from a claim about the real one.")
("identity.collection.author.progress", "isa", "IdentityCollection")
("identity.collection.author.progress", "identity", "author")
("identity.collection.author.progress", "title", "Let a story find its form.")
("identity.collection.author.progress", "note", "Worlds, scenes and creative tools in development: room for more than one route through a story, more than one medium, and consequences that continue beyond a single scene.")
("identity.collection.author.progress", "image", "assets/identities/optimized/author-threads-v2.webp")
("identity.collection.author.progress", "item", "worldwright")
("identity.card.author.worldwright", "note", "The developing storytelling platform at the centre of this perspective.")
("identity.collection.author.progress", "item", "creator-studio")
("identity.card.author.creator-studio", "note", "Let an idea move between prose, images, film and interaction.")
("identity.collection.author.progress", "item", "simulation")
("identity.card.author.simulation", "note", "Ask what a mechanism makes possible beyond the immediate scene.")
("identity.collection.author.tool", "isa", "IdentityCollection")
("identity.collection.author.tool", "identity", "author")
("identity.collection.author.tool", "title", "Make space for the unfinished work.")
("identity.collection.author.tool", "note", "Creative work also needs a place, a next step and an honest view of what depends on what.")
("identity.collection.author.tool", "image", "assets/identities/optimized/author-threads-v2.webp")
("identity.collection.author.tool", "item", "workgarden")
("identity.card.author.workgarden", "note", "Give the unfinished scene a place to wait and a next step.")
("identity.collection.author.tool", "item", "harborboard")
("identity.card.author.harborboard", "note", "Keep the structure of a larger creative undertaking in view.")

