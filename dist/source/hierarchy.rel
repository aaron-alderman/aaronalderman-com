("identity.sourcerer", "questionHref", "questions-sourcerer.html")
("identity.sourcerer", "questionCopy", "How do I build software that earns trust?")
("identity.sourcerer", "isa", "IdentityQuestionPage")
("identity.sourcerer", "questionTitle", "How do I build")
("identity.sourcerer", "questionEm", "software that earns trust?")
("identity.sourcerer", "questionSubtitle", "Powerful tools. Visible reasons. People who can say no.")
("identity.sourcerer", "questionIntro", "I want the things I build to be useful without asking people to surrender their judgment. Sourcery explores how software can carry an explicit account of what it does, what permits it, and how a change can be checked.")
("identity.sourcerer", "questionHeading", "The magic has to show its work.")
("identity.sourcerer", "questionBody", "A system can be impressive and still be difficult to question. I want understanding, permission and repair to be part of the design. That means making consequential behaviour inspectable, keeping authority bounded, and distinguishing a promising demonstration from a capability people can rely on.")
("identity.sourcerer", "questionImage", "assets/atlas/unseen-v1.png")
("identity.sourcerer", "questionLight", "unseen")
("identity.sourcerer", "questionLabel", "Sourcerer")
("folds.page.questions-sourcerer", "isa", "StandalonePage")
("folds.page.questions-sourcerer", "canonical", "https://aaronalderman.com/questions-sourcerer.html")
("identity.sourcerer", "question", "identity.sourcerer.question.0")
("identity.sourcerer.question.0", "label", "Permission")
("identity.sourcerer.question.0", "title", "Who gave this system the right to act?")
("identity.sourcerer.question.0", "note", "A request to help is not permission to do everything. I want the scope of an action to remain clear, especially when an agent or automation is doing the work.")
("identity.sourcerer.question.0", "href", "places/permission.html")
("identity.sourcerer.question.0", "cta", "Explore permission")
("identity.sourcerer", "question", "identity.sourcerer.question.1")
("identity.sourcerer.question.1", "label", "Understanding")
("identity.sourcerer.question.1", "title", "Can someone else see why it did that?")
("identity.sourcerer.question.1", "note", "An explanation needs something solid behind it: an explicit description, a source, a reproducible check. Sourcery brings those descriptions and their execution into a common process algebra.")
("identity.sourcerer.question.1", "href", "sourcery/")
("identity.sourcerer.question.1", "cta", "Explore Sourcery")
("identity.sourcerer", "question", "identity.sourcerer.question.2")
("identity.sourcerer.question.2", "label", "Change")
("identity.sourcerer.question.2", "title", "What would convince me this change is safe to accept?")
("identity.sourcerer.question.2", "note", "A successful example is a beginning. I need evidence about the behaviour being changed, its limits and the responsibilities that remain with people.")
("identity.sourcerer.question.2", "href", "temple/")
("identity.sourcerer.question.2", "cta", "Explore Temple")
("identity.sourcerer", "question", "identity.sourcerer.question.3")
("identity.sourcerer.question.3", "label", "Repair")
("identity.sourcerer.question.3", "title", "What happens when my software is wrong?")
("identity.sourcerer.question.3", "note", "People need a way to stop, challenge and revise a system. Repair belongs in the ordinary route through the work, rather than depending on the builder being available.")
("identity.sourcerer.question.3", "href", "places/revision.html")
("identity.sourcerer.question.3", "cta", "Explore revision")
("identity.dad", "questionHref", "questions-dad.html")
("identity.dad", "questionCopy", "How do I stay present as Dad?")
("identity.dad", "isa", "IdentityQuestionPage")
("identity.dad", "questionTitle", "How do I stay")
("identity.dad", "questionEm", "present as Dad?")
("identity.dad", "questionSubtitle", "Attention. Patience. The next ordinary moment.")
("identity.dad", "questionIntro", "Being Dad asks something different of me from building a system or explaining an idea. I want to be someone my children can turn to: ready to listen, willing to learn, and responsible for the way I use my authority.")
("identity.dad", "questionHeading", "Care has to become something they can experience.")
("identity.dad", "questionBody", "Good intentions do not make me present. I have to make time, notice when I am distracted, and listen without deciding too quickly what someone needs. These are commitments I want to practise, not a claim that I have got parenting figured out.")
("identity.dad", "questionImage", "assets/atlas/human-v1.png")
("identity.dad", "questionLight", "human")
("identity.dad", "questionLabel", "Dad")
("folds.page.questions-dad", "isa", "StandalonePage")
("folds.page.questions-dad", "canonical", "https://aaronalderman.com/questions-dad.html")
("identity.dad", "question", "identity.dad.question.0")
("identity.dad.question.0", "label", "Attention")
("identity.dad.question.0", "title", "Am I listening, or already preparing my answer?")
("identity.dad.question.0", "note", "I want to make room for what my children are actually telling me, including feelings I cannot immediately fix. Sometimes the next good thing is to put the task down and stay.")
("identity.dad.question.0", "href", "places/listening.html")
("identity.dad.question.0", "cta", "Explore listening")
("identity.dad", "question", "identity.dad.question.1")
("identity.dad.question.1", "label", "Authority")
("identity.dad.question.1", "title", "Can I set a boundary without making love feel conditional?")
("identity.dad.question.1", "note", "Being responsible includes saying no when something is unsafe. I want the reason to be understandable, and the relationship to remain a place of care even when we disagree.")
("identity.dad.question.1", "href", "places/restraint.html")
("identity.dad.question.1", "cta", "Explore restraint")
("identity.dad", "question", "identity.dad.question.2")
("identity.dad.question.2", "label", "Repair")
("identity.dad.question.2", "title", "Can I say I was wrong without making them comfort me?")
("identity.dad.question.2", "note", "An apology should name what I did and be followed by a change. My children should not have to carry the work of protecting my image of myself.")
("identity.dad.question.2", "href", "places/revision.html")
("identity.dad.question.2", "cta", "Explore repair")
("identity.dad", "question", "identity.dad.question.3")
("identity.dad.question.3", "label", "Growing room")
("identity.dad.question.3", "title", "Am I helping them become themselves?")
("identity.dad.question.3", "note", "I can offer support, experience and protection while leaving room for their own interests and judgment. The question is what helps them grow, rather than what makes my plans easier.")
("identity.dad.question.3", "href", "places/care.html")
("identity.dad.question.3", "cta", "Explore care")
("identity.author", "questionHref", "questions-author.html")
("identity.author", "questionCopy", "What do I owe the people who enter my stories?")
("identity.author", "isa", "IdentityQuestionPage")
("identity.author", "questionTitle", "What do I owe")
("identity.author", "questionEm", "the people who enter my stories?")
("identity.author", "questionSubtitle", "Words make worlds. Worlds teach us what to notice.")
("identity.author", "questionIntro", "Writing lets me imagine lives, choices and possibilities beyond my own. I want the worlds I make to invite attention: to people, to consequences, and to things a neat explanation can leave out.")
("identity.author", "questionHeading", "A story is a way of paying attention.")
("identity.author", "questionBody", "An invented world still makes choices about who matters, whose voice is heard, and what a reader is invited to hope for. I want to make those choices with care, while leaving room for surprise, ambiguity and a reader’s own response.")
("identity.author", "questionImage", "assets/atlas/overview-v1.png")
("identity.author", "questionLight", "unseen")
("identity.author", "questionLabel", "Author")
("folds.page.questions-author", "isa", "StandalonePage")
("folds.page.questions-author", "canonical", "https://aaronalderman.com/questions-author.html")
("identity.author", "question", "identity.author.question.0")
("identity.author.question.0", "label", "People")
("identity.author.question.0", "title", "Who gets to be a person in this story?")
("identity.author.question.0", "note", "A character should have room to want, refuse and surprise me. I want to notice when I have reduced someone to a lesson, a convenient obstacle or a reward for somebody else.")
("identity.author.question.0", "href", "places/listening.html")
("identity.author.question.0", "cta", "Explore attention to others")
("identity.author", "question", "identity.author.question.1")
("identity.author.question.1", "label", "Consequences")
("identity.author.question.1", "title", "Does the world remember what its characters do?")
("identity.author.question.1", "note", "Choices should leave traces. Worldwright explores storytelling in which a world can develop through connected situations and consequences, with its construction open to inspection.")
("identity.author.question.1", "href", "worldwright/")
("identity.author.question.1", "cta", "Explore Worldwright")
("identity.author", "question", "identity.author.question.2")
("identity.author.question.2", "label", "Craft")
("identity.author.question.2", "title", "Can the same idea find its right form?")
("identity.author.question.2", "note", "A scene might want to become prose, a drawing, an animation or something a person can explore. Creator Studio is the developing workspace for bringing those forms into conversation.")
("identity.author.question.2", "href", "creator-studio/")
("identity.author.question.2", "cta", "Explore Creator Studio")
("identity.author", "question", "identity.author.question.3")
("identity.author.question.3", "label", "Honesty")
("identity.author.question.3", "title", "What am I asking the reader to believe?")
("identity.author.question.3", "note", "I want to distinguish invention from a claim about the real world, and conviction from certainty. Revision is part of taking both the story and the reader seriously.")
("identity.author.question.3", "href", "places/revision.html")
("identity.author.question.3", "cta", "Explore revision")
("identity.christian", "questionHref", "questions.html")
("identity.christian", "questionCopy", "How do I actually live like Jesus?")

