# Authoritative Encounter source for microsite-sourcery.
# JSON is generated by the selected process frontend.
# Executed through the existing lowering, admission and kernel.
process-module "temple/surface-process-module/1"
profile "encounter/module-batch/microsite-sourcery/1"

process sourcery.subject:
  port text.lowerCase { value = $eventInput.text } → lower
  port text.match { value = $lower; pattern = $eventInput.configuration.subjectPattern; flags = "" } → match
  let result = $eventInput.fallback
  when not(eq($match, null)):
    port text.split { value = at($match.groups, 1); pattern = "\\s+" } → candidates
    fold $candidates as word; reading starts { words = list(); done = false }:
      let next = $reading
      when not($reading.done):
        when includes($eventInput.configuration.stopWords, $word):
          let next = { words = $reading.words; done = true }
        when not(includes($eventInput.configuration.stopWords, $word)):
          let words = append($reading.words, list($word))
          port number.calculate { operation = "greaterEqual"; values = list(count($words), 2) } → full
          let next = { words = $words; done = $full }
      yield $next → reading
    when not(eq(count($reading.words), 0)):
      port text.join { values = $reading.words; separator = " " } → words
      let determiner = at($match.groups, 0)
      let result = concat(
        if(includes(list("the", "our", "my", "your", "their"), $determiner), $determiner, "the"),
        " ",
        $words
      )

process sourcery.format:
  let value = $eventInput.value
  port value.describe { value = $value } → kind
  let result = $value
  when eq($kind.type, "string"):
    port record.entries { value = $eventInput.variables } → variables
    fold $variables as variable; formatted starts $value:
      port text.replaceAll {
        value = $formatted;
        search = concat("{{", at($variable, 0), "}}");
        replacement = at($variable, 1)
      } → formatted
      yield $formatted → result
  when $kind.array:
    fold $value as item; parts starts list():
      port kernel.invoke {
        query = "sourcery.format";
        input = { value = $item; variables = $eventInput.variables }
      } → part
      yield append($parts, list($part)) → result
  when and(eq($kind.type, "object"), not($kind.null), not($kind.array)):
    port record.entries { value = $value } → entries
    fold $entries as entry; formatted starts {  }:
      port kernel.invoke {
        query = "sourcery.format";
        input = { value = at($entry, 1); variables = $eventInput.variables }
      } → part
      port record.put { record = $formatted; key = at($entry, 0); value = $part } → formatted
      yield $formatted → result

process sourcery.draft:
  let configuration = $eventInput.configuration
  port text.lowerCase { value = $eventInput.text } → lower
  fold $configuration.archetypes as archetype; key starts "generic":
    let next = $key
    when eq($key, "generic"):
      port text.matches { value = $lower; pattern = $archetype.re.pattern; flags = $archetype.re.flags } → matches
      when $matches:
        let next = $archetype.key
    yield $next → key
  let template = at($configuration.templates, $key)
  port kernel.invoke {
    query = "sourcery.subject";
    input = {
      text = $eventInput.text;
      fallback = $template.fallback;
      configuration = $configuration
    }
  } → subject
  fold $configuration.events as event; naming starts { noun = "entry"; found = false }:
    let next = $naming
    when not($naming.found):
      port text.matches { value = $lower; pattern = $event.pattern; flags = $event.flags } → matches
      when $matches:
        let next = { noun = $event.noun; found = true }
    yield $next → naming
  let noun = $naming.noun
  port text.slice { value = $noun; start = 0; end = 1 } → first
  port text.upperCase { value = $first } → capital
  port text.slice { value = $noun; start = 1 } → rest
  let capitalNoun = concat($capital, $rest)
  port text.matches { value = $noun; pattern = "(s|x|ch|sh)$" } → takesEs
  let pluralNoun = concat($noun, if($takesEs, "es", "s"))
  port text.matches { value = $noun; pattern = "^[aeiou]" } → vowel
  port text.match { value = $eventInput.text; pattern = $configuration.amountPattern } → amountMatch
  let amount = if(eq($amountMatch, null), "", at($amountMatch, "text"))
  port text.replace { value = $amount; pattern = "\\s"; flags = "g"; replacement = "" } → amount
  port text.replace {
    value = $subject;
    pattern = "^(the|our|my|your|their) ";
    flags = "";
    replacement = ""
  } → recordName
  port text.slice { value = $recordName; start = 0; end = 1 } → first
  port text.upperCase { value = $first } → capital
  port text.slice { value = $recordName; start = 1 } → rest
  let recordName = concat($capital, $rest)
  let variables = {
    subject = $subject;
    noun = $noun;
    capitalNoun = $capitalNoun;
    pluralNoun = $pluralNoun;
    article = if($vowel, "an", "a");
    amountPrefix = if(eq($amount, ""), "", concat(" at ", $amount));
    approvalSubject = if(eq($amount, ""), "Requests over the limit", concat("Requests over ", $amount));
    recordName = $recordName
  }
  port kernel.invoke { query = "sourcery.format"; input = { value = $template; variables = $variables } } → draft
  port text.matchAll { value = $eventInput.text; pattern = $configuration.refusalPattern; flags = "gi" } → refusalMatches
  fold $refusalMatches as match; refusals starts list():
    let next = $refusals
    port number.calculate { operation = "less"; values = list(count($refusals), 2) } → room
    when $room:
      port text.lowerCase { value = at($match.groups, 0) } → refusal
      let next = append($refusals, list(concat("No ", $refusal, ", as you asked")))
    yield $next → refusals
  let result = {
    pattern = $draft.pattern;
    title = $draft.title;
    creates = $draft.creates;
    rules = $draft.rules;
    asks = $draft.asks;
    wont = append(append($refusals, $draft.wont), list("Make any of this real before you seal it"))
  }

process sourcery.proposal:
  port kernel.invoke {
    query = "sourcery.draft";
    input = { text = $eventInput.text; configuration = $eventInput.configuration }
  } → draft
  port digest.sha256 { text = $eventInput.text; fallback = true } → intentHash
  port text.slice { value = $intentHash; start = 0; end = 4 } → first
  port number.parse { value = $first; radix = 16 } → number
  port number.calculate { operation = "remainder"; values = list($number, 40) } → number
  let broomNo = add($number, 1)
  let proposal = {
    kind = "proposal";
    intent = $eventInput.text;
    pattern = $draft.pattern;
    creates = map(
      $draft.creates,
      "creation",
      concat(at($creation, 0), ": ", at($creation, 1), " (", at($creation, 2), ")")
    );
    rules = $draft.rules;
    asks = $draft.asks;
    wont = $draft.wont;
    emissary = concat("broom-", $broomNo);
    askedBy = "you";
    basis = $eventInput.previous
  }
  port kernel.invoke { query = "canonical.encode"; input = { value = $proposal; numbers = true } } → canonical
  port digest.sha256 { text = $canonical; fallback = true } → hash
  let result = { draft = $draft; proposal = $proposal; hash = $hash; broomNo = $broomNo }

process sourcery.decide:
  let ledger = $eventInput.ledger
  let current = $eventInput.current
  let previous = if(
    eq(count($ledger), 0),
    "genesis",
    at(at($ledger, add(count($ledger), -1)), "witness")
  )
  let record = {
    kind = "witness";
    n = add(count($ledger), 1);
    verdict = $eventInput.verdict;
    by = "you";
    emissary = $current.proposal.emissary;
    intent = $current.proposal.intent;
    note = $eventInput.note;
    proposal = $current.hash;
    previous = $previous;
    at = $eventInput.at
  }
  port kernel.invoke { query = "canonical.encode"; input = { value = $record; numbers = true } } → canonical
  port digest.sha256 { text = $canonical; fallback = true } → witness
  let result = {
    record = $record;
    witness = $witness;
    ledger = append($ledger, list({ record = $record; witness = $witness }))
  }

process sourcery.verify:
  let ledger = $eventInput.ledger
  fold $ledger as entry; recomputed starts list():
    port kernel.invoke { query = "canonical.encode"; input = { value = $entry.record; numbers = true } } → canonical
    port digest.sha256 { text = $canonical; fallback = true } → hash
    yield append($recomputed, list($hash)) → recomputed
  fold range(count($ledger)) as position; verification starts { marks = list(); firstBad = -1 }:
    let index = add($position, -1)
    let entry = at($ledger, $index)
    let selfOk = eq(at($recomputed, $index), $entry.witness)
    let linkOk = if(
      eq($index, 0),
      eq($entry.record.previous, "genesis"),
      eq($entry.record.previous, at($recomputed, add($index, -1)))
    )
    let ok = and($selfOk, $linkOk, eq($verification.firstBad, -1))
    let firstBad = if(and(not($ok), eq($verification.firstBad, -1)), $index, $verification.firstBad)
    yield { marks = append($verification.marks, list($ok)); firstBad = $firstBad } → verification
  let ok = eq($verification.firstBad, -1)
  port number.calculate { operation = "greater"; values = list(count($ledger), add($verification.firstBad, 1)) } → later
  let result = {
    marks = $verification.marks;
    firstBad = $verification.firstBad;
    ok = $ok;
    message = if(
      $ok,
      concat(
        "✓ ",
        count($ledger),
        if(eq(count($ledger), 1), " witness", " witnesses"),
        " recomputed. The chain is intact."
      ),
      concat(
        "✗ № ",
        add($verification.firstBad, 1),
        " no longer matches its witness",
        if($later, ", so every entry after it has lost its footing.", "."),
        " Rewriting history shows."
      )
    )
  }

process sourcery.tamper:
  let ledger = $eventInput.ledger
  let result = { ledger = $ledger; originalRecord = $eventInput.originalRecord; message = "" }
  when not(eq(count($ledger), 0)):
    let entry = at($ledger, 0)
    let originalRecord = $eventInput.originalRecord
    let record = $originalRecord
    let message = "Tampering undone. Verify again to see the chain restored."
    when eq($originalRecord, null):
      let originalRecord = $entry.record
      port record.put {
        record = $entry.record;
        key = "intent";
        value = concat($entry.record.intent, " (and the neighbour’s cat)")
      } → record
      let message = "Entry № 1 now reads differently, but its witness hasn’t changed. Try verifying."
    when not(eq($eventInput.originalRecord, null)):
      let originalRecord = null
    port record.put { record = $entry; key = "record"; value = $record } → entry
    let ledger = map(
      range(count($ledger)),
      "position",
      if(eq($position, 1), $entry, at($ledger, add($position, -1)))
    )
    let result = { ledger = $ledger; originalRecord = $originalRecord; message = $message }

