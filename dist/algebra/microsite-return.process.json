    "microsite.return.project": [
      {
        "let": "returnDocument",
        "value": [
          "one",
          "$msDocument",
          "path"
        ]
      },
      {
        "call": "microsite.return.decorate"
      }
    ],
    "microsite.return.decorate": [
      {
        "call": "microsite.return.inspectHome"
      },
      {
        "when": [
          "and",
          [
            "not",
            "$returnHasHome"
          ],
          [
            "not",
            [
              "includes",
              "$result",
              "id=\"microsite-return\""
            ]
          ]
        ],
        "then": [
          {
            "let": "returnMarkup",
            "value": "$result"
          },
          {
            "port": "text.split",
            "args": {
              "value": "$returnDocument",
              "pattern": "/"
            },
            "into": "returnParts"
          },
          {
            "port": "text.join",
            "args": {
              "values": [
                "map",
                [
                  "range",
                  [
                    "add",
                    [
                      "count",
                      "$returnParts"
                    ],
                    -1
                  ]
                ],
                "level",
                "../"
              ],
              "separator": ""
            },
            "into": "returnPrefix"
          },
          {
            "let": "input",
            "value": {
              "tag": "link",
              "attrs": {
                "rel": "stylesheet",
                "href": [
                  "concat",
                  "$returnPrefix",
                  "assets/microsite-return.css?v=return-2"
                ]
              },
              "children": [
                "list"
              ]
            }
          },
          {
            "call": "html.serialize"
          },
          {
            "let": "returnHead",
            "value": [
              "concat",
              "$result",
              "\n"
            ]
          },
          {
            "let": "input",
            "value": {
              "tag": "a",
              "attrs": {
                "id": "microsite-return",
                "class": "microsite-return",
                "href": [
                  "concat",
                  "$returnPrefix",
                  "index.html#microsites"
                ],
                "aria-label": "Back to Aaron Alderman’s main website",
                "data-site": [
                  "at",
                  "$returnParts",
                  0
                ]
              },
              "children": [
                "list",
                {
                  "tag": "span",
                  "attrs": {
                    "aria-hidden": "true"
                  },
                  "children": [
                    "list",
                    "←"
                  ]
                },
                {
                  "tag": "span",
                  "attrs": {},
                  "children": [
                    "list",
                    "Back to Aaron Alderman"
                  ]
                }
              ]
            }
          },
          {
            "call": "html.serialize"
          },
          {
            "let": "returnBody",
            "value": [
              "concat",
              "\n",
              "$result",
              "\n"
            ]
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$returnMarkup",
              "search": "</head>",
              "replacement": [
                "concat",
                "$returnHead",
                "</head>"
              ]
            },
            "into": "returnMarkup"
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$returnMarkup",
              "search": "</body>",
              "replacement": [
                "concat",
                "$returnBody",
                "</body>"
              ]
            },
            "into": "result"
          }
        ]
      }
    ],
    "microsite.return.all": [
      {
        "each": [
          "subjects",
          "isa",
          "StandalonePage"
        ],
        "as": "returnPage",
        "steps": [
          {
            "let": "returnCanonical",
            "value": [
              "one",
              "$returnPage",
              "canonical"
            ]
          },
          {
            "port": "text.matches",
            "args": {
              "value": "$returnCanonical",
              "pattern": "/$"
            },
            "into": "returnDirectory"
          },
          {
            "when": [
              "and",
              "$returnDirectory",
              [
                "includes",
                "$returnCanonical",
                [
                  "one",
                  "site",
                  "origin"
                ]
              ],
              [
                "not",
                [
                  "eq",
                  "$returnCanonical",
                  [
                    "one",
                    "site",
                    "origin"
                  ]
                ]
              ]
            ],
            "then": [
              {
                "port": "text.replaceAll",
                "args": {
                  "value": "$returnCanonical",
                  "search": [
                    "one",
                    "site",
                    "origin"
                  ],
                  "replacement": ""
                },
                "into": "returnRoute"
              },
              {
                "let": "returnDocument",
                "value": [
                  "concat",
                  "$returnRoute",
                  "index.html"
                ]
              },
              {
                "port": "file.read",
                "args": {
                  "path": "$returnDocument"
                },
                "into": "result"
              },
              {
                "call": "microsite.return.decorate"
              },
              {
                "let": "surfaceWritePath",
                "value": "$returnDocument"
              },
              {
                "call": "assurance.surface.register"
              },
              {
                "port": "file.write",
                "args": {
                  "path": "$returnDocument",
                  "text": "$result"
                },
                "into": "_"
              }
            ]
          }
        ]
      }
    ]
  }
