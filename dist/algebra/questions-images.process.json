{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "images.publish": [
      {
        "each": [
          "subjects",
          "isa",
          "StyleRule"
        ],
        "as": "styleRule",
        "steps": [
          {
            "let": "selector",
            "value": [
              "one",
              "$styleRule",
              "selector"
            ]
          },
          {
            "port": "text.matches",
            "args": {
              "value": "$selector",
              "pattern": "\\.q-question:(?:nth-child|last-child)"
            },
            "into": "positional"
          },
          {
            "assert": [
              "not",
              "$positional"
            ],
            "message": "IMAGE-SOURCE: Card position cannot select image framing."
          },
          {
            "when": [
              "and",
              [
                "includes",
                "$selector",
                ".q-question"
              ],
              [
                "includes",
                "$selector",
                "img"
              ]
            ],
            "then": [
              {
                "each": [
                  "objects",
                  "$styleRule",
                  "declaration"
                ],
                "as": "declaration",
                "steps": [
                  {
                    "when": [
                      "eq",
                      [
                        "one",
                        "$declaration",
                        "property"
                      ],
                      "object-fit"
                    ],
                    "then": [
                      {
                        "assert": [
                          "or",
                          [
                            "and",
                            [
                              "eq",
                              "$styleRule",
                              "questions.style.32"
                            ],
                            [
                              "eq",
                              [
                                "one",
                                "$declaration",
                                "value"
                              ],
                              "cover"
                            ]
                          ],
                          [
                            "and",
                            [
                              "eq",
                              "$styleRule",
                              "questions.style.33"
                            ],
                            [
                              "eq",
                              [
                                "one",
                                "$declaration",
                                "value"
                              ],
                              "contain"
                            ]
                          ]
                        ],
                        "message": "IMAGE-SOURCE: An additional rule overrides the declared purpose fitting."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "assert": [
          "eq",
          [
            "one",
            "questions.style.32.object-fit",
            "value"
          ],
          "cover"
        ],
        "message": "IMAGE-SOURCE: Illustration framing changed."
      },
      {
        "assert": [
          "eq",
          [
            "one",
            "questions.style.33.object-fit",
            "value"
          ],
          "contain"
        ],
        "message": "IMAGE-SOURCE: Emblem framing changed."
      },
      {
        "assert": [
          "eq",
          [
            "one",
            "questions.style.33",
            "selector"
          ],
          ".q-question>img[src*=\"/world-emblems/\"]"
        ],
        "message": "IMAGE-SOURCE: Emblem framing must select the declared asset purpose, never a card position."
      },
      {
        "assert": [
          "eq",
          [
            "one",
            "questions.style.34",
            "selector"
          ],
          ".q-question>img[src$=\"/questions/open-workshop-daylight-v2.png\"]"
        ],
        "message": "IMAGE-SOURCE: Focal position must belong to its illustration."
      },
      {
        "let": "imageAssets",
        "value": [
          "map",
          [
            "subjects",
            "isa",
            "QuestionImage"
          ],
          "asset",
          {
            "path": [
              "one",
              "$asset",
              "path"
            ],
            "purpose": [
              "one",
              "$asset",
              "purpose"
            ],
            "fit": [
              "one",
              "$asset",
              "fit"
            ]
          }
        ]
      },
      {
        "each": "$imageAssets",
        "as": "asset",
        "steps": [
          {
            "port": "text.matches",
            "args": {
              "value": "$asset.path",
              "pattern": "^assets/(?:atlas|world-emblems|questions)/[a-z0-9-]+\\.png$"
            },
            "into": "boundedAsset"
          },
          {
            "assert": "$boundedAsset",
            "message": "IMAGE-SOURCE: Image configuration must contain a bounded raster asset path."
          },
          {
            "assert": [
              "and",
              [
                "includes",
                [
                  "list",
                  "illustration",
                  "emblem"
                ],
                "$asset.purpose"
              ],
              [
                "eq",
                "$asset.fit",
                [
                  "if",
                  [
                    "eq",
                    "$asset.purpose",
                    "emblem"
                  ],
                  "contain",
                  "cover"
                ]
              ],
              [
                "eq",
                [
                  "includes",
                  "$asset.path",
                  "/world-emblems/"
                ],
                [
                  "eq",
                  "$asset.purpose",
                  "emblem"
                ]
              ]
            ],
            "message": "IMAGE-SOURCE: Asset purpose and source fitting disagree."
          }
        ]
      },
      {
        "let": "imageVariants",
        "value": [
          "list",
          {
            "id": "main",
            "route": "questions.html",
            "base": "/",
            "expected": 6
          },
          {
            "id": "christian",
            "route": "worlds/christian/questions.html",
            "base": "/worlds/christian/",
            "expected": 6
          },
          {
            "id": "dad",
            "route": "worlds/dad/questions.html",
            "base": "/worlds/dad/",
            "expected": 4
          },
          {
            "id": "sourcerer",
            "route": "worlds/sourcerer/questions.html",
            "base": "/worlds/sourcerer/",
            "expected": 4
          },
          {
            "id": "author",
            "route": "worlds/author/questions.html",
            "base": "/worlds/author/",
            "expected": 4
          },
          {
            "id": "counterexample-broken",
            "route": "worlds/sourcerer/questions.html",
            "base": "/worlds/sourcerer/",
            "expected": 4
          },
          {
            "id": "counterexample-size",
            "route": "worlds/sourcerer/questions.html",
            "base": "/worlds/sourcerer/",
            "expected": 4
          }
        ]
      },
      {
        "each": "$imageVariants",
        "as": "variant",
        "steps": [
          {
            "let": "runtimeAssets",
            "value": "$imageAssets"
          },
          {
            "when": [
              "eq",
              "$variant.id",
              "counterexample-broken"
            ],
            "then": [
              {
                "let": "runtimeAssets",
                "value": [
                  "append",
                  "$imageAssets",
                  [
                    "list",
                    {
                      "path": "data:image/png;base64,invalid",
                      "purpose": "illustration",
                      "fit": "cover"
                    }
                  ]
                ]
              }
            ]
          },
          {
            "port": "json.stringify",
            "args": {
              "value": {
                "expected": "$variant.expected",
                "assets": "$runtimeAssets",
                "route": "$variant.route"
              }
            },
            "into": "configurationText"
          },
          {
            "let": "runtimePath",
            "value": "workshop/runtime.js?v=questions-images-1"
          },
          {
            "port": "file.read",
            "args": {
              "path": "$variant.route"
            },
            "into": "originalPage"
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$originalPage",
              "search": "<head>",
              "replacement": "<head><meta name=\"robots\" content=\"noindex\">"
            },
            "into": "auditPage"
          },
          {
            "fold": [
              "list",
              "expedition.css",
              "assets/",
              "the-field/",
              "places/",
              "assurance/"
            ],
            "as": "relativePrefix",
            "accumulator": "rootedPage",
            "initial": "$auditPage",
            "steps": [
              {
                "port": "text.replaceAll",
                "args": {
                  "value": "$rootedPage",
                  "search": [
                    "concat",
                    "href=\"",
                    "$relativePrefix"
                  ],
                  "replacement": [
                    "concat",
                    "href=\"/",
                    "$relativePrefix"
                  ]
                },
                "into": "rootedPage"
              },
              {
                "port": "text.replaceAll",
                "args": {
                  "value": "$rootedPage",
                  "search": [
                    "concat",
                    "src=\"",
                    "$relativePrefix"
                  ],
                  "replacement": [
                    "concat",
                    "src=\"/",
                    "$relativePrefix"
                  ]
                },
                "into": "rootedPage"
              }
            ],
            "yield": "$rootedPage",
            "into": "auditPage"
          },
          {
            "let": "diagnosticPath",
            "value": [
              "concat",
              "assurance/images/",
              "$variant.id",
              ".html"
            ]
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$auditPage",
              "search": "</head>",
              "replacement": "<style>#image-assurance-spacing-trigger{position:fixed;width:0;height:0;overflow:hidden;pointer-events:none}html:has(#reading-spacing-override) #image-assurance-spacing-trigger{animation:imageSpacingReady 1ms linear 1!important}@keyframes imageSpacingReady{from{opacity:0}to{opacity:1}}</style></head>"
            },
            "into": "auditPage"
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$auditPage",
              "search": [
                "concat",
                "https://aaronalderman.com/",
                "$variant.route"
              ],
              "replacement": [
                "concat",
                "https://aaronalderman.com/",
                "$diagnosticPath"
              ]
            },
            "into": "auditPage"
          },
          {
            "when": [
              "eq",
              "$variant.id",
              "counterexample-broken"
            ],
            "then": [
              {
                "fold": [
                  "list",
                  "../../",
                  "/",
                  ""
                ],
                "as": "imagePrefix",
                "accumulator": "mutatedPage",
                "initial": "$auditPage",
                "steps": [
                  {
                    "port": "text.replaceAll",
                    "args": {
                      "value": "$mutatedPage",
                      "search": [
                        "concat",
                        "src=\"",
                        "$imagePrefix",
                        "assets/atlas/unseen-v1.png\""
                      ],
                      "replacement": "src=\"data:image/png;base64,invalid\""
                    },
                    "into": "changedPage"
                  }
                ],
                "yield": "$changedPage",
                "into": "auditPage"
              }
            ]
          },
          {
            "when": [
              "eq",
              "$variant.id",
              "counterexample-size"
            ],
            "then": [
              {
                "port": "text.replaceAll",
                "args": {
                  "value": "$auditPage",
                  "search": "</head>",
                  "replacement": "<style>.q-question:nth-child(2)>img{width:140px!important}</style></head>"
                },
                "into": "auditPage"
              }
            ]
          },
          {
            "let": "auditPanel",
            "value": [
              "concat",
              "<section aria-labelledby=\"image-assurance-heading\" style=\"margin:40px auto;padding:24px;width:86%;background:#fff;color:#193f3b;border:1px solid #8daaa4;border-radius:12px\">",
              "<span id=\"image-assurance-spacing-trigger\" aria-hidden=\"true\"></span>",
              "<h2 id=\"image-assurance-heading\">Questions image assurance</h2>",
              "<p>Illustrations fill their frames; emblems fit inside them. Loading, image dimensions and card bounds are observed below; fitting is checked at source. This diagnostic copy uses eager loading. Artistic crops remain visual review.</p>",
              "<p id=\"image-assurance-status\" style=\"overflow-wrap:anywhere\">Waiting for browser observations.</p><ol id=\"image-assurance-observations\"></ol></section>",
              "<script type=\"application/json\" id=\"image-assurance-config\">",
              "$configurationText",
              "</script><script src=\"/",
              "$runtimePath",
              "\"></script></body>"
            ]
          },
          {
            "port": "text.replaceAll",
            "args": {
              "value": "$auditPage",
              "search": "</body>",
              "replacement": "$auditPanel"
            },
            "into": "auditPage"
          },
          {
            "let": "surfaceWritePath",
            "value": "$diagnosticPath"
          },
          {
            "port": "file.write",
            "args": {
              "path": "$surfaceWritePath",
              "text": "$auditPage"
            },
            "into": "_"
          }
        ]
      },
      {
        "port": "file.copy",
        "args": {
          "path": "tooling/assurance/image-evidence.json"
        },
        "into": "_"
      },
      {
        "port": "file.read",
        "args": {
          "path": "tooling/assurance/image-evidence.json"
        },
        "into": "imageEvidence"
      },
      {
        "port": "file.write",
        "args": {
          "path": "assurance/images.json",
          "text": "$imageEvidence"
        },
        "into": "_"
      },
      {
        "let": "surfaceWritePath",
        "value": "assurance/images/index.html"
      },
      {
        "port": "file.write",
        "args": {
          "path": "$surfaceWritePath",
          "text": [
            "concat",
            "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Questions image assurance — Aaron Alderman</title><link rel=\"canonical\" href=\"https://aaronalderman.com/assurance/images/\"><link rel=\"stylesheet\" href=\"/expedition.css?v=",
            [
              "one",
              "site",
              "stylesheetVersion"
            ],
            "\"></head>",
            "<body data-question-identity=\"sourcerer\" style=\"background:#fbf8ef;color:#193f3b\"><a class=\"skip\" href=\"#main\">Skip to content</a><header class=\"masthead\" style=\"background:#fff\"><a class=\"brand\" href=\"/\" aria-label=\"Aaron Alderman\">Aaron Alderman</a><nav><a href=\"/assurance/\">All assurance</a></nav></header><main id=\"main\" class=\"section\"><p class=\"eyebrow\" style=\"color:#285f75\">Assurance / Questions imagery</p><h1>Does each image belong in its frame?</h1>",
            "<p>Portrait illustrations fill their frames. Transparent emblems fit inside them. The choice belongs to the image’s purpose, rather than its position in a row.</p><p>The source checks fitting rules and refuses positional overrides. The admitted browser programme measures loading, natural dimensions, card bounds and consistent frame sizes at four declared widths. Deliberately broken images and a wrong-size card must fail their checks.</p>",
            "<p>These diagnostic copies use eager image loading. They do not establish scrolling-triggered lazy loading, arbitrary computed CSS, or artistic crop quality.</p><p><a href=\"/assurance/images.json\">Read the current measured report →</a></p><h2>Explore the diagnostic copies</h2><ul>",
            "<li><a href=\"main.html\">Main Questions</a></li><li><a href=\"christian.html\">Christian</a></li><li><a href=\"dad.html\">Dad</a></li><li><a href=\"sourcerer.html\">Sourcerer</a></li><li><a href=\"author.html\">Author</a></li></ul><details><summary>Deliberate counterexamples</summary><p>These copies intentionally contain an invalid image or a mismatched frame. They must be rejected by assurance.</p><ul><li><a href=\"counterexample-broken.html\">Broken image</a></li><li><a href=\"counterexample-size.html\">Wrong frame size</a></li></ul></details></main><footer class=\"footer\"><p>Aaron Alderman</p><nav><a href=\"https://github.com/aaron-alderman/aaronalderman-com/blob/main/LICENSE.md\">Licence ↗</a><a href=\"https://github.com/aaron-alderman/aaronalderman-com/blob/main/CHRISTIAN_STEWARDSHIP_COVENANT.md\">Christian stewardship covenant ↗</a></nav></footer></body></html>"
          ]
        },
        "into": "_"
      },
      {
        "port": "file.read",
        "args": {
          "path": "assurance/generated-pages.json"
        },
        "into": "registryText"
      },
      {
        "port": "json.parse",
        "args": {
          "text": "$registryText"
        },
        "into": "registry"
      },
      {
        "fold": [
          "append",
          [
            "map",
            "$imageVariants",
            "variant",
            [
              "concat",
              "assurance/images/",
              "$variant.id",
              ".html"
            ]
          ],
          [
            "list",
            "assurance/images/index.html"
          ]
        ],
        "as": "imagePath",
        "accumulator": "registered",
        "initial": "$registry",
        "steps": [
          {
            "port": "record.put",
            "args": {
              "record": "$registered",
              "key": "$imagePath",
              "value": true
            },
            "into": "updated"
          }
        ],
        "yield": "$updated",
        "into": "registry"
      },
      {
        "port": "json.stringify",
        "args": {
          "value": "$registry"
        },
        "into": "registryText"
      },
      {
        "port": "file.write",
        "args": {
          "path": "assurance/generated-pages.json",
          "text": "$registryText"
        },
        "into": "_"
      },
      {
        "port": "file.read",
        "args": {
          "path": "assurance/reading-experience/index.html"
        },
        "into": "readingExperiencePage"
      },
      {
        "port": "text.replaceAll",
        "args": {
          "value": "$readingExperiencePage",
          "search": "</main>",
          "replacement": "<section class=\"assurance-boundary\"><h2>Does each image belong in its frame?</h2><p>Questions illustrations fill their frames; transparent emblems fit inside them. A separate track checks the source rules, real image loading and card geometry, including deliberate failure cases.</p><p><a href=\"../images/\">Explore Questions image assurance →</a></p></section></main>"
        },
        "into": "readingExperiencePage"
      },
      {
        "port": "file.write",
        "args": {
          "path": "assurance/reading-experience/index.html",
          "text": "$readingExperiencePage"
        },
        "into": "_"
      }
    ],
    "images.shared.start": [
      {
        "port": "browser.select",
        "args": {
          "selector": "#image-assurance-status"
        },
        "into": "imagePanel"
      },
      {
        "when": [
          "eq",
          [
            "count",
            "$imagePanel"
          ],
          0
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "workshop.boot",
              "input": {}
            },
            "into": "_"
          }
        ]
      },
      {
        "when": [
          "not",
          [
            "eq",
            [
              "count",
              "$imagePanel"
            ],
            0
          ]
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "images.boot",
              "input": {}
            },
            "into": "_"
          }
        ]
      }
    ],
    "images.boot": [
      {
        "port": "browser.property",
        "args": {
          "ref": "#image-assurance-config",
          "name": "textContent"
        },
        "into": "configurationText"
      },
      {
        "port": "json.parse",
        "args": {
          "text": "$configurationText"
        },
        "into": "imageConfiguration"
      },
      {
        "port": "state.set",
        "args": {
          "key": "image.assurance.configuration",
          "value": "$imageConfiguration"
        },
        "into": "_"
      },
      {
        "port": "state.set",
        "args": {
          "key": "image.assurance.scrolled",
          "value": false
        },
        "into": "_"
      },
      {
        "port": "browser.select",
        "args": {
          "selector": ".q-question>img"
        },
        "into": "imageNodes"
      },
      {
        "each": "$imageNodes",
        "as": "imageNode",
        "steps": [
          {
            "port": "browser.on",
            "args": {
              "ref": "$imageNode.ref",
              "event": "load",
              "query": "images.audit",
              "input": {}
            },
            "into": "_"
          },
          {
            "port": "browser.on",
            "args": {
              "ref": "$imageNode.ref",
              "event": "error",
              "query": "images.audit",
              "input": {}
            },
            "into": "_"
          },
          {
            "port": "browser.attribute",
            "args": {
              "ref": "$imageNode.ref",
              "name": "loading",
              "value": "eager"
            },
            "into": "_"
          }
        ]
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "window",
          "event": "load",
          "query": "images.audit",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "window",
          "event": "scroll",
          "query": "images.audit",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "window",
          "event": "resize",
          "query": "images.audit",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#image-assurance-spacing-trigger",
          "event": "animationend",
          "query": "images.audit",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "images.audit",
          "input": {}
        },
        "into": "_"
      }
    ],
    "images.audit": [
      {
        "port": "state.get",
        "args": {
          "key": "image.assurance.configuration"
        },
        "into": "imageConfiguration"
      },
      {
        "port": "browser.select",
        "args": {
          "selector": ".q-question>img"
        },
        "into": "imageNodes"
      },
      {
        "port": "browser.select",
        "args": {
          "selector": ".q-question"
        },
        "into": "imageFrames"
      },
      {
        "assert": [
          "eq",
          [
            "count",
            "$imageFrames"
          ],
          [
            "count",
            "$imageNodes"
          ]
        ],
        "message": "IMAGE-BROWSER: Each card must contain exactly one declared image."
      },
      {
        "let": "reference",
        "value": [
          "at",
          "$imageNodes",
          0
        ]
      },
      {
        "fold": [
          "range",
          [
            "count",
            "$imageNodes"
          ]
        ],
        "as": "ordinal",
        "accumulator": "observations",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "let": "imageNode",
            "value": [
              "at",
              "$imageNodes",
              [
                "add",
                "$ordinal",
                -1
              ]
            ]
          },
          {
            "port": "browser.property",
            "args": {
              "ref": "$imageNode.ref",
              "name": "complete"
            },
            "into": "complete"
          },
          {
            "port": "browser.property",
            "args": {
              "ref": "$imageNode.ref",
              "name": "naturalWidth"
            },
            "into": "naturalWidth"
          },
          {
            "port": "browser.property",
            "args": {
              "ref": "$imageNode.ref",
              "name": "naturalHeight"
            },
            "into": "naturalHeight"
          },
          {
            "let": "frame",
            "value": [
              "at",
              "$imageFrames",
              [
                "add",
                "$ordinal",
                -1
              ]
            ]
          },
          {
            "let": "assets",
            "value": [
              "filter",
              "$imageConfiguration.assets",
              "asset",
              [
                "includes",
                "$imageNode.attributes.src",
                "$asset.path"
              ]
            ]
          },
          {
            "let": "purpose",
            "value": [
              "if",
              [
                "eq",
                [
                  "count",
                  "$assets"
                ],
                1
              ],
              [
                "at",
                "$assets",
                0
              ],
              {
                "purpose": "unknown",
                "fit": "unknown"
              }
            ]
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "greater",
              "values": [
                "list",
                "$naturalWidth",
                0
              ]
            },
            "into": "hasWidth"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "greater",
              "values": [
                "list",
                "$naturalHeight",
                0
              ]
            },
            "into": "hasHeight"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "subtract",
              "values": [
                "list",
                "$frame.rect.left",
                1
              ]
            },
            "into": "leftEdge"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "subtract",
              "values": [
                "list",
                "$frame.rect.top",
                1
              ]
            },
            "into": "topEdge"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "add",
              "values": [
                "list",
                "$frame.rect.right",
                1
              ]
            },
            "into": "rightEdge"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "add",
              "values": [
                "list",
                "$frame.rect.bottom",
                1
              ]
            },
            "into": "bottomEdge"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "greaterEqual",
              "values": [
                "list",
                "$imageNode.rect.left",
                "$leftEdge"
              ]
            },
            "into": "leftOK"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "greaterEqual",
              "values": [
                "list",
                "$imageNode.rect.top",
                "$topEdge"
              ]
            },
            "into": "topOK"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "lessEqual",
              "values": [
                "list",
                "$imageNode.rect.right",
                "$rightEdge"
              ]
            },
            "into": "rightOK"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "lessEqual",
              "values": [
                "list",
                "$imageNode.rect.bottom",
                "$bottomEdge"
              ]
            },
            "into": "bottomOK"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "subtract",
              "values": [
                "list",
                "$imageNode.rect.width",
                "$reference.rect.width"
              ]
            },
            "into": "widthDelta"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "subtract",
              "values": [
                "list",
                "$imageNode.rect.height",
                "$reference.rect.height"
              ]
            },
            "into": "heightDelta"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "abs",
              "values": [
                "list",
                "$widthDelta"
              ]
            },
            "into": "widthError"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "abs",
              "values": [
                "list",
                "$heightDelta"
              ]
            },
            "into": "heightError"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "lessEqual",
              "values": [
                "list",
                "$widthError",
                1
              ]
            },
            "into": "widthOK"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "lessEqual",
              "values": [
                "list",
                "$heightError",
                1
              ]
            },
            "into": "heightOK"
          },
          {
            "let": "loaded",
            "value": [
              "and",
              "$complete",
              "$hasWidth",
              "$hasHeight"
            ]
          },
          {
            "let": "bounds",
            "value": [
              "and",
              "$leftOK",
              "$topOK",
              "$rightOK",
              "$bottomOK"
            ]
          },
          {
            "let": "size",
            "value": [
              "and",
              "$widthOK",
              "$heightOK"
            ]
          },
          {
            "let": "known",
            "value": [
              "and",
              [
                "eq",
                [
                  "count",
                  "$assets"
                ],
                1
              ],
              [
                "includes",
                [
                  "list",
                  "cover",
                  "contain"
                ],
                "$purpose.fit"
              ]
            ]
          },
          {
            "let": "row",
            "value": {
              "n": "$ordinal",
              "kind": "$purpose.purpose",
              "fit": "$purpose.fit",
              "loaded": "$loaded",
              "nw": "$naturalWidth",
              "nh": "$naturalHeight",
              "w": "$imageNode.rect.width",
              "h": "$imageNode.rect.height",
              "bounds": "$bounds",
              "size": "$size",
              "known": "$known"
            }
          },
          {
            "port": "json.stringify",
            "args": {
              "value": "$row"
            },
            "into": "rowText"
          },
          {
            "assert": [
              "includes",
              [
                "list",
                "illustration",
                "emblem"
              ],
              "$purpose.purpose"
            ],
            "message": "IMAGE-BROWSER: Unclassified image source."
          }
        ],
        "yield": [
          "append",
          "$observations",
          [
            "list",
            {
              "row": "$row",
              "text": "$rowText",
              "passed": [
                "and",
                "$loaded",
                "$bounds",
                "$size",
                "$known"
              ]
            }
          ]
        ],
        "into": "observations"
      },
      {
        "let": "failures",
        "value": [
          "count",
          [
            "filter",
            "$observations",
            "observation",
            [
              "not",
              "$observation.passed"
            ]
          ]
        ]
      },
      {
        "port": "browser.property",
        "args": {
          "ref": "html",
          "name": "clientWidth"
        },
        "into": "viewportWidth"
      },
      {
        "port": "browser.property",
        "args": {
          "ref": "html",
          "name": "clientHeight"
        },
        "into": "viewportHeight"
      },
      {
        "port": "browser.select",
        "args": {
          "selector": "#reading-spacing-override"
        },
        "into": "spacingSheets"
      },
      {
        "let": "spacingProfile",
        "value": [
          "and",
          [
            "includes",
            [
              "list",
              305,
              320
            ],
            "$viewportWidth"
          ],
          [
            "eq",
            "$viewportHeight",
            800
          ]
        ]
      },
      {
        "let": "spacingReady",
        "value": [
          "or",
          [
            "not",
            "$spacingProfile"
          ],
          [
            "eq",
            [
              "count",
              "$spacingSheets"
            ],
            1
          ]
        ]
      },
      {
        "let": "summary",
        "value": {
          "protocol": "images/1",
          "observed": [
            "count",
            "$observations"
          ],
          "expected": "$imageConfiguration.expected",
          "failed": "$failures",
          "complete": [
            "and",
            [
              "eq",
              [
                "count",
                "$observations"
              ],
              "$imageConfiguration.expected"
            ],
            "$spacingReady"
          ]
        }
      },
      {
        "port": "json.stringify",
        "args": {
          "value": "$summary"
        },
        "into": "summaryText"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#image-assurance-status",
          "html": "$summaryText"
        },
        "into": "_"
      },
      {
        "port": "text.join",
        "args": {
          "values": [
            "map",
            "$observations",
            "observation",
            [
              "concat",
              "<li data-image-observation=\"\" style=\"font:12px/1.6 monospace;overflow-wrap:anywhere\">",
              "$observation.text",
              "</li>"
            ]
          ],
          "separator": ""
        },
        "into": "rowMarkup"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#image-assurance-observations",
          "html": "$rowMarkup"
        },
        "into": "_"
      },
      {
        "port": "state.get",
        "args": {
          "key": "image.assurance.scrolled"
        },
        "into": "alreadyScrolled"
      },
      {
        "when": [
          "not",
          "$alreadyScrolled"
        ],
        "then": [
          {
            "port": "state.set",
            "args": {
              "key": "image.assurance.scrolled",
              "value": true
            },
            "into": "_"
          },
          {
            "port": "browser.scrollIntoView",
            "args": {
              "ref": "$reference.ref",
              "block": "start",
              "behavior": "instant"
            },
            "into": "_"
          }
        ]
      }
    ]
  }
}
