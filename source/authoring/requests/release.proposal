{
  "protocol": "worldwright/authoring-proposal/1",
  "apply": false,
  "changes": [
    {
      "file": "source/assurance/questions-images.encounter",
      "beforeSha256": "efbbacc5ca0a4838c2ce0ea130c2ff71fe5e7dc8fbb9e6de683683dee4c0ea39",
      "text": "process-module \"temple/surface-process-module/1\"\nprofile \"encounter/assurance/questions-images/1\"\n\n# These are real Questions projections copied for diagnostic observation only.\n# Browser mechanisms are unchanged. Source fitting and rendered geometry are\n# reported separately; this programme does not certify artistic crop quality.\nprocess images.publish:\n  each subjects(\"isa\", \"StyleRule\") as styleRule:\n    let selector = one($styleRule, \"selector\")\n    port text.matches { value = $selector; pattern = \"\\\\.q-question:(?:nth-child|last-child)\" } → positional\n    assert not($positional)\n      otherwise \"IMAGE-SOURCE: Card position cannot select image framing.\"\n    when and(includes($selector, \".q-question\"), includes($selector, \"img\")):\n      each objects($styleRule, \"declaration\") as declaration:\n        when eq(one($declaration, \"property\"), \"object-fit\"):\n          assert or(and(eq($styleRule, \"questions.style.32\"), eq(one($declaration, \"value\"), \"cover\")), and(eq($styleRule, \"questions.style.33\"), eq(one($declaration, \"value\"), \"contain\")))\n            otherwise \"IMAGE-SOURCE: An additional rule overrides the declared purpose fitting.\"\n  assert eq(one(\"questions.style.32.object-fit\", \"value\"), \"cover\")\n    otherwise \"IMAGE-SOURCE: Illustration framing changed.\"\n  assert eq(one(\"questions.style.33.object-fit\", \"value\"), \"contain\")\n    otherwise \"IMAGE-SOURCE: Emblem framing changed.\"\n  assert eq(one(\"questions.style.33\", \"selector\"), \".q-question>img[src*=\\\"/world-emblems/\\\"]\")\n    otherwise \"IMAGE-SOURCE: Emblem framing must select the declared asset purpose, never a card position.\"\n  assert eq(one(\"questions.style.34\", \"selector\"), \".q-question>img[src$=\\\"/questions/open-workshop-daylight-v2.png\\\"]\")\n    otherwise \"IMAGE-SOURCE: Focal position must belong to its illustration.\"\n  let imageAssets = map(subjects(\"isa\", \"QuestionImage\"), \"asset\", {\n    path = one($asset, \"path\"); purpose = one($asset, \"purpose\"); fit = one($asset, \"fit\")\n  })\n  each $imageAssets as asset:\n    port text.matches { value = $asset.path; pattern = \"^assets/(?:atlas|world-emblems|questions)/[a-z0-9-]+\\\\.png$\" } → boundedAsset\n    assert $boundedAsset\n      otherwise \"IMAGE-SOURCE: Image configuration must contain a bounded raster asset path.\"\n    assert and(includes(list(\"illustration\", \"emblem\"), $asset.purpose), eq($asset.fit, if(eq($asset.purpose, \"emblem\"), \"contain\", \"cover\")), eq(includes($asset.path, \"/world-emblems/\"), eq($asset.purpose, \"emblem\")))\n      otherwise \"IMAGE-SOURCE: Asset purpose and source fitting disagree.\"\n  let imageVariants = list(\n    { id = \"main\"; route = \"questions.html\"; base = \"/\"; expected = 6 },\n    { id = \"christian\"; route = \"worlds/christian/questions.html\"; base = \"/worlds/christian/\"; expected = 6 },\n    { id = \"dad\"; route = \"worlds/dad/questions.html\"; base = \"/worlds/dad/\"; expected = 4 },\n    { id = \"sourcerer\"; route = \"worlds/sourcerer/questions.html\"; base = \"/worlds/sourcerer/\"; expected = 4 },\n    { id = \"author\"; route = \"worlds/author/questions.html\"; base = \"/worlds/author/\"; expected = 4 },\n    { id = \"counterexample-broken\"; route = \"worlds/sourcerer/questions.html\"; base = \"/worlds/sourcerer/\"; expected = 4 },\n    { id = \"counterexample-size\"; route = \"worlds/sourcerer/questions.html\"; base = \"/worlds/sourcerer/\"; expected = 4 }\n  )\n  each $imageVariants as variant:\n    let runtimeAssets = $imageAssets\n    when eq($variant.id, \"counterexample-broken\"):\n      let runtimeAssets = append($imageAssets, list({ path = \"data:image/png;base64,invalid\"; purpose = \"illustration\"; fit = \"cover\" }))\n    port json.stringify { value = { expected = $variant.expected; assets = $runtimeAssets; route = $variant.route } } → configurationText\n    let runtimePath = \"workshop/runtime.js?v=questions-images-1\"\n    port file.read { path = $variant.route } → originalPage\n    port text.replaceAll { value = $originalPage; search = \"<head>\"; replacement = \"<head><meta name=\\\"robots\\\" content=\\\"noindex\\\">\" } → auditPage\n    # Root-relative resources preserve the original destinations without a base\n    # element changing native fragment links in the diagnostic copy.\n    fold list(\"expedition.css\", \"assets/\", \"the-field/\", \"places/\", \"assurance/\") as relativePrefix; rootedPage starts $auditPage:\n      port text.replaceAll { value = $rootedPage; search = concat(\"href=\\\"\", $relativePrefix); replacement = concat(\"href=\\\"/\", $relativePrefix) } → rootedPage\n      port text.replaceAll { value = $rootedPage; search = concat(\"src=\\\"\", $relativePrefix); replacement = concat(\"src=\\\"/\", $relativePrefix) } → rootedPage\n      yield $rootedPage → auditPage\n    let diagnosticPath = concat(\"assurance/images/\", $variant.id, \".html\")\n    # The existing browser event port observes this nonvisual CSS event after\n    # the spacing stylesheet enters the document, even without scroll anchoring.\n    port text.replaceAll { value = $auditPage; search = \"</head>\"; replacement = \"<style>#image-assurance-spacing-trigger{position:fixed;width:0;height:0;overflow:hidden;pointer-events:none}html:has(#reading-spacing-override) #image-assurance-spacing-trigger{animation:imageSpacingReady 1ms linear 1!important}@keyframes imageSpacingReady{from{opacity:0}to{opacity:1}}</style></head>\" } → auditPage\n    port text.replaceAll { value = $auditPage; search = concat(\"https://aaronalderman.com/\", $variant.route); replacement = concat(\"https://aaronalderman.com/\", $diagnosticPath) } → auditPage\n    when eq($variant.id, \"counterexample-broken\"):\n      fold list(\"../../\", \"/\", \"\") as imagePrefix; mutatedPage starts $auditPage:\n        port text.replaceAll { value = $mutatedPage; search = concat(\"src=\\\"\", $imagePrefix, \"assets/atlas/unseen-v1.png\\\"\"); replacement = \"src=\\\"data:image/png;base64,invalid\\\"\" } → changedPage\n        yield $changedPage → auditPage\n    when eq($variant.id, \"counterexample-size\"):\n      port text.replaceAll { value = $auditPage; search = \"</head>\"; replacement = \"<style>.q-question:nth-child(2)>img{width:140px!important}</style></head>\" } → auditPage\n    let auditPanel = concat(\n      \"<section aria-labelledby=\\\"image-assurance-heading\\\" style=\\\"margin:40px auto;padding:24px;width:86%;background:#fff;color:#193f3b;border:1px solid #8daaa4;border-radius:12px\\\">\",\n      \"<span id=\\\"image-assurance-spacing-trigger\\\" aria-hidden=\\\"true\\\"></span>\",\n      \"<h2 id=\\\"image-assurance-heading\\\">Questions image assurance</h2>\",\n      \"<p>Illustrations fill their frames; emblems fit inside them. Loading, image dimensions and card bounds are observed below; fitting is checked at source. This diagnostic copy uses eager loading. Artistic crops remain visual review.</p>\",\n      \"<p id=\\\"image-assurance-status\\\" style=\\\"overflow-wrap:anywhere\\\">Waiting for browser observations.</p><ol id=\\\"image-assurance-observations\\\"></ol></section>\",\n      \"<script type=\\\"application/json\\\" id=\\\"image-assurance-config\\\">\", $configurationText, \"</script><script src=\\\"/\", $runtimePath, \"\\\"></script></body>\"\n    )\n    port text.replaceAll { value = $auditPage; search = \"</body>\"; replacement = $auditPanel } → auditPage\n    let surfaceWritePath = $diagnosticPath\n    port file.write { path = $surfaceWritePath; text = $auditPage } → _\n  port file.copy { path = \"tooling/assurance/image-evidence.json\" } → _\n  port file.read { path = \"tooling/assurance/image-evidence.json\" } → imageEvidence\n  port file.write { path = \"assurance/images.json\"; text = $imageEvidence } → _\n  let surfaceWritePath = \"assurance/images/index.html\"\n  port file.write {\n    path = $surfaceWritePath;\n    text = concat(\n      \"<!doctype html><html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>Questions image assurance — Aaron Alderman</title><link rel=\\\"canonical\\\" href=\\\"https://aaronalderman.com/assurance/images/\\\"><link rel=\\\"stylesheet\\\" href=\\\"/expedition.css?v=\", one(\"site\", \"stylesheetVersion\"), \"\\\"></head>\",\n      \"<body data-question-identity=\\\"sourcerer\\\" style=\\\"background:#fbf8ef;color:#193f3b\\\"><a class=\\\"skip\\\" href=\\\"#main\\\">Skip to content</a><header class=\\\"masthead\\\" style=\\\"background:#fff\\\"><a class=\\\"brand\\\" href=\\\"/\\\" aria-label=\\\"Aaron Alderman\\\">Aaron Alderman</a><nav><a href=\\\"/assurance/\\\">All assurance</a></nav></header><main id=\\\"main\\\" class=\\\"section\\\"><p class=\\\"eyebrow\\\" style=\\\"color:#285f75\\\">Assurance / Questions imagery</p><h1>Does each image belong in its frame?</h1>\",\n      \"<p>Portrait illustrations fill their frames. Transparent emblems fit inside them. The choice belongs to the image’s purpose, rather than its position in a row.</p><p>The source checks fitting rules and refuses positional overrides. The admitted browser programme measures loading, natural dimensions, card bounds and consistent frame sizes at four declared widths. Deliberately broken images and a wrong-size card must fail their checks.</p>\",\n      \"<p>These diagnostic copies use eager image loading. They do not establish scrolling-triggered lazy loading, arbitrary computed CSS, or artistic crop quality.</p><p><a href=\\\"/assurance/images.json\\\">Read the current measured report →</a></p><h2>Explore the diagnostic copies</h2><ul>\",\n      \"<li><a href=\\\"main.html\\\">Main Questions</a></li><li><a href=\\\"christian.html\\\">Christian</a></li><li><a href=\\\"dad.html\\\">Dad</a></li><li><a href=\\\"sourcerer.html\\\">Sourcerer</a></li><li><a href=\\\"author.html\\\">Author</a></li></ul><details><summary>Deliberate counterexamples</summary><p>These copies intentionally contain an invalid image or a mismatched frame. They must be rejected by assurance.</p><ul><li><a href=\\\"counterexample-broken.html\\\">Broken image</a></li><li><a href=\\\"counterexample-size.html\\\">Wrong frame size</a></li></ul></details></main><footer class=\\\"footer\\\"><p>Aaron Alderman</p><nav><a href=\\\"https://github.com/aaron-alderman/aaronalderman-com/blob/main/LICENSE.md\\\">Licence ↗</a><a href=\\\"https://github.com/aaron-alderman/aaronalderman-com/blob/main/CHRISTIAN_STEWARDSHIP_COVENANT.md\\\">Christian stewardship covenant ↗</a></nav></footer></body></html>\"\n    )\n  } → _\n  port file.read { path = \"assurance/generated-pages.json\" } → registryText\n  port json.parse { text = $registryText } → registry\n  fold append(map($imageVariants, \"variant\", concat(\"assurance/images/\", $variant.id, \".html\")), list(\"assurance/images/index.html\")) as imagePath; registered starts $registry:\n    port record.put { record = $registered; key = $imagePath; value = true } → updated\n    yield $updated → registry\n  port json.stringify { value = $registry } → registryText\n  port file.write { path = \"assurance/generated-pages.json\"; text = $registryText } → _\n  port file.read { path = \"assurance/reading-experience/index.html\" } → readingExperiencePage\n  port text.replaceAll {\n    value = $readingExperiencePage; search = \"</main>\";\n    replacement = \"<section class=\\\"assurance-boundary\\\"><h2>Does each image belong in its frame?</h2><p>Questions illustrations fill their frames; transparent emblems fit inside them. A separate track checks the source rules, real image loading and card geometry, including deliberate failure cases.</p><p><a href=\\\"../images/\\\">Explore Questions image assurance →</a></p></section></main>\"\n  } → readingExperiencePage\n  port file.write { path = \"assurance/reading-experience/index.html\"; text = $readingExperiencePage } → _\n\nprocess images.shared.start:\n  port browser.select { selector = \"#image-assurance-status\" } → imagePanel\n  when eq(count($imagePanel), 0):\n    port kernel.invoke { query = \"workshop.boot\"; input = { } } → _\n  when not(eq(count($imagePanel), 0)):\n    port kernel.invoke { query = \"images.boot\"; input = { } } → _\n\nprocess images.boot:\n  port browser.property { ref = \"#image-assurance-config\"; name = \"textContent\" } → configurationText\n  port json.parse { text = $configurationText } → imageConfiguration\n  port state.set { key = \"image.assurance.configuration\"; value = $imageConfiguration } → _\n  port state.set { key = \"image.assurance.scrolled\"; value = false } → _\n  port browser.select { selector = \".q-question>img\" } → imageNodes\n  each $imageNodes as imageNode:\n    port browser.on { ref = $imageNode.ref; event = \"load\"; query = \"images.audit\"; input = { } } → _\n    port browser.on { ref = $imageNode.ref; event = \"error\"; query = \"images.audit\"; input = { } } → _\n    port browser.attribute { ref = $imageNode.ref; name = \"loading\"; value = \"eager\" } → _\n  port browser.on { ref = \"window\"; event = \"load\"; query = \"images.audit\"; input = { } } → _\n  port browser.on { ref = \"window\"; event = \"scroll\"; query = \"images.audit\"; input = { } } → _\n  port browser.on { ref = \"window\"; event = \"resize\"; query = \"images.audit\"; input = { } } → _\n  port browser.on { ref = \"#image-assurance-spacing-trigger\"; event = \"animationend\"; query = \"images.audit\"; input = { } } → _\n  port kernel.invoke { query = \"images.audit\"; input = { } } → _\n\nprocess images.audit:\n  port state.get { key = \"image.assurance.configuration\" } → imageConfiguration\n  port browser.select { selector = \".q-question>img\" } → imageNodes\n  port browser.select { selector = \".q-question\" } → imageFrames\n  assert eq(count($imageFrames), count($imageNodes))\n    otherwise \"IMAGE-BROWSER: Each card must contain exactly one declared image.\"\n  let reference = at($imageNodes, 0)\n  fold range(count($imageNodes)) as ordinal; observations starts list():\n    let imageNode = at($imageNodes, add($ordinal, -1))\n    port browser.property { ref = $imageNode.ref; name = \"complete\" } → complete\n    port browser.property { ref = $imageNode.ref; name = \"naturalWidth\" } → naturalWidth\n    port browser.property { ref = $imageNode.ref; name = \"naturalHeight\" } → naturalHeight\n    let frame = at($imageFrames, add($ordinal, -1))\n    let assets = filter($imageConfiguration.assets, \"asset\", includes($imageNode.attributes.src, $asset.path))\n    let purpose = if(eq(count($assets), 1), at($assets, 0), { purpose = \"unknown\"; fit = \"unknown\" })\n    port number.calculate { operation = \"greater\"; values = list($naturalWidth, 0) } → hasWidth\n    port number.calculate { operation = \"greater\"; values = list($naturalHeight, 0) } → hasHeight\n    port number.calculate { operation = \"subtract\"; values = list($frame.rect.left, 1) } → leftEdge\n    port number.calculate { operation = \"subtract\"; values = list($frame.rect.top, 1) } → topEdge\n    port number.calculate { operation = \"add\"; values = list($frame.rect.right, 1) } → rightEdge\n    port number.calculate { operation = \"add\"; values = list($frame.rect.bottom, 1) } → bottomEdge\n    port number.calculate { operation = \"greaterEqual\"; values = list($imageNode.rect.left, $leftEdge) } → leftOK\n    port number.calculate { operation = \"greaterEqual\"; values = list($imageNode.rect.top, $topEdge) } → topOK\n    port number.calculate { operation = \"lessEqual\"; values = list($imageNode.rect.right, $rightEdge) } → rightOK\n    port number.calculate { operation = \"lessEqual\"; values = list($imageNode.rect.bottom, $bottomEdge) } → bottomOK\n    port number.calculate { operation = \"subtract\"; values = list($imageNode.rect.width, $reference.rect.width) } → widthDelta\n    port number.calculate { operation = \"subtract\"; values = list($imageNode.rect.height, $reference.rect.height) } → heightDelta\n    port number.calculate { operation = \"abs\"; values = list($widthDelta) } → widthError\n    port number.calculate { operation = \"abs\"; values = list($heightDelta) } → heightError\n    port number.calculate { operation = \"lessEqual\"; values = list($widthError, 1) } → widthOK\n    port number.calculate { operation = \"lessEqual\"; values = list($heightError, 1) } → heightOK\n    let loaded = and($complete, $hasWidth, $hasHeight)\n    let bounds = and($leftOK, $topOK, $rightOK, $bottomOK)\n    let size = and($widthOK, $heightOK)\n    let known = and(eq(count($assets), 1), includes(list(\"cover\", \"contain\"), $purpose.fit))\n    let row = { n = $ordinal; kind = $purpose.purpose; fit = $purpose.fit; loaded = $loaded; nw = $naturalWidth; nh = $naturalHeight; w = $imageNode.rect.width; h = $imageNode.rect.height; bounds = $bounds; size = $size; known = $known }\n    port json.stringify { value = $row } → rowText\n    assert includes(list(\"illustration\", \"emblem\"), $purpose.purpose)\n      otherwise \"IMAGE-BROWSER: Unclassified image source.\"\n    yield append($observations, list({ row = $row; text = $rowText; passed = and($loaded, $bounds, $size, $known) })) → observations\n  let failures = count(filter($observations, \"observation\", not($observation.passed)))\n  port browser.property { ref = \"html\"; name = \"clientWidth\" } → viewportWidth\n  port browser.property { ref = \"html\"; name = \"clientHeight\" } → viewportHeight\n  port browser.select { selector = \"#reading-spacing-override\" } → spacingSheets\n  let spacingProfile = and(includes(list(305, 320), $viewportWidth), eq($viewportHeight, 800))\n  let spacingReady = or(not($spacingProfile), eq(count($spacingSheets), 1))\n  let summary = { protocol = \"images/1\"; observed = count($observations); expected = $imageConfiguration.expected; failed = $failures; complete = and(eq(count($observations), $imageConfiguration.expected), $spacingReady) }\n  port json.stringify { value = $summary } → summaryText\n  port browser.content { ref = \"#image-assurance-status\"; html = $summaryText } → _\n  port text.join { values = map($observations, \"observation\", concat(\"<li data-image-observation=\\\"\\\" style=\\\"font:12px/1.6 monospace;overflow-wrap:anywhere\\\">\", $observation.text, \"</li>\")); separator = \"\" } → rowMarkup\n  port browser.content { ref = \"#image-assurance-observations\"; html = $rowMarkup } → _\n  port state.get { key = \"image.assurance.scrolled\" } → alreadyScrolled\n  when not($alreadyScrolled):\n    port state.set { key = \"image.assurance.scrolled\"; value = true } → _\n    port browser.scrollIntoView { ref = $reference.ref; block = \"start\"; behavior = \"instant\" } → _\n"
    }
  ]
}
