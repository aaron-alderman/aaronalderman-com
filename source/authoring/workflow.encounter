# Source migration, evidence retirement and clean verification share author.run.
# Native ports observe, invoke existing machinery, stage files and report exits.
process-module "temple/surface-process-module/1"
profile "encounter/authoring-workflow/1"

process author.run:
  port value.describe { value = $request } → requestKind
  assert $requestKind.plain
    otherwise "AUTHOR-001: Request must be a record."
  let protocol = at($request, "protocol")
  assert includes(list("worldwright/authoring-proposal/1", "worldwright/source-migration/1", "worldwright/retire-helpers/1", "worldwright/clean-verification/1", "worldwright/provenance-gate/1", "worldwright/provenance-selftest/1", "worldwright/source-registration/1", "worldwright/apply-release/1", "worldwright/images-prepare/1", "worldwright/images-verify/1"), $protocol)
    otherwise "AUTHOR-002: Unknown proposal protocol."
  when eq($protocol, "worldwright/authoring-proposal/1"):
    let helperDirectory = ".build"
    call author.provenance.helpers
    call author.edit
  when eq($protocol, "worldwright/source-migration/1"):
    call author.migration.prepare
    let proposal = $result
    call author.transaction
  when eq($protocol, "worldwright/retire-helpers/1"):
    call author.retirement.prepare
    let proposal = $result
    call author.transaction
  when eq($protocol, "worldwright/clean-verification/1"):
    call author.clean.run
  when eq($protocol, "worldwright/provenance-gate/1"):
    call author.provenance.run
  when eq($protocol, "worldwright/provenance-selftest/1"):
    call author.provenance.selftest
  when eq($protocol, "worldwright/source-registration/1"):
    let helperDirectory = ".build"
    call author.provenance.helpers
    call author.registration.prepare
    let proposal = $result
    call author.transaction
  when eq($protocol, "worldwright/apply-release/1"):
    call author.release
  when eq($protocol, "worldwright/images-prepare/1"):
    call images.prepare
  when eq($protocol, "worldwright/images-verify/1"):
    call images.verify

process author.flag:
  port value.describe { value = at($request, "apply") } → applyType
  assert eq($applyType.type, "boolean")
    otherwise "AUTHOR-003: apply must be an explicit boolean."

process author.validation:
  assert isArray(at($validation, "runs"))
    otherwise "AUTHOR-011: Structured command results are required."
  assert eq(count($validation.runs), count($commands))
    otherwise "AUTHOR-011: Every selected check must have an observed result."
  fold range(count($commands)) as position; valid starts true:
    let index = add($position, -1)
    let check = at($validation.runs, $index)
    let selected = at($commands, $index)
    port json.stringify { value = at($check, "command") } → observedCommand
    port json.stringify { value = append(list($selected.tool), $selected.args) } → expectedCommand
    yield and($valid, eq($observedCommand, $expectedCommand), eq(at($check, "status"), 0), eq(at($check, "error"), null)) → valid
  assert $valid
    otherwise "AUTHOR-011: Candidate failed checks; source was not committed."
  port record.put { record = $validation; key = "ok"; value = true } → validation

process author.commands:
  let preparation = if(eq(at($request, "protocol"), "worldwright/clean-verification/1"), list(), list(
    { tool = "node"; args = list("tooling/assess-reading-experience.mjs") },
    { tool = "node"; args = list("tooling/assess-reading-contrast.mjs") }
  ))
  let result = append(list(
    { tool = "npm"; args = list("ci", "--ignore-scripts", "--no-audit", "--no-fund", "--cache", ".npm-cache") },
    { tool = "node"; args = list("tooling/author.mjs", "source/authoring/requests/images-prepare.request") }
  ), append($preparation, list(
    { tool = "node"; args = list("bootstrap/run.cjs", ".", "dist", "bootstrap/site.json") },
    { tool = "node"; args = list("tooling/assess-reading-experience.mjs") },
    { tool = "node"; args = list("tooling/assess-reading-contrast.mjs") },
    { tool = "node"; args = list("bootstrap/run.cjs", ".", "dist", "bootstrap/site.json") },
    { tool = "node"; args = list("tooling/assess-reading-experience.mjs", "--check") },
    { tool = "node"; args = append(list("--test"), $contract.checks) },
    { tool = "node"; args = list("tooling/verify-microsite-presentation.mjs", "dist") }
  )))

process author.transaction:
  port publication.stage { changes = $proposal.changes } → candidate
  call author.commands
  let commands = $result
  port publication.validate { commands = $commands; receiptPath = "dist/build-receipt.json" } → validation
  call author.validation
  let commit = null
  when $request.apply:
    port document.commit { changes = $proposal.changes } → commit
  let receiptFile = null
  when eq($request.protocol, "worldwright/retire-helpers/1"):
    let receiptFile = $contract.retirement.receipt
  port receipt.write {
    file = $receiptFile;
    value = {
      protocol = "worldwright/authoring-receipt/2";
      requestProtocol = $request.protocol;
      applied = $request.apply;
      files = $proposal.files;
      evidence = or(at($proposal, "evidence"), list());
      validation = $validation;
      commit = $commit
    }
  } → result

process author.migration.prepare:
  call author.flag
  assert isArray(at($request, "transitions"))
    otherwise "MIGRATE-001: Explicit transitions are required."
  assert not(eq(count($request.transitions), 0))
    otherwise "MIGRATE-001: Empty migrations refuse."
  port document.observe { file = "source/authoring-contract.json" } → contractBefore
  port json.parse { text = $contractBefore.text } → contractObserved
  port json.stringify { value = $contractObserved } → contractObservedText
  port json.stringify { value = $contract } → contractLoadedText
  assert eq($contractObservedText, $contractLoadedText)
    otherwise "MIGRATE-002: Authoring contract changed after loading."
  fold $contract.migration.manifests as file; controls starts list():
    port document.observe { file = $file } → observed
    port json.parse { text = $observed.text } → manifest
    yield append($controls, list({ file = $file; observed = $observed; manifest = $manifest })) → controls
  let updatedContract = $contract
  let changes = list()
  let evidence = list()
  let seen = list()
  fold $request.transitions as transition; migration starts {
    controls = $controls; contract = $updatedContract; changes = $changes; evidence = $evidence; seen = $seen
  }:
    let controls = $migration.controls
    let updatedContract = $migration.contract
    let changes = $migration.changes
    let evidence = $migration.evidence
    let seen = $migration.seen
    assert includes($contract.editable, $transition.json)
      otherwise "MIGRATE-003: The JSON must be an existing editable owner."
    assert not(includes($seen, $transition.json))
      otherwise "MIGRATE-004: Repeated migration target."
    assert not(includes($seen, $transition.source))
      otherwise "MIGRATE-004: Repeated source destination."
    port text.matches { value = $transition.source; pattern = "^source/[A-Za-z0-9_./-]+\\.encounter$" } → sourcePath
    port text.matches { value = $transition.source; pattern = "(?:^|/)\\.\\.(?:/|$)" } → traversal
    assert and($sourcePath, not($traversal))
      otherwise "MIGRATE-005: A bounded Encounter source destination is required."
    assert includes($contract.migration.frontends, $transition.frontend)
      otherwise "MIGRATE-006: Select a declared frontend."
    port document.observe { file = $transition.json } → original
    assert and($original.exists, eq($original.sha256, $transition.beforeSha256))
      otherwise "MIGRATE-007: Stale or absent JSON owner."
    port document.observe { file = $transition.frontend } → frontend
    assert eq($frontend.sha256, $transition.frontendSha256)
      otherwise "MIGRATE-008: Frontend selection changed."
    port document.observe { file = $transition.source } → sourceBefore
    assert not($sourceBefore.exists)
      otherwise "MIGRATE-009: Migration cannot overwrite a source owner."
    port json.parse { text = $original.text } → originalModule
    assert eq($originalModule.protocol, "temple/surface-process-module/1")
      otherwise "MIGRATE-010: A surface process module is required."
    port process.compile { frontend = $transition.frontend; file = $transition.source; text = $transition.text } → compiled
    port json.stringify { value = $originalModule } → originalJson
    port json.stringify { value = $compiled.surface } → candidateJson
    assert eq($originalJson, $candidateJson)
      otherwise "MIGRATE-011: Ordered module correspondence failed."
    port record.entries { value = $originalModule.queries } → definitions
    assert not(eq(count($definitions), 0))
      otherwise "MIGRATE-012: A nonempty module is required."
    let entry = at(at($definitions, 0), 0)
    port process.lower { model = { entry = $entry; queries = $originalModule.queries } } → originalLowered
    port process.lower { model = { entry = $entry; queries = $compiled.surface.queries } } → candidateLowered
    port json.stringify { value = $originalLowered } → originalLoweredText
    port json.stringify { value = $candidateLowered } → candidateLoweredText
    assert eq($originalLoweredText, $candidateLoweredText)
      otherwise "MIGRATE-013: Whole-module lowering correspondence failed."
    let primary = at($controls, 0)
    assert includes($primary.manifest.modules, $transition.json)
      otherwise "MIGRATE-014: JSON is not selected by the primary build."
    fold $controls as control; nextControls starts list():
      let manifest = $control.manifest
      when includes($manifest.modules, $transition.json):
        let selected = or(at($manifest, "processModules"), list())
        let duplicates = filter($selected, "selection", or(eq($selection.output, $transition.json), eq($selection.file, $transition.source)))
        assert eq(count($duplicates), 0)
          otherwise "MIGRATE-015: Conflicting process authority already selected."
        port record.put { record = $manifest; key = "modules"; value = filter($manifest.modules, "moduleFile", not(eq($moduleFile, $transition.json))) } → manifest
        port record.put { record = $manifest; key = "processModules"; value = append($selected, list({ file = $transition.source; output = $transition.json; frontend = $transition.frontend })) } → manifest
      yield append($nextControls, list({ file = $control.file; observed = $control.observed; manifest = $manifest })) → controls
    port record.put { record = $updatedContract; key = "editable"; value = append(filter($updatedContract.editable, "owner", not(eq($owner, $transition.json))), list($transition.source)) } → updatedContract
    port record.put { record = $updatedContract.owners; key = "applicationProcesses"; value = append(filter($updatedContract.owners.applicationProcesses, "owner", not(eq($owner, $transition.json))), list($transition.source)) } → nextOwners
    port record.put { record = $updatedContract; key = "owners"; value = $nextOwners } → updatedContract
    port record.put { record = or(at($updatedContract, "generated"), { }); key = $transition.json; value = { source = $transition.source; frontend = $transition.frontend } } → nextGenerated
    port record.put { record = $updatedContract; key = "generated"; value = $nextGenerated } → updatedContract
    port text.split { value = $transition.json; pattern = "/" } → pathParts
    let archive = concat($contract.migration.archiveRoot, "/", $original.sha256, "-", at($pathParts, add(count($pathParts), -1)), ".txt")
    port document.observe { file = $archive } → archived
    when $archived.exists:
      assert eq($archived.sha256, $original.sha256)
        otherwise "MIGRATE-016: Existing predecessor archive differs."
    when not($archived.exists):
      let changes = append($changes, list({ file = $archive; beforeSha256 = null; text = $original.text }))
    let changes = append($changes, list(
      { file = $transition.source; beforeSha256 = null; text = $transition.text },
      { file = $transition.json; beforeSha256 = $original.sha256; text = null }
    ))
    let evidence = append($evidence, list({ json = $transition.json; source = $transition.source; predecessor = $archive; jsonSha256 = $original.sha256; sourceHash = $compiled.sourceHash; frontendSha256 = $frontend.sha256; orderedJson = true; loweredEquality = true }))
    let seen = append($seen, list($transition.json, $transition.source))
    yield { controls = $controls; contract = $updatedContract; changes = $changes; evidence = $evidence; seen = $seen } → migration
  let changes = $migration.changes
  fold $migration.controls as control; manifestChanges starts $changes:
    port json.stringify { value = $control.manifest; space = 2 } → text
    yield append($manifestChanges, list({ file = $control.file; beforeSha256 = $control.observed.sha256; text = concat($text, "\n") })) → changes
  port json.stringify { value = $migration.contract; space = 2 } → text
  let changes = append($changes, list({ file = "source/authoring-contract.json"; beforeSha256 = $contractBefore.sha256; text = concat($text, "\n") }))
  let result = { changes = $changes; files = map($changes, "change", $change.file); evidence = $migration.evidence }

process author.retirement.prepare:
  call author.flag
  port document.entries { directory = $contract.retirement.directory } → entries
  port value.sort { values = map(filter($entries, "entry", eq($entry.kind, "file")), "entry", $entry.name) } → names
  port document.observe { file = $contract.retirement.index } → indexBefore
  let previous = list()
  when $indexBefore.exists:
    port json.parse { text = $indexBefore.text } → index
    let previous = $index.items
  fold $names as name; retirement starts { changes = list(); items = list() }:
    let changes = $retirement.changes
    let items = $retirement.items
    port text.matches { value = $name; pattern = "^[A-Za-z0-9_.-]+\\.(?:cjs|mjs|js|py)$" } → helper
    when $helper:
      let file = concat($contract.retirement.directory, "/", $name)
      port document.observe { file = $file } → current
      assert $current.exists
        otherwise "RETIRE-001: Selected helper disappeared."
      let archive = concat($contract.retirement.archiveRoot, "/", $current.sha256, "-", $name, ".txt")
      port document.observe { file = $archive } → archived
      when $archived.exists:
        assert eq($archived.sha256, $current.sha256)
          otherwise "RETIRE-002: Existing archive differs; retirement refused."
      when not($archived.exists):
        let changes = append($changes, list({ file = $archive; beforeSha256 = null; text = $current.text }))
      let changes = append($changes, list({ file = $file; beforeSha256 = $current.sha256; text = null }))
      let items = append($items, list({ original = $file; archive = $archive; sha256 = $current.sha256; role = "Retired one-off development helper; historical evidence only" }))
    yield { changes = $changes; items = $items } → retirement
  assert not(eq(count($retirement.items), 0))
    otherwise "RETIRE-003: No one-off helpers selected."
  let index = { protocol = "worldwright/retired-helper-evidence/1"; items = append($previous, $retirement.items) }
  port json.stringify { value = $index; space = 2 } → indexText
  let changes = append($retirement.changes, list({ file = $contract.retirement.index; beforeSha256 = $indexBefore.sha256; text = concat($indexText, "\n") }))
  let result = { changes = $changes; files = map($changes, "change", $change.file); evidence = $retirement.items }

process author.clean.run:
  port checkout.stage { excludeRoots = list(".build", "node_modules", "dist") } → checkout
  assert $checkout.clean
    otherwise "CLEAN-001: Commit tracked source before clean verification."
  assert and($checkout.excludedBuild, $checkout.excludedDependencies, $checkout.excludedOutput)
    otherwise "CLEAN-002: Clean verification cannot inherit working outputs or dependencies."
  call author.commands
  let commands = $result
  port publication.validate { commands = $commands; receiptPath = "dist/build-receipt.json" } → validation
  call author.validation
  port receipt.write {
    file = $contract.clean.receipt;
    value = { protocol = "worldwright/clean-checkout-receipt/1"; checkout = $checkout; validation = $validation; applied = false }
  } → result

# Publication replays these constraints from the preceding trusted revision.
# Git emits observations; this programme owns classification and acceptance.
# A proposed receipt is never treated as evidence that author.run executed.
process author.provenance.kind:
  port text.matches { value = $file; pattern = "^dist/" } → generatedOutput
  port text.matches { value = $file; pattern = "^tooling/assurance/(?:reading-experience-(?:capture|evidence)|contrast-evidence|image-evidence)\\.json$" } → generatedEvidence
  let transport = eq($file, "source/authoring/requests/release.proposal")
  port text.matches { value = $file; pattern = "\\.(?:mjs|cjs|js|py)$" } → executable
  port text.matches { value = $file; pattern = "(?:^|/)\\.\\.(?:/|$)|^/|\\\\|[\\r\\n\\t]" } → escaping
  let selected = filter($planned, "change", eq($change.file, $file))
  let result = {
    allowed = and(not($escaping), or($generatedOutput, and(not($executable), or($generatedEvidence, $transport, eq(count($selected), 1)))));
    ignored = or($generatedOutput, $generatedEvidence, $transport);
    selected = $selected
  }

process author.provenance.helpers:
  port document.entries { directory = $helperDirectory } → helperEntries
  each filter($helperEntries, "entry", eq($entry.kind, "file")) as helperEntry:
    port text.matches { value = $helperEntry.name; pattern = "\\.(?:mjs|cjs|js|py)$" } → helperExecutable
    assert not($helperExecutable)
      otherwise "PROVENANCE-001: Active one-off helpers are forbidden. Retire them through author.run before authoring."

process author.provenance.plan:
  let request = $replayProposal
  call author.flag
  assert not($request.apply)
    otherwise "PROVENANCE-002: Release proposals must request a replay, not a write to the trusted checkout."
  when eq($request.protocol, "worldwright/authoring-proposal/1"):
    call author.prepare
  when eq($request.protocol, "worldwright/source-registration/1"):
    call author.registration.prepare
  when eq($request.protocol, "worldwright/source-migration/1"):
    call author.migration.prepare
  assert includes(list("worldwright/authoring-proposal/1", "worldwright/source-registration/1", "worldwright/source-migration/1"), $request.protocol)
    otherwise "PROVENANCE-003: This proposal protocol cannot authorize a publication."

process author.provenance.run:
  let gateRequest = $request
  assert eq($gateRequest.protocol, "worldwright/provenance-gate/1")
    otherwise "PROVENANCE-004: Expected the provenance request."
  assert and(eq($gateRequest.candidate, ".build/provenance/candidate"), eq($gateRequest.diff, ".build/provenance/changes.raw"))
    otherwise "PROVENANCE-004: Only the CI-established candidate and Git transcript are accepted."
  let helperDirectory = ".build"
  call author.provenance.helpers
  port document.observe { file = concat($gateRequest.candidate, "/source/authoring/requests/release.proposal") } → proposed
  assert $proposed.exists
    otherwise "PROVENANCE-005: Publication has no authoring proposal."
  port json.parse { text = $proposed.text } → replayProposal
  call author.provenance.plan
  let planned = $result.changes
  port document.observe { file = $gateRequest.diff } → gitDiff
  assert $gitDiff.exists
    otherwise "PROVENANCE-006: Missing native Git change observation."
  port text.split { value = $gitDiff.text; pattern = "\\r?\\n" } → lines
  let changed = list()
  fold filter($lines, "line", not(eq($line, ""))) as line; observedChanges starts list():
    port text.split { value = $line; pattern = "\\t" } → fields
    assert eq(count($fields), 2)
      otherwise "PROVENANCE-007: Malformed or quoted Git path."
    port text.split { value = at($fields, 0); pattern = " " } → metadata
    assert eq(count($metadata), 5)
      otherwise "PROVENANCE-007: Malformed Git metadata."
    assert and(includes(list(":100644", ":100755", ":000000"), at($metadata, 0)), includes(list("100644", "100755", "000000"), at($metadata, 1)), includes(list("M", "A", "D"), at($metadata, 4)))
      otherwise "PROVENANCE-008: Symlinks, submodules, renames and ambiguous change types refuse."
    let file = at($fields, 1)
    assert not(includes($observedChanges, $file))
      otherwise "PROVENANCE-009: Duplicate Git path."
    call author.provenance.kind
    let classification = $result
    assert $classification.allowed
      otherwise "PROVENANCE-010: Changed bytes are outside the approved authoring plan; native scripts and unowned JSON cannot be authorized by a receipt."
    when not($classification.ignored):
      let change = at($classification.selected, 0)
      port document.observe { file = concat($gateRequest.candidate, "/", $file) } → actual
      assert if(eq($change.text, null), not($actual.exists), and($actual.exists, eq($actual.text, $change.text)))
        otherwise "PROVENANCE-011: Candidate bytes differ from the algebra-replayed proposal."
    yield append($observedChanges, list($file)) → changed
  each $planned as expectedChange:
    assert includes($changed, $expectedChange.file)
      otherwise "PROVENANCE-012: A planned write is absent from the actual change set."
  let result = {
    protocol = "worldwright/authoring-provenance/1";
    status = "source-plan-replayed";
    proposalSha256 = $proposed.sha256;
    diffSha256 = $gitDiff.sha256;
    files = map($planned, "change", $change.file);
    boundary = "The trusted preceding revision replayed authoring authority and matched every functional changed byte. CI must rebuild, regenerate evidence and validate the same candidate before publication. This is execution evidence, not a signature authenticating a claimed historical receipt."
  }

process author.provenance.selftest:
  let planned = list({ file = "source/questions.rel"; beforeSha256 = "fixture"; text = "candidate REL" })
  let cases = list(
    { file = "source/questions.rel"; allowed = true },
    { file = "dist/questions.html"; allowed = true },
    { file = "dist/assurance/questions-images-runtime.js"; allowed = true },
    { file = "tooling/assurance/reading-experience-evidence.json"; allowed = true },
    { file = ".build/image-helper.mjs"; allowed = false },
    { file = "tooling/reading-experience-observer.mjs"; allowed = false },
    { file = "algebra/new-image-policy.process.json"; allowed = false },
    { file = "source/new-image-policy.json"; allowed = false },
    { file = "algebra/microsite-return.process.json"; allowed = false },
    { file = "source/questions.rel/../bypass"; allowed = false },
    { file = ".github/workflows/pages.yml"; allowed = false }
  )
  each $cases as testCase:
    let file = $testCase.file
    call author.provenance.kind
    assert eq($result.allowed, $testCase.allowed)
      otherwise "PROVENANCE-TEST: Classification counterexample failed."
  let result = { protocol = "worldwright/provenance-selftest/1"; passed = count($cases); failed = 0 }

process author.release:
  let helperDirectory = ".build"
  call author.provenance.helpers
  port document.observe { file = "source/authoring/requests/release.proposal" } → release
  assert $release.exists
    otherwise "RELEASE-001: Supply the exact proposal that CI will replay."
  port json.parse { text = $release.text } → replayProposal
  call author.provenance.plan
  let proposal = $result
  port record.put { record = $replayProposal; key = "apply"; value = true } → request
  call author.transaction

# New readable owners are registered by this programme, not by editing manifests
# or writing executable JSON. All frontend metadata below is generated data.
process author.registration.prepare:
  call author.flag
  let registrationRequest = $request
  port text.matches { value = $request.id; pattern = "^[a-z][a-z0-9-]{2,60}$" } → validId
  assert $validId
    otherwise "REGISTER-001: A bounded source identity is required."
  let sourceFile = concat("source/assurance/", $request.id, ".encounter")
  let outputFile = concat("algebra/", $request.id, ".process.json")
  let profileFile = concat("source/assurance/", $request.id, ".profile.json")
  let frontendFile = concat("bootstrap/frontends/", $request.id, ".json")
  each list($sourceFile, $profileFile, $frontendFile) as absentFile:
    port document.observe { file = $absentFile } → absent
    assert not($absent.exists)
      otherwise "REGISTER-002: Registration cannot overwrite an existing owner or frontend."
  assert eq($request.baseFrontend, "bootstrap/frontends/microsite-temple-ui.json")
    otherwise "REGISTER-003: The existing bounded frontend is required."
  port document.observe { file = $request.baseFrontend } → frontendBefore
  assert eq($frontendBefore.sha256, $request.frontendSha256)
    otherwise "REGISTER-004: Stale frontend authority."
  port json.parse { text = $frontendBefore.text } → frontend
  let originalProfileFile = $frontend.data.lpPolicy.file
  port document.observe { file = $frontend.data.lpPolicy.file } → profileBefore
  port json.parse { text = $profileBefore.text } → profile
  port document.observe { file = "bootstrap/ports.json" } → portsBefore
  port json.parse { text = $portsBefore.text } → portPolicy
  let availablePorts = distinct(append($portPolicy.profiles.build, $portPolicy.profiles.workshopBrowser))
  assert isArray($request.ports)
    otherwise "REGISTER-005: Explicit existing mechanisms are required."
  each $request.ports as selectedPort:
    assert includes($availablePorts, $selectedPort)
      otherwise "REGISTER-005: Registration cannot invent or widen native mechanisms."
  port record.put { record = $profile; key = "name"; value = concat("encounter/assurance/", $request.id, "/1") } → profile
  port record.put { record = $profile; key = "directPorts"; value = distinct($request.ports) } → profile
  port record.put { record = $profile; key = "statementForms"; value = distinct(append($profile.statementForms, list("assert"))) } → profile
  port record.put { record = $profile; key = "operators"; value = distinct(append($profile.operators, list("one", "subjects", "objects"))) } → profile
  port json.stringify { value = $profile; space = 2 } → profileText
  let profileText = concat($profileText, "\n")
  port digest.sha256 { text = $profileText } → profileHash
  port record.put { record = $frontend.data.lpPolicy; key = "file"; value = $profileFile } → profileSelection
  port record.put { record = $frontend.data; key = "lpPolicy"; value = $profileSelection } → frontendData
  port record.put { record = $frontend; key = "data"; value = $frontendData } → frontend
  port record.put { record = $frontend; key = "files"; value = map($frontend.files, "dependency", if(eq($dependency.path, $originalProfileFile), { path = $profileFile; sha256 = $profileHash }, $dependency)) } → frontend
  port record.entries { value = $frontend } → frontendEntries
  port record.fromEntries { entries = filter($frontendEntries, "pair", not(eq(at($pair, 0), "identity"))) } → unsignedFrontend
  port json.stringify { value = $unsignedFrontend } → unsignedText
  port digest.sha256 { text = $unsignedText } → identity
  port record.put { record = $unsignedFrontend; key = "identity"; value = $identity } → frontend
  port json.stringify { value = $frontend; space = 2 } → frontendText
  let frontendText = concat($frontendText, "\n")
  port document.observe { file = "bootstrap/site.json" } → manifestBefore
  port json.parse { text = $manifestBefore.text } → manifest
  assert not(includes($manifest.modules, $outputFile))
    otherwise "REGISTER-006: The proposed generated output already has a JSON authority."
  let selected = or(at($manifest, "processModules"), list())
  assert eq(count(filter($selected, "selection", or(eq($selection.file, $sourceFile), eq($selection.output, $outputFile)))), 0)
    otherwise "REGISTER-006: Conflicting process authority."
  port record.put { record = $manifest; key = "processModules"; value = append($selected, list({ file = $sourceFile; output = $outputFile; frontend = $frontendFile })) } → manifest
  port json.stringify { value = $manifest; space = 2 } → manifestText
  port document.observe { file = "source/authoring-contract.json" } → contractBefore
  let nextContract = $contract
  port record.put { record = $nextContract; key = "editable"; value = distinct(append($nextContract.editable, list($sourceFile, "source/assurance/reading-experience.json"))) } → nextContract
  port record.put { record = $nextContract.owners; key = "applicationProcesses"; value = append($nextContract.owners.applicationProcesses, list($sourceFile)) } → nextOwners
  port record.put { record = $nextContract; key = "owners"; value = $nextOwners } → nextContract
  port record.put { record = $nextContract.generated; key = $outputFile; value = { source = $sourceFile; frontend = $frontendFile } } → nextGenerated
  port record.put { record = $nextContract; key = "generated"; value = $nextGenerated } → nextContract
  port record.put { record = $nextContract.migration; key = "frontends"; value = append($nextContract.migration.frontends, list($frontendFile)) } → nextMigration
  port record.put { record = $nextContract; key = "migration"; value = $nextMigration } → nextContract
  port json.stringify { value = $nextContract; space = 2 } → contractText
  let changes = list(
    { file = $sourceFile; beforeSha256 = null; text = $registrationRequest.text },
    { file = $profileFile; beforeSha256 = null; text = $profileText },
    { file = $frontendFile; beforeSha256 = null; text = $frontendText },
    { file = "bootstrap/site.json"; beforeSha256 = $manifestBefore.sha256; text = concat($manifestText, "\n") },
    { file = "source/authoring-contract.json"; beforeSha256 = $contractBefore.sha256; text = concat($contractText, "\n") }
  )
  assert eq($registrationRequest.buildEntry, "images.publish")
    otherwise "REGISTER-007: This registration installs the declared Questions image projection."
  port document.observe { file = "algebra/publication.process.json" } → publicationBefore
  port json.parse { text = $publicationBefore.text } → publicationModule
  let buildSteps = at($publicationModule.queries, "publication.build")
  assert eq(count(filter($buildSteps, "step", eq(at($step, "call"), "microsite.return.all"))), 1)
    otherwise "REGISTER-007: The declared publication insertion point is ambiguous."
  fold $buildSteps as step; integrated starts list():
    yield append($integrated, if(eq(at($step, "call"), "microsite.return.all"), list({ call = $registrationRequest.buildEntry }, $step), list($step))) → integrated
  port record.put { record = $publicationModule.queries; key = "publication.build"; value = $integrated } → publicationQueries
  port record.put { record = $publicationModule; key = "queries"; value = $publicationQueries } → publicationModule
  port json.stringify { value = $publicationModule; space = 2 } → publicationText
  let changes = append($changes, list({ file = "algebra/publication.process.json"; beforeSha256 = $publicationBefore.sha256; text = concat($publicationText, "\n") }))
  port document.observe { file = "source/assurance/reading-experience.json" } → browserBefore
  port json.parse { text = $browserBefore.text } → browserConfiguration
  assert and(isArray($registrationRequest.browserRoutes), includes(range(16), count($registrationRequest.browserRoutes)))
    otherwise "REGISTER-008: Bounded image observation routes are required."
  each $registrationRequest.browserRoutes as diagnosticRoute:
    port text.matches { value = $diagnosticRoute; pattern = "^assurance/images/[a-z-]+\\.html$" } → diagnosticPath
    assert $diagnosticPath
      otherwise "REGISTER-008: Browser diagnostics must stay inside the image assurance directory."
    assert eq(count(filter($browserConfiguration.plan.routes, "route", eq($route.path, $diagnosticRoute))), 0)
      otherwise "REGISTER-008: Duplicate browser route."
  port record.put { record = $browserConfiguration.plan; key = "routes"; value = append($browserConfiguration.plan.routes, map($registrationRequest.browserRoutes, "route", { path = $route; skip = "#main"; next = null })) } → browserPlan
  port record.put { record = $browserConfiguration; key = "plan"; value = $browserPlan } → browserConfiguration
  port record.put { record = $browserConfiguration; key = "scope"; value = "Declared reader routes plus five Questions image diagnostics and two deliberate counterexamples. Chromium at desktop, two equivalent reflow widths and increased text spacing. Images have a separate algebra-owned assurance report; artistic cropping remains visual review." } → browserConfiguration
  port json.stringify { value = $browserConfiguration; space = 2 } → browserText
  let changes = append($changes, list({ file = "source/assurance/reading-experience.json"; beforeSha256 = $browserBefore.sha256; text = concat($browserText, "\n") }))
  when not(eq(count(or(at($registrationRequest, "changes"), list())), 0)):
    let previousContract = $contract
    let contract = $nextContract
    let request = { protocol = "worldwright/authoring-proposal/1"; apply = $registrationRequest.apply; changes = $registrationRequest.changes }
    call author.prepare
    let changes = append($changes, $result.changes)
    let contract = $previousContract
  let request = $registrationRequest
  assert eq(count(distinct(map($changes, "change", $change.file))), count($changes))
    otherwise "REGISTER-009: A source or control has more than one planned write."
  let result = { changes = $changes; files = map($changes, "change", $change.file); evidence = list({ kind = "registered-readable-source"; source = $sourceFile; output = $outputFile; frontend = $frontendFile; profileSha256 = $profileHash; nativeMechanisms = "existing build and workshop profiles only" }) }
