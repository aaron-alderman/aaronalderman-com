// Compact form of the existing identity cross, shared by every reading page.
("reading.theme.style.button", "isa", "StyleRule")
("reading.theme.style.button", "projection", "main")
("reading.theme.style.button", "selector", ".identity-switch.reading-theme-switch")
("reading.theme.style.button", "declaration", "reading.theme.css.width")
("reading.theme.css.width", "property", "width")
("reading.theme.css.width", "value", "64px")
("reading.theme.style.button", "declaration", "reading.theme.css.height")
("reading.theme.css.height", "property", "height")
("reading.theme.css.height", "value", "64px")
("reading.theme.style.button", "declaration", "reading.theme.css.margin")
("reading.theme.css.margin", "property", "margin")
("reading.theme.css.margin", "value", "0")
("reading.theme.style.button", "declaration", "reading.theme.css.fixed")
("reading.theme.css.fixed", "property", "position")
("reading.theme.css.fixed", "value", "fixed")
("reading.theme.style.button", "declaration", "reading.theme.css.right")
("reading.theme.css.right", "property", "right")
("reading.theme.css.right", "value", "max(20px,env(safe-area-inset-right))")
("reading.theme.style.button", "declaration", "reading.theme.css.bottomEdge")
("reading.theme.css.bottomEdge", "property", "bottom")
("reading.theme.css.bottomEdge", "value", "max(20px,env(safe-area-inset-bottom))")
("reading.theme.style.button", "declaration", "reading.theme.css.layer")
("reading.theme.css.layer", "property", "z-index")
("reading.theme.css.layer", "value", "50")
("reading.theme.style.button", "declaration", "reading.theme.css.surface")
("reading.theme.css.surface", "property", "background")
("reading.theme.css.surface", "value", "var(--reading-surface)")
("reading.theme.style.glyph", "isa", "StyleRule")
("reading.theme.style.glyph", "projection", "main")
("reading.theme.style.glyph", "selector", ".reading-theme-switch .identity-cross")
("reading.theme.style.glyph", "declaration", "reading.theme.css.scale")
("reading.theme.css.scale", "property", "transform")
("reading.theme.css.scale", "value", "scale(.45)")
("reading.theme.style.hint", "isa", "StyleRule")
("reading.theme.style.hint", "projection", "main")
("reading.theme.style.hint", "selector", ".reading-theme-switch .identity-hint")
("reading.theme.style.hint", "declaration", "reading.theme.css.absolute")
("reading.theme.css.absolute", "property", "position")
("reading.theme.css.absolute", "value", "absolute")
("reading.theme.style.hint", "declaration", "reading.theme.css.bottom")
("reading.theme.css.bottom", "property", "bottom")
("reading.theme.css.bottom", "value", "3px")
("reading.theme.style.hint", "declaration", "reading.theme.css.size")
("reading.theme.css.size", "property", "font-size")
("reading.theme.css.size", "value", "9px")
("reading.theme.style.label", "isa", "StyleRule")
("reading.theme.style.label", "projection", "main")
("reading.theme.style.label", "selector", ".reading-theme-switch [data-theme-label]::after")
("reading.theme.style.label", "declaration", "reading.theme.css.label")
("reading.theme.css.label", "property", "content")
("reading.theme.css.label", "value", "attr(data-theme-label)")
("reading.theme.style.focus", "isa", "StyleRule")
("reading.theme.style.focus", "projection", "main")
