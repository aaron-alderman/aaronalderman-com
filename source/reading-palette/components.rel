// Shared additions to the reading component library. Base components live in
// styles.values.rel; chrome.rel owns shared light header/footer corrections.
("grow.style.source", "projection", "main")
("grow.style.sourceOpen", "projection", "main")
("grow.style.thought", "projection", "main")
("grow.style.examples", "projection", "main")
("grow.style.exampleTitles", "projection", "main")
("grow.style.reference", "projection", "main")
("grow.style.referenceCard", "projection", "main")
("grow.style.guide", "projection", "main")
("grow.style.source", "isa", "StyleRule")
("grow.style.source", "selector", ".reading-source summary")
("grow.style.source", "declaration", "grow.style.cursor")
("grow.style.cursor", "property", "cursor")
("grow.style.cursor", "value", "pointer")
("grow.style.source", "declaration", "grow.style.action")
("grow.style.source", "declaration", "grow.style.summaryHeight")
("grow.style.summaryHeight", "property", "min-height")
("grow.style.summaryHeight", "value", "44px")
("grow.style.action", "property", "color")
("grow.style.action", "value", "var(--reading-action)")
("grow.style.sourceOpen", "isa", "StyleRule")
("grow.style.sourceOpen", "selector", ".reading-source[open] summary")
("grow.style.sourceOpen", "declaration", "grow.style.space")
("grow.style.space", "property", "margin-bottom")
("grow.style.space", "value", "20px")
("grow.style.thought", "isa", "StyleRule")
("grow.style.thought", "selector", ".reading-pause-thought,.reading-question,.reading-prayer")
("grow.style.thought", "declaration", "grow.style.serif")
("grow.style.serif", "property", "font-family")
("grow.style.serif", "value", "var(--serif)")
("grow.style.thought", "declaration", "grow.style.thoughtSize")
("grow.style.thoughtSize", "property", "font-size")
("grow.style.thoughtSize", "value", "clamp(23px,2.8vw,28px)")
("grow.style.thought", "declaration", "grow.style.action")
("grow.style.examples", "isa", "StyleRule")
("grow.style.examples", "selector", ".reading-example-grid")
("grow.style.examples", "declaration", "grow.style.grid")
("grow.style.grid", "property", "display")
("grow.style.grid", "value", "grid")
("grow.style.examples", "declaration", "grow.style.columns")
("grow.style.columns", "property", "grid-template-columns")
("grow.style.columns", "value", "repeat(auto-fit,minmax(min(100%,180px),1fr))")
("grow.style.examples", "declaration", "grow.style.gap")
("grow.style.gap", "property", "gap")
("grow.style.gap", "value", "18px")
("grow.style.exampleTitles", "isa", "StyleRule")
("grow.style.exampleTitles", "selector", ".reading-example h3")
("grow.style.exampleTitles", "declaration", "grow.style.exampleSize")
("grow.style.exampleSize", "property", "font-size")
("grow.style.exampleSize", "value", "22px")
("grow.style.reference", "isa", "StyleRule")
("grow.style.reference", "selector", ".reading-series-grid")
("grow.style.reference", "declaration", "grow.style.grid")
("grow.style.reference", "declaration", "grow.style.referenceColumns")
("grow.style.referenceColumns", "property", "grid-template-columns")
("grow.style.referenceColumns", "value", "repeat(auto-fit,minmax(min(100%,260px),1fr))")
("grow.style.reference", "declaration", "grow.style.gap")
("grow.style.referenceCard", "isa", "StyleRule")
("grow.style.referenceCard", "selector", ".reading-series-card")
("grow.style.referenceCard", "declaration", "grow.style.referencePadding")
("grow.style.referencePadding", "property", "padding")
("grow.style.referencePadding", "value", "32px")
("grow.style.referenceCard", "declaration", "grow.style.referenceBorder")
("grow.style.referenceBorder", "property", "border")
("grow.style.referenceBorder", "value", "1px solid var(--reading-line)")
("grow.style.guide", "isa", "StyleRule")
("grow.style.guide", "selector", ".reading-guide")
("grow.style.guide", "declaration", "grow.style.guideWidth")
("grow.style.guideWidth", "property", "max-width")
("grow.style.guideWidth", "value", "68ch")

// Inspection-only layout. Published components inherit their existing rules.
