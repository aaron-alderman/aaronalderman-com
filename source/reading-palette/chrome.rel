// Palette-owned light reading chrome. Articles and landing pages use the same
// foreground/background pairs; body text tokens must never sit on dark chrome.
("reading.contrast.header", "isa", "StyleRule")
("reading.contrast.header", "projection", "main")
("reading.contrast.header", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .masthead")
("reading.contrast.header", "declaration", "reading.contrast.bg")
("reading.contrast.bg", "property", "background")
("reading.contrast.bg", "value", "var(--reading-bg)")
("reading.contrast.header", "declaration", "reading.contrast.text")
("reading.contrast.text", "property", "color")
("reading.contrast.text", "value", "var(--reading-text)")
("reading.contrast.header", "declaration", "reading.contrast.bottom")
("reading.contrast.bottom", "property", "border-bottom")
("reading.contrast.bottom", "value", "1px solid var(--reading-line)")
("reading.contrast.headerLinks", "isa", "StyleRule")
("reading.contrast.headerLinks", "projection", "main")
("reading.contrast.headerLinks", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .masthead :is(a.brand,nav a)")
("reading.contrast.headerLinks", "declaration", "reading.contrast.text")
("reading.contrast.headerLinks", "declaration", "reading.contrast.touch")
("reading.contrast.touch", "property", "min-height")
("reading.contrast.touch", "value", "44px")
("reading.contrast.headerLinks", "declaration", "reading.contrast.inline")
("reading.contrast.inline", "property", "display")
("reading.contrast.inline", "value", "inline-flex")
("reading.contrast.headerLinks", "declaration", "reading.contrast.align")
("reading.contrast.align", "property", "align-items")
("reading.contrast.align", "value", "center")
("reading.contrast.mark", "isa", "StyleRule")
("reading.contrast.mark", "projection", "main")
("reading.contrast.mark", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .monogram")
("reading.contrast.mark", "declaration", "reading.contrast.accent")
("reading.contrast.accent", "property", "color")
("reading.contrast.accent", "value", "var(--reading-accent)")
("reading.contrast.mark", "declaration", "reading.contrast.markBorder")
("reading.contrast.markBorder", "property", "border-color")
("reading.contrast.markBorder", "value", "var(--reading-accent)")
("reading.contrast.footer", "isa", "StyleRule")
("reading.contrast.footer", "projection", "main")
("reading.contrast.footer", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) footer.footer")
("reading.contrast.footer", "declaration", "style.062.background")
("reading.contrast.footer", "declaration", "reading.contrast.footerText")
("reading.contrast.footerText", "property", "color")
("reading.contrast.footerText", "value", "#bac1cb")
("reading.contrast.signature", "isa", "StyleRule")
("reading.contrast.signature", "projection", "main")
("reading.contrast.signature", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .footer .signature")
("reading.contrast.signature", "declaration", "reading.contrast.footerHeading")
("reading.contrast.footerHeading", "property", "color")
("reading.contrast.footerHeading", "value", "#f3eddf")
("reading.contrast.footerLinks", "isa", "StyleRule")
("reading.contrast.footerLinks", "projection", "main")
("reading.contrast.footerLinks", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .footer a")
("reading.contrast.footerLinks", "declaration", "reading.contrast.footerText")
("reading.contrast.action", "property", "color")
("reading.contrast.action", "value", "var(--reading-action)")
("reading.contrast.hover", "isa", "StyleRule")
("reading.contrast.hover", "projection", "main")
("reading.contrast.hover", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .masthead a:hover")
("reading.contrast.hover", "declaration", "reading.contrast.action")
("reading.contrast.footerHover", "isa", "StyleRule")
("reading.contrast.footerHover", "projection", "main")
("reading.contrast.footerHover", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .footer a:is(:hover,:focus-visible)")
("reading.contrast.footerHover", "declaration", "reading.contrast.footerGold")
("reading.contrast.footerGold", "property", "color")
("reading.contrast.footerGold", "value", "#e6bc79")
("reading.contrast.footerHover", "declaration", "reading.contrast.footerOutline")
("reading.contrast.footerOutline", "property", "outline-color")
("reading.contrast.footerOutline", "value", "#e6bc79")
("reading.contrast.focus", "isa", "StyleRule")
("reading.contrast.focus", "projection", "main")
("reading.contrast.focus", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) :is(a,summary):focus-visible")
("reading.contrast.focus", "declaration", "reading.contrast.outline")
("reading.contrast.outline", "property", "outline")
("reading.contrast.outline", "value", "3px solid var(--reading-action)")
("reading.contrast.focus", "declaration", "reading.contrast.offset")
("reading.contrast.offset", "property", "outline-offset")
("reading.contrast.offset", "value", "4px")
("reading.contrast.mobileHeader", "isa", "StyleRule")
("reading.contrast.mobileHeader", "projection", "main")
("reading.contrast.mobileHeader", "context", "(max-width: 700px)")
("reading.contrast.mobileHeader", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .masthead")
("reading.contrast.mobileHeader", "declaration", "reading.contrast.autoHeight")
("reading.contrast.autoHeight", "property", "height")
("reading.contrast.autoHeight", "value", "auto")
("reading.contrast.mobileHeader", "declaration", "reading.contrast.mobilePadding")
("reading.contrast.mobilePadding", "property", "padding")
("reading.contrast.mobilePadding", "value", "16px 6%")
("reading.contrast.mobileHeader", "declaration", "reading.contrast.wrap")
("reading.contrast.wrap", "property", "flex-wrap")
("reading.contrast.wrap", "value", "wrap")
("reading.contrast.mobileHeader", "declaration", "reading.contrast.gap")
("reading.contrast.gap", "property", "gap")
("reading.contrast.gap", "value", "12px 24px")
("reading.contrast.mobileNav", "isa", "StyleRule")
("reading.contrast.mobileNav", "projection", "main")
("reading.contrast.mobileNav", "context", "(max-width: 700px)")
("reading.contrast.mobileNav", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .masthead nav")
("reading.contrast.mobileNav", "declaration", "reading.contrast.wrap")
("reading.contrast.mobileNav", "declaration", "reading.contrast.gap")
("reading.contrast.mobileLast", "isa", "StyleRule")
("reading.contrast.mobileLast", "projection", "main")
("reading.contrast.mobileLast", "context", "(max-width: 700px)")
("reading.contrast.mobileLast", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) .masthead nav a:last-child")
("reading.contrast.mobileLast", "declaration", "reading.contrast.inline")
