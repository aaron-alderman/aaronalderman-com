// Style guidance is authored data and is also rendered in the palette reference.
("reading.palette", "guide", "guide.voice")
("guide.voice", "title", "Address the reader as a person")
("guide.voice", "text", "Write directly to teenagers in clear, warm language. Give examples and reasons. Leave room for questions and disagreement. Keep private family history outside the public article.")
("reading.palette", "guide", "guide.rhythm")
("guide.rhythm", "title", "Give the reading a rhythm")
("guide.rhythm", "text", "Start with a recognisable situation. Develop connected paragraphs. Introduce one source invitation, one pause, practical examples, one question and one small practice. Use quiet space between ideas.")
("reading.palette", "guide", "guide.colour")
("guide.colour", "title", "Inherit the surrounding reading room")
("guide.colour", "text", "Use the existing Dad reading-room tokens and the shared masthead, wordmark, main navigation and footer. Articles use reading-essay, faith-essay-header, faith-essay-body, inline contents and numbered sections. Series pages use gate-hero, faith-feature, faith-feature-actions, identity-thread-grid and identity-thread, inheriting their typography, image treatment, spacing and responsive rules from Dad Threads. Extend this vocabulary with scoped components; do not introduce a separate theme, sidebar layout or reader-facing authoring navigation.")
("reading.palette", "guide", "guide.access")
("guide.access", "title", "Let every reader take their time")
("guide.access", "text", "Provide a skip link, meaningful headings, visible keyboard focus, readable contrast, responsive images and a narrow prose measure. Use native expandable content. No automatic animation, carousels or required interaction.")
("reading.palette", "guide", "guide.evidence")
("guide.evidence", "title", "Keep source and application distinct")
("guide.evidence", "text", "Name and link the Gospel passage. Do not invent episodes in Jesus’ adolescence. Present theological applications as readings of the text. Use the disciples’ failures when discussing wrongdoing and repair.")
("reading.palette", "guide", "guide.types")
("guide.types", "title", "Constrain content before projection")
("guide.types", "text", "Refuse unknown content types and fields, missing or repeated single values, wrong reference types, invalid routes, unsafe source links, duplicate section anchors and inconsistent planned-entry status. Static content cannot supply markup, scripts or event handlers.")
