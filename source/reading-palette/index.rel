// Shared reading palette index and closed content contracts.
// First worked composition: Father / Growing Up in the Way of Jesus.
("reading.palette", "isa", "PaletteIndex")
("reading.palette", "title", "The reading palette")
("reading.palette", "description", "A working design guide for the reading pages: inspect real components, compare colour tokens and try keyboard, source and responsive states. These examples share their styles and composition with the published pages.")
("reading.palette", "demo", "palette.demo.patterns")
("reading.palette", "demo", "palette.demo.prose")
("reading.palette", "demo", "palette.demo.components")
("reading.palette", "demo", "palette.demo.colour")
("reading.palette", "demo", "palette.demo.catalogue")
("reading.palette", "demo", "palette.demo.rules")
("reading.palette", "demo", "palette.demo.projection")
("reading.palette", "demo", "palette.demo.checks")
("palette.demo.projection", "title", "One projection definition")
("palette.demo.projection", "note", "Reading pages, maps and specialist tools share one closed projection tree and stylesheet owner. Their layouts serve different purposes; their classes, attributes and output identities pass through the same admission boundary.")
("palette.demo.patterns", "title", "Page patterns")
("palette.demo.patterns", "note", "The feature, artwork, buttons and reading cards below use the same composition as the series page. Available articles link onward; planned articles stay clearly labelled.")
("palette.demo.prose", "title", "Typography and prose")
("palette.demo.prose", "note", "A numbered section at the real essay reading width. Compare its heading, paragraph spacing and line length with the full Dad essay.")
("palette.demo.components", "title", "Reading components")
("palette.demo.components", "note", "These are the actual Room to Grow components. Open the source invitation, follow the links and move through them with the keyboard. Questions remain private; this page collects no answers.")
("palette.demo.colour", "title", "Colour tokens")
("palette.demo.colour", "note", "These swatches start with the Dad palette. Use the cross fixed at the bottom right to cycle the reading themes from anywhere on the page; both swatches and values follow your choice. Components use the same CSS variables.")
("palette.demo.catalogue", "title", "Component index")
("palette.demo.catalogue", "note", "The content types and rules behind each component. Expand an entry for its intended use and constraints.")
("palette.demo.rules", "title", "Style guide")
("palette.demo.rules", "note", "Change shared components here before adding page-specific styling. Article prose and illustrations remain in their content sources.")
("palette.demo.checks", "title", "Try the styles")
("palette.demo.checks", "note", "Use this page as a manual inspection surface. Passing automated checks does not establish a visual or keyboard pass.")
("reading.palette", "check", "Use Tab and Shift+Tab to move through links and summaries. Check that focus is visible and nothing traps the keyboard.")
("reading.palette", "check", "Press Enter or Space on the source invitation and component-index summaries. Check both closed and open states.")
("reading.palette", "check", "Hover the primary button, secondary link and reading card. The same states should appear on the actual series page.")
("reading.palette", "check", "Resize to a narrow phone width and zoom to 200%. Check heading wrapping, stacked images and cards, prose width and the absence of horizontal scrolling.")
("reading.palette", "check", "Inspect the shared masthead and footer as well as the page body. Compare with Dad Threads and the existing Dad essay using the links below.")
("reading.palette", "check", "Activate the cross with a click, Enter or Space. Cycle through Dad, Sourcerer, Author and Christian, checking the whole page, live theme announcement and colour values. The article stays in place.")
("reading.palette", "component", "palette.hero")
("reading.palette", "component", "palette.prose")
("reading.palette", "component", "palette.scripture")
("reading.palette", "component", "palette.pause")
("reading.palette", "component", "palette.sayings")
("reading.palette", "component", "palette.examples")
("reading.palette", "component", "palette.question")
("reading.palette", "component", "palette.practice")
("reading.palette", "component", "palette.series")
("palette.hero", "isa", "PaletteComponent")
("palette.hero", "title", "Illustrated opening")
("palette.hero", "contentType", "ReadingImage")
("palette.hero", "purpose", "Set a welcoming scene and establish the article’s subject.")
("palette.hero", "rule", "One main illustration; meaningful alternative text; intrinsic dimensions; no essential text baked into artwork.")
("palette.prose", "isa", "PaletteComponent")
("palette.prose", "title", "Reading section")
("palette.prose", "contentType", "ReadingSection")
("palette.prose", "purpose", "Develop one thought through a heading and connected paragraphs.")
("palette.prose", "rule", "Keep paragraphs at a comfortable reading width. Use headings for real changes of subject. Preserve source order.")
("palette.scripture", "isa", "PaletteComponent")
("palette.scripture", "title", "Expandable source invitation")
("palette.scripture", "contentType", "ScriptureReading")
("palette.scripture", "purpose", "Let a reader open a short prompt and visit the controlling passage.")
("palette.scripture", "rule", "Use native details and summary, a named reference and a source link. Distinguish paraphrase from quotation and application.")
("palette.pause", "isa", "PaletteComponent")
("palette.pause", "title", "Reading pause")
("palette.pause", "contentType", "ReadingPause")
("palette.pause", "purpose", "Give one important thought time and visual space.")
("palette.pause", "rule", "Place at a declared section boundary. Use an aside for editorial emphasis; do not make original prose look like a biblical quotation.")
("palette.sayings", "isa", "PaletteComponent")
("palette.sayings", "title", "Words to borrow")
("palette.sayings", "contentType", "ReadingSection")
("palette.sayings", "purpose", "Give a reader short, usable language for an ordinary conversation.")
("palette.sayings", "rule", "Use an accessible list. Present possibilities without prescribing a personality or demanding confrontation.")
("palette.examples", "isa", "PaletteComponent")
("palette.examples", "title", "Everyday practice cards")
("palette.examples", "contentType", "PracticeExample")
("palette.examples", "purpose", "Connect a situation with one possible response.")
("palette.examples", "rule", "Keep the situation and response together. Stack on small screens. State that these are examples.")
("palette.question", "isa", "PaletteComponent")
("palette.question", "title", "Reflection question")
("palette.question", "contentType", "ReflectionQuestion")
("palette.question", "purpose", "Offer a thought to carry away from the article.")
("palette.question", "rule", "One clear question with permission to think privately. No form, submission, tracking, score or required disclosure.")
("palette.practice", "isa", "PaletteComponent")
("palette.practice", "title", "Small practice")
("palette.practice", "contentType", "ReadingPractice")
("palette.practice", "purpose", "Suggest a modest action and a way to notice what happened.")
("palette.practice", "rule", "Keep the action achievable. Avoid progress scores, streaks and promises about outcomes.")
("palette.series", "isa", "PaletteComponent")
("palette.series", "title", "Reading thread")
("palette.series", "contentType", "ReadingSeries")
("palette.series", "purpose", "Locate the article in a series and offer a route onward.")
("palette.series", "rule", "Render available drafts as links. Planned articles remain text with an explicit status; never create dead links.")

