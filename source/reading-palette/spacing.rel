// Shared spacing corrections, applied to components rather than individual pages.
("reading.space.cards", "isa", "StyleRule")
("reading.space.cards", "projection", "main")
("reading.space.cards", "selector", ":is(.faith-threads,.reading-room) .identity-thread:not(:has(>img))")
("reading.space.cards", "declaration", "reading.space.top32")
("reading.space.top32", "property", "padding-top")
("reading.space.top32", "value", "32px")
("reading.space.cards", "declaration", "reading.space.bottom28")
("reading.space.bottom28", "property", "padding-bottom")
("reading.space.bottom28", "value", "28px")
("reading.space.kicker", "isa", "StyleRule")
("reading.space.kicker", "projection", "main")
("reading.space.kicker", "selector", ":is(.faith-threads,.reading-room) .identity-thread>.faith-thread-kicker:first-child")
("reading.space.kicker", "declaration", "reading.space.top0")
("reading.space.top0", "property", "margin-top")
("reading.space.top0", "value", "0")
("reading.space.reference", "isa", "StyleRule")
("reading.space.reference", "projection", "main")
("reading.space.reference", "selector", ".reading-series-card")
("reading.space.reference", "declaration", "reading.space.radius")
("reading.space.radius", "property", "border-radius")
("reading.space.radius", "value", "18px")
("reading.space.reference", "declaration", "reading.space.surface")
("reading.space.surface", "property", "background")
("reading.space.surface", "value", "var(--reading-surface)")
("reading.space.referenceFirst", "isa", "StyleRule")
("reading.space.referenceFirst", "projection", "main")
("reading.space.referenceFirst", "selector", ".reading-series-card>:first-child")
("reading.space.referenceFirst", "declaration", "reading.space.top0")
("reading.space.referenceLast", "isa", "StyleRule")
("reading.space.referenceLast", "projection", "main")
("reading.space.referenceLast", "selector", ".reading-series-card>:last-child")
("reading.space.referenceLast", "declaration", "reading.space.bottom0")
("reading.space.bottom0", "property", "margin-bottom")
("reading.space.bottom0", "value", "0")
("reading.space.prose", "isa", "StyleRule")
("reading.space.prose", "projection", "main")
("reading.space.prose", "selector", ".reading-palette .faith-essay-body")
("reading.space.prose", "declaration", "reading.space.margin0")
("reading.space.margin0", "property", "margin")
("reading.space.margin0", "value", "0")
("reading.space.proseStart", "isa", "StyleRule")
("reading.space.proseStart", "projection", "main")
("reading.space.proseStart", "selector", ".reading-palette .faith-essay-body>:first-child")
("reading.space.proseStart", "declaration", "reading.space.top0")
("reading.space.intro", "isa", "StyleRule")
("reading.space.intro", "projection", "main")
("reading.space.intro", "selector", ".reading-palette .gate-hero>p:last-child")
("reading.space.intro", "declaration", "reading.space.measure")
("reading.space.measure", "property", "max-width")
("reading.space.measure", "value", "68ch")
("reading.space.grid", "isa", "StyleRule")
("reading.space.grid", "projection", "main")
("reading.space.grid", "selector", ".reading-palette .reading-series-grid")
("reading.space.grid", "declaration", "reading.space.gap")
("reading.space.gap", "property", "gap")
("reading.space.gap", "value", "24px")
("reading.space.rules", "isa", "StyleRule")
("reading.space.rules", "projection", "main")
("reading.space.rules", "selector", ".reading-palette .reading-guide>section")
("reading.space.rules", "declaration", "reading.space.ruleGap")
("reading.space.ruleGap", "property", "margin-bottom")
("reading.space.ruleGap", "value", "32px")
("reading.space.mobileGutters", "isa", "StyleRule")
("reading.space.mobileGutters", "projection", "main")
("reading.space.mobileGutters", "context", "(max-width: 700px)")
("reading.space.mobileGutters", "selector", "body :is(.reading-room,.reading-essay)")
("reading.space.mobileGutters", "declaration", "reading.space.left24")
("reading.space.left24", "property", "padding-left")
("reading.space.left24", "value", "24px")
("reading.space.mobileGutters", "declaration", "reading.space.right24")
("reading.space.right24", "property", "padding-right")
("reading.space.right24", "value", "24px")
("reading.space.mobileCross", "isa", "StyleRule")
("reading.space.mobileCross", "projection", "main")
("reading.space.mobileCross", "context", "(max-width: 700px)")
("reading.space.mobileCross", "selector", ".identity-switch.reading-theme-switch")
("reading.space.mobileCross", "declaration", "reading.space.crossWidth")
("reading.space.crossWidth", "property", "width")
("reading.space.crossWidth", "value", "56px")
("reading.space.mobileCross", "declaration", "reading.space.crossHeight")
("reading.space.crossHeight", "property", "height")
("reading.space.crossHeight", "value", "56px")
("reading.space.mobileFooter", "isa", "StyleRule")
("reading.space.mobileFooter", "projection", "main")
("reading.space.mobileFooter", "context", "(max-width: 700px)")
("reading.space.mobileFooter", "selector", "body:has(:is(.faith-threads,.reading-room,.faith-essay,.reading-essay)) footer.footer")
("reading.space.mobileFooter", "declaration", "reading.space.clearance")
("reading.space.clearance", "property", "padding-bottom")
("reading.space.clearance", "value", "104px")
("reading.space.citation", "isa", "StyleRule")
("reading.space.citation", "projection", "main")
("reading.space.citation", "selector", ".reading-citation")
("reading.space.citation", "declaration", "reading.space.noWrap")
("reading.space.noWrap", "property", "white-space")
("reading.space.noWrap", "value", "nowrap")
("reading.space.citation", "declaration", "reading.space.inlineBlock")
("reading.space.inlineBlock", "property", "display")
("reading.space.inlineBlock", "value", "inline-block")
("reading.space.buttons", "isa", "StyleRule")
("reading.space.buttons", "projection", "main")
("reading.space.buttons", "selector", ".faith-button")
("reading.space.buttons", "declaration", "reading.space.balance")
("reading.space.balance", "property", "text-wrap")
("reading.space.balance", "value", "balance")
("reading.space.buttons", "declaration", "reading.space.centre")
("reading.space.centre", "property", "text-align")
("reading.space.centre", "value", "center")
