("v336", "type", "Sequence")
("v337", "type", "String")
("v337", "scalar", "Why begin with Jesus?")
("v336", "item", "v337")
("v335", "value", "v336")
("v317", "item", "v330")
("v338", "type", "Record")
("v338", "entry", "v339")
("v339", "type", "Entry")
("v339", "key", "tag")
("v340", "type", "String")
("v340", "scalar", "p")
("v339", "value", "v340")
("v338", "entry", "v341")
("v341", "type", "Entry")
("v341", "key", "attrs")
("v342", "type", "Record")
("v341", "value", "v342")
("v338", "entry", "v343")
("v343", "type", "Entry")
("v343", "key", "children")
("v344", "type", "Sequence")
("v345", "type", "String")
("v345", "scalar", "For this Christian reading, Jesus is the centre by which I try to understand the character of God. John’s account of God entering human life, the self-giving described in Philippians, and Jesus’ teaching about serving others guide the interpretation. These are particular Christian commitments, with historical and theological claims that deserve their own examination. ")
("v344", "item", "v345")
("v346", "type", "Record")
("v346", "entry", "v347")
("v347", "type", "Entry")
("v347", "key", "tag")
("v348", "type", "String")
