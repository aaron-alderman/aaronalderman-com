("v685", "type", "Entry")
("v685", "key", "children")
("v686", "type", "Sequence")
("v687", "type", "String")
("v687", "scalar", "Suppose a person with authority says that faith requires someone else to stay silent about harm. Before accepting that claim, I should ask for the passage and its context, examine how the authority is being used, and listen to the person carrying the cost. Their safety and freedom to speak need attention now.")
("v686", "item", "v687")
("v685", "value", "v686")
