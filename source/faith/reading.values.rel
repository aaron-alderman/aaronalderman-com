("v679", "scalar", "What changes in an ordinary decision?")
("v678", "item", "v679")
("v677", "value", "v678")
("v659", "item", "v672")
("v680", "type", "Record")
("v680", "entry", "v681")
("v681", "type", "Entry")
("v681", "key", "tag")
