("v646", "type", "Entry")
("v646", "key", "children")
("v647", "type", "Sequence")
("v648", "type", "String")
("v648", "scalar", "I do not have to settle every ultimate question before treating someone as a neighbour. I can listen, work alongside them, receive correction and acknowledge goodness without asking them to become a supporting character in my account of God. An honest disagreement can remain an honest relationship.")
("v647", "item", "v648")
