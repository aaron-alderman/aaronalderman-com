("v0", "entry", "v20")
("v20", "type", "Entry")
("v20", "key", "semantics")
("v21", "type", "Sequence")
("v22", "type", "String")
("v22", "scalar", "All three methods read the same selected evidence IDs and claim version.")
("v21", "item", "v22")
("v23", "type", "String")
("v23", "scalar", "Conditions are conjunctive equality checks; missing values fail. The first matching rule in descending priority supplies the weight.")
("v21", "item", "v23")
("v24", "type", "String")
("v24", "scalar", "Only admitted evidence contributes. Support and challenge are exact millionth-unit integers, not truth probabilities.")
("v21", "item", "v24")
("v25", "type", "String")
("v25", "scalar", "Independent sources count distinct source actors explicitly marked independent among admitted items.")
("v21", "item", "v25")
("v26", "type", "String")
("v26", "scalar", "Insufficient source count yields Undecided before thresholds are tested. Both thresholds yield Conflicted; support only Accepted; challenge only Rejected; neither Undecided.")
("v21", "item", "v26")
("v20", "value", "v21")
("v0", "entry", "v27")
("v27", "type", "Entry")
("v27", "key", "scope")
("v28", "type", "String")
("v28", "scalar", "These three original published 1.0.0 example methods have non-overlapping matching rules. This bounded projection does not implement arbitrary Claimipedia languages, conflicting priority ties, real submissions, authority, persistence or production adjudication.")
("v27", "value", "v28")
