("questions", "title", "How do I actually live like Jesus?")
("questions", "description", "Questions I’m living and building with: Christian faith, accountable software, honest inquiry and the practice of care.")
("questions", "hero", "assets/questions/open-workshop-v1.png")
("questions", "subtitle", "Here. With these people. With the power I have.")
("questions", "intro", "I’m building software, pursuing an account of the physical world, and trying to follow Christ. I want those commitments to answer to one another—in the way I work, listen and care.")
("questions.asset.workshop", "isa", "PublicationAsset")
("questions.asset.workshop", "path", "assets/questions/open-workshop-v1.png")
("questions.power", "isa", "LivedQuestion")
("questions.power", "label", "01 / Power & agency")
("questions.power", "title", "Where am I helping—and where am I taking over?")
("questions.power", "note", "Having the power to act does not settle what I owe the person in front of me. I need to ask whose freedom my help makes possible.")
("questions.power", "href", "places/kenosis.html")
("questions.power", "cta", "Explore power and agency")
("questions.power", "image", "assets/atlas/boundary-v1.png")
("questions.power", "light", "boundary")
("questions.permission", "isa", "LivedQuestion")
("questions.permission", "label", "02 / Engineering & restraint")
("questions.permission", "title", "What must I refuse, even if I can make it work?")
("questions.permission", "note", "A working system can still ask too much of people. I want my engineering to make its authority, limits and costs visible.")
("questions.permission", "href", "places/permission.html")
("questions.permission", "cta", "Examine permission and responsibility")
("questions.permission", "image", "assets/world-emblems/temple-v1.png")
("questions.permission", "light", "human")
("questions.truth", "isa", "LivedQuestion")
("questions.truth", "label", "03 / Physics & truth")
("questions.truth", "title", "What would make me surrender the theory I want to be true?")
("questions.truth", "note", "If I ask an explanation to earn my trust, I have to leave it somewhere to fail. That includes the explanations I most want to succeed.")
("questions.truth", "href", "places/laboratory.html")
("questions.truth", "cta", "Enter the working laboratory")
("questions.truth", "image", "assets/atlas/unseen-v1.png")
("questions.truth", "light", "unseen")
("questions.software", "isa", "LivedQuestion")
("questions.software", "label", "04 / Sourcery & accountability")
("questions.software", "title", "Can the software I build answer for what it does?")
("questions.software", "note", "People should be able to follow a change, question its reasons and retain a meaningful say in what happens next.")
("questions.software", "href", "places/sourcery.html")
("questions.software", "cta", "Follow the human question in Sourcery")
("questions.software", "image", "assets/world-emblems/sourcery-v1.png")
("questions.software", "light", "boundary")
("questions.care", "isa", "LivedQuestion")
("questions.care", "label", "05 / Attention & care")
("questions.care", "title", "How do I keep caring when understanding isn’t enough?")
("questions.care", "note", "I can understand a principle and still miss the person. I want to practise attention, listen to correction and keep finding contact.")
("questions.care", "href", "places/care.html")
("questions.care", "cta", "Begin with care")
("questions.care", "image", "assets/atlas/human-v1.png")
("questions.care", "light", "human")
("questions.repair", "isa", "LivedQuestion")
("questions.repair", "label", "06 / History & repair")
("questions.repair", "title", "How do I repair harm without rewriting what happened?")
("questions.repair", "note", "An apology cannot make the past disappear. Repair has to leave room for truth, changed practice and the other person’s boundaries.")
("questions.repair", "href", "places/revision.html")
("questions.repair", "cta", "Follow the visible seam")
("questions.repair", "image", "assets/questions/open-workshop-v1.png")
("questions.repair", "light", "human")
("field.choice.cover-quietly", "isa", "FieldChoice")
("field.choice.cover-quietly", "id", "cover-quietly")
("field.choice.cover-quietly", "title", "Cover the shift quietly")
("field.choice.cover-quietly", "direct", "Mira can leave and the workshop stays staffed. I absorb the cost.")
("field.choice.cover-quietly", "relational", "The coordinator may come to rely on private cover.")
("field.choice.cover-quietly", "institutional", "Understaffing may remain a workable institutional strategy.")
("field.choice.cover-quietly", "unknown", "I still do not know why Mira needs to leave or whether I can keep doing this.")
("field.choice.ask-and-convene", "isa", "FieldChoice")
("field.choice.ask-and-convene", "id", "ask-and-convene")
("field.choice.ask-and-convene", "title", "Ask privately and share the responsibility")
("field.choice.ask-and-convene", "direct", "Mira can say only what she chooses. I ask who has capacity to help.")
("field.choice.ask-and-convene", "relational", "Others may gain a safer way to name their own limits.")
("field.choice.ask-and-convene", "institutional", "The staffing rule may have to be examined and defended openly.")
("field.choice.ask-and-convene", "unknown", "A shared process may be too slow for the immediate problem.")
("field.choice.expose-publicly", "isa", "FieldChoice")
("field.choice.expose-publicly", "id", "expose-publicly")
("field.choice.expose-publicly", "title", "Make the staffing problem public")
("field.choice.expose-publicly", "direct", "The problem becomes visible, and public pressure may secure help.")
("field.choice.expose-publicly", "relational", "I expose Mira’s private request without her consent.")
("field.choice.expose-publicly", "institutional", "Other workers may become less willing to ask for help.")
("field.choice.expose-publicly", "unknown", "A fast result would not by itself settle what the disclosure cost her.")
("field.choice.decline-and-connect", "isa", "FieldChoice")
("field.choice.decline-and-connect", "id", "decline-and-connect")
("field.choice.decline-and-connect", "title", "Set a boundary and help find another route")
("field.choice.decline-and-connect", "direct", "I preserve my capacity and contact the cooperative about cover.")
("field.choice.decline-and-connect", "relational", "Mira’s request remains a request, rather than an obligation I have to accept.")
("field.choice.decline-and-connect", "institutional", "Responsibility may move towards a shared rota.")
("field.choice.decline-and-connect", "unknown", "Another person may not arrive in time. Setting a boundary does not remove that consequence.")
("field.choice.leave-encounter", "isa", "FieldChoice")
("field.choice.leave-encounter", "id", "leave-encounter")
("field.choice.leave-encounter", "title", "Leave this encounter")
("field.choice.leave-encounter", "direct", "I make no intervention in the scenario.")
("field.choice.leave-encounter", "relational", "My standing does not depend on completing this exercise.")
("field.choice.leave-encounter", "institutional", "The situation continues beyond the part this encounter shows.")
("field.choice.leave-encounter", "unknown", "The later outcome is unknown. I can leave without being assessed.")
