("v278", "scalar", "<div class=\"world-encounter\" data-world-type=\"garden\" data-mode=\"budget\"><p class=\"encounter-label\">THE GARDEN / A DECLARED COMPATIBILITY RULE</p><div class=\"world-controls\"><button class=\"control\" data-world=\"garden-mode\" data-value=\"budget\" aria-pressed=\"true\">A shared limit</button><button class=\"control\" data-world=\"garden-mode\" data-value=\"positive\" aria-pressed=\"false\">Two linked quantities</button></div><p class=\"equation-note\" id=\"garden-equation\" hidden>Response [[x, c], [c, y]]<br>x ≥ 0, y ≥ 0, and x·y ≥ c²</p><div class=\"possibility-grid\" role=\"img\" aria-label=\"Twenty-five pairs. Pairs with sum no greater than four are currently admitted.\"><span class=\"possibility-seed admitted\" data-x=\"0\" data-y=\"0\"><i></i><small>0,0</small></span><span class=\"possibility-seed admitted\" data-x=\"1\" data-y=\"0\"><i></i><small>1,0</small></span><span class=\"possibility-seed admitted\" data-x=\"2\" data-y=\"0\"><i></i><small>2,0</small></span><span class=\"possibility-seed admitted\" data-x=\"3\" data-y=\"0\"><i></i><small>3,0</small></span><span class=\"possibility-seed admitted\" data-x=\"4\" data-y=\"0\"><i></i><small>4,0</small></span><span class=\"possibility-seed admitted\" data-x=\"0\" data-y=\"1\"><i></i><small>0,1</small></span><span class=\"possibility-seed admitted\" data-x=\"1\" data-y=\"1\"><i></i><small>1,1</small></span><span class=\"possibility-seed admitted\" data-x=\"2\" data-y=\"1\"><i></i><small>2,1</small></span><span class=\"possibility-seed admitted\" data-x=\"3\" data-y=\"1\"><i></i><small>3,1</small></span><span class=\"possibility-seed \" data-x=\"4\" data-y=\"1\"><i></i><small>4,1</small></span><span class=\"possibility-seed admitted\" data-x=\"0\" data-y=\"2\"><i></i><small>0,2</small></span><span class=\"possibility-seed admitted\" data-x=\"1\" data-y=\"2\"><i></i><small>1,2</small></span><span class=\"possibility-seed admitted\" data-x=\"2\" data-y=\"2\"><i></i><small>2,2</small></span><span class=\"possibility-seed \" data-x=\"3\" data-y=\"2\"><i></i><small>3,2</small></span><span class=\"possibility-seed \" data-x=\"4\" data-y=\"2\"><i></i><small>4,2</small></span><span class=\"possibility-seed admitted\" data-x=\"0\" data-y=\"3\"><i></i><small>0,3</small></span><span class=\"possibility-seed admitted\" data-x=\"1\" data-y=\"3\"><i></i><small>1,3</small></span><span class=\"possibility-seed \" data-x=\"2\" data-y=\"3\"><i></i><small>2,3</small></span><span class=\"possibility-seed \" data-x=\"3\" data-y=\"3\"><i></i><small>3,3</small></span><span class=\"possibility-seed \" data-x=\"4\" data-y=\"3\"><i></i><small>4,3</small></span><span class=\"possibility-seed admitted\" data-x=\"0\" data-y=\"4\"><i></i><small>0,4</small></span><span class=\"possibility-seed \" data-x=\"1\" data-y=\"4\"><i></i><small>1,4</small></span><span class=\"possibility-seed \" data-x=\"2\" data-y=\"4\"><i></i><small>2,4</small></span><span class=\"possibility-seed \" data-x=\"3\" data-y=\"4\"><i></i><small>3,4</small></span><span class=\"possibility-seed \" data-x=\"4\" data-y=\"4\"><i></i><small>4,4</small></span></div><label class=\"range-label\" for=\"garden-limit\"><span id=\"garden-rule-copy\">Keep pairs whose two numbers add up to at most</span> <output id=\"garden-value\">4</output></label><input class=\"world-range\" id=\"garden-limit\" data-world-input=\"garden\" type=\"range\" min=\"0\" max=\"8\" step=\"1\" value=\"4\"><div class=\"world-result\" id=\"world-result\" aria-live=\"polite\">15 of the 25 pairs fit this rule.</div><p class=\"world-note\">AN AUTHORED FINITE RULE · NO PHYSICAL LAW IS INFERRED</p></div>")
