# Authoritative shared Markdown, lexer and formatting processes.
# JSON is generated by the selected Encounter process frontend.
process-module "temple/surface-process-module/1"
profile "encounter/shared-source-module/2"

process sp.role:
  let v = at($eventInput, "text")
  let language = at($eventInput, "language")
  let role = "plain"
  when eq($language, "javascript"):
    when eq(at($eventInput, "category"), "comment"):
      let role = "comment"
    port value.describe { value = at($eventInput, "keyword") } → keywordType
    when and(eq(at($keywordType, "type"), "string"), not(eq(at($eventInput, "keyword"), ""))):
      let role = "keyword"
    fold at($spPolicy, "javascriptRoles") as rule; role starts $role:
      when includes(at($rule, "kinds"), at($eventInput, "kind")):
        let role = at($rule, "role")
      yield $role → role
  when not(eq($language, "javascript")):
    port text.slice { value = $v; start = 0; end = 1 } → first
    port text.matches { value = $v; pattern = "^\\s*$" } → white
    when not($white):
      when eq($first, "\""):
        let role = "string"
        when eq($language, "json"):
          port text.matches { value = at($eventInput, "tail"); pattern = "^\\s*:" } → key
          when $key:
            let role = "property"
        when eq($language, "rel"):
          when eq(at($eventInput, "atom"), 0):
            let role = "identity"
          when eq(at($eventInput, "atom"), 1):
            let role = "predicate"
      when and(not(eq($first, "\"")), includes(list("true", "false"), $v)):
        let role = "boolean"
      when eq($v, "null"):
        let role = "keyword"
      port text.matches { value = $v; pattern = "^-?[0-9]" } → number
      when $number:
        let role = "number"
      port text.matches { value = $v; pattern = "^(?://|#)" } → comment
      when $comment:
        let role = "comment"
      when and(
        includes(list("encounter", "temple", "process"), $language),
        not(or($comment, eq($first, "\""), $number))
      ):
        port text.matches { value = $v; pattern = "^[A-Za-z_]" } → name
        when and($name, eq($role, "plain")):
          let role = if(includes(at($spPolicy, "keywords"), $v), "keyword", "identifier")
        when includes(list("@", at($spPolicy, "referenceSigil")), $first):
          let role = "reference"
      when includes(at($spPolicy, "punctuation"), $v):
        let role = "punctuation"
      when includes(at($spPolicy, "operators"), $v):
        let role = "operator"
  when or(
    and(
      eq($language, "rel"),
      eq(at($eventInput, "atom"), 2),
      includes(at($spPolicy, "typePredicates"), at($eventInput, "predicate")),
      eq($role, "string")
    ),
    and(
      includes(list("encounter", "temple"), $language),
      at($eventInput, "typeExpected"),
      includes(list("string", "identifier"), $role)
    )
  ):
    let role = "type"
  when eq($language, "markdown"):
    let role = "plain"
    port text.matches { value = $v; pattern = "^(?:#{1,6}|\\*\\*)" } → mdHeading
    when $mdHeading:
      let role = "keyword"
    port text.matches { value = $v; pattern = "^`|^~~~" } → mdCode
    when $mdCode:
      let role = "string"
    port text.matches { value = $v; pattern = "^\\[" } → mdLink
    when $mdLink:
      let role = "reference"
    port text.matches { value = $v; pattern = "^(?:\\||[-+>] |\\*)" } → mdPunctuation
    when $mdPunctuation:
      let role = "operator"
  let result = $role

process sp.scan:
  let text = at($eventInput, "text")
  let language = at($eventInput, "language")
  port kernel.invoke { query = "source.split"; input = { text = $text; language = $language } } → lexed
  let parts = at($lexed, "parts")
  let withinLimit = at($lexed, "withinLimit")
  let segments = list({ start = 0; end = count($text); text = $text; role = "plain" })
  when $withinLimit:
    fold $parts as part; scan starts {
      offset = 0;
      segments = list();
      atom = 0;
      predicate = null;
      typeNext = false;
      previous = null;
      declaration = null
    }:
      let start = at($scan, "offset")
      let end = add($start, count($part))
      let segments = at($scan, "segments")
      let atom = at($scan, "atom")
      when eq($part, "("):
        let atom = 0
      port text.slice { value = $text; start = $end; end = count($text) } → tail
      port kernel.invoke {
        query = "sp.role";
        input = {
          text = $part;
          language = $language;
          tail = $tail;
          atom = $atom;
          predicate = at($scan, "predicate");
          typeExpected = at($scan, "typeNext")
        }
      } → role
      when not(eq(count($part), 0)):
        let segments = append($segments, list({ start = $start; end = $end; text = $part; role = $role }))
      port text.slice { value = $part; start = 0; end = 1 } → first
      when eq($first, "\""):
        let atom = add($atom, 1)
      let predicate = at($scan, "predicate")
      let typeNext = at($scan, "typeNext")
      let previous = at($scan, "previous")
      let declaration = at($scan, "declaration")
      when and(eq($language, "rel"), eq(at($scan, "atom"), 1), eq($first, "\"")):
        try:
          port json.parse { text = $part } → predicate
        catch predicateFault:
          let predicate = null
      port text.matches { value = $part; pattern = "[\\r\\n]" } → lineBreak
      port text.matches { value = $part; pattern = "^\\s*$" } → space
      when $lineBreak:
        let typeNext = false
        let previous = null
        let declaration = null
      when and(not($space), not(eq($role, "comment"))):
        when and(eq($previous, null), eq($role, "keyword"), eq($part, "given")):
          let declaration = "given"
        let typeNext = and(
          includes(list("encounter", "temple"), $language),
          eq($role, "keyword"),
          or(
            includes(at(at($spPolicy, "typeIntroducers"), $language), $part),
            and(eq($part, "as"), or(eq($previous, "show"), eq($declaration, "given")))
          )
        )
        let previous = $part
      yield {
      offset = $end;
      segments = $segments;
      atom = $atom;
      predicate = $predicate;
      typeNext = $typeNext;
      previous = $previous;
      declaration = $declaration
    } → scan
    let segments = at($scan, "segments")
  let result = {
    segments = $segments;
    diagnostic = if($withinLimit, null, "SP-LIMIT: Exact text retained without token decoration.")
  }

process sp.observed:
  let text = at($eventInput, "text")
  let observed = at($eventInput, "observed")
  assert and(
    eq(at($observed, "units"), "utf16"),
    eq(at($observed, "sha256"), at($eventInput, "sha256")),
    isArray(at($observed, "tokens"))
  )
    otherwise "SP-OBSERVATION: Token observations belong to a different source basis."
  assert includes(
    range(add(at($spPolicy, "maxParts"), 1)),
    add(count(at($observed, "tokens")), 1)
  )
    otherwise "SP-LIMIT: Too many observed tokens."
  fold at($observed, "tokens") as token; scan starts { offset = 0; segments = list() }:
    let start = at($token, "start")
    let end = at($token, "end")
    port text.slice { value = $text; start = 0; end = $start } → prefix
    port text.slice { value = $text; start = 0; end = $end } → endPrefix
    assert and(eq(count($prefix), $start), eq(count($endPrefix), $end))
      otherwise "SP-RANGE: Token endpoint is outside the exact UTF-16 source."
    port text.slice { value = $text; start = at($scan, "offset"); end = $start } → gap
    port text.slice { value = $text; start = $start; end = $end } → raw
    assert and(
      eq(add(at($scan, "offset"), count($gap)), $start),
      eq(add($start, count($raw)), $end)
    )
      otherwise "SP-OVERLAP: Token observations are reversed or overlap."
    let segments = at($scan, "segments")
    when not(eq(count($gap), 0)):
      let segments = append(
        $segments,
        list({ start = at($scan, "offset"); end = $start; text = $gap; role = "plain" })
      )
    port kernel.invoke {
      query = "sp.role";
      input = {
        text = $raw;
        language = "javascript";
        category = at($token, "category");
        kind = at($token, "kind");
        keyword = at($token, "keyword")
      }
    } → role
    when not(eq(count($raw), 0)):
      let segments = append($segments, list({ start = $start; end = $end; text = $raw; role = $role }))
    yield { offset = $end; segments = $segments } → scan
  port text.slice { value = $text; start = at($scan, "offset"); end = count($text) } → tail
  let result = at($scan, "segments")
  when not(eq(count($tail), 0)):
    let result = append(
      $result,
      list({ start = at($scan, "offset"); end = count($text); text = $tail; role = "plain" })
    )

process sp.clip:
  let text = at($eventInput, "text")
  let clipStart = at(at($eventInput, "clip"), "start")
  let clipEnd = at(at($eventInput, "clip"), "end")
  port text.slice { value = $text; start = 0; end = $clipStart } → startPrefix
  port text.slice { value = $text; start = 0; end = $clipEnd } → endPrefix
  port text.slice { value = $text; start = $clipStart; end = $clipEnd } → expected
  assert and(
    eq(count($startPrefix), $clipStart),
    eq(count($endPrefix), $clipEnd),
    eq(add($clipStart, count($expected)), $clipEnd)
  )
    otherwise "SP-CLIP: Invalid source fragment coordinates."
  fold at($eventInput, "segments") as segment; clipped starts list():
    port text.slice { value = $startPrefix; start = 0; end = at($segment, "start") } → commonStart
    let start = add(add($clipStart, at($segment, "start")), concat("-", count($commonStart)))
    port text.slice { value = $endPrefix; start = 0; end = at($segment, "end") } → commonEnd
    let end = count($commonEnd)
    port text.slice { value = $text; start = $start; end = $end } → piece
    let next = $clipped
    when not(eq(count($piece), 0)):
      let next = append(
        $clipped,
        list({ start = $start; end = $end; text = $piece; role = at($segment, "role") })
      )
    yield $next → clipped
  let joined = fold($clipped, "segment", "joined", "", concat($joined, at($segment, "text")))
  assert eq($joined, $expected)
    otherwise "SP-COVERAGE: Presentation must preserve the exact source fragment."
  port text.split { value = $startPrefix; pattern = "\\r\\n|\\r|\\n" } → prefixLines
  let result = { segments = $clipped; text = $expected; firstLine = count($prefixLines) }

process sp.line:
  let result = {
    tag = "span";
    attrs = {
      class = concat(
        "sp-line",
        if(eq(at($eventInput, "number"), at($eventInput, "selectedLine")), " highlight", "")
      );
      "data-line" = concat(at($eventInput, "number"))
    };
    children = at($eventInput, "children")
  }

process sp.render:
  let selectedLine = at($eventInput, "selectedLine")
  fold at($eventInput, "segments") as segment; layout starts { number = at($eventInput, "firstLine"); lines = list(); pending = list() }:
    assert includes(at($spPolicy, "roles"), at($segment, "role"))
      otherwise "SP-ROLE: Unknown presentation role."
    port text.split { value = at($segment, "text"); pattern = "(\\r\\n|\\n|\\r)" } → pieces
    fold $pieces as piece; line starts $layout:
      let number = at($line, "number")
      let lines = at($line, "lines")
      let pending = at($line, "pending")
      port text.matches { value = $piece; pattern = "^(?:\\r\\n|\\n|\\r)$" } → newline
      when $newline:
        port kernel.invoke {
          query = "sp.line";
          input = { number = $number; selectedLine = $selectedLine; children = $pending }
        } → lineTree
        let lines = append($lines, list($lineTree, $piece))
        let number = add($number, 1)
        let pending = list()
      when and(not($newline), not(eq($piece, ""))):
        let pending = append(
          $pending,
          list(
            {
              tag = "span";
              attrs = { class = concat("sp-token sp-", at($segment, "role")) };
              children = list($piece)
            }
          )
        )
      yield { number = $number; lines = $lines; pending = $pending } → nextLayout
    yield $nextLayout → layout
  port kernel.invoke {
    query = "sp.line";
    input = {
      number = at($layout, "number");
      selectedLine = $selectedLine;
      children = at($layout, "pending")
    }
  } → lastLine
  let result = {
    tag = "code";
    attrs = {
      class = "sp-code";
      "data-theme" = at($eventInput, "theme");
      "data-numbered" = if(at($eventInput, "lineNumbers"), "true", "false");
      tabindex = "0"
    };
    children = append(at($layout, "lines"), list($lastLine))
  }

process sp.present:
  port kernel.invoke { query = "s01.portable"; input = { value = $eventInput; ancestors = list() } } → portable
  assert $portable
    otherwise "SP-INPUT: Presentation requires finite own-data."
  let text = at($eventInput, "text")
  port value.describe { value = $text } → type
  assert eq(at($type, "type"), "string")
    otherwise "SP-INPUT: Exact source text is required."
  port digest.sha256 { text = $text } → hash
  assert eq($hash, at($eventInput, "expectedHash"))
    otherwise "SP-BASIS: Source hash mismatch."
  let file = at($eventInput, "file")
  let fileAlias = at(at($spPolicy, "fileAliases"), $file)
  when $fileAlias:
    let file = $fileAlias
  let language = at($eventInput, "language")
  let theme = at($eventInput, "theme")
  assert includes(at($spPolicy, "themesAllowed"), $theme)
    otherwise "SP-THEME: Unknown theme."
  when eq($language, "auto"):
    let language = "plain"
    fold at($spPolicy, "fileProfiles") as profile; language starts $language:
      port text.matches { value = $file; pattern = at($profile, "pattern") } → matches
      when $matches:
        let language = at($profile, "language")
      yield $language → language
  let reason = null
  let segments = list({ start = 0; end = count($text); text = $text; role = "plain" })
  port text.slice { value = $text; start = 0; end = at($spPolicy, "maxCodeUnits") } → bounded
  let bounded = eq(count($bounded), count($text))
  when not($bounded):
    let reason = "SP-LIMIT: Source retained as plain text at this presentation bound."
  when and(
    $bounded,
    includes(list("json", "rel", "encounter", "temple", "process", "markdown"), $language)
  ):
    port kernel.invoke { query = "sp.scan"; input = { text = $text; language = $language } } → scanned
    let segments = at($scanned, "segments")
    let reason = at($scanned, "diagnostic")
  when and($bounded, eq($language, "javascript")):
    when at($eventInput, "observed"):
      port kernel.invoke {
        query = "sp.observed";
        input = { text = $text; sha256 = $hash; observed = at($eventInput, "observed") }
      } → segments
    when not(at($eventInput, "observed")):
      let reason = "SP-UNBOUND: JavaScript token observations are unavailable; exact text retained."
  let clip = at($eventInput, "clip")
  when not($clip):
    let clip = { start = 0; end = count($text) }
  port kernel.invoke { query = "sp.clip"; input = { text = $text; clip = $clip; segments = $segments } } → clipped
  port kernel.invoke {
    query = "sp.render";
    input = {
      segments = at($clipped, "segments");
      theme = $theme;
      lineNumbers = at($eventInput, "lineNumbers");
      selectedLine = at($eventInput, "selectedLine");
      firstLine = at($clipped, "firstLine")
    }
  } → tree
  let result = {
    protocol = "encounter/source-presentation/1";
    ok = true;
    sourceHash = $hash;
    units = "utf16";
    language = $language;
    assurance = "lexical-presentation-only";
    diagnostic = $reason;
    text = at($clipped, "text");
    segments = at($clipped, "segments");
    tree = $tree;
    origin = at($eventInput, "origin");
    profile = at($spPolicy, "protocol")
  }

process sp.expression:
  let value = at($eventInput, "value")
  let depth = at($eventInput, "depth")
  when eq($depth, null):
    let depth = 0
  assert includes(range(65), add($depth, 1))
    otherwise "SP-DEPTH: Expression presentation exceeds its declared bound."
  port value.describe { value = $value } → type
  let indent = fold(range($depth), "unused", "indent", "", concat($indent, "  "))
  let childIndent = concat($indent, "  ")
  let text = ""
  when at($type, "array"):
    let op = at($value, 0)
    fold range(count($value)) as oneIndex; args starts list():
      when not(eq($oneIndex, 1)):
        port kernel.invoke {
          query = "sp.expression";
          input = { value = at($value, add($oneIndex, -1)); depth = add($depth, 1) }
        } → arg
        let args = append($args, list($arg))
      yield $args → args
    port text.join { values = $args; separator = ", " } → inlineArgs
    let text = concat($op, "(", $inlineArgs, ")")
    port text.matches { value = $text; pattern = "[\\s\\S]{89}|\\n" } → wide
    when $wide:
      port text.join { values = $args; separator = concat(",\n", $childIndent) } → multilineArgs
      let text = concat($op, "(\n", $childIndent, $multilineArgs, "\n", $indent, ")")
    when eq(count($value), 0):
      let text = "[]"
  when and(eq(at($type, "type"), "object"), not(at($type, "null")), not(at($type, "array"))):
    port record.entries { value = $value } → entries
    fold $entries as entry; fields starts list():
      port kernel.invoke { query = "sp.expression"; input = { value = at($entry, 1); depth = add($depth, 1) } } → field
      port text.matches { value = at($entry, 0); pattern = "^[A-Za-z_][A-Za-z0-9_]*$" } → plainKey
      let fieldKey = at($entry, 0)
      when not($plainKey):
        port json.stringify { value = at($entry, 0) } → fieldKey
      let fields = append($fields, list(concat($fieldKey, " = ", $field)))
      yield $fields → fields
    port text.join { values = $fields; separator = "; " } → inlineFields
    let text = concat("{ ", $inlineFields, " }")
    port text.matches { value = $text; pattern = "[\\s\\S]{89}|\\n" } → wide
    when $wide:
      port text.join { values = $fields; separator = concat(";\n", $childIndent) } → multilineFields
      let text = concat("{\n", $childIndent, $multilineFields, "\n", $indent, "}")
  when eq(at($type, "type"), "string"):
    port text.slice { value = $value; start = 0; end = 1 } → first
    let text = $value
    when not(eq($first, at($spPolicy, "referenceSigil"))):
      port json.stringify { value = $value } → text
  when or(at($type, "null"), includes(list("number", "boolean"), at($type, "type"))):
    port value.string { value = $value } → text
  let result = $text

process sp.programme:
  let programme = at($eventInput, "programme")
  let depth = at($eventInput, "depth")
  assert and(isArray($programme), includes(range(65), add($depth, 1)))
    otherwise "SP-PROGRAMME: A bounded process array is required."
  let indent = fold(range($depth), "unused", "indent", "", concat($indent, "  "))
  fold $programme as statement; listing starts "":
    port kernel.invoke {
      query = "sp.statement";
      input = { statement = $statement; indent = $indent; depth = $depth }
    } → line
    let listing = concat($listing, if(eq($listing, ""), "", "\n"), $line)
    yield $listing → listing
  let result = $listing

process sp.statement:
  let st = at($eventInput, "statement")
  let indent = at($eventInput, "indent")
  let depth = at($eventInput, "depth")
  port record.entries { value = $st } → fields
  let keys = map($fields, "field", at($field, 0))
  let done = false
  let text = ""
  when includes($keys, "let"):
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "value"); depth = $depth } } → v
    let text = concat($indent, "let ", at($st, "let"), " = ", $v)
    let done = true
  when and(not($done), includes($keys, "assert")):
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "assert"); depth = $depth } } → v
    port json.stringify { value = at($st, "message") } → message
    let text = concat($indent, "assert ", $v, "\n", $indent, "  otherwise ", $message)
    let done = true
  when and(not($done), includes($keys, "port")):
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "args"); depth = $depth } } → v
    let text = concat($indent, "port ", at($st, "port"), " ", $v, " → ", at($st, "into"))
    let done = true
  when and(not($done), includes($keys, "call")):
    let text = concat($indent, "call ", at($st, "call"))
    let done = true
  when and(not($done), includes($keys, "when")):
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "when"); depth = $depth } } → v
    port kernel.invoke {
      query = "sp.programme";
      input = { programme = at($st, "then"); depth = add($depth, 1) }
    } → body
    let text = concat($indent, "when ", $v, ":\n", $body)
    let done = true
  when and(not($done), includes($keys, "fold")):
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "fold"); depth = $depth } } → v
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "initial"); depth = $depth } } → initial
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "yield"); depth = $depth } } → yield
    port kernel.invoke {
      query = "sp.programme";
      input = { programme = at($st, "steps"); depth = add($depth, 1) }
    } → body
    let text = concat(
      $indent,
      "fold ",
      $v,
      " as ",
      at($st, "as"),
      "; ",
      at($st, "accumulator"),
      " starts ",
      $initial,
      ":\n",
      if(eq($body, ""), "", concat($body, "\n")),
      $indent,
      "  yield ",
      $yield,
      " → ",
      at($st, "into")
    )
    let done = true
  when and(not($done), includes($keys, "each")):
    port kernel.invoke { query = "sp.expression"; input = { value = at($st, "each"); depth = $depth } } → v
    port kernel.invoke {
      query = "sp.programme";
      input = { programme = at($st, "steps"); depth = add($depth, 1) }
    } → body
    let text = concat($indent, "each ", $v, " as ", at($st, "as"), ":\n", $body)
    let done = true
  when and(not($done), includes($keys, "try")):
    port kernel.invoke {
      query = "sp.programme";
      input = { programme = at($st, "try"); depth = add($depth, 1) }
    } → tryBody
    port kernel.invoke {
      query = "sp.programme";
      input = { programme = at($st, "catch"); depth = add($depth, 1) }
    } → catchBody
    let text = concat(
      $indent,
      "try:\n",
      $tryBody,
      "\n",
      $indent,
      "catch ",
      at($st, "error"),
      ":\n",
      $catchBody
    )
    let done = true
  when not($done):
    port kernel.invoke { query = "sp.expression"; input = { value = $st; depth = $depth } } → v
    let text = concat($indent, $v)
  let result = $text

process sp.listing:
  port kernel.invoke {
    query = "sp.programme";
    input = { programme = at($eventInput, "programme"); depth = 0 }
  } → text
  let result = {
    text = $text;
    scope = "generated-process-definition";
    origin = at($eventInput, "origin");
    limitations = list(
      "Generated notation, not original source characters.",
      "No branch is marked executed; no change authority is created."
    )
  }

process sp.style:
  call sp.stylePlan
  let cssPlan = $result
  call css.renderPlan

process sp.outline:
  fold at($eventInput, "nodes") as node; text starts "":
    yield concat(
    $text,
    if(eq($text, ""), "", "\n\n"),
    at($node, "order"),
    ". ",
    at($node, "kind"),
    " · ",
    at($node, "label"),
    "\n",
    at($node, "pointer"),
    "\n",
    at($node, "detail")
  ) → text
  let result = {
    text = $text;
    language = "process";
    scope = "generated-process-outline";
    origin = at($eventInput, "origin")
  }

process sp.metadata:
  port kernel.invoke { query = "s01.portable"; input = { value = $eventInput; ancestors = list() } } → portable
  assert $portable
    otherwise "SP-INPUT: Metadata requires finite own-data."
  let subject = at($eventInput, "subject")
  port value.describe { value = at($eventInput, "record") } → recordType
  assert and(at($recordType, "plain"), not(at($recordType, "array")))
    otherwise "SP-METADATA: A typed record is required."
  port value.describe { value = $subject } → subjectType
  assert and(eq(at($subjectType, "type"), "string"), not(eq($subject, "")))
    otherwise "SP-METADATA: An explicit subject identity is required."
  port record.entries { value = at($eventInput, "record") } → entries
  fold $entries as entry; facts starts list():
    when not(eq(at($entry, 0), "text")):
      let values = if(isArray(at($entry, 1)), at($entry, 1), list(at($entry, 1)))
      fold $values as value; facts starts $facts:
        let facts = append($facts, list({ s = $subject; p = at($entry, 0); o = $value; pol = "is" }))
        yield $facts → facts
    yield $facts → facts
  let sourceFacts = $facts
  let format = "rel"
  call source.encode
  let text = $result
  port digest.sha256 { text = $text } → hash
  port kernel.invoke {
    query = "sp.present";
    input = {
      text = $text;
      file = "generated-typed-projection.rel";
      language = "rel";
      expectedHash = $hash;
      theme = at($eventInput, "theme");
      lineNumbers = false;
      selectedLine = null;
      origin = at($eventInput, "origin")
    }
  } → presentation
  let result = { scope = "generated-typed-projection"; facts = $facts; presentation = $presentation }

process sp.stylePlan:
  let tokens = list()
  let rules = at($spPolicy, "layoutRules")
  fold at($spPolicy, "themes") as theme; palette starts { tokens = $tokens; rules = $rules }:
    port record.entries { value = at($theme, "roles") } → roles
    let tokens = at($palette, "tokens")
    let rules = at($palette, "rules")
    fold $roles as role; themeState starts { tokens = $tokens; rules = $rules }:
      let name = concat("sp-", at($theme, "id"), "-", at($role, 0))
      let tokens = append(
        at($themeState, "tokens"),
        list({ id = $name; name = $name; value = at($role, 1) })
      )
      let rules = append(
        at($themeState, "rules"),
        list(
          {
            selector = concat(".sp-code[data-theme=\"", at($theme, "id"), "\"] .sp-", at($role, 0));
            context = null;
            declarations = list({ property = "color"; value = concat("var(--", $name, ")") })
          }
        )
      )
      yield { tokens = $tokens; rules = $rules } → themeState
    yield $themeState → palette
  let cssPlan = { imports = list(); tokens = at($palette, "tokens"); rules = at($palette, "rules") }
  let result = $cssPlan

process source.split:
  let text = at($eventInput, "text")
  let language = at($eventInput, "language")
  let jsonPattern = fold(
    at($lexPolicy, "jsonPatternPath"),
    "pathPart",
    "owner",
    $lexGrammar,
    at($owner, $pathPart)
  )
  port text.slice { value = $jsonPattern; start = 1; end = add(count($jsonPattern), -1) } → jsonInner
  let pattern = $jsonPattern
  when eq($language, "rel"):
    let pattern = concat("(", $jsonInner, "|[()]|//[^\\r\\n]*)")
  when includes(list("encounter", "temple", "process"), $language):
    let pattern = concat(
      "(",
      at($lexPolicy, "identifierPattern"),
      "|",
      $jsonInner,
      "|#[^\\r\\n]*|[()=;]|→|[^\\S\\r\\n]+)"
    )
  when eq($language, "markdown"):
    let pattern = $lexPolicy.markdownPattern
  port text.split { value = $text; pattern = $pattern } → parts
  let withinLimit = includes(range(add(at($lexPolicy, "maxParts"), 1)), add(count($parts), 1))
  let result = { parts = $parts; withinLimit = $withinLimit }

process source.lex:
  let text = at($eventInput, "text")
  port text.slice { value = $text; start = 0; end = at($lexPolicy, "maxCodeUnits") } → bounded
  let sizeOk = eq(count($bounded), count($text))
  let tokens = list()
  let withinLimit = false
  when $sizeOk:
    port kernel.invoke {
      query = "source.split";
      input = { text = $text; language = at($eventInput, "language") }
    } → split
    let withinLimit = at($split, "withinLimit")
    when $withinLimit:
      fold at($split, "parts") as part; state starts { offset = 0; tokens = list() }:
        port text.split { value = $part; pattern = "(\\r\\n|\\n|\\r)" } → pieces
        fold $pieces as piece; inner starts $state:
          let offset = at($inner, "offset")
          let end = add($offset, count($piece))
          let tokens = at($inner, "tokens")
          when not(eq($piece, "")):
            let tokens = append($tokens, list({ text = $piece; start = $offset; end = $end }))
          yield { offset = $end; tokens = $tokens } → state
        yield $state → state
      let tokens = at($state, "tokens")
  let countOk = includes(range(add(at($lexPolicy, "maxParts"), 1)), add(count($tokens), 1))
  let result = {
    tokens = $tokens;
    withinLimit = and($sizeOk, $withinLimit, $countOk);
    diagnostic = if(
      and($sizeOk, $withinLimit, $countOk),
      null,
      "SP-LIMIT: Exact lexical source exceeds its bound."
    )
  }

process s01.portable:
  port value.describe { value = at($eventInput, "value") } → d
  let yes = or(
    at($d, "null"),
    eq(at($d, "type"), "string"),
    eq(at($d, "type"), "boolean"),
    at($d, "finite")
  )
  when and(
    not($yes),
    at($d, "dataOnly"),
    or(at($d, "plain"), and(at($d, "array"), at($d, "dense"))),
    not(
      includes(
        if(isArray(at($eventInput, "ancestors")), at($eventInput, "ancestors"), list()),
        at($eventInput, "value")
      )
    )
  ):
    port record.entries { value = at($eventInput, "value") } → es
    fold $es as e; ok starts true:
      port kernel.invoke {
        query = "s01.portable";
        input = {
          value = at($e, 1);
          ancestors = append(at($eventInput, "ancestors"), list(at($eventInput, "value")))
        }
      } → child
      yield and($ok, $child) → yes
  let result = $yes

process md.inline:
  port text.split { value = $eventInput.text; pattern = $lexPolicy.markdownPattern } → mdTokens
  fold $mdTokens as mdToken; mdNodes starts list():
    let mdNode = $mdToken
    port text.matches { value = $mdToken; pattern = "^\\*\\*[^*]+\\*\\*$" } → mdStrong
    when $mdStrong:
      port text.slice { value = $mdToken; start = 2; end = add(count($mdToken), -2) } → mdLabel
      let mdNode = { tag = "strong"; attrs = {  }; children = list($mdLabel) }
    port text.matches { value = $mdToken; pattern = "^\\*[^*]+\\*$" } → mdEm
    when $mdEm:
      port text.slice { value = $mdToken; start = 1; end = add(count($mdToken), -1) } → mdLabel
      let mdNode = { tag = "em"; attrs = {  }; children = list($mdLabel) }
    port text.matches { value = $mdToken; pattern = "^`[^`]+`$" } → mdCode
    when $mdCode:
      port text.slice { value = $mdToken; start = 1; end = add(count($mdToken), -1) } → mdLabel
      let mdNode = { tag = "code"; attrs = {  }; children = list($mdLabel) }
    port text.matches { value = $mdToken; pattern = "^\\[[^\\]]+\\]\\([^)]+\\)$" } → mdLink
    when $mdLink:
      port text.indexOf { value = $mdToken; search = "](" } → mdAt
      port text.slice { value = $mdToken; start = 1; end = $mdAt } → mdLabel
      port text.slice { value = $mdToken; start = add($mdAt, 2); end = add(count($mdToken), -1) } → mdTarget
      port text.matches { value = $mdTarget; pattern = "^https?://[^\\s<>]+$" } → mdSafe
      let mdNode = if(
        $mdSafe,
        {
          tag = "a";
          attrs = { href = $mdTarget; rel = "noreferrer" };
          children = list($mdLabel)
        },
        {
          tag = "span";
          attrs = {
            class = "md-source-link";
            title = concat("Source-relative link; target is not bundled: ", $mdTarget)
          };
          children = list(
            $mdLabel,
            { tag = "small"; attrs = {  }; children = list(concat(" [source: ", $mdTarget, "]")) }
          )
        }
      )
    port text.matches { value = $mdToken; pattern = "^  \\r?\\n$" } → mdBreak
    when $mdBreak:
      let mdNode = { tag = "br"; attrs = {  }; children = list() }
    let mdNodes = append($mdNodes, list($mdNode))
    yield $mdNodes → mdNodes
  let result = $mdNodes

process md.block:
  let mdLines = $eventInput.lines
  let mdKind = $eventInput.kind
  let mdTree = null
  port text.join { values = $mdLines; separator = "\n" } → mdText
  when eq($mdKind, "paragraph"):
    port kernel.invoke { query = "md.inline"; input = { text = $mdText } } → mdInline
    let mdTree = { tag = "p"; attrs = {  }; children = $mdInline }
  when eq($mdKind, "heading"):
    port text.split { value = $mdText; pattern = "^(#{1,6}) +" } → mdHeadingParts
    port kernel.invoke { query = "md.inline"; input = { text = at($mdHeadingParts, 2) } } → mdInline
    let mdTree = { tag = concat("h", count(at($mdHeadingParts, 1))); attrs = {  }; children = $mdInline }
  when eq($mdKind, "code"):
    port digest.sha256 { text = $mdText } → mdHash
    port kernel.invoke {
      query = "sp.present";
      input = {
        text = $mdText;
        language = if(
          includes(list("json", "rel", "process", "encounter", "temple"), $eventInput.language),
          $eventInput.language,
          "text"
        );
        file = "markdown-fence";
        theme = "dark";
        expectedHash = $mdHash;
        lineNumbers = false;
        selectedLine = null;
        origin = { scope = "Markdown fenced code projection" }
      }
    } → mdCodeView
    let mdTree = { tag = "pre"; attrs = { class = "md-code" }; children = list($mdCodeView.tree) }
  when eq($mdKind, "quote"):
    port text.replaceAll { value = $mdText; search = "> "; replacement = "" } → mdText
    port kernel.invoke { query = "md.inline"; input = { text = $mdText } } → mdInline
    let mdTree = { tag = "blockquote"; attrs = {  }; children = $mdInline }
  when includes(list("ul", "ol"), $mdKind):
    fold $mdLines as mdLine; mdItems starts list():
      port text.split { value = $mdLine; pattern = "^\\s*(?:[-+*]|[0-9]+\\.) +" } → mdListParts
      port kernel.invoke { query = "md.inline"; input = { text = at($mdListParts, 1) } } → mdInline
      let mdItems = append($mdItems, list({ tag = "li"; attrs = {  }; children = $mdInline }))
      yield $mdItems → mdItems
    let mdTree = { tag = $mdKind; attrs = {  }; children = $mdItems }
  when eq($mdKind, "table"):
    fold range(count($mdLines)) as mdI; mdRows starts list():
      let mdLine = at($mdLines, add($mdI, -1))
      port text.matches { value = $mdLine; pattern = "^\\s*\\|?[: \\-|]+\\|[: \\-|]*$" } → mdSeparator
      when not($mdSeparator):
        port text.trim { value = $mdLine } → mdLine
        port text.slice { value = $mdLine; start = 1; end = add(count($mdLine), -1) } → mdLine
        port text.split { value = $mdLine; pattern = "\\|" } → mdCells
        fold $mdCells as mdCell; mdCellViews starts list():
          port text.trim { value = $mdCell } → mdCell
          port kernel.invoke { query = "md.inline"; input = { text = $mdCell } } → mdInline
          let mdCellViews = append(
            $mdCellViews,
            list(
              {
                tag = if(eq($mdI, 1), "th", "td");
                attrs = if(eq($mdI, 1), { scope = "col" }, {  });
                children = $mdInline
              }
            )
          )
          yield $mdCellViews → mdCellViews
        let mdRows = append($mdRows, list({ tag = "tr"; attrs = {  }; children = $mdCellViews }))
      yield $mdRows → mdRows
    let mdTree = {
      tag = "div";
      attrs = { class = "md-table-wrap" };
      children = list(
        {
          tag = "table";
          attrs = {  };
          children = list({ tag = "tbody"; attrs = {  }; children = $mdRows })
        }
      )
    }
  let result = $mdTree

process md.preview:
  let mdInput = $eventInput.text
  assert includes(range(160001), add(count($mdInput), 1))
    otherwise "MD-BOUND: Document exceeds the shared source bound."
  port text.split { value = $mdInput; pattern = "\\r?\\n" } → mdLines
  assert includes(range(2001), add(count($mdLines), 1))
    otherwise "MD-LINES: Preview exceeds 2000 lines."
  fold append($mdLines, list("")) as mdLine; mdState starts { nodes = list(); lines = list(); kind = ""; fence = ""; language = "" }:
    let mdNodes = $mdState.nodes
    let mdPending = $mdState.lines
    let mdKind = $mdState.kind
    let mdFence = $mdState.fence
    let mdWasFence = not(eq($mdFence, ""))
    let mdLanguage = $mdState.language
    let mdNext = "paragraph"
    let mdSkip = false
    port text.matches { value = $mdLine; pattern = "^\\s*$" } → mdBlank
    when $mdBlank:
      let mdNext = ""
    when true:
      port text.matches { value = $mdLine; pattern = "^#{1,6} +" } → mdMatch
      when $mdMatch:
        let mdNext = "heading"
    when true:
      port text.matches { value = $mdLine; pattern = "^\\s*\\|.*\\|\\s*$" } → mdMatch
      when $mdMatch:
        let mdNext = "table"
    when true:
      port text.matches { value = $mdLine; pattern = "^\\s*[-+*] +" } → mdMatch
      when $mdMatch:
        let mdNext = "ul"
    when true:
      port text.matches { value = $mdLine; pattern = "^\\s*[0-9]+\\. +" } → mdMatch
      when $mdMatch:
        let mdNext = "ol"
    when true:
      port text.matches { value = $mdLine; pattern = "^> ?" } → mdMatch
      when $mdMatch:
        let mdNext = "quote"
    port text.matches { value = $mdLine; pattern = "^(?:```|~~~)" } → mdMarker
    when not(eq($mdFence, "")):
      let mdNext = "code"
      port text.slice { value = $mdLine; start = 0; end = 3 } → mdPrefix
      when eq($mdPrefix, $mdFence):
        let mdNext = ""
        let mdFence = ""
        let mdSkip = true
    when and($mdMarker, not($mdWasFence)):
      port text.slice { value = $mdLine; start = 0; end = 3 } → mdFence
      port text.slice { value = $mdLine; start = 3; end = count($mdLine) } → mdLanguage
      port text.trim { value = $mdLanguage } → mdLanguage
      let mdNext = "code"
      let mdSkip = true
    when and(not(eq($mdNext, $mdKind)), not(eq($mdKind, ""))):
      port kernel.invoke {
        query = "md.block";
        input = { lines = $mdPending; kind = $mdKind; language = $mdLanguage }
      } → mdBlock
      let mdNodes = append($mdNodes, list($mdBlock))
      let mdPending = list()
    when and(not(eq($mdNext, "")), not($mdSkip)):
      let mdPending = append($mdPending, list($mdLine))
    when eq($mdNext, "heading"):
      port kernel.invoke { query = "md.block"; input = { lines = $mdPending; kind = "heading" } } → mdBlock
      let mdNodes = append($mdNodes, list($mdBlock))
      let mdPending = list()
      let mdNext = ""
    yield {
    nodes = $mdNodes;
    lines = $mdPending;
    kind = $mdNext;
    fence = $mdFence;
    language = $mdLanguage
  } → mdState
  when not(eq($mdState.kind, "")):
    port kernel.invoke {
      query = "md.block";
      input = { lines = $mdState.lines; kind = $mdState.kind; language = $mdState.language }
    } → mdBlock
    let mdState = { nodes = append($mdState.nodes, list($mdBlock)) }
  let result = { tag = "article"; attrs = { class = "markdown-preview" }; children = $mdState.nodes }

process sp.structure:
  let structureDepth = $eventInput.depth
  assert includes(range(65), add($structureDepth, 1))
    otherwise "SP-STRUCTURE: Programme nesting exceeds its declared bound."
  fold range(count($eventInput.programme)) as structureI; structureRows starts list():
    let structureStatement = at($eventInput.programme, add($structureI, -1))
    port record.entries { value = $structureStatement } → structureFields
    let structureKeys = map($structureFields, "structureField", at($structureField, 0))
    let structureForms = filter(
      list("let", "assert", "port", "call", "when", "fold", "each", "try"),
      "structureForm",
      includes($structureKeys, $structureForm)
    )
    assert eq(count($structureForms), 1)
      otherwise "SP-STRUCTURE: Exactly one supported statement form is required."
    let structurePointer = concat($eventInput.pointer, "/", add($structureI, -1))
    let structureRows = append(
      $structureRows,
      list({ form = at($structureForms, 0); pointer = $structurePointer })
    )
    fold list("then", "steps", "try", "catch") as structureChild; structureChildren starts $structureRows:
      when includes($structureKeys, $structureChild):
        port kernel.invoke {
          query = "sp.structure";
          input = {
            programme = at($structureStatement, $structureChild);
            pointer = concat($structurePointer, "/", $structureChild);
            depth = add($structureDepth, 1)
          }
        } → structureNested
        let structureChildren = append($structureChildren, $structureNested)
      yield $structureChildren → structureRows
    yield $structureRows → structureRows
  let result = $structureRows

process sp.moduleView:
  let moduleValue = $eventInput.module
  assert eq($moduleValue.protocol, "temple/surface-process-module/1")
    otherwise "SP-MODULE: A surface-process module is required."
  port record.entries { value = $moduleValue.queries } → moduleEntries
  let moduleMatches = filter($moduleEntries, "moduleEntry", eq(at($moduleEntry, 0), $eventInput.name))
  assert eq(count($moduleMatches), 1)
    otherwise "SP-MODULE: The selected query does not exist."
  let moduleName = $eventInput.name
  let moduleProgramme = at(at($moduleMatches, 0), 1)
  let modulePointer = concat("/queries/", $moduleName)
  port kernel.invoke { query = "sp.programme"; input = { programme = $moduleProgramme; depth = 1 } } → moduleText
  port kernel.invoke {
    query = "sp.structure";
    input = { programme = $moduleProgramme; pointer = $modulePointer; depth = 0 }
  } → moduleStatements
  let result = {
    name = $moduleName;
    text = concat("process ", $moduleName, ":\n", $moduleText);
    pointer = $modulePointer;
    statements = $moduleStatements;
    forms = distinct(map($moduleStatements, "moduleStatement", $moduleStatement.form));
    scope = "generated-readable-projection; JSON remains authoritative"
  }

