("microsite.entry.temple", "description", "Enter a living system of promises. Tend its lamp, test a rule, and see why some changes are welcomed while others are refused.")
("microsite.entry.temple", "detail", "A lamp to tend · A history to inspect")
("microsite.entry.temple", "statusLabel", "Interactive microsite")
("microsite.entry.temple", "icon", "{\"tag\":\"svg\",\"attrs\":{\"viewBox\":\"0 0 80 80\",\"class\":\"world-emblem\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"stroke-width\":1.25,\"stroke-linecap\":\"round\",\"stroke-linejoin\":\"round\",\"aria-hidden\":\"true\"},\"children\":[\"list\",{\"tag\":\"path\",\"attrs\":{\"d\":\"M12 66h56M18 61h44M24 56V26l16-14 16 14v30M30 56V30l10-9 10 9v26M35 49h10V35H35zM40 7V3M40 63v10\"},\"children\":[\"list\"]},{\"tag\":\"path\",\"attrs\":{\"d\":\"M38 43q-4-5 2-10 6 5 2 10z\"},\"children\":[\"list\"]},{\"tag\":\"circle\",\"attrs\":{\"cx\":40,\"cy\":40,\"r\":17},\"children\":[\"list\"]}]}")
("microsite.entry.sourcery", "description", "Give an idea to a small fleet of broomsticks. Watch it become a proposal, decide what happens, then inspect the trail it leaves behind.")
("microsite.entry.sourcery", "detail", "An idea to cast · A decision to witness")
("microsite.entry.sourcery", "statusLabel", "Interactive microsite")
("microsite.entry.sourcery", "icon", "{\"tag\":\"svg\",\"attrs\":{\"viewBox\":\"0 0 80 80\",\"class\":\"world-emblem\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"stroke-width\":1.25,\"stroke-linecap\":\"round\",\"stroke-linejoin\":\"round\",\"aria-hidden\":\"true\"},\"children\":[\"list\",{\"tag\":\"path\",\"attrs\":{\"d\":\"M17 63 57 23M23 57l-8-1-7 12 9 4 11-9zM47 12l3-9 3 9 9 3-9 3-3 9-3-9-9-3zM65 44l2-6 2 6 6 2-6 2-2 6-2-6-6-2zM21 22v8M17 26h8M28 68q23 3 35-20\"},\"children\":[\"list\"]},{\"tag\":\"circle\",\"attrs\":{\"cx\":31,\"cy\":14,\"r\":2},\"children\":[\"list\"]},{\"tag\":\"circle\",\"attrs\":{\"cx\":64,\"cy\":65,\"r\":2},\"children\":[\"list\"]}]}")
("microsite.entry.claimipedia", "description", "Bring one claim into the light of three review methods. Change the evidence and discover why their conclusions can disagree.")
