("microsite.entry.temple", "description", "An execution kernel for systems governed by explicit rules. Proposed changes are checked against rules and authority, with a record of acceptance or refusal.")
("microsite.entry.temple", "detail", "Illustrated by a lamp, a gate and a checkable history.")
("microsite.entry.temple", "statusLabel", "Engineering & philosophy")
("microsite.entry.temple", "icon", "{\"tag\":\"img\",\"attrs\":{\"src\":\"assets/world-emblems/temple-v1.png\",\"class\":\"world-emblem\",\"width\":128,\"height\":128,\"alt\":\"\",\"decoding\":\"async\",\"aria-hidden\":\"true\"},\"children\":[\"list\"]}")
("microsite.entry.sourcery", "description", "An approach to creating software from explicit meaning. People and AI propose changes; declared rules and accountable decisions govern what takes effect.")
("microsite.entry.sourcery", "detail", "Illustrated by a fable, proposals and a decision ledger.")
("microsite.entry.sourcery", "statusLabel", "Engineering & philosophy")
("microsite.entry.sourcery", "icon", "{\"tag\":\"img\",\"attrs\":{\"src\":\"assets/world-emblems/sourcery-v1.png\",\"class\":\"world-emblem\",\"width\":128,\"height\":128,\"alt\":\"\",\"decoding\":\"async\",\"aria-hidden\":\"true\"},\"children\":[\"list\"]}")
("microsite.entry.claimipedia", "description", "A framework for versioned claims, evidence and explicit review methods. Keep assumptions and conclusions distinct, so disagreement can be examined and revised.")
("microsite.entry.claimipedia", "detail", "Illustrated by three methods reading the same evidence.")
("microsite.entry.claimipedia", "statusLabel", "Engineering & philosophy")
("microsite.entry.claimipedia", "icon", "{\"tag\":\"img\",\"attrs\":{\"src\":\"assets/world-emblems/claimipedia-v1.png\",\"class\":\"world-emblem\",\"width\":128,\"height\":128,\"alt\":\"\",\"decoding\":\"async\",\"aria-hidden\":\"true\"},\"children\":[\"list\"]}")
("microsite.entry.worldwright", "isa", "PublishedMicrosite")
("microsite.entry.worldwright", "name", "Worldwright")
("microsite.entry.worldwright", "light", "blue")
("microsite.entry.worldwright", "note", "Compose stories people find their own way through.")
("microsite.entry.worldwright", "description", "A storytelling and authoring product in development. Connect people, ideas, sources and scenes into worlds readers can explore along different paths.")
("microsite.entry.worldwright", "detail", "This personal expedition is its first composition.")
("microsite.entry.worldwright", "statusLabel", "In preparation")
("microsite.entry.worldwright", "href", "worldwright/")
("microsite.entry.worldwright", "status", "placeholder")
