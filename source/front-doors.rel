("capability.field", "icon", "{\"tag\":\"svg\",\"attrs\":{\"viewBox\":\"0 0 32 32\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"stroke-width\":1.5,\"stroke-linecap\":\"round\",\"stroke-linejoin\":\"round\",\"class\":\"capability-icon\",\"aria-hidden\":\"true\",\"focusable\":\"false\"},\"children\":[{\"tag\":\"path\",\"attrs\":{\"d\":\"M3 23c5-12 8 10 13-2s8 7 13-8M3 15c5-12 8 10 13-2s8 7 13-8M4 29h24\"},\"children\":[]}]}")
("page.capability.the-field", "isa", "StandalonePage")
("page.capability.the-field", "canonical", "https://aaronalderman.com/the-field/")
("capability.kingdom", "lead", "What should power make room for?")
("capability.kingdom", "paragraphs", "[{\"tag\":\"p\",\"attrs\":{},\"children\":[\"Kingdom brings together questions of agency, restraint, faith and care. The recurring question is how power can help others flourish while leaving them room to act.\"]},{\"tag\":\"p\",\"attrs\":{},\"children\":[\"Begin with kenosis, then follow its difficult boundary: when does restraint protect freedom, and when does care require intervention?\"]}]")
("capability.kingdom", "links", "[{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/kenosis.html\"},\"children\":[\"Begin with power and agency →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/care.html\"},\"children\":[\"Remember to care →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../gate.html#path-kingdom\"},\"children\":[\"Follow the research and sources →\"]}]")
("capability.world-modelling", "lead", "A model is a way of seeing. What does it leave out?")
("capability.world-modelling", "paragraphs", "[{\"tag\":\"p\",\"attrs\":{},\"children\":[\"World Modelling connects representation, possibility, memory and scale. A useful model makes some distinctions available and leaves others outside its frame.\"]},{\"tag\":\"p\",\"attrs\":{},\"children\":[\"Explore how those choices affect what can be observed, compared and changed. Keep the conditions and limits of the model beside its results.\"]}]")
("capability.world-modelling", "links", "[{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/representation.html\"},\"children\":[\"Start with the mapmaker’s debt →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/possibility.html\"},\"children\":[\"Explore what can exist together →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/scale.html\"},\"children\":[\"Change the scale →\"]}]")
("capability.creativity", "lead", "What else could this become?")
("capability.creativity", "paragraphs", "[{\"tag\":\"p\",\"attrs\":{},\"children\":[\"Creativity is a set of ways to explore possibilities: notice a pattern, try a different arrangement, follow a surprising connection, and see what survives the change.\"]},{\"tag\":\"p\",\"attrs\":{},\"children\":[\"Begin with a small pattern you can grow and count, then follow the larger questions of intention, authorship and composing a world someone else can explore.\"]}]")
("capability.creativity", "links", "[{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/tiling.html\"},\"children\":[\"Grow a pattern →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/will.html\"},\"children\":[\"Follow an intention →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../worldwright/\"},\"children\":[\"Explore storytelling with Worldwright →\"]}]")
("capability.field", "lead", "Where the questions are still alive.")
("capability.field", "paragraphs", "[{\"tag\":\"p\",\"attrs\":{},\"children\":[\"The Field brings open questions into contact with ways to investigate them. What is uncertain? Which observation would help? What could another person check?\"]},{\"tag\":\"p\",\"attrs\":{},\"children\":[\"Enter through a working laboratory, follow the limits of a measurement, or return to the research programme and its unfinished questions.\"]}]")
("capability.field", "links", "[{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/laboratory.html\"},\"children\":[\"Think through a test →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../places/observation.html\"},\"children\":[\"Ask what the measurement missed →\"]},{\"tag\":\"a\",\"attrs\":{\"class\":\"button\",\"href\":\"../gate.html#path-field\"},\"children\":[\"Explore the open research →\"]}]")
