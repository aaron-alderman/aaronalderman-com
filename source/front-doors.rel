("scroll.index", "tree", "{\"tag\":\"div\",\"attrs\":{\"class\":\"writing-page\"},\"children\":[{\"tag\":\"header\",\"attrs\":{\"class\":\"writing-heading\"},\"children\":[{\"tag\":\"p\",\"attrs\":{\"class\":\"mission-eyebrow\"},\"children\":[\"AARON ALDERMAN / THOUGHTS\"]},{\"tag\":\"h1\",\"attrs\":{},\"children\":[\"Ideas worth working toward.\"]},{\"tag\":\"p\",\"attrs\":{\"class\":\"writing-lead\"},\"children\":[\"Essays on power, understanding, faith, and what we can build together.\"]}]},{\"tag\":\"article\",\"attrs\":{\"class\":\"writing-feature\"},\"children\":[{\"tag\":\"p\",\"attrs\":{\"class\":\"mission-eyebrow\"},\"children\":[\"THE FOUNDATIONAL ESSAY\"]},{\"tag\":\"h2\",\"attrs\":{},\"children\":[{\"tag\":\"a\",\"attrs\":{\"href\":\"power-must-serve-life/\"},\"children\":[\"Power Must Serve Life\"]}]},{\"tag\":\"p\",\"attrs\":{\"class\":\"writing-declaration\"},\"children\":[\"We can build a civilisation in which growing power gives people greater freedom to live, understand, create, and care. I intend to help make it real.\"]},{\"tag\":\"p\",\"attrs\":{},\"children\":[\"The full arc of a kenotic programme for science, computing, and human flourishing. From following Jesus and an account of power shaped by service, through disciplined inquiry and accountable construction, into capabilities people can keep.\"]},{\"tag\":\"div\",\"attrs\":{\"class\":\"writing-feature-footer\"},\"children\":[{\"tag\":\"a\",\"attrs\":{\"href\":\"power-must-serve-life/\",\"class\":\"mission-button\"},\"children\":[\"Read the scroll →\"]},{\"tag\":\"p\",\"attrs\":{\"class\":\"scroll-meta\"},\"children\":[\"Extended mission essay · Draft for review\"]}]}]},{\"tag\":\"div\",\"attrs\":{\"class\":\"writing-after\"},\"children\":[{\"tag\":\"p\",\"attrs\":{\"class\":\"mission-eyebrow\"},\"children\":[\"FROM CONVICTION TO CONSTRUCTION\"]},{\"tag\":\"h2\",\"attrs\":{},\"children\":[\"The work continues beyond the page.\"]},{\"tag\":\"p\",\"attrs\":{},\"children\":[\"Discover the projects, questions, and reading paths connected by this purpose.\"]},{\"tag\":\"a\",\"attrs\":{\"href\":\"/#microsites\",\"class\":\"mission-text-link\"},\"children\":[\"Explore the work →\"]}]}]}")
