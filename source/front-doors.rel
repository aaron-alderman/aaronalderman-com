("capability.world-modelling", "icon", "{\"tag\":\"svg\",\"attrs\":{\"viewBox\":\"0 0 32 32\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"stroke-width\":1.5,\"stroke-linecap\":\"round\",\"stroke-linejoin\":\"round\",\"class\":\"capability-icon\",\"aria-hidden\":\"true\",\"focusable\":\"false\"},\"children\":[{\"tag\":\"circle\",\"attrs\":{\"cx\":16,\"cy\":16,\"r\":12},\"children\":[]},{\"tag\":\"ellipse\",\"attrs\":{\"cx\":16,\"cy\":16,\"rx\":5,\"ry\":12},\"children\":[]},{\"tag\":\"path\",\"attrs\":{\"d\":\"M4 16h24M7 9h18M7 23h18\"},\"children\":[]}]}")
