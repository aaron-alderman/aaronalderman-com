("page.capability.world-modelling", "canonical", "https://aaronalderman.com/world-modelling/")
("capability.creativity", "slug", "creativity")
("capability.creativity", "icon", "{\"tag\":\"svg\",\"attrs\":{\"viewBox\":\"0 0 32 32\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"stroke-width\":1.5,\"stroke-linecap\":\"round\",\"stroke-linejoin\":\"round\",\"class\":\"capability-icon\",\"aria-hidden\":\"true\",\"focusable\":\"false\"},\"children\":[{\"tag\":\"path\",\"attrs\":{\"d\":\"M16 3l3.5 9.5L29 16l-9.5 3.5L16 29l-3.5-9.5L3 16l9.5-3.5ZM25 3v6M22 6h6\"},\"children\":[]}]}")
