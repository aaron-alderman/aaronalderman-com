                { tag = "div"; attrs = { class = "lane-header" }; children = list({ tag = "span"; attrs = { class = "lane-mark"; "aria-hidden" = "true" }; children = list("↗") }, { tag = "div"; attrs = {}; children = list({ tag = "p"; attrs = { class = "eyebrow" }; children = list("The web menu") }, { tag = "p"; attrs = { class = "object-id" }; children = list("@experiment.WebMainMenu") }) }) },
                { tag = "form"; attrs = { id = "web-form"; class = "edit-card" }; children = list(
