        { tag = "footer"; attrs = {}; children = list({ tag = "p"; attrs = {}; children = list("The example checks each change before applying it. Changes stay in this tab’s memory; no account, shared record or repository is edited. Reload to begin again.") }, { tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("Source identities and boundaries") }, { tag = "p"; attrs = {}; children = list("This is a live explanatory fixture, not the authoring bootstrap or a complete mainframe. Presentation uses the common component and stylesheet definitions; session and interface behaviour are process algebra; the existing algebra owns the language semantics and source patches. The unchanged Temple kernel and existing algebra run locally in a Web Worker. Reloading starts a fresh example. Hashes and source links identify the supplied starting snapshot; candidate edits and their basis revisions appear in the return-path receipt.") }, { tag = "div"; attrs = { id = "hashes" }; children = list() }) }) }, "\n",
