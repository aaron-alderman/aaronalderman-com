          { tag = "section"; attrs = { class = "stage"; "aria-labelledby" = "context-heading" }; children = list(
            { tag = "div"; attrs = { class = "stage-heading" }; children = list({ tag = "span"; attrs = { class = "step"; "aria-hidden" = "true" }; children = list("3") }, { tag = "div"; attrs = {}; children = list({ tag = "p"; attrs = { class = "eyebrow" }; children = list("Two places to show the story") }, { tag = "h2"; attrs = { id = "context-heading" }; children = list("Two views, with visible differences") }) }) }, "\n",
            { tag = "div"; attrs = { class = "lanes" }; children = list(
