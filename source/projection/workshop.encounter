# The workshop shell is an ordinary pure Encounter component. It returns the
# common tree and cannot emit HTML, CSS, files or DOM effects.
process-module "temple/surface-process-module/1"

process component.workshop:
  let tabs = list({ key = "source"; title = "Source" }, { key = "pure"; title = "Pure expressions" }, { key = "process"; title = "Process" }, { key = "html"; title = "HTML" }, { key = "receipt"; title = "Last change" })
  let processes = list({ key = "navigation"; title = "Generated NavigationItem" }, { key = "web"; title = "Generated WebLink" }, { key = "row"; title = "Generated MainframeRow" }, { key = "resolve"; title = "ec.resolve · contextual resolution" }, { key = "patch"; title = "ec.patch · source edit and forward check" }, { key = "corePatch"; title = "ec.patch · lowered primitive expressions" }, { key = "serialize"; title = "projection.serialize · common projection entry" }, { key = "live"; title = "lab.edit · this example’s entry point" })
  let result = { tag = "html"; attrs = { lang = "en" }; children = list(
    { tag = "head"; attrs = {}; children = list(
      { tag = "meta"; attrs = { charset = "utf-8" }; children = list() },
      { tag = "meta"; attrs = { name = "viewport"; content = "width=device-width,initial-scale=1" }; children = list() },
      { tag = "title"; attrs = {}; children = list("TheStory · a living infographic") },
      { tag = "link"; attrs = { rel = "icon"; href = "data:," }; children = list() },
      { tag = "link"; attrs = { rel = "stylesheet"; href = "./style.css" }; children = list() },
      { tag = "script"; attrs = { defer = true; src = "runtime.js" }; children = list() }
    ) }, "\n",
    { tag = "body"; attrs = {}; children = list(
      { tag = "a"; attrs = { class = "skip"; href = "#source-story" }; children = list("Skip to the story") },
      { tag = "main"; attrs = {}; children = list("\n",
        { tag = "header"; attrs = {}; children = list(
          { tag = "p"; attrs = { class = "tour-back" }; children = list({ tag = "a"; attrs = { href = $readerReturn }; children = list("← Back to the Worldwright trail") }, { tag = "span"; attrs = {}; children = list("THE WORKSHOP · AN ENCOUNTER EXAMPLE") }) },
          { tag = "p"; attrs = { class = "eyebrow" }; children = list("Encounter ", { tag = "span"; attrs = {}; children = list("/") }, " a living infographic") },
          { tag = "div"; attrs = { class = "title-row" }; children = list(
            { tag = "div"; attrs = {}; children = list({ tag = "h1"; attrs = {}; children = list("One story.", { tag = "br"; attrs = {}; children = list() }, "Follow the thread.") }, { tag = "p"; attrs = { class = "hero-note" }; children = list("Change a title → watch the views update → follow the change back.") }) },
            { tag = "div"; attrs = { class = "intro" }; children = list({ tag = "p"; attrs = {}; children = list("AI can help with the work.", { tag = "br"; attrs = {}; children = list() }, "You decide what is worth making.") }, { tag = "p"; attrs = { class = "quiet" }; children = list("Change a value. Follow its meaning, rules and consequences. The example makes human choices visible and machine work inspectable.") }, { tag = "span"; attrs = { class = "badge"; id = "revision" }; children = list("Connecting…") }) }
          ) }
        ) }, "\n",
        { tag = "details"; attrs = { class = "authorship-note" }; children = list(
          { tag = "summary"; attrs = {}; children = list("Less unnecessary labour. More room for human authorship.") },
          { tag = "div"; attrs = {}; children = list(
            { tag = "p"; attrs = {}; children = list({ tag = "strong"; attrs = {}; children = list("You choose the purpose.") }, " Taste, usefulness, care and responsibility remain human work. A functioning application is a beginning; people decide whether it serves them well.") },
            { tag = "p"; attrs = {}; children = list({ tag = "strong"; attrs = {}; children = list("You can understand and change the workings.") }, " The wider aim is architecture you can inspect, revise, replace and take with you. Here, two editable values demonstrate explicit source ownership; general programme and contract editing remain future work.") },
            { tag = "p"; attrs = {}; children = list({ tag = "strong"; attrs = {}; children = list("You can ask what was checked.") }, " Assurance should fit the consequences and retain essential safeguards. This example checks a bounded typed edit and its forward result. That is evidence for this slice, not independent verification or a guarantee of a larger application.") },
            { tag = "p"; attrs = {}; children = list("Remove unnecessary labour. Preserve human authorship. Make the consequences understandable and the evidence inspectable.") }
          ) }
        ) },
        { tag = "div"; attrs = { class = "live-status" }; children = list({ tag = "span"; attrs = { class = "live-dot"; "aria-hidden" = "true" }; children = list() }, { tag = "p"; attrs = { id = "status"; role = "status"; "aria-live" = "polite" }; children = list("Preparing the checked example…") }, { tag = "a"; attrs = { href = "#return-path" }; children = list("Follow the last edit ↓") }) },
        { tag = "p"; attrs = { id = "error"; role = "alert"; hidden = true }; children = list() }, "\n",
        { tag = "section"; attrs = { class = "start-guide"; "aria-labelledby" = "start-heading" }; children = list(
          { tag = "h2"; attrs = { id = "start-heading" }; children = list("Try this first") },
          { tag = "ol"; attrs = {}; children = map(list("Change the story title in step 1 and choose “Apply title.” The story page and list row update; the menu keeps its own label.", "Change the menu label in step 3. Only the menu changes.", "Look at the previews in step 4. Open the code sections if you want to see how it works."), "text", { tag = "li"; attrs = {}; children = list($text) }) },
          { tag = "p"; attrs = {}; children = list("Changes stay in this tab. Reloading starts the example again.") }
        ) },
        { tag = "div"; attrs = { class = "flow" }; children = list("\n",
          { tag = "section"; attrs = { id = "source-story"; class = "stage"; "aria-labelledby" = "meaning-heading" }; children = list(
            { tag = "div"; attrs = { class = "stage-heading" }; children = list({ tag = "span"; attrs = { class = "step"; "aria-hidden" = "true" }; children = list("1") }, { tag = "div"; attrs = {}; children = list({ tag = "p"; attrs = { class = "eyebrow" }; children = list("Meaning / the source") }, { tag = "h2"; attrs = { id = "meaning-heading" }; children = list("Start with the story") }) }, { tag = "span"; attrs = { class = "kind" }; children = list("Story") }) }, "\n",
            { tag = "div"; attrs = { class = "source-grid" }; children = list(
              { tag = "form"; attrs = { id = "title-form"; class = "edit-card story" }; children = list(
                { tag = "p"; attrs = { class = "object-id" }; children = list("@TheStory") }, { tag = "label"; attrs = { for = "story-title" }; children = list("What is its title?") },
                { tag = "div"; attrs = { class = "input-row" }; children = list({ tag = "input"; attrs = { id = "story-title"; name = "title"; type = "text"; autocomplete = "off"; "aria-describedby" = "title-route" }; children = list() }, { tag = "button"; attrs = { type = "submit" }; children = list("Apply title ", { tag = "span"; attrs = { "aria-hidden" = "true" }; children = list("↗") }) }) },
                { tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("See how the title is stored") }, { tag = "pre"; attrs = { id = "fact-inline"; class = "compact" }; children = list() }) },
                { tag = "p"; attrs = { class = "explain" }; children = list("Change this title and the row and story page follow.") },
                { tag = "button"; attrs = { id = "title-route"; class = "route-link"; type = "button"; "data-route" = "title" }; children = list("Loading route…") },
                { tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("Read the two content entries") }, { tag = "div"; attrs = { id = "content-inline" }; children = list() }) }
              ) }, "\n",
              { tag = "aside"; attrs = { class = "type-card" }; children = list(
                { tag = "p"; attrs = { class = "eyebrow" }; children = list("Rules for this example") }, { tag = "h3"; attrs = {}; children = list("What can you enter?") },
                { tag = "p"; attrs = {}; children = list("The title must contain some text. The story content is a set of text entries. The example checks these rules before accepting a change.") },
                { tag = "details"; attrs = {}; children = list(
                  { tag = "summary"; attrs = {}; children = list("See the technical field names") },
                  { tag = "dl"; attrs = {}; children = list({ tag = "dt"; attrs = {}; children = list("S.Title") }, { tag = "dd"; attrs = {}; children = list("One nonempty string") }, { tag = "dt"; attrs = {}; children = list("S.Content") }, { tag = "dd"; attrs = {}; children = list("Many strings, with named TextEntry occurrences") }, { tag = "dt"; attrs = {}; children = list("Contract") }, { tag = "dd"; attrs = {}; children = list("Closed: undeclared fields are refused") }) },
                  { tag = "p"; attrs = { class = "quiet" }; children = list("These are the fixture’s Story contract. The full declarations are inspectable below.") },
                  { tag = "button"; attrs = { type = "button"; class = "text-link"; "data-source" = "contracts" }; children = list("Read the full rules in code ↗") }
                ) }
              ) }
            ) }
          ) }, "\n",
          { tag = "div"; attrs = { class = "connector"; "aria-hidden" = "true" }; children = list({ tag = "span"; attrs = {}; children = list("parse · index · compile · check") }, { tag = "b"; attrs = {}; children = list("↓") }) }, "\n",
          { tag = "section"; attrs = { class = "stage"; "aria-labelledby" = "projection-heading" }; children = list(
            { tag = "div"; attrs = { class = "stage-heading" }; children = list({ tag = "span"; attrs = { class = "step"; "aria-hidden" = "true" }; children = list("2") }, { tag = "div"; attrs = {}; children = list({ tag = "p"; attrs = { class = "eyebrow" }; children = list("A menu entry / another way to find the story") }, { tag = "h2"; attrs = { id = "projection-heading" }; children = list("Give the story a way to be found") }) }, { tag = "span"; attrs = { class = "kind" }; children = list("Menu entry") }) }, "\n",
            { tag = "div"; attrs = { class = "projection-grid" }; children = list(
              { tag = "article"; attrs = { class = "projection-card" }; children = list(
                { tag = "p"; attrs = { class = "object-id" }; children = list("@experiment.nav.story") },
                { tag = "div"; attrs = { class = "mapping" }; children = list({ tag = "span"; attrs = {}; children = list("Story title") }, { tag = "b"; attrs = { "aria-hidden" = "true" }; children = list("→") }, { tag = "div"; attrs = {}; children = list({ tag = "small"; attrs = {}; children = list("Menu label") }, { tag = "strong"; attrs = { id = "base-label" }; children = list() }) }) },
                { tag = "div"; attrs = { class = "mapping" }; children = list({ tag = "span"; attrs = {}; children = list("source") }, { tag = "b"; attrs = { "aria-hidden" = "true" }; children = list("→") }, { tag = "div"; attrs = {}; children = list({ tag = "small"; attrs = {}; children = list("Opens this story") }, { tag = "strong"; attrs = {}; children = list("@TheStory") }) }) },
                { tag = "p"; attrs = { class = "explain" }; children = list("A label and a Story reference. The story keeps its identity.") }
              ) },
              { tag = "article"; attrs = { class = "page-card" }; children = list({ tag = "p"; attrs = { class = "object-id" }; children = list("@experiment.page.story ", { tag = "span"; attrs = { class = "kind" }; children = list("Page") }) }, { tag = "h3"; attrs = { id = "page-title" }; children = list() }, { tag = "p"; attrs = { class = "mono" }; children = list("P.subject → @TheStory") }, { tag = "p"; attrs = { class = "mono"; id = "page-route" }; children = list() }, { tag = "p"; attrs = { class = "quiet" }; children = list("Its title follows the same source. Its route gives the web link somewhere to go.") }) }
            ) }, "\n",
            { tag = "details"; attrs = { class = "algebra-fold" }; children = list({ tag = "summary"; attrs = {}; children = list("See the pure expressions and generated process") }, { tag = "div"; attrs = { id = "inline-pure" }; children = list() }, { tag = "h3"; attrs = {}; children = list("The generated NavigationItem process") }, { tag = "pre"; attrs = { id = "inline-navigation" }; children = list() }, { tag = "p"; attrs = { class = "panel-note" }; children = list("Readable call notation for the stored algebra; ports remain explicit.") }) }
          ) }, "\n",
