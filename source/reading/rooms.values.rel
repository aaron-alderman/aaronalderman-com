("v2355", "type", "Sequence")
("v2356", "type", "String")
("v2356", "scalar", "Fiction can make an emotional or ethical possibility intelligible. Its power to move a reader does not turn an invented event into historical evidence. Naming the kind of work being offered protects both imagination and truth.")
("v2355", "item", "v2356")
("v2354", "value", "v2355")
