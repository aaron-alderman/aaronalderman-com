("v2291", "key", "children")
("v2292", "type", "Sequence")
("v2293", "type", "String")
("v2293", "scalar", "When a story draws on real life, the ability to describe someone does not give me unlimited authority over their account. I need to consider what is mine to tell, what requires permission and where a faithful uncertainty belongs.")
("v2292", "item", "v2293")
("v2291", "value", "v2292")
("v2257", "item", "v2286")
