("v641", "type", "Sequence")
("v642", "type", "String")
("v642", "scalar", "The same care needs to reach the wider household. My responsibilities sit among other people’s needs, limits and relationships. Being Dad is a particular role in that shared life, with a duty to listen beyond my own account of it.")
("v641", "item", "v642")
("v640", "value", "v641")
("v606", "item", "v635")
