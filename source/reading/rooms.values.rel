("v532", "type", "String")
("v532", "scalar", "My interest in systems makes this a useful question to keep asking. A plan can help me remember what matters, but the plan should remain answerable to the people it is meant to serve. A child is not a project whose value appears in a progress report.")
("v531", "item", "v532")
("v530", "value", "v531")
