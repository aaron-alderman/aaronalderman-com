("v633", "type", "Sequence")
("v634", "type", "String")
("v634", "scalar", "I want to offer belonging that leaves room for difference: interests I do not share, questions I cannot answer and a future I cannot author on someone else’s behalf. Care can prepare a person to choose without trying to choose their whole life for them.")
("v633", "item", "v634")
("v632", "value", "v633")
("v606", "item", "v627")
