("v2283", "key", "children")
("v2284", "type", "Sequence")
("v2285", "type", "String")
("v2285", "scalar", "A person can exceed the role a plot offers them. I want to ask what a scene leaves outside the frame: another point of view, an ordinary need, a relationship that does not exist simply to advance the central character.")
("v2284", "item", "v2285")
("v2283", "value", "v2284")
("v2257", "item", "v2278")
("v2286", "type", "Record")
