("v2400", "type", "Record")
("v2399", "value", "v2400")
("v2396", "entry", "v2401")
("v2401", "type", "Entry")
("v2401", "key", "children")
("v2402", "type", "Sequence")
("v2403", "type", "String")
("v2403", "scalar", "I like the possibility that the same scene can mean something different on return. An earlier detail can acquire weight because the reader has encountered another relationship or point of view. The story can invite that recognition and leave its personal meaning with them.")
("v2402", "item", "v2403")
("v2401", "value", "v2402")
("v2367", "item", "v2396")
("v2404", "type", "Record")
