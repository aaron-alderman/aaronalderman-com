("v1377", "type", "String")
("v1377", "scalar", "The process algebra is a way of describing actions and how they compose: what an action receives, what it changes, which conditions it requires and what follows. It lets a definition do practical work instead of remaining a comment beside unrelated code.")
("v1376", "item", "v1377")
("v1375", "value", "v1376")
("v1349", "item", "v1370")
