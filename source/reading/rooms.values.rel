("v578", "type", "Sequence")
("v579", "type", "String")
("v579", "scalar", "The difficult test of care often arrives after an impatient answer or a promise I have failed to keep. I want repair to begin with what I actually did, rather than a long account of why I meant well.")
("v578", "item", "v579")
("v577", "value", "v578")
("v551", "item", "v572")
("v580", "type", "Record")
("v580", "entry", "v581")
