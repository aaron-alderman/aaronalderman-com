("v2449", "type", "Sequence")
("v2450", "type", "String")
("v2450", "scalar", "A story does not need to explain every image immediately. A small joke can release pressure; an odd detail can invite a second look; a quiet stretch can let the reader’s attention settle somewhere the argument did not predict.")
("v2449", "item", "v2450")
("v2448", "value", "v2449")
("v2422", "item", "v2443")
("v2451", "type", "Record")
