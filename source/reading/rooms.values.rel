("v2393", "type", "Entry")
("v2393", "key", "children")
("v2394", "type", "Sequence")
("v2395", "type", "String")
("v2395", "scalar", "A reader brings experiences I cannot know. I can offer a question, a scene or a change in perspective without telling them what they secretly fear or what a chosen route proves about their character.")
("v2394", "item", "v2395")
("v2393", "value", "v2394")
("v2367", "item", "v2388")
("v2396", "type", "Record")
