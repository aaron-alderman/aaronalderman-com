("v2521", "type", "String")
("v2521", "scalar", "A faithful draft can become clearer without becoming less particular. Sometimes the better change is to remove a claim I cannot support, leave an uncertainty visible or allow a character more room than the first outline gave them.")
("v2520", "item", "v2521")
("v2519", "value", "v2520")
