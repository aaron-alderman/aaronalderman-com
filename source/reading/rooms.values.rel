("v523", "type", "Sequence")
("v524", "type", "String")
("v524", "scalar", "I do not want every shared hour to carry an improvement target. Play, wandering, making something peculiar and laughing at a joke that goes nowhere can belong to a good life without proving a result.")
("v523", "item", "v524")
("v522", "value", "v523")
