("v2338", "key", "children")
("v2339", "type", "Sequence")
("v2340", "type", "String")
("v2340", "scalar", "Imagination can make room for a possibility that ordinary habits have hidden. A world becomes more interesting when its relationships and consequences have enough shape that an easy answer cannot resolve everything.")
("v2339", "item", "v2340")
("v2338", "value", "v2339")
("v2312", "item", "v2333")
("v2341", "type", "Record")
