("v2409", "type", "Entry")
("v2409", "key", "children")
("v2410", "type", "Sequence")
("v2411", "type", "String")
("v2411", "scalar", "A branching world makes this responsibility more visible. Choosing a route should give a reader a meaningful way to explore. It should not disguise an assessment of their worth as a playful interaction.")
("v2410", "item", "v2411")
("v2409", "value", "v2410")
