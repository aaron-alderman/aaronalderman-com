("v1549", "type", "Sequence")
("v1550", "type", "String")
("v1550", "scalar", "Replay and undo also need honest meanings. Replaying a recorded sequence can reproduce the sequence without reproducing a person’s reasons. Reversing a local edit does not necessarily reverse an email already sent, a disclosure already made or someone else’s lost time.")
("v1549", "item", "v1550")
("v1548", "value", "v1549")
("v1514", "item", "v1543")
