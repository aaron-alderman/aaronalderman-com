("v413", "type", "Sequence")
("v414", "type", "String")
("v414", "scalar", "There is a difference between hearing the outline of a difficulty and understanding what it is like for the person living it. I want to leave a little room between the first explanation I form and the answer I give.")
("v413", "item", "v414")
("v412", "value", "v413")
("v386", "item", "v407")
("v415", "type", "Record")
("v415", "entry", "v416")
("v416", "type", "Entry")
("v416", "key", "tag")
