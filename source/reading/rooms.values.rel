("v2513", "type", "String")
("v2513", "scalar", "I want to distinguish what a reader actually says from my interpretation of their response. Disagreement may reveal a weakness, a different experience or a live tension the story should preserve. It does not have to be converted into a single measure of success.")
("v2512", "item", "v2513")
("v2511", "value", "v2512")
