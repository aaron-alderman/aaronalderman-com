("v585", "type", "Entry")
("v585", "key", "children")
("v586", "type", "Sequence")
("v587", "type", "String")
("v587", "scalar", "An apology should not make a child responsible for making me feel better. I can name the action, hear its effect and say what I will try to change. Forgiveness cannot be demanded as proof that the apology worked.")
("v586", "item", "v587")
("v585", "value", "v586")
("v551", "item", "v580")
("v588", "type", "Record")
