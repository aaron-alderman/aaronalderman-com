("v420", "type", "Entry")
("v420", "key", "children")
("v421", "type", "Sequence")
("v422", "type", "String")
("v422", "scalar", "That can mean putting something down, asking another question or letting a silence last. It can also mean joining what has caught a child’s attention without needing it to become useful. A shell, a drawing or a half-built thing can be worth our time before it becomes a lesson.")
("v421", "item", "v422")
("v420", "value", "v421")
("v386", "item", "v415")
