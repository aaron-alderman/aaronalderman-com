("v2566", "key", "children")
("v2567", "type", "Sequence")
("v2568", "type", "String")
("v2568", "scalar", "The ambition is for an author to shape a coherent world while a reader finds a journey within it. Reusable structure can support that freedom, provided the structure does not mistake a record of navigation for an account of someone’s inner life.")
("v2567", "item", "v2568")
("v2566", "value", "v2567")
