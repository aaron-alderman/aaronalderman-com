("v2346", "type", "Entry")
("v2346", "key", "children")
("v2347", "type", "Sequence")
("v2348", "type", "String")
("v2348", "scalar", "I want the work to keep track of what its choices cost. A character’s action should meet the world and the other people in it. A beautiful setting can deepen that encounter when it offers something to explore, rather than only decorating an explanation.")
("v2347", "item", "v2348")
("v2346", "value", "v2347")
("v2312", "item", "v2341")
