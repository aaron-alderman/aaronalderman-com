("v6205", "entry", "v6210")
("v6210", "type", "Entry")
("v6210", "key", "children")
("v6211", "type", "Sequence")
("v6212", "type", "String")
("v6212", "scalar", "The psychological hypothesis can be made specific. After participating, are people better able to explain consequential operations? Can they pursue goals they chose? Can they detect mistakes and judge when to rely on an agent? Can they disagree, refuse, and propose alternatives? Can they create useful work with others and continue with less assistance when they want to?")
("v6211", "item", "v6212")
("v6210", "value", "v6211")
("v5761", "item", "v6205")
("v6213", "type", "Record")
("v6213", "entry", "v6214")
("v6214", "type", "Entry")
("v6214", "key", "tag")
("v6215", "type", "String")
