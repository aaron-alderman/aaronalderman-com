("v1822", "type", "Sequence")
("v1823", "type", "String")
("v1823", "scalar", "This is the purpose that connects the corpus: to understand reality more deeply, make meaning something people can work with, and turn increasing capability into greater freedom, responsibility, creativity, and shared life.")
("v1822", "item", "v1823")
("v1821", "value", "v1822")
