("v2217", "entry", "v2222")
("v2222", "type", "Entry")
("v2222", "key", "children")
("v2223", "type", "Sequence")
("v2224", "type", "String")
("v2224", "scalar", "Capability is a responsibility. Knowing more, being stronger, possessing better tools, or controlling an institution gives a person more ways to affect others. I want that capability to be exercised in ways that protect life, enable participation, support growth, and repair what has been damaged.")
("v2223", "item", "v2224")
("v2222", "value", "v2223")
("v2034", "item", "v2217")
("v2225", "type", "Record")
