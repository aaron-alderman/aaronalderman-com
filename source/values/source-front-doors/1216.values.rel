("v6330", "key", "children")
("v6331", "type", "Sequence")
("v6332", "type", "String")
("v6332", "scalar", "The work is an invitation to bring mathematics, experiments, criticism, craftsmanship, experience, faith, imagination, and the willingness to build. Different contributions can strengthen the undertaking while retaining their own voices.")
("v6331", "item", "v6332")
("v6330", "value", "v6331")
("v6261", "item", "v6325")
