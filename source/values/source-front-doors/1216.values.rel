("v5243", "key", "children")
("v5244", "type", "Sequence")
("v5245", "type", "String")
("v5245", "scalar", "An experience becomes culturally consequential when people can carry it into another setting.")
("v5244", "item", "v5245")
("v5243", "value", "v5244")
("v5206", "item", "v5238")
("v5246", "type", "Record")
("v5246", "entry", "v5247")
