("v5171", "type", "Entry")
("v5171", "key", "children")
("v5172", "type", "Sequence")
("v5173", "type", "String")
("v5173", "scalar", "For people seeking to follow Jesus, the programme's success could make kenosis feel generative in contemporary life. A theological commitment would have helped produce useful inquiry, trustworthy tools, and practices that expand participation. Faith could be experienced as a source of serious construction and service.")
("v5172", "item", "v5173")
("v5171", "value", "v5172")
("v5057", "item", "v5166")
