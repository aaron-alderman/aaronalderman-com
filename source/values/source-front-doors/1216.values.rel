("v6298", "type", "Entry")
("v6298", "key", "children")
("v6299", "type", "Sequence")
("v6300", "type", "String")
("v6300", "scalar", "I intend to give this work the full force of my conviction, imagination, and practical effort.")
("v6299", "item", "v6300")
("v6298", "value", "v6299")
("v6261", "item", "v6293")
("v6301", "type", "Record")
("v6301", "entry", "v6302")
