("v1975", "type", "Entry")
("v1975", "key", "children")
("v1976", "type", "Sequence")
("v1977", "type", "String")
("v1977", "scalar", "I want to bring those possibilities into a connected programme of inquiry and construction.")
("v1976", "item", "v1977")
("v1975", "value", "v1976")
("v1848", "item", "v1970")
("v1978", "type", "Record")
("v1978", "entry", "v1979")
("v1979", "type", "Entry")
("v1979", "key", "tag")
