("v1962", "entry", "v1967")
("v1967", "type", "Entry")
("v1967", "key", "children")
("v1968", "type", "Sequence")
("v1969", "type", "String")
("v1969", "scalar", "A discovery can deepen understanding. A language can make a difficult idea expressible. A tool can make a previously inaccessible task manageable. An institution can make cooperation dependable. Each can enlarge the space in which people understand, choose, create, and act.")
("v1968", "item", "v1969")
("v1967", "value", "v1968")
("v1848", "item", "v1962")
("v1970", "type", "Record")
("v1970", "entry", "v1971")
