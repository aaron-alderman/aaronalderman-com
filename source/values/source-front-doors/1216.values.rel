("v6338", "key", "children")
("v6339", "type", "Sequence")
("v6340", "type", "String")
("v6340", "scalar", "Success would include people whose abilities and purposes carry the work beyond its starting point. They would make discoveries I did not make, build worlds I did not imagine, and correct things I had not understood.")
("v6339", "item", "v6340")
("v6338", "value", "v6339")
("v6261", "item", "v6333")
