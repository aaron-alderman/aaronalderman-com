("v5310", "type", "Entry")
("v5310", "key", "attrs")
("v5311", "type", "Record")
("v5310", "value", "v5311")
("v5307", "entry", "v5312")
("v5312", "type", "Entry")
("v5312", "key", "children")
("v5313", "type", "Sequence")
("v5314", "type", "String")
("v5314", "scalar", "A successful example gives those expectations something concrete to point to. It supplies methods and evidence alongside aspiration.")
("v5313", "item", "v5314")
("v5312", "value", "v5313")
("v5206", "item", "v5307")
("v5315", "type", "Record")
("v5315", "entry", "v5316")
("v5316", "type", "Entry")
("v5316", "key", "tag")
("v5317", "type", "String")
("v5317", "scalar", "p")
