("v3981", "type", "Entry")
("v3981", "key", "attrs")
("v3982", "type", "Record")
("v3981", "value", "v3982")
("v3978", "entry", "v3983")
("v3983", "type", "Entry")
("v3983", "key", "children")
("v3984", "type", "Sequence")
("v3985", "type", "String")
("v3985", "scalar", "Technical constraints can give aspects of that commitment an enforceable form. They can make certain unauthorised actions unavailable, require an explicit grant, retain a record, or refuse a transformation whose declared evidence and authority fail its admission rules. Their force depends on the completeness and reliability of the mechanisms that enforce them.")
("v3984", "item", "v3985")
("v3983", "value", "v3984")
("v3777", "item", "v3978")
("v3986", "type", "Record")
