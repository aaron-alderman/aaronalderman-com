("v5179", "type", "Entry")
("v5179", "key", "children")
("v5180", "type", "Sequence")
("v5181", "type", "String")
("v5181", "scalar", "Other people could encounter the same achievements through different convictions. They might value accountable systems, intellectual openness, creative freedom, or mutual support without adopting the programme's theology.")
("v5180", "item", "v5181")
("v5179", "value", "v5180")
("v5057", "item", "v5174")
("v5182", "type", "Record")
