("v5155", "key", "children")
("v5156", "type", "Sequence")
("v5157", "type", "String")
("v5157", "scalar", "This possibility depends on the quality of the connections. Mathematical work earns mathematical confidence. Physical claims earn confidence through their relationship with evidence. Software earns confidence through what it reliably does. Ethical commitments earn credibility through how people are treated.")
("v5156", "item", "v5157")
("v5155", "value", "v5156")
