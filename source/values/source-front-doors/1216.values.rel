("v5147", "key", "children")
("v5148", "type", "Sequence")
("v5149", "type", "String")
("v5149", "scalar", "Coherence could grow through clearer relationships among understanding, conviction, and action. Purpose could grow through worthwhile tasks that connect personal effort to shared aims. Significance could be experienced through participation in a setting where a person's judgment, contribution, and development matter.")
("v5148", "item", "v5149")
("v5147", "value", "v5148")
("v5057", "item", "v5142")
