("v6213", "entry", "v6218")
("v6218", "type", "Entry")
("v6218", "key", "children")
("v6219", "type", "Sequence")
("v6220", "type", "String")
("v6220", "scalar", "The evidence should include observed performance, people's accounts of their experience, and appropriate established measures. Repeated observations can distinguish an initial burst of enthusiasm from lasting capability. Comparisons with other ways of working can help identify what the programme contributes.")
("v6219", "item", "v6220")
("v6218", "value", "v6219")
("v5761", "item", "v6213")
("v6221", "type", "Record")
