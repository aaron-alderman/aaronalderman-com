("v2260", "type", "Sequence")
("v2261", "type", "String")
("v2261", "scalar", "That gives the mission a demanding practical standard. A system should help people become more able to understand what concerns them, more able to make consequential choices, and more able to take responsibility together.")
("v2260", "item", "v2261")
("v2259", "value", "v2260")
("v2034", "item", "v2254")
