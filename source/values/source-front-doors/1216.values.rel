("v3990", "type", "Record")
("v3989", "value", "v3990")
("v3986", "entry", "v3991")
("v3991", "type", "Entry")
("v3991", "key", "children")
("v3992", "type", "Sequence")
("v3993", "type", "String")
("v3993", "scalar", "Social practice must carry the commitment further. People need usable routes to question a decision, contest a permission, obtain help, and recover from mistakes. Good intentions need competent implementation. Competent implementation needs continuing judgment about whom it serves.")
("v3992", "item", "v3993")
("v3991", "value", "v3992")
("v3777", "item", "v3986")
("v3994", "type", "Record")
