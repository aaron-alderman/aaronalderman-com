("v4000", "type", "Sequence")
("v4001", "type", "String")
("v4001", "scalar", "Success would include people being better able to live their own lives: learning when they want to learn, delegating when they want help, creating what matters to them, and participating in decisions that affect them.")
("v4000", "item", "v4001")
("v3999", "value", "v4000")
