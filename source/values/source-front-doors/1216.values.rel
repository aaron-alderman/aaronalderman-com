("v6232", "key", "attrs")
("v6233", "type", "Record")
("v6232", "value", "v6233")
("v6229", "entry", "v6234")
("v6234", "type", "Entry")
("v6234", "key", "children")
("v6235", "type", "Sequence")
("v6236", "type", "String")
("v6236", "scalar", "The present psychology literature provides plausible mechanisms. It does not establish this programme's effects or guarantee a worldwide transformation. The task is to test whether the intended conditions become real experiences and whether those experiences produce durable benefits.")
("v6235", "item", "v6236")
("v6234", "value", "v6235")
("v5761", "item", "v6229")
("v6237", "type", "Record")
