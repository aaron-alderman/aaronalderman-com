("v2613", "type", "Sequence")
("v2614", "type", "String")
("v2614", "scalar", "Theology enters this inquiry as a source of purpose and questions. Mathematics supplies exact objects and consequences. Experiment asks what nature does. Their relationship becomes stronger when each contribution remains identifiable.")
("v2613", "item", "v2614")
("v2612", "value", "v2613")
