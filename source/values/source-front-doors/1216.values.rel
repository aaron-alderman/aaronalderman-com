("v1830", "type", "Sequence")
("v1831", "type", "String")
("v1831", "scalar", "The work includes theology, mathematics and physics, programming languages and systems, artificial intelligence, and the institutions through which we learn, work, create, and cooperate. Its ambition is to connect what reality allows, what love asks of us, and what we can actually build.")
("v1830", "item", "v1831")
("v1829", "value", "v1830")
