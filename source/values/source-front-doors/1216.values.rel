("v6221", "entry", "v6226")
("v6226", "type", "Entry")
("v6226", "key", "children")
("v6227", "type", "Sequence")
("v6228", "type", "String")
("v6228", "scalar", "Where causal claims are made, the evaluation design must address alternative explanations, including prior motivation, selection into the programme, facilitator skill, and novelty. Reports from people who struggle, decline, or leave are part of understanding the result.")
("v6227", "item", "v6228")
("v6226", "value", "v6227")
("v5761", "item", "v6221")
("v6229", "type", "Record")
