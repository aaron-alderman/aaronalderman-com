("v6323", "type", "String")
("v6323", "scalar", "Following Jesus is central to that purpose.")
("v6322", "item", "v6323")
("v6321", "value", "v6322")
("v6315", "item", "v6316")
("v6324", "type", "String")
("v6324", "scalar", " I take his self-giving as a standard for what power should become in relation to others.")
("v6315", "item", "v6324")
("v6314", "value", "v6315")
("v6261", "item", "v6309")
