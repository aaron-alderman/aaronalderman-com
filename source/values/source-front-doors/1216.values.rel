("v5318", "key", "attrs")
("v5319", "type", "Record")
("v5318", "value", "v5319")
("v5315", "entry", "v5320")
("v5320", "type", "Entry")
("v5320", "key", "children")
("v5321", "type", "Sequence")
("v5322", "type", "String")
("v5322", "scalar", "The wider consequence could be a change in the perceived relationship between care and competence. Serving others could become recognisable as an organising principle capable of producing sophisticated, dependable work.")
("v5321", "item", "v5322")
("v5320", "value", "v5321")
("v5206", "item", "v5315")
("v5323", "type", "Record")
("v5323", "entry", "v5324")
("v5324", "type", "Entry")
("v5324", "key", "tag")
("v5325", "type", "String")
("v5325", "scalar", "p")
("v5324", "value", "v5325")
("v5323", "entry", "v5326")
("v5326", "type", "Entry")
("v5326", "key", "attrs")
("v5327", "type", "Record")
("v5326", "value", "v5327")
("v5323", "entry", "v5328")
("v5328", "type", "Entry")
("v5328", "key", "children")
("v5329", "type", "Sequence")
("v5330", "type", "String")
("v5330", "scalar", "That is a substantial cultural possibility. It would make humane ambition easier to discuss in practical terms, and give people more ways to act on it.")
("v5329", "item", "v5330")
("v5328", "value", "v5329")
("v5206", "item", "v5323")
("v5331", "type", "Record")
("v5331", "entry", "v5332")
("v5332", "type", "Entry")
("v5332", "key", "tag")
("v5333", "type", "String")
