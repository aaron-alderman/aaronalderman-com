("v2268", "type", "Sequence")
("v2269", "type", "String")
("v2269", "scalar", "This obligation falls especially on those who hold power. An appeal to self-giving should never become an easy way to ask vulnerable people to accept avoidable harm. The work of making room belongs in the design of authority, the distribution of resources, the protection of participants, and the willingness of leaders to be answerable.")
("v2268", "item", "v2269")
("v2267", "value", "v2268")
("v2034", "item", "v2262")
