("v6301", "entry", "v6306")
("v6306", "type", "Entry")
("v6306", "key", "children")
("v6307", "type", "Sequence")
("v6308", "type", "String")
("v6308", "scalar", "I want to understand reality deeply enough to discover useful structure. I want to make systems intelligible enough for people to shape them. I want increasingly capable intelligence to serve human life. I want the things we build to leave people with more room to understand, choose, create, cooperate, and care.")
("v6307", "item", "v6308")
("v6306", "value", "v6307")
