("v5336", "type", "Entry")
("v5336", "key", "children")
("v5337", "type", "Sequence")
("v5338", "type", "String")
("v5338", "scalar", "The spread would depend on access, intelligibility, adaptation, and sustained results. Different communities would need to make the work their own. The most valuable diffusion would include new applications and improvements that the original programme could not have anticipated.")
("v5337", "item", "v5338")
("v5336", "value", "v5337")
