("v5246", "entry", "v5251")
("v5251", "type", "Entry")
("v5251", "key", "children")
("v5252", "type", "Sequence")
("v5253", "type", "String")
("v5253", "scalar", "Someone who has worked within an intelligible, participatory arrangement gains a concrete point of comparison. They may bring that experience into a workplace, school, research group, religious community, or public institution. They can describe what worked, explain why it mattered, and help reproduce it.")
("v5252", "item", "v5253")
("v5251", "value", "v5252")
("v5206", "item", "v5246")
("v5254", "type", "Record")
