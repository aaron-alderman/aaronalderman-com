("v3974", "type", "Record")
("v3973", "value", "v3974")
("v3970", "entry", "v3975")
("v3975", "type", "Entry")
("v3975", "key", "children")
("v3976", "type", "Sequence")
("v3977", "type", "String")
("v3977", "scalar", "Following Jesus gives the contribution I am proposing its direction: an ability to understand and act for the good of others while preserving their reality as persons with purposes of their own.")
("v3976", "item", "v3977")
("v3975", "value", "v3976")
("v3777", "item", "v3970")
("v3978", "type", "Record")
("v3978", "entry", "v3979")
("v3979", "type", "Entry")
("v3979", "key", "tag")
("v3980", "type", "String")
("v3980", "scalar", "p")
("v3979", "value", "v3980")
