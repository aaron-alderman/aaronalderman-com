("v2628", "key", "children")
("v2629", "type", "Sequence")
("v2630", "type", "String")
("v2630", "scalar", "That is an intellectual connection worth pursuing. Its value lies in the work it generates: definitions, maps, proofs, measurements, implementations, and discoveries that other people can examine.")
("v2629", "item", "v2630")
("v2628", "value", "v2629")
