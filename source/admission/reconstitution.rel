// Reconstitution requirements, not an executable admission policy.
// This document does not authorise or install its own implementation.
("publication.reconstitution", "status", "implemented and qualified locally; rendered-browser tooling unavailable; remote publication suspended")
("publication.reconstitution", "reason", "The owner rejects JSON as an alternate programme-authoring and admission path")
("publication.reconstitution", "scope", "Reconstitute the existing website and publication behaviour without new product features")
("publication.reconstitution", "staticSource", "REL facts under explicit schema and ownership")
("publication.reconstitution", "behaviourSource", "Encounter text through the sole declared compiler")
("publication.reconstitution", "behaviourPath", "Encounter source; bounded hydration to typed REL; source-bound admission; execution; projection")
("publication.reconstitution", "intermediateAuthority", "Hydrated REL is compiler output for admission, never an independently editable programme input")
("publication.reconstitution", "bootstrapObligation", "Declare the minimal trusted compiler, checker, kernel and mechanical ports with exact source identities; do not claim that supplied bootstrap machinery admitted itself")
("publication.reconstitution", "bootstrapNoFallback", "Retired JSON and forensic captures must not be loaded to bootstrap or recover publication")
("publication.reconstitution", "bootstrapNoApplicationPolicy", "No application rendering, routing, prose, CSS, feature selection or migration policy in native host code")
("publication.reconstitution", "kernelObligation", "Retain existing bounded kernel semantics and execution limits; declare and qualify any necessary mechanical codec adaptation")
("publication.reconstitution", "inMemoryDistinction", "Kernel-internal values are implementation state, not a public serialised programme-loading interface")
("publication.reconstitution", "staticAdmission", "Validate types, references, ownership, source closure and permitted representations before composition")
("publication.reconstitution", "staticCannotExecute", "Static REL statements, strings, assets and source quotations cannot become instructions, imports or executable authority")
("publication.reconstitution", "behaviourAdmission", "Bind exact source bytes, compiler basis, emitted REL and permitted effects; validate every executable entry and reachable programme")
("publication.reconstitution", "provenanceAuthority", "A candidate's origin labels, filenames and hashes alone do not prove compiler execution or admission")
("publication.reconstitution", "dispatchAuthority", "Dispatch can select only programmes from the actual admitted closure; callers cannot supply replacement models, programme bodies or grant maps")
("publication.reconstitution", "dynamicCandidate", "Existing workshop candidate behaviour must return through the same hydration and admission owner before execution")
("publication.reconstitution", "noJsonFiles", "Zero JSON files across the website worktree and produced publication, including source, configuration, intermediates, receipts, dependency manifests, generated output and caches")
("publication.reconstitution", "noEncodedObjectFrontDoor", "No JSON, serialized process objects or source programmes hidden in REL string values for later decoding and execution")
("publication.reconstitution", "noNativeAuthoring", "No preparation scripts, templates, content generators or per-page native implementation outside Encounter")
("publication.reconstitution", "noGeneratedAuthority", "Generated HTML, CSS and runtime projections cannot serve as source, admission evidence for a different revision, or fallback input")
("publication.reconstitution", "publication", "Projection is downstream of admission; there is no independently authorable build step")
("publication.reconstitution", "receipts", "Source selection, hydration, admission, execution and projection evidence must be readable REL with exact identities and honest scope")
("publication.reconstitution", "failure", "Missing source, malformed syntax, invalid types, stale identities, undeclared effects or absent admission refuse before publication; no fallback")
("publication.reconstitution", "preservation", "Preserve existing prose, routes, illustrations, mobile behaviour and exact corpus targets as migration obligations")
("publication.reconstitution", "verification", "Qualify positive behaviour, refusal cases, exact source correspondence and browser output; old build success cannot stand in for this qualification")
("publication.reconstitution", "release", "Keep the current live deployment unchanged until the complete replacement closure passes qualification")
("publication.reconstitution", "requiredRefusal", "JSON file presented as source")
("publication.reconstitution", "requiredRefusal", "Renamed serialized programme presented as REL")
("publication.reconstitution", "requiredRefusal", "Static quotation or asset requested as executable programme")
("publication.reconstitution", "requiredRefusal", "Candidate supplies compiledBy or admitted flags without actual admission")
("publication.reconstitution", "requiredRefusal", "Hydrated programme changed after its source-bound admission")
("publication.reconstitution", "requiredRefusal", "Caller supplies a raw model or asks for an undeclared entry")
("publication.reconstitution", "requiredRefusal", "Native or retired helper requested as a publication dependency")
("publication.reconstitution", "requiredRefusal", "A stale generated output or cache is offered as fallback")
("publication.reconstitution", "requiredRefusal", "Invalid child programme or undeclared effect hidden behind an otherwise valid entry")
