{
  "protocol": "encounter-process-text/2",
  "status": "supplied-bootstrap-syntax-definition",
  "operators": [
    "and",
    "append",
    "at",
    "concat",
    "count",
    "eq",
    "if",
    "list",
    "not",
    "or"
  ],
  "forbidden": [
    "__proto__",
    "prototype",
    "constructor"
  ],
  "referenceSigil": "$",
  "directPorts": [
    "asset.blobURL",
    "asset.json",
    "browser.attribute",
    "browser.content",
    "browser.environment",
    "browser.focus",
    "browser.intersection",
    "browser.on",
    "browser.relative",
    "browser.select",
    "browser.write",
    "kernel.invoke",
    "media.load",
    "media.pause",
    "media.play",
    "media.read",
    "media.write",
    "number.calculate",
    "number.format",
    "number.parse",
    "state.get",
    "state.set",
    "text.matches",
    "text.replace",
    "text.slice"
  ],
  "maxDepth": 64,
  "maxCodeUnits": 160000,
  "maxTokens": 36000,
  "name": "encounter/module-batch/microsite-media/1",
  "emitProfile": false,
  "statementForms": [
    "each",
    "fold",
    "let",
    "port",
    "try",
    "when"
  ],
  "statementFieldOrder": {
    "try": [
      "try",
      "catch",
      "error"
    ]
  },
  "allowEmptyCatch": true
}
