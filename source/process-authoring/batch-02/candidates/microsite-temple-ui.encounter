# Immutable JSON-to-Encounter correspondence fixture for microsite-temple-ui.
process-module "temple/surface-process-module/1"
profile "encounter/module-batch/microsite-temple-ui/1"

process ui.temple.recipe:
  port browser.read { ref = "input[name=preset]:checked" } → preset
  port browser.read { ref = "input[name=identity]:checked" } → identity
  port browser.read { ref = "#stale" } → stale
  port browser.read { ref = "#false-claim" } → falseClaim
  port browser.read { ref = "#note-text" } → note
  let result = {
    preset = at($preset, "value");
    identity = at($identity, "value");
    stale = and(at($stale, "checked"), not(at($stale, "disabled")));
    falseClaim = at($falseClaim, "checked");
    note = at($note, "value")
  }

process ui.temple.init:
  port state.get { key = "configuration" } → configuration
  port browser.environment {  } → env
  when not(at($env, "crypto")):
    port kernel.invoke {
      query = "ui.html";
      input = {
        node = {
          tag = "p";
          attrs = { class = "verdict-idle" };
          children = list(
            "This miniature needs Web Crypto (a secure context such as https:// or localhost)."
          )
        }
      }
    } → html
    port browser.content { ref = "#verdict"; html = $html } → _
  when at($env, "crypto"):
    port state.set { key = "busy"; value = false } → _
    port state.set { key = "forged"; value = null } → _
    port state.set { key = "seenCells"; value = list() } → _
    port state.set { key = "seenDigests"; value = list() } → _
    port kernel.invoke {
      query = "ui.html";
      input = {
        node = map(
          at($configuration, "identities"),
          "person",
          {
            tag = "label";
            attrs = {  };
            children = list(
              {
                tag = "input";
                attrs = {
                  type = "radio";
                  name = "identity";
                  value = at($person, "id");
                  checked = eq(at($person, "id"), "steward")
                };
                children = list()
              },
              "\n      ",
              { tag = "b"; attrs = {  }; children = list(at($person, "label")) },
              { tag = "small"; attrs = {  }; children = list(at($person, "note")) }
            )
          }
        )
      }
    } → html
    port browser.content { ref = "#identities"; html = $html } → _
    port kernel.invoke {
      query = "ui.html";
      input = {
        node = map(
          at($configuration, "presets"),
          "preset",
          {
            tag = "label";
            attrs = { class = "preset"; "data-preset" = at($preset, "id"); title = at($preset, "blurb") };
            children = list(
              {
                tag = "input";
                attrs = {
                  type = "radio";
                  name = "preset";
                  value = at($preset, "id");
                  checked = eq(at($preset, "id"), "tend")
                };
                children = list()
              },
              "\n      ",
              { tag = "b"; attrs = {  }; children = list(at($preset, "title")) }
            )
          }
        )
      }
    } → html
    port browser.content { ref = "#presets"; html = $html } → _
    port kernel.invoke { query = "lamp.createWorld"; input = { configuration = $configuration } } → world
    port state.set { key = "world"; value = $world } → _
    port state.set { key = "stageStates"; value = {  } } → _
    port kernel.invoke { query = "ui.temple.stages"; input = {  } } → result
    port kernel.invoke { query = "ui.temple.render"; input = { fresh = false } } → result
    port kernel.invoke { query = "ui.temple.covenant"; input = {  } } → result
    port kernel.invoke { query = "ui.temple.journal"; input = {  } } → result
    port kernel.invoke { query = "ui.temple.preview"; input = {  } } → result
    port browser.on {
      ref = "#composer";
      event = "submit";
      query = "ui.temple.propose";
      input = {  };
      preventDefault = true
    } → _
    port browser.on { ref = "#composer"; event = "change"; query = "ui.temple.preview"; input = {  } } → _
    port browser.on { ref = "#note-text"; event = "input"; query = "ui.temple.preview"; input = {  } } → _
    port browser.on { ref = "#replay"; event = "click"; query = "ui.temple.replay"; input = {  } } → _
    port browser.on {
      ref = "#forge-edit";
      event = "click";
      query = "ui.temple.replay";
      input = { mode = "edit" }
    } → _
    port browser.on {
      ref = "#forge-rewrite";
      event = "click";
      query = "ui.temple.replay";
      input = { mode = "rewrite" }
    } → _
    port browser.on { ref = "#restore"; event = "click"; query = "ui.temple.restore"; input = {  } } → _

process ui.temple.stages:
  port state.get { key = "configuration" } → configuration
  port state.get { key = "stageStates" } → stageStates
  port kernel.invoke {
    query = "ui.html";
    input = {
      node = map(
        at($configuration, "stages"),
        "s",
        {
          tag = "li";
          attrs = { class = at(at($stageStates, at($s, "n")), "state") };
          children = list(
            {
              tag = "span";
              attrs = { class = "dot"; "aria-hidden" = "true" };
              children = list(
                if(
                  eq(at(at($stageStates, at($s, "n")), "state"), "ok"),
                  "✓",
                  if(eq(at(at($stageStates, at($s, "n")), "state"), "fail"), "✗", at($s, "n"))
                )
              )
            },
            {
              tag = "span";
              attrs = {  };
              children = list(
                { tag = "b"; attrs = {  }; children = list(at($s, "title")) },
                {
                  tag = "small";
                  attrs = {  };
                  children = list(or(at(at($stageStates, at($s, "n")), "detail"), at($s, "gloss")))
                }
              )
            }
          )
        }
      )
    }
  } → html
  port browser.content { ref = "#stages"; html = $html } → _

process ui.temple.preview:
  port state.get { key = "world" } → world
  port state.get { key = "configuration" } → configuration
  port state.get { key = "busy" } → busy
  port kernel.invoke { query = "ui.temple.recipe"; input = {  } } → recipe
  port browser.write { ref = "#note-field"; name = "hidden"; value = not(eq(at($recipe, "preset"), "note")) } → _
  let preset = at(
    filter(at($configuration, "presets"), "p", eq(at($p, "id"), at($recipe, "preset"))),
    0
  )
  port browser.write { ref = "#preset-blurb"; name = "textContent"; value = at($preset, "blurb") } → _
  port number.calculate { operation = "greater"; values = list(count(at(at($world, "temple"), "roots")), 1) } → canStale
  port browser.write { ref = "#stale"; name = "disabled"; value = not($canStale) } → _
  when not($canStale):
    port browser.write { ref = "#stale"; name = "checked"; value = false } → _
  port browser.write {
    ref = "#stale-hint";
    name = "textContent";
    value = if($canStale, "(the state before the last acceptance)", "(accept a change first)")
  } → _
  port browser.select { selector = ".preset" } → presets
  each $presets as option:
    port kernel.invoke {
      query = "lamp.availability";
      input = { temple = at($world, "temple"); preset = at(at($option, "attributes"), "data-preset") }
    } → blocked
    port browser.class { ref = at($option, "ref"); name = "unavailable"; value = not(not($blocked)) } → _
  port kernel.invoke {
    query = "lamp.availability";
    input = { temple = at($world, "temple"); preset = at($recipe, "preset") }
  } → blocked
  port browser.write { ref = "#availability"; name = "textContent"; value = or($blocked, "") } → _
  port browser.write { ref = "#propose"; name = "disabled"; value = or(not(not($blocked)), $busy) } → _
  try:
    port kernel.invoke {
      query = "lamp.buildProposal";
      input = {
        temple = at($world, "temple");
        registry = at($world, "registry");
        recipe = $recipe;
        configuration = $configuration
      }
    } → proposal
    port json.stringify { value = at($proposal, "wire"); space = 1 } → wire
    port kernel.invoke {
      query = "canonical.encode";
      input = { value = at($proposal, "wire"); numbers = false }
    } → canonical
    port text.utf8Length { value = $canonical } → bytes
    port browser.write {
      ref = "#wire";
      name = "textContent";
      value = concat(
        $wire,
        "\n\n— ",
        $bytes,
        " canonical bytes. The witness hashes the canonical form."
      )
    } → _
  catch error:
    port browser.write { ref = "#wire"; name = "textContent"; value = or($blocked, at($error, "message")) } → _

process ui.temple.render:
  port state.get { key = "world" } → world
  port state.get { key = "seenCells" } → seenCells
  port state.get { key = "seenDigests" } → seenDigests
  let t = at($world, "temple")
  let covenant = at(at($world, "registry"), at(at($t, "state"), "predicateId"))
  port kernel.invoke { query = "address.short"; input = { id = at($world, "id"); head = 10; tail = 6 } } → id
  port browser.write { ref = "#t-id"; name = "textContent"; value = $id } → _
  port browser.attribute { ref = "#t-id"; name = "title"; value = at($world, "id") } → _
  port browser.read { ref = "#t-root" } → root
  port kernel.invoke { query = "address.short"; input = { id = at($t, "root"); head = 10; tail = 6 } } → id
  port browser.write { ref = "#t-root"; name = "textContent"; value = $id } → _
  port browser.attribute { ref = "#t-root"; name = "title"; value = at($t, "root") } → _
  when and(
    at(at($root, "attributes"), "title"),
    not(eq(at(at($root, "attributes"), "title"), at($t, "root")))
  ):
    port browser.class { ref = "#t-root"; name = "pulse"; value = false } → _
    port browser.reflow { ref = "#t-root" } → _
    port browser.class { ref = "#t-root"; name = "pulse"; value = true } → _
  port browser.write { ref = "#t-seq"; name = "textContent"; value = at($t, "sequence") } → _
  port browser.write { ref = "#t-cov"; name = "textContent"; value = at($covenant, "title") } → _
  port kernel.invoke { query = "lamp.cellsByKey"; input = { state = at($t, "state") } } → cells
  port value.sort { values = map($cells, "cell", at($cell, "id")); mode = "locale" } → ids
  let cells = map($ids, "id", at(filter($cells, "cell", eq(at($cell, "id"), $id)), 0))
  let oil = at(filter($cells, "cell", eq(at($cell, "key"), "lamp.oil")), 0)
  let flame = at(filter($cells, "cell", eq(at($cell, "key"), "lamp.flame")), 0)
  port browser.attribute {
    ref = "#lamp";
    name = "data-lit";
    value = if(eq(at($flame, "value"), "lit"), "true", "false")
  } → _
  port number.parse { value = or(at($oil, "value"), 0) } → measures
  port browser.write {
    ref = "#oil-label";
    name = "textContent";
    value = concat(
      "Oil: ",
      $measures,
      " measure",
      if(eq($measures, 1), "", "s"),
      " · flame ",
      or(at($flame, "value"), "absent")
    )
  } → _
  port number.calculate { operation = "min"; values = list($measures, 12) } → arithmetic1
  let dropCount = $arithmetic1
  port kernel.invoke {
    query = "ui.html";
    input = {
      node = map(range($dropCount), "drop", { tag = "i"; attrs = {  }; children = list() })
    }
  } → html
  port browser.content { ref = "#oil-drops"; html = $html } → _
  fold $cells as cell; items starts list():
    port kernel.invoke { query = "address.digest"; input = { id = at($cell, "id") } } → digest
    port text.slice { value = $digest; start = 0; end = 12 } → digest
    yield append(
    $items,
    list(
      {
        tag = "li";
        attrs = {
          class = if(and(at($eventInput, "fresh"), not(includes($seenCells, at($cell, "id")))), "new", "");
          title = at($cell, "id")
        };
        children = list(
          { tag = "span"; attrs = { class = "k" }; children = list(at($cell, "key")) },
          { tag = "span"; attrs = { class = "v" }; children = list(at($cell, "value")) },
          { tag = "span"; attrs = { class = "id" }; children = list(concat($digest, "…")) }
        )
      }
    )
  ) → items
  port kernel.invoke { query = "ui.html"; input = { node = $items } } → html
  port browser.content { ref = "#cells"; html = $html } → _
  port state.set { key = "seenCells"; value = map($cells, "cell", at($cell, "id")) } → _
  port kernel.invoke {
    query = "ui.temple.tree";
    input = {
      tree = at($t, "tree");
      root = at($t, "root");
      predicateId = at(at($t, "state"), "predicateId");
      fresh = at($eventInput, "fresh");
      seen = $seenDigests
    }
  } → tree
  port kernel.invoke { query = "ui.html"; input = { node = at($tree, "nodes") } } → html
  port browser.content { ref = "#tree"; html = $html } → _
  port state.set { key = "seenDigests"; value = at($tree, "seen") } → _

process ui.temple.tree:
  let levels = at(at($eventInput, "tree"), "levels")
  let leaves = at($levels, 0)
  let L = count($levels)
  let positions = list()
  fold range($L) as levelNumber; positions starts list():
    let level = add($levelNumber, -1)
    let values = at($levels, $level)
    let last = at($positions, add($level, -1))
    fold range(count($values)) as itemNumber; row starts list():
      let index = add($itemNumber, -1)
      let x = 180
      when eq($level, 0):
        when not(eq(count($leaves), 1)):
          port number.calculate { operation = "multiply"; values = list($index, 292) } → arithmetic2
          port number.calculate { operation = "subtract"; values = list(count($leaves), 1) } → arithmetic3
          port number.calculate { operation = "divide"; values = list($arithmetic2, $arithmetic3) } → arithmetic4
          port number.calculate { operation = "add"; values = list(34, $arithmetic4) } → arithmetic5
          let x = $arithmetic5
      when not(eq($level, 0)):
        port number.calculate { operation = "multiply"; values = list($index, 2) } → arithmetic6
        let firstIndex = $arithmetic6
        let a = at($last, $firstIndex)
        let b = at($last, add($firstIndex, 1))
        let x = $a
        when not(or(eq($b, null), eq($b, at({  }, "absent")))):
          port number.calculate { operation = "add"; values = list($a, $b) } → arithmetic7
          port number.calculate { operation = "divide"; values = list($arithmetic7, 2) } → arithmetic8
          let x = $arithmetic8
      yield append($row, list($x)) → row
    yield append($positions, list($row)) → positions
  let nodes = list()
  fold range($L) as levelNumber; nodes starts $nodes:
    let level = add($levelNumber, -1)
    let values = at($levels, $level)
    port kernel.invoke { query = "ui.temple.treeY"; input = { level = $level; count = $L } } → y
    when not(eq($level, 0)):
      port kernel.invoke { query = "ui.temple.treeY"; input = { level = add($level, -1); count = $L } } → childY
      fold range(count($values)) as itemNumber; nodes starts $nodes:
        let index = add($itemNumber, -1)
        let d = at($values, $index)
        port number.calculate { operation = "multiply"; values = list($index, 2) } → arithmetic9
        let firstIndex = $arithmetic9
        fold list($firstIndex, add($firstIndex, 1)) as child; nodes starts $nodes:
          let x = at(at($positions, add($level, -1)), $child)
          when not(or(eq($x, null), eq($x, at({  }, "absent")))):
            let nodes = append(
              $nodes,
              list(
                {
                  tag = "line";
                  attrs = {
                    class = concat(
                      "edge",
                      if(
                        and(
                          and(at($eventInput, "fresh"), not(includes(at($eventInput, "seen"), $d))),
                          and(
                            at($eventInput, "fresh"),
                            not(includes(at($eventInput, "seen"), at(at($levels, add($level, -1)), $child)))
                          )
                        ),
                        " hot",
                        ""
                      )
                    );
                    x1 = $x;
                    y1 = $childY;
                    x2 = at(at($positions, $level), $index);
                    y2 = $y
                  };
                  children = list()
                }
              )
            )
          yield $nodes → nodes
        yield $nodes → nodes
    yield $nodes → nodes
  port kernel.invoke { query = "address.digest"; input = { id = at($eventInput, "predicateId") } } → predicate
  port kernel.invoke { query = "address.digest"; input = { id = at($eventInput, "root") } } → root
  let cellRoot = at(at($levels, add($L, -1)), 0)
  let nodes = append(
    $nodes,
    list(
      {
        tag = "line";
        attrs = {
          class = concat(
            "edge",
            if(
              and(at($eventInput, "fresh"), not(includes(at($eventInput, "seen"), $cellRoot))),
              " hot",
              ""
            )
          );
          x1 = at(at($positions, add($L, -1)), 0);
          y1 = 66;
          x2 = 180;
          y2 = 30
        };
        children = list()
      },
      {
        tag = "line";
        attrs = {
          class = concat(
            "edge",
            if(
              and(at($eventInput, "fresh"), not(includes(at($eventInput, "seen"), $predicate))),
              " hot",
              ""
            )
          );
          x1 = 300;
          y1 = 66;
          x2 = 200;
          y2 = 30
        };
        children = list()
      }
    )
  )
  fold range($L) as levelNumber; nodes starts $nodes:
    let level = add($levelNumber, -1)
    port kernel.invoke { query = "ui.temple.treeY"; input = { level = $level; count = $L } } → y
    fold range(count(at($levels, $level))) as itemNumber; nodes starts $nodes:
      let index = add($itemNumber, -1)
      let d = at(at($levels, $level), $index)
      let x = at(at($positions, $level), $index)
      let nodes = append(
        $nodes,
        list(
          {
            tag = "circle";
            attrs = {
              class = concat(
                "node",
                if(
                  and(at($eventInput, "fresh"), not(includes(at($eventInput, "seen"), $d))),
                  " hot",
                  ""
                )
              );
              cx = $x;
              cy = $y;
              r = if(eq($level, 0), 5, 4)
            };
            children = list()
          }
        )
      )
      when eq($level, 0):
        port number.calculate { operation = "remainder"; values = list($index, 2) } → odd
        port text.slice { value = $d; start = 0; end = 5 } → label
        let nodes = append(
          $nodes,
          list(
            {
              tag = "text";
              attrs = { class = "leaf-label"; x = $x; y = if($odd, 158, 148); "text-anchor" = "middle" };
              children = list($label)
            }
          )
        )
      yield $nodes → nodes
    yield $nodes → nodes
  port text.slice { value = $root; start = 0; end = 8 } → label
  let nodes = append(
    $nodes,
    list(
      {
        tag = "rect";
        attrs = {
          class = concat(
            "node",
            if(
              and(at($eventInput, "fresh"), not(includes(at($eventInput, "seen"), $predicate))),
              " hot",
              ""
            )
          );
          x = 295;
          y = 61;
          width = 10;
          height = 10;
          transform = "rotate(45 300 66)"
        };
        children = list()
      },
      {
        tag = "text";
        attrs = { class = "leaf-label"; x = 312; y = 69 };
        children = list("covenant")
      },
      {
        tag = "path";
        attrs = {
          class = concat(
            "keystone",
            if(
              and(at($eventInput, "fresh"), not(includes(at($eventInput, "seen"), $root))),
              " hot",
              ""
            )
          );
          d = "M138 6 H222 L214 30 H146 Z"
        };
        children = list()
      },
      {
        tag = "text";
        attrs = { class = "root-label"; x = 180; y = 21; "text-anchor" = "middle" };
        children = list(concat("root ", $label))
      }
    )
  )
  let seen = list($root, $predicate)
  fold $levels as row; seen starts $seen:
    let seen = append($seen, $row)
    yield $seen → seen
  let result = { nodes = $nodes; seen = $seen }

process ui.temple.treeY:
  let result = 66
  when not(eq(at($eventInput, "count"), 1)):
    port number.calculate { operation = "multiply"; values = list(at($eventInput, "level"), 66) } → arithmetic10
    port number.calculate { operation = "subtract"; values = list(at($eventInput, "count"), 1) } → arithmetic11
    port number.calculate { operation = "divide"; values = list($arithmetic10, $arithmetic11) } → arithmetic12
    port number.calculate { operation = "subtract"; values = list(132, $arithmetic12) } → arithmetic13
    let result = $arithmetic13

process ui.temple.covenant:
  port state.get { key = "world" } → world
  port state.get { key = "configuration" } → configuration
  let cov = at(at($world, "registry"), at(at(at($world, "temple"), "state"), "predicateId"))
  port browser.write { ref = "#covenant-name"; name = "textContent"; value = at($cov, "title") } → _
  let states = or(at(at($eventInput, "report"), "rules"), list())
  port kernel.invoke {
    query = "ui.html";
    input = {
      node = map(
        at($cov, "rules"),
        "rule",
        {
          tag = "li";
          attrs = {
            class = concat(
              if(
                eq(at(at(filter($states, "s", eq(at($s, "name"), at($rule, "name"))), 0), "ok"), true),
                "held",
                if(
                  eq(at(at(filter($states, "s", eq(at($s, "name"), at($rule, "name"))), 0), "ok"), false),
                  "broken",
                  ""
                )
              ),
              if(at($eventInput, "fresh"), " changed", "")
            )
          };
          children = list(
            { tag = "span"; attrs = { class = "rule-name" }; children = list(at($rule, "name")) },
            { tag = "span"; attrs = {  }; children = list(at($rule, "text")) },
            {
              tag = "span";
              attrs = { class = "rule-state" };
              children = list(
                if(
                  eq(at(at(filter($states, "s", eq(at($s, "name"), at($rule, "name"))), 0), "ok"), true),
                  "✓ held",
                  if(
                    eq(at(at(filter($states, "s", eq(at($s, "name"), at($rule, "name"))), 0), "ok"), false),
                    "✗ broken",
                    ""
                  )
                )
              )
            }
          )
        }
      )
    }
  } → html
  port browser.content { ref = "#rules"; html = $html } → _
  port kernel.invoke { query = "lamp.render"; input = { node = at($cov, "ast"); indent = "" } } → ast
  port browser.write { ref = "#ast"; name = "textContent"; value = $ast } → _
  port kernel.invoke { query = "lamp.measure"; input = { node = at($cov, "ast") } } → size
  port browser.write {
    ref = "#ast-size";
    name = "textContent";
    value = concat(
      at($size, "nodes"),
      " nodes · depth ",
      at($size, "depth"),
      " · the Ark allows 512 nodes and depth 32",
      if(
        at($eventInput, "report"),
        concat(" · this judgment used ", at(at($eventInput, "report"), "fuel"), " of 2048 fuel"),
        ""
      ),
      ". Every operator is from the closed set."
    )
  } → _

process ui.temple.lesson:
  let r = at($eventInput, "recipe")
  let v = at($eventInput, "verdict")
  let result = { text = "The covenant said no."; ref = "" }
  when at($v, "accepted"):
    let result = { text = "Accepted, and witnessed."; ref = "" }
    when includes(list("tend", "tend-unseen"), at($r, "preset")):
      let result = {
        text = if(
          eq(at($r, "identity"), "visitor"),
          "The amended covenant welcomes a visitor’s hand on the oil. The law changed first — by a witnessed act — and only then did this become possible.",
          "The steward’s hand is on the oil. The proposal named the role cell, the covenant could see it, and the fixed algebra did the rest."
        );
        ref = "The lamp is lit"
      }
    when eq(at($r, "preset"), "refill"):
      let result = {
        text = "The oil cell was consumed and a fuller one created — the only way anything changes here. Cells are never edited in place.";
        ref = "III · No hidden mutation"
      }
    when eq(at($r, "preset"), "note"):
      let result = {
        text = "Creation is open to anyone — even an AI emissary. What it cannot do is move what the covenant guards.";
        ref = "Creation is open; consumption is governed"
      }
    when eq(at($r, "preset"), "amend"):
      let result = {
        text = concat(
          "The covenant is now “",
          at($eventInput, "activeTitle"),
          "”. It becomes active only in the resulting state — it did not judge its own installation. Try tending the lamp as the visitor."
        );
        ref = "VII · No retrospective law"
      }
  when not(at($v, "accepted")):
    let rules = or(at(at($v, "failure"), "rules"), list())
    when includes($rules, "A"):
      let result = { text = "Oil moves only by the hands this covenant names."; ref = "Covenant rule A" }
      when and(
        eq(at($r, "identity"), "visitor"),
        not(includes(at($eventInput, "beforeTitle"), "amended"))
      ):
        let result = {
          text = "Under this covenant, oil moves only by the steward’s hand. The steward could amend the covenant to welcome visitors — try it.";
          ref = "Covenant rule A"
        }
      when and(eq(at($r, "identity"), "steward"), eq(at($r, "preset"), "tend-unseen")):
        let result = {
          text = "Refused — even for the steward. The proposal never named the role cell, so the covenant could not see who the steward is. A covenant sees only what a proposal names.";
          ref = "Information access is authority too"
        }
      when eq(at($r, "identity"), "emissary"):
        let result = {
          text = "The emissary holds a full copy of the Temple and a capable mind — and neither is authority. Acting for the visitor is not being the visitor.";
          ref = "I · No implicit authority"
        }
    when includes($rules, "B"):
      let result = {
        text = "Oil never simply vanishes here. Consuming it means creating it again, fuller or emptier, in plain sight.";
        ref = "Covenant rule B"
      }
    when includes($rules, "D"):
      let result = {
        text = "Only the steward may amend the covenant — and the steward must be seen to be the steward.";
        ref = "Covenant rule D"
      }
    when includes($rules, "C"):
      let result = {
        text = "The steward’s role is fixed in this covenant. No one proposes their way into it.";
        ref = "Covenant rule C"
      }
    when eq(at(at($v, "failure"), "stage"), 1):
      let result = {
        text = "Something in the proposal was not canonical or not bounded. It never reached the law.";
        ref = "IV · No ambient context"
      }
    when eq(at(at($v, "failure"), "stage"), 2):
      let result = {
        text = "The proposal was built on a state that no longer exists. A stale basis is never applied — no one can slip a change in “before” another.";
        ref = "Stage 2 · the exact starting point"
      }
    when eq(at(at($v, "failure"), "stage"), 3):
      let result = {
        text = "The fixed algebra could not apply this delta to the current state.";
        ref = "V · No executable mutation authority"
      }
    when eq(at(at($v, "failure"), "stage"), 4):
      let result = {
        text = "The proposer claimed a result the algebra does not produce. What you say will happen must be what happens.";
        ref = "A supplied answer cannot stand in for verification"
      }
    when eq(at(at($v, "failure"), "stage"), 6):
      let result = {
        text = "Refused — even for the steward. A covenant may narrow the Ark; it can never exceed it. This one was nested beyond the Ark’s bound.";
        ref = "II · No absolute local policy"
      }

process ui.temple.propose:
  port state.get { key = "busy" } → busy
  when not($busy):
    port state.get { key = "world" } → world
    port state.get { key = "configuration" } → configuration
    port kernel.invoke { query = "ui.temple.recipe"; input = {  } } → recipe
    port kernel.invoke {
      query = "lamp.availability";
      input = { temple = at($world, "temple"); preset = at($recipe, "preset") }
    } → blocked
    when not($blocked):
      port state.set { key = "busy"; value = true } → _
      port browser.write { ref = "#propose"; name = "disabled"; value = true } → _
      port kernel.invoke { query = "ui.temple.restore"; input = {  } } → result
      port state.set { key = "stageStates"; value = {  } } → _
      port kernel.invoke { query = "ui.temple.stages"; input = {  } } → result
      port browser.write { ref = "#verdict"; name = "className"; value = "verdict" } → _
      port kernel.invoke {
        query = "ui.html";
        input = {
          node = { tag = "p"; attrs = { class = "verdict-idle" }; children = list("Judging…") }
        }
      } → html
      port browser.content { ref = "#verdict"; html = $html } → _
      let beforeTitle = at(
        at(at($world, "registry"), at(at(at($world, "temple"), "state"), "predicateId")),
        "title"
      )
      port kernel.invoke {
        query = "lamp.propose";
        input = { world = $world; recipe = $recipe; configuration = $configuration }
      } → proposed
      port state.set { key = "world"; value = at($proposed, "world") } → _
      port state.set {
        key = "pendingProposal";
        value = { recipe = $recipe; result = at($proposed, "result"); beforeTitle = $beforeTitle }
      } → _
      port kernel.invoke { query = "ui.temple.animateStage"; input = { n = 1 } } → result

process ui.temple.animateStage:
  port state.get { key = "stageStates" } → stageStates
  port record.put { record = $stageStates; key = at($eventInput, "n"); value = { state = "running" } } → stageStates
  port state.set { key = "stageStates"; value = $stageStates } → _
  port kernel.invoke { query = "ui.temple.stages"; input = {  } } → result
  port browser.environment {  } → env
  port browser.timer {
    milliseconds = if(at($env, "reduced"), 0, 210);
    query = "ui.temple.finishStage";
    input = { n = at($eventInput, "n") }
  } → _

process ui.temple.finishStage:
  port state.get { key = "pendingProposal" } → pendingProposal
  port state.get { key = "stageStates" } → stageStates
  port state.get { key = "configuration" } → configuration
  let got = at(
    filter(
      at(at($pendingProposal, "result"), "stages"),
      "s",
      eq(at($s, "n"), at($eventInput, "n"))
    ),
    0
  )
  when not(or(eq($got, null), eq($got, at({  }, "absent")))):
    port record.put {
      record = $stageStates;
      key = at($eventInput, "n");
      value = { state = if(at($got, "ok"), "ok", "fail"); detail = at($got, "detail") }
    } → stageStates
  when or(or(eq($got, null), eq($got, at({  }, "absent"))), not(at($got, "ok"))):
    fold at($configuration, "stages") as s; stageStates starts $stageStates:
      port number.calculate {
        operation = if(or(eq($got, null), eq($got, at({  }, "absent"))), "greaterEqual", "greater");
        values = list(at($s, "n"), at($eventInput, "n"))
      } → skipped
      when $skipped:
        port record.put {
          record = $stageStates;
          key = at($s, "n");
          value = { state = "skipped"; detail = "Not reached." }
        } → stageStates
      yield $stageStates → stageStates
  port state.set { key = "stageStates"; value = $stageStates } → _
  port kernel.invoke { query = "ui.temple.stages"; input = {  } } → result
  let continue = and(at($got, "ok"), not(eq(at($eventInput, "n"), 6)))
  when $continue:
    port kernel.invoke { query = "ui.temple.animateStage"; input = { n = add(at($eventInput, "n"), 1) } } → result
  when not($continue):
    port kernel.invoke { query = "ui.temple.finishProposal"; input = {  } } → result

process ui.temple.finishProposal:
  port state.get { key = "pendingProposal" } → pendingProposal
  port state.get { key = "world" } → world
  let v = at($pendingProposal, "result")
  port kernel.invoke {
    query = "ui.temple.lesson";
    input = {
      recipe = at($pendingProposal, "recipe");
      verdict = $v;
      beforeTitle = at($pendingProposal, "beforeTitle");
      activeTitle = at(
        at(at($world, "registry"), at(at(at($world, "temple"), "state"), "predicateId")),
        "title"
      )
    }
  } → lesson
  port browser.write {
    ref = "#verdict";
    name = "className";
    value = if(at($v, "accepted"), "verdict accepted", "verdict refused")
  } → _
  port kernel.invoke {
    query = "ui.html";
    input = {
      node = list(
        {
          tag = "h4";
          attrs = {  };
          children = list(
            if(
              at($v, "accepted"),
              concat("Accepted · sequence ", at(at(at($v, "witness"), "body"), "sequence")),
              concat(
                "Refused at stage ",
                at(at($v, "failure"), "stage"),
                " · ",
                at(at($v, "failure"), "code")
              )
            )
          )
        },
        { tag = "p"; attrs = {  }; children = list(at($lesson, "text")) },
        if(
          at($v, "accepted"),
          null,
          {
            tag = "p";
            attrs = {  };
            children = list("The refusal has its own witness. The state did not move.")
          }
        ),
        {
          tag = "p";
          attrs = { class = "ref" };
          children = list(
            if(
              at($v, "accepted"),
              at($lesson, "ref"),
              concat(
                at($lesson, "ref"),
                if(at($lesson, "ref"), " · ", ""),
                "VIII · No silent failure"
              )
            )
          )
        },
        {
          tag = "p";
          attrs = {  };
          children = list({ tag = "code"; attrs = {  }; children = list(at(at($v, "witness"), "id")) })
        }
      )
    }
  } → html
  port browser.content { ref = "#verdict"; html = $html } → _
  port kernel.invoke { query = "ui.temple.render"; input = { fresh = at($v, "accepted") } } → result
  port kernel.invoke {
    query = "ui.temple.covenant";
    input = { fresh = true; report = at($v, "covenantReport") }
  } → result
  port kernel.invoke { query = "ui.temple.journal"; input = {  } } → result
  port browser.content { ref = "#replay-lines"; html = "" } → _
  port state.set { key = "busy"; value = false } → _
  port kernel.invoke { query = "ui.temple.preview"; input = {  } } → result

process ui.temple.label:
  port state.get { key = "configuration" } → configuration
  let person = at(
    filter(
      at($configuration, "identities"),
      "person",
      eq(at($person, "id"), at($eventInput, "id"))
    ),
    0
  )
  let result = or(at($person, "label"), at($eventInput, "id"))

process ui.temple.journal:
  port state.get { key = "world" } → world
  port state.get { key = "forged" } → forged
  let journal = if($forged, at($forged, "journal"), at($world, "journal"))
  let forgedIndex = if($forged, at($forged, "index"), -1)
  fold range(count($journal)) as position; items starts list():
    port number.calculate { operation = "subtract"; values = list(count($journal), $position) } → arithmetic14
    let index = $arithmetic14
    let e = at($journal, $index)
    let b = at($e, "body")
    let accepted = eq(at($b, "outcome"), "accepted")
    port kernel.invoke { query = "ui.temple.label"; input = { id = at($b, "identity") } } → label
    port kernel.invoke { query = "address.short"; input = { id = at($e, "id"); head = 12; tail = 6 } } → witness
    let out = concat(
      "refused at stage ",
      at(at($b, "failure"), "stage"),
      " · ",
      at(at($b, "failure"), "code"),
      " · state unchanged"
    )
    when $accepted:
      port kernel.invoke {
        query = "address.short";
        input = { id = at($b, "finalStateRoot"); head = 8; tail = 0 }
      } → root
      let out = concat("accepted · sequence ", at($b, "sequence"), " · root → ", $root)
    yield append(
    $items,
    list(
      {
        tag = "li";
        attrs = {
          class = concat(
            if($accepted, "accepted", "rejected"),
            if(and(eq($position, 1), eq($forgedIndex, -1)), " fresh", ""),
            if(eq($index, $forgedIndex), " forged", "")
          )
        };
        children = list(
          {
            tag = "span";
            attrs = { class = "seq" };
            children = list(if($accepted, concat("#", at($b, "sequence")), "—"))
          },
          {
            tag = "span";
            attrs = {  };
            children = list(
              {
                tag = "span";
                attrs = { class = "what" };
                children = list(
                  { tag = "b"; attrs = {  }; children = list($label) },
                  " · ",
                  at(at($b, "context"), "purpose")
                )
              },
              { tag = "span"; attrs = { class = "out" }; children = list($out) },
              {
                tag = "code";
                attrs = { class = "wid"; title = at($e, "id") };
                children = list(concat("witness ", $witness))
              }
            )
          }
        )
      }
    )
  ) → items
  port kernel.invoke {
    query = "ui.html";
    input = {
      node = if(
        eq(count($journal), 0),
        {
          tag = "li";
          attrs = { class = "empty" };
          children = list("No witnesses yet. The first proposal — accepted or refused — will leave one.")
        },
        $items
      )
    }
  } → html
  port browser.content { ref = "#journal"; html = $html } → _
  let accepted = count(filter(at($world, "journal"), "e", eq(at(at($e, "body"), "outcome"), "accepted")))
  port number.calculate { operation = "subtract"; values = list(count(at($world, "journal")), $accepted) } → arithmetic15
  let refused = $arithmetic15
  port browser.write {
    ref = "#journal-count";
    name = "textContent";
    value = if(
      eq(count(at($world, "journal")), 0),
      "No witnesses yet.",
      concat(
        count(at($world, "journal")),
        " witness",
        if(eq(count(at($world, "journal")), 1), "", "es"),
        " · ",
        $accepted,
        " accepted · ",
        $refused,
        " refused"
      )
    )
  } → _
  port kernel.invoke { query = "ui.temple.chain"; input = {  } } → result

process ui.temple.restore:
  port state.set { key = "forged"; value = null } → _
  port browser.write { ref = "#forgery"; name = "hidden"; value = true } → _
  port browser.write { ref = "#restore"; name = "hidden"; value = true } → _
  port browser.content { ref = "#replay-lines"; html = "" } → _
  port kernel.invoke { query = "ui.temple.journal"; input = {  } } → result

process ui.temple.replayBusy:
  each list("replay", "forge-edit", "forge-rewrite", "restore") as id:
    port browser.write { ref = concat("#", $id); name = "disabled"; value = at($eventInput, "value") } → _

process ui.temple.replay:
  port kernel.invoke { query = "ui.temple.replayBusy"; input = { value = true } } → result
  port state.get { key = "world" } → world
  port state.get { key = "forged" } → forged
  port state.get { key = "configuration" } → configuration
  let journal = if($forged, at($forged, "journal"), at($world, "journal"))
  let proceed = true
  when at($eventInput, "mode"):
    port kernel.invoke { query = "ui.temple.restore"; input = {  } } → result
    port kernel.invoke {
      query = "lamp.forge";
      input = { world = $world; mode = at($eventInput, "mode"); configuration = $configuration }
    } → forged
    port state.set { key = "forged"; value = $forged } → _
    port browser.write { ref = "#forgery"; name = "hidden"; value = false } → _
    when or(eq($forged, null), eq($forged, at({  }, "absent"))):
      port browser.write {
        ref = "#forgery";
        name = "textContent";
        value = "There is no history worth forging yet. Tend the lamp first, as the steward."
      } → _
      port kernel.invoke { query = "ui.temple.replayBusy"; input = { value = false } } → result
      let proceed = false
    when not(or(eq($forged, null), eq($forged, at({  }, "absent")))):
      port browser.write {
        ref = "#forgery";
        name = "textContent";
        value = concat(at($forged, "description"), " Now a verifier replays it:")
      } → _
      port browser.write { ref = "#restore"; name = "hidden"; value = false } → _
      let journal = at($forged, "journal")
      port kernel.invoke { query = "ui.temple.journal"; input = {  } } → result
  when $proceed:
    port kernel.invoke {
      query = "lamp.replay";
      input = {
        world = $world;
        journal = $journal;
        publishedHead = at(at($world, "temple"), "root");
        configuration = $configuration
      }
    } → replay
    port browser.content { ref = "#replay-lines"; html = "" } → _
    port kernel.invoke { query = "ui.temple.replayLine"; input = { lines = at($replay, "lines"); index = 0 } } → result

process ui.temple.replayLine:
  let line = at(at($eventInput, "lines"), at($eventInput, "index"))
  when not(or(eq($line, null), eq($line, at({  }, "absent")))):
    port kernel.invoke {
      query = "ui.html";
      input = {
        node = {
          tag = "li";
          attrs = {
            class = concat(
              if(at($line, "ok"), "", "bad"),
              if(eq(add(at($eventInput, "index"), 1), count(at($eventInput, "lines"))), " final", "")
            )
          };
          children = list(at($line, "text"))
        }
      }
    } → html
    port browser.insert { ref = "#replay-lines"; position = "beforeend"; html = $html } → _
    port browser.environment {  } → env
    port number.calculate { operation = "greater"; values = list(count(at($eventInput, "lines")), 12) } → many
    port browser.timer {
      query = "ui.temple.replayLine";
      input = { lines = at($eventInput, "lines"); index = add(at($eventInput, "index"), 1) };
      milliseconds = if(at($env, "reduced"), 0, if($many, 60, 120))
    } → _
  when or(eq($line, null), eq($line, at({  }, "absent"))):
    port kernel.invoke { query = "ui.temple.replayBusy"; input = { value = false } } → result

process ui.temple.chain:
  port state.get { key = "world" } → world
  port browser.select { selector = "#chain" } → targets
  when not(eq(count($targets), 0)):
    port text.slice { value = at($world, "journal"); start = -11 } → shown
    port number.calculate { operation = "subtract"; values = list(count(at($world, "journal")), count($shown)) } → arithmetic16
    let hidden = $arithmetic16
    port number.calculate { operation = "max"; values = list(1, count($shown)) } → arithmetic17
    port number.calculate { operation = "multiply"; values = list($arithmetic17, 28) } → arithmetic18
    port number.calculate { operation = "add"; values = list(78, $arithmetic18) } → arithmetic19
    let height = $arithmetic19
    port browser.attribute { ref = "#chain"; name = "viewBox"; value = concat("0 0 420 ", $height) } → _
    let nodes = list(
      {
        tag = "line";
        attrs = { class = "spine"; x1 = 96; y1 = 34; x2 = 96; y2 = add($height, -18) };
        children = list()
      },
      {
        tag = "circle";
        attrs = { class = "genesis"; cx = 96; cy = 34; r = 8 };
        children = list()
      },
      {
        tag = "text";
        attrs = { class = "lbl-caps"; x = 116; y = 38 };
        children = list("GENESIS")
      }
    )
    when not(eq($hidden, 0)):
      let nodes = append(
        $nodes,
        list(
          {
            tag = "text";
            attrs = { x = 116; y = 56 };
            children = list(concat("… ", $hidden, " earlier witness", if(eq($hidden, 1), "", "es")))
          }
        )
      )
    fold range(count($shown)) as position; nodes starts $nodes:
      let b = at(at($shown, add($position, -1)), "body")
      port kernel.invoke { query = "ui.temple.label"; input = { id = at($b, "identity") } } → identity
      port number.calculate { operation = "multiply"; values = list($position, 28) } → arithmetic20
      port number.calculate { operation = "add"; values = list(58, $arithmetic20, if(eq($hidden, 0), -6, 0)) } → arithmetic21
      let y = $arithmetic21
      when eq(at($b, "outcome"), "accepted"):
        let nodes = append(
          $nodes,
          list(
            {
              tag = "circle";
              attrs = { class = "acc"; cx = 96; cy = $y; r = 6 };
              children = list()
            },
            {
              tag = "text";
              attrs = { x = 116; y = add($y, 4) };
              children = list(
                concat(
                  "#",
                  at($b, "sequence"),
                  " · ",
                  $identity,
                  " · ",
                  at(at($b, "context"), "purpose")
                )
              )
            }
          )
        )
      when not(eq(at($b, "outcome"), "accepted")):
        let nodes = append(
          $nodes,
          list(
            {
              tag = "line";
              attrs = { class = "rej-link"; x1 = 96; y1 = $y; x2 = 130; y2 = $y };
              children = list()
            },
            {
              tag = "circle";
              attrs = { class = "rej"; cx = 136; cy = $y; r = 5 };
              children = list()
            },
            {
              tag = "text";
              attrs = { x = 152; y = add($y, 4) };
              children = list(concat("refused · ", $identity, " · stage ", at(at($b, "failure"), "stage")))
            }
          )
        )
      yield $nodes → nodes
    port kernel.invoke { query = "ui.html"; input = { node = $nodes } } → html
    port browser.content { ref = "#chain"; html = $html } → _
    let accepted = count(filter(at($world, "journal"), "e", eq(at(at($e, "body"), "outcome"), "accepted")))
    port number.calculate { operation = "subtract"; values = list(count(at($world, "journal")), $accepted) } → arithmetic22
    let refused = $arithmetic22
    port browser.write {
      ref = "#chain-summary";
      name = "textContent";
      value = if(
        eq(count(at($world, "journal")), 0),
        "Your Temple so far: genesis, and nothing else yet. Try the gate above.",
        concat(
          "Your Temple so far: genesis, ",
          $accepted,
          " accepted transition",
          if(eq($accepted, 1), "", "s"),
          " and ",
          $refused,
          " refusal",
          if(eq($refused, 1), "", "s"),
          " — every one witnessed. Only acceptances advance the state."
        )
      )
    } → _

