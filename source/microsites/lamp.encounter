process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lamp.availability:
  port kernel.invoke {
    query = "lamp.findCell";
    input = { state = $eventInput.temple.state; key = "lamp.oil" }
  } → oil
  let result = null
  when and(
    includes(list("tend", "tend-unseen"), $eventInput.preset),
    not(eq($oil, null)),
    eq($oil.value, "0")
  ):
    let result = "The oil is spent. Refill the lamp first."
  when and(
    includes(list("tend", "tend-unseen", "take", "refill"), $eventInput.preset),
    eq($oil, null)
  ):
    let result = "There is no oil cell."

process lamp.applyUnchecked:
  let state = $eventInput.temple.state
  fold $eventInput.delta.consume as id; cells starts $state.cells:
    port kernel.invoke { query = "record.remove"; input = { record = $cells; key = $id } } → cells
    yield $cells → cells
  fold $eventInput.delta.create as cell; cells starts $cells:
    port kernel.invoke { query = "lamp.cellId"; input = { cell = $cell } } → id
    port record.put { record = $cells; key = $id; value = { key = $cell.key; value = $cell.value } } → cells
    yield $cells → cells
  let result = { cells = $cells; predicateId = or($eventInput.successorId, $state.predicateId) }

process address.flip:
  port text.split { value = $eventInput.id; pattern = ":" } → parts
  let digest = at($parts, 2)
  port text.slice { value = $digest; start = 0; end = 3 } → before
  port text.slice { value = $digest; start = 3; end = 4 } → character
  port text.slice { value = $digest; start = 4 } → after
  let result = concat(
    at($parts, 0),
    ":",
    at($parts, 1),
    ":",
    $before,
    if(eq($character, "0"), "1", "0"),
    $after
  )

process lamp.buildProposal:
  let temple = $eventInput.temple
  let recipe = $eventInput.recipe
  let configuration = $eventInput.configuration
  port kernel.invoke { query = "lamp.findCell"; input = { state = $temple.state; key = "lamp.oil" } } → oil
  port kernel.invoke { query = "lamp.findCell"; input = { state = $temple.state; key = "lamp.flame" } } → flame
  port kernel.invoke { query = "lamp.findCell"; input = { state = $temple.state; key = "role.steward" } } → role
  let read = list()
  let consume = list()
  let create = list()
  let successor = null
  assert includes(map($configuration.presets, "p", $p.id), $recipe.preset)
    otherwise "Unknown preset"
  when includes(list("tend", "tend-unseen"), $recipe.preset):
    port record.get { record = $recipe; key = "forgeOil" } → nextOil
    when eq($nextOil, null):
      port number.parse { value = $oil.value } → measures
      port number.calculate { operation = "max"; values = list(0, add($measures, -1)) } → measures
      let nextOil = concat($measures)
    when and(eq($recipe.preset, "tend"), not(eq($role, null))):
      let read = list($role.id)
    let consume = list($oil.id, $flame.id)
    let create = list({ key = "lamp.oil"; value = $nextOil }, { key = "lamp.flame"; value = "lit" })
  when eq($recipe.preset, "refill"):
    when not(eq($role, null)):
      let read = list($role.id)
    let consume = list($oil.id)
    port number.parse { value = $oil.value } → measures
    let create = list({ key = "lamp.oil"; value = concat(add($measures, 3)) })
  when eq($recipe.preset, "take"):
    when not(eq($role, null)):
      let read = list($role.id)
    let consume = list($oil.id)
  when eq($recipe.preset, "note"):
    port kernel.invoke { query = "lamp.cellsByKey"; input = { state = $temple.state } } → cells
    port text.replace {
      value = or(at($recipe, "note"), "");
      pattern = "[\u0000-\u001f]";
      flags = "g";
      replacement = ""
    } → note
    port text.trim { value = $note } → note
    fold $cells as cell; notes starts 0:
      port text.matches { value = $cell.key; pattern = "^note\\." } → isNote
      yield add($notes, if($isNote, 1, 0)) → noteCount
    let create = list(
      {
        key = concat("note.", add($noteCount, 1));
        value = or($note, "Thank you for the light.")
      }
    )
  when eq($recipe.preset, "appoint"):
    let consume = list($role.id)
    let create = list({ key = "role.steward"; value = $recipe.identity })
  when eq($recipe.preset, "amend"):
    port kernel.invoke {
      query = "canonical.identify";
      input = { kind = "predicate"; value = at(at($configuration.covenants, 1), "ast") }
    } → amendedId
    port kernel.invoke {
      query = "canonical.identify";
      input = { kind = "predicate"; value = at(at($configuration.covenants, 0), "ast") }
    } → originalId
    let successor = at(
      $eventInput.registry,
      if(eq($temple.state.predicateId, $amendedId), $originalId, $amendedId)
    )
    when not(eq($role, null)):
      let read = list($role.id)
  when eq($recipe.preset, "amend-beyond"):
    port kernel.invoke {
      query = "canonical.identify";
      input = { kind = "predicate"; value = at(at($configuration.covenants, 2), "ast") }
    } → unboundedId
    let successor = at($eventInput.registry, $unboundedId)
    when not(eq($role, null)):
      let read = list($role.id)
  port number.calculate { operation = "greater"; values = list(count($temple.roots), 1) } → canStale
  let basis = if(
    and(or(at($recipe, "stale"), false), $canStale),
    at($temple.roots, add(count($temple.roots), -2)),
    $temple.root
  )
  let delta = { read = $read; consume = $consume; create = $create }
  port kernel.invoke {
    query = "lamp.applyUnchecked";
    input = {
      temple = $temple;
      delta = $delta;
      successorId = if(eq($successor, null), null, at($successor, "id"))
    }
  } → nextState
  port kernel.invoke { query = "lamp.stateRoot"; input = { state = $nextState } } → honest
  let claimed = $honest.root
  when or(at($recipe, "falseClaim"), false):
    port kernel.invoke { query = "address.flip"; input = { id = $claimed } } → claimed
  let preset = at(filter($configuration.presets, "preset", eq($preset.id, $recipe.preset)), 0)
  let result = {
    recipe = $recipe;
    successor = $successor;
    wire = {
      identity = $recipe.identity;
      context = { purpose = $preset.title };
      delta = {
        basis = $basis;
        read = $read;
        consume = $consume;
        create = $create;
        nextPredicate = if(eq($successor, null), null, at($successor, "id"));
        claimedFinalStateRoot = $claimed
      }
    }
  }

process lamp.checkCanonical:
  let proposal = $eventInput.proposal
  let limits = $eventInput.configuration.limits
  let bad = null
  port kernel.invoke { query = "canonical.is"; input = { value = $proposal.wire } } → canonical
  when not($canonical):
    let bad = "Proposal contains a non-canonical value."
  when eq($bad, null):
    port kernel.invoke { query = "canonical.encode"; input = { value = $proposal.wire; numbers = false } } → wireJSON
    port text.utf8Length { value = $wireJSON } → bytes
    port number.calculate { operation = "greater"; values = list($bytes, $limits.contextBytes) } → tooMany
    when $tooMany:
      let bad = concat("Proposal is ", $bytes, " bytes; the bound is ", $limits.contextBytes, ".")
  fold list("read", "consume", "create") as list; issue starts $bad:
    let next = $issue
    when eq($issue, null):
      port number.calculate {
        operation = "greater";
        values = list(count(at($proposal.wire.delta, $list)), $limits.deltaCells)
      } → tooMany
      when $tooMany:
        let next = concat("Too many cells in ", $list, ".")
    yield $next → bad
  fold $proposal.wire.delta.create as cell; issue starts $bad:
    let next = $issue
    when eq($issue, null):
      port value.type { value = $cell.key } → keyType
      port text.matches { value = $cell.key; pattern = "^[a-z]+(\\.[a-z0-9-]+)+$" } → validKey
      when or(not(eq($keyType, "string")), not($validKey)):
        port value.encode { value = $cell.key } → keyJSON
        let next = concat("Malformed cell key ", $keyJSON, ".")
      when eq($next, null):
        port value.type { value = $cell.value } → valueType
        when not(eq($valueType, "string")):
          let next = "Cell values must be strings."
        when eq($valueType, "string"):
          port number.calculate { operation = "greater"; values = list(count($cell.value), $limits.valueLength) } → tooLong
          when $tooLong:
            let next = concat("A value exceeds ", $limits.valueLength, " characters.")
    yield $next → bad
  let result = $bad

process lamp.judge:
  let temple = $eventInput.temple
  let proposal = $eventInput.proposal
  let configuration = $eventInput.configuration
  let wire = $proposal.wire
  let delta = $wire.delta
  let stages = list()
  let failure = null
  let nextState = null
  let nextRoot = null
  let tree = null
  let covenantReport = null
  let created = list()
  port kernel.invoke {
    query = "lamp.checkCanonical";
    input = { proposal = $proposal; configuration = $configuration }
  } → bad
  when not(eq($bad, null)):
    let failure = { stage = 1; code = "NONCANONICAL"; detail = $bad }
    let stages = append($stages, list({ n = 1; ok = false; detail = $bad }))
  when eq($bad, null):
    port kernel.invoke { query = "canonical.encode"; input = { value = $wire; numbers = false } } → wireJSON
    port text.utf8Length { value = $wireJSON } → bytes
    let stages = append(
      $stages,
      list({ n = 1; ok = true; detail = concat($bytes, " bytes, within bounds.") })
    )
  when eq($failure, null):
    port kernel.invoke { query = "address.short"; input = { id = $delta.basis; head = 8; tail = 0 } } → basisShort
    port kernel.invoke { query = "address.short"; input = { id = $temple.root; head = 8; tail = 0 } } → rootShort
    when not(eq($delta.basis, $temple.root)):
      let failure = {
        stage = 2;
        code = "STALE_BASIS";
        detail = concat("Basis ", $basisShort, " is not the current root ", $rootShort, ".")
      }
      let stages = append(
        $stages,
        list(
          {
            n = 2;
            ok = false;
            detail = concat("Basis ", $basisShort, " is not the current root ", $rootShort, ".")
          }
        )
      )
    when eq($delta.basis, $temple.root):
      let stages = append(
        $stages,
        list({ n = 2; ok = true; detail = concat("Basis ", $basisShort, " is current.") })
      )
  when eq($failure, null):
    let cells = $temple.state.cells
    fold $delta.consume as id; applying starts { cells = $cells; failure = null; stages = $stages }:
      let next = $applying
      when eq($applying.failure, null):
        port record.get { record = $temple.state.cells; key = $id } → cell
        when eq($cell, null):
          port kernel.invoke { query = "address.short"; input = { id = $id; head = 8; tail = 0 } } → idShort
          let detail = concat("Consumed cell ", $idShort, " is not in S₀.")
          let next = {
            cells = $applying.cells;
            failure = { stage = 3; code = "CONSUMED_CELL_ABSENT"; detail = $detail };
            stages = append($applying.stages, list({ n = 3; ok = false; detail = $detail }))
          }
        when not(eq($cell, null)):
          port kernel.invoke { query = "record.remove"; input = { record = $applying.cells; key = $id } } → remainingCells
          port record.put { record = $applying; key = "cells"; value = $remainingCells } → next
      yield $next → applying
    let cells = $applying.cells
    let failure = $applying.failure
    let stages = $applying.stages
    fold $delta.read as id; reading starts { failure = $failure; stages = $stages }:
      let next = $reading
      when eq($reading.failure, null):
        port record.get { record = $temple.state.cells; key = $id } → cell
        when eq($cell, null):
          port kernel.invoke { query = "address.short"; input = { id = $id; head = 8; tail = 0 } } → idShort
          let detail = concat("Read cell ", $idShort, " is not in S₀.")
          let next = {
            failure = { stage = 3; code = "READ_CELL_ABSENT"; detail = $detail };
            stages = append($reading.stages, list({ n = 3; ok = false; detail = $detail }))
          }
      yield $next → reading
    let failure = $reading.failure
    let stages = $reading.stages
    when eq($failure, null):
      fold $delta.create as cell; createdCells starts list():
        port kernel.invoke { query = "lamp.cellId"; input = { cell = $cell } } → id
        port record.put { record = $cell; key = "id"; value = $id } → identified
        yield append($createdCells, list($identified)) → created
      fold $created as cell; creating starts { cells = $cells; failure = null; stages = $stages }:
        let next = $creating
        when eq($creating.failure, null):
          port record.get { record = $creating.cells; key = $cell.id } → existing
          when not(eq($existing, null)):
            let detail = concat("Created cell ", $cell.key, " already exists.")
            let next = {
              cells = $creating.cells;
              failure = { stage = 3; code = "CELL_ALREADY_PRESENT"; detail = $detail };
              stages = append($creating.stages, list({ n = 3; ok = false; detail = $detail }))
            }
          when eq($existing, null):
            port record.put {
              record = $creating.cells;
              key = $cell.id;
              value = { key = $cell.key; value = $cell.value }
            } → inserted
            port record.put { record = $creating; key = "cells"; value = $inserted } → next
        yield $next → creating
      let cells = $creating.cells
      let failure = $creating.failure
      let stages = $creating.stages
    let predicateId = $temple.state.predicateId
    when and(eq($failure, null), not(eq($delta.nextPredicate, null))):
      let expected = null
      when not(eq($proposal.successor, null)):
        port kernel.invoke {
          query = "canonical.identify";
          input = { kind = "predicate"; value = $proposal.successor.ast }
        } → expected
      when not(eq($expected, $delta.nextPredicate)):
        let failure = {
          stage = 3;
          code = "SUCCESSOR_UNRESOLVED";
          detail = "The successor predicate does not match its id."
        }
        let stages = append(
          $stages,
          list({ n = 3; ok = false; detail = "The successor predicate does not match its id." })
        )
      when eq($expected, $delta.nextPredicate):
        let predicateId = $delta.nextPredicate
    let nextState = { cells = $cells; predicateId = $predicateId }
    when eq($failure, null):
      let stages = append(
        $stages,
        list(
          {
            n = 3;
            ok = true;
            detail = concat(
              "−",
              count($delta.consume),
              " cell",
              if(eq(count($delta.consume), 1), "", "s"),
              ", +",
              count($delta.create),
              " cell",
              if(eq(count($delta.create), 1), "", "s"),
              if($delta.nextPredicate, ", successor covenant attached", ""),
              "."
            )
          }
        )
      )
  when eq($failure, null):
    port kernel.invoke { query = "lamp.stateRoot"; input = { state = $nextState } } → commitment
    let nextRoot = $commitment.root
    let tree = $commitment.tree
    port kernel.invoke {
      query = "address.short";
      input = { id = $delta.claimedFinalStateRoot; head = 8; tail = 0 }
    } → claimedShort
    port kernel.invoke { query = "address.short"; input = { id = $nextRoot; head = 8; tail = 0 } } → nextShort
    when not(eq($delta.claimedFinalStateRoot, $nextRoot)):
      let failure = {
        stage = 4;
        code = "CLAIMED_ROOT_MISMATCH";
        detail = concat("Claimed ", $claimedShort, ", computed ", $nextShort, ".")
      }
      let stages = append(
        $stages,
        list(
          {
            n = 4;
            ok = false;
            detail = concat("Claimed ", $claimedShort, ", computed ", $nextShort, ".")
          }
        )
      )
    when eq($delta.claimedFinalStateRoot, $nextRoot):
      let stages = append(
        $stages,
        list({ n = 4; ok = true; detail = concat("Claimed and computed: ", $nextShort, ".") })
      )
  when eq($failure, null):
    let covenant = at($temple.predicates, $temple.state.predicateId)
    port kernel.invoke { query = "lamp.namedCells"; input = { state = $temple.state; ids = $delta.read } } → readCells
    port kernel.invoke { query = "lamp.namedCells"; input = { state = $temple.state; ids = $delta.consume } } → consumeCells
    port record.fromEntries { entries = map($delta.create, "cell", list($cell.key, $cell.value)) } → createCells
    let view = {
      identity = $wire.identity;
      read = $readCells;
      consume = $consumeCells;
      create = $createCells;
      successor = or($delta.nextPredicate, null)
    }
    fold $covenant.rules as rule; rules starts list():
      port kernel.invoke {
        query = "lamp.evaluate";
        input = { node = $rule.ast; view = $view; fuel = $configuration.limits.fuel }
      } → evaluated
      yield append($rules, list({ name = $rule.name; text = $rule.text; ok = $evaluated.value })) → rules
    port kernel.invoke {
      query = "lamp.evaluate";
      input = { node = $covenant.ast; view = $view; fuel = $configuration.limits.fuel }
    } → whole
    let covenantReport = { covenant = $covenant.title; rules = $rules; fuel = $whole.fuelUsed; view = $view }
    let broken = filter($rules, "rule", not($rule.ok))
    when not($whole.value):
      port text.join { values = map($broken, "rule", $rule.name); separator = ", " } → brokenNames
      let firstBroken = at($broken, 0)
      let failure = {
        stage = 5;
        code = "COVENANT_FALSE";
        detail = concat(
          "Rule ",
          $brokenNames,
          ": ",
          if(eq(count($broken), 0), "the covenant returned false.", at($firstBroken, "text"))
        );
        rules = map($broken, "rule", $rule.name)
      }
      let stages = append(
        $stages,
        list(
          {
            n = 5;
            ok = false;
            detail = concat(
              "Rule ",
              $brokenNames,
              ": ",
              if(eq(count($broken), 0), "the covenant returned false.", at($firstBroken, "text"))
            )
          }
        )
      )
    when $whole.value:
      let stages = append(
        $stages,
        list(
          {
            n = 5;
            ok = true;
            detail = concat(
              "All ",
              count($rules),
              " rules hold · fuel ",
              $whole.fuelUsed,
              " of ",
              $configuration.limits.fuel,
              "."
            )
          }
        )
      )
  when eq($failure, null):
    let arkIssue = null
    when not(eq($proposal.successor, null)):
      port kernel.invoke { query = "lamp.measure"; input = { node = $proposal.successor.ast } } → measurement
      port number.calculate {
        operation = "greater";
        values = list($measurement.depth, $configuration.limits.depth)
      } → deep
      port number.calculate {
        operation = "greater";
        values = list($measurement.nodes, $configuration.limits.nodes)
      } → large
      let arkIssue = if(
        not($measurement.closed),
        "The successor covenant uses an operator outside the closed set.",
        if(
          $deep,
          concat(
            "The successor covenant is ",
            $measurement.depth,
            " deep; the Ark allows ",
            $configuration.limits.depth,
            "."
          ),
          if(
            $large,
            concat(
              "The successor covenant has ",
              $measurement.nodes,
              " nodes; the Ark allows ",
              $configuration.limits.nodes,
              "."
            ),
            null
          )
        )
      )
    when not(eq($arkIssue, null)):
      let failure = { stage = 6; code = "ARK_INVARIANT"; detail = $arkIssue }
      let stages = append($stages, list({ n = 6; ok = false; detail = $arkIssue }))
    when eq($arkIssue, null):
      let stages = append(
        $stages,
        list(
          { n = 6; ok = true; detail = "Bounds, operators and structure are within the Ark." }
        )
      )
  let accepted = eq($failure, null)
  let body = {
    kind = "witness";
    temple = $temple.id;
    predicate = $temple.state.predicateId;
    identity = $wire.identity;
    context = $wire.context;
    initialStateRoot = $temple.root;
    delta = {
      basis = $delta.basis;
      read = $delta.read;
      consume = $delta.consume;
      create = $delta.create;
      nextPredicate = or($delta.nextPredicate, null);
      claimedFinalStateRoot = $delta.claimedFinalStateRoot
    };
    outcome = if($accepted, "accepted", "rejected");
    failure = if(
      $accepted,
      null,
      { stage = concat(at($failure, "stage")); code = at($failure, "code") }
    );
    finalStateRoot = if($accepted, $nextRoot, null);
    sequence = if($accepted, concat(add($temple.sequence, 1)), null);
    previousWitness = $temple.tip
  }
  port kernel.invoke { query = "canonical.identify"; input = { kind = "witness"; value = $body } } → witnessId
  let result = {
    accepted = $accepted;
    stages = $stages;
    failure = $failure;
    covenantReport = $covenantReport;
    witness = { id = $witnessId; body = $body };
    S1 = if($accepted, $nextState, null);
    S1root = $nextRoot;
    tree = $tree;
    created = $created
  }

process lamp.namedCells:
  port record.fromEntries {
    entries = map(
      $eventInput.ids,
      "id",
      list(
        at(at($eventInput.state.cells, $id), "key"),
        at(at($eventInput.state.cells, $id), "value")
      )
    )
  } → result

process lamp.commit:
  port record.put { record = $eventInput.temple; key = "tip"; value = $eventInput.result.witness.id } → temple
  when $eventInput.result.accepted:
    port record.put { record = $temple; key = "state"; value = $eventInput.result.S1 } → temple
    port record.put { record = $temple; key = "root"; value = $eventInput.result.S1root } → temple
    port record.put { record = $temple; key = "sequence"; value = add($temple.sequence, 1) } → temple
  let result = $temple

process lamp.propose:
  let world = $eventInput.world
  port kernel.invoke {
    query = "lamp.buildProposal";
    input = {
      temple = $world.temple;
      registry = $world.registry;
      recipe = $eventInput.recipe;
      configuration = $eventInput.configuration
    }
  } → proposal
  port kernel.invoke {
    query = "lamp.judge";
    input = {
      temple = $world.temple;
      proposal = $proposal;
      configuration = $eventInput.configuration
    }
  } → judgment
  port kernel.invoke { query = "lamp.commit"; input = { temple = $world.temple; result = $judgment } } → temple
  when $judgment.accepted:
    port record.put { record = $temple; key = "tree"; value = $judgment.tree } → temple
    port record.put {
      record = $temple;
      key = "roots";
      value = append($temple.roots, list($judgment.S1root))
    } → temple
  port record.put { record = $world; key = "temple"; value = $temple } → world
  port record.put {
    record = $world;
    key = "journal";
    value = append(
      $world.journal,
      list(
        {
          id = $judgment.witness.id;
          body = $judgment.witness.body;
          recipe = $eventInput.recipe
        }
      )
    )
  } → world
  let result = { world = $world; proposal = $proposal; result = $judgment }

process lamp.freshTemple:
  let g = $eventInput.world.genesis
  let result = {
    id = $g.id;
    arkId = $g.arkId;
    state = $g.state;
    root = $g.root;
    predicates = $eventInput.world.registry;
    sequence = 0;
    tip = null;
    roots = list($g.root)
  }

process lamp.replay:
  let world = $eventInput.world
  let journal = $eventInput.journal
  port kernel.invoke { query = "lamp.freshTemple"; input = { world = $world } } → temple
  port kernel.invoke {
    query = "canonical.identify";
    input = {
      kind = "context";
      value = {
        name = "The Temple of the Lamp";
        purpose = "A miniature running in your browser, for illustration."
      }
    }
  } → contextId
  port kernel.invoke {
    query = "canonical.identify";
    input = {
      kind = "temple";
      value = {
        ark = $world.genesis.arkId;
        initialStateRoot = $temple.root;
        genesisContext = $contextId
      }
    }
  } → templeCheck
  let result = {
    ok = false;
    lines = list({ ok = false; text = "Genesis does not reproduce this Temple’s identity." })
  }
  when eq($templeCheck, $world.id):
    fold range(count($journal)) as position; checking starts {
      temple = $temple;
      lines = list({ ok = true; text = "Genesis reproduces the Temple’s identity." });
      ok = true;
      at = null;
      accepted = 0;
      refused = 0
    }:
      let next = $checking
      when $checking.ok:
        let index = add($position, -1)
        let entry = at($journal, $index)
        let label = concat("Witness ", $position)
        port kernel.invoke { query = "canonical.identify"; input = { kind = "witness"; value = $entry.body } } → id
        let problem = null
        when not(eq($id, $entry.id)):
          let problem = concat($label, ": its contents no longer match its hash. The record was altered.")
        when and(eq($problem, null), not(eq($entry.body.previousWitness, $checking.temple.tip))):
          let problem = concat($label, ": it does not follow the witness before it.")
        when eq($problem, null):
          let proposal = {
            wire = {
              identity = $entry.body.identity;
              context = $entry.body.context;
              delta = $entry.body.delta
            };
            successor = if(
              $entry.body.delta.nextPredicate,
              at($world.registry, $entry.body.delta.nextPredicate),
              null
            )
          }
          port kernel.invoke {
            query = "lamp.judge";
            input = {
              temple = $checking.temple;
              proposal = $proposal;
              configuration = $eventInput.configuration
            }
          } → again
          when not(eq($again.witness.id, $entry.id)):
            let problem = concat($label, ": re-judging it from genesis gives a different witness.")
        when not(eq($problem, null)):
          let next = {
            temple = $checking.temple;
            lines = append($checking.lines, list({ ok = false; text = $problem }));
            ok = false;
            at = $index;
            accepted = $checking.accepted;
            refused = $checking.refused
          }
        when eq($problem, null):
          port kernel.invoke { query = "lamp.commit"; input = { temple = $checking.temple; result = $again } } → temple
          when $again.accepted:
            port record.put { record = $temple; key = "roots"; value = append($temple.roots, list($again.S1root)) } → temple
          let next = {
            temple = $temple;
            lines = append(
              $checking.lines,
              list(
                {
                  ok = true;
                  text = concat(
                    $label,
                    ": re-judged — ",
                    if(
                      $again.accepted,
                      concat("accepted, sequence ", $again.witness.body.sequence),
                      concat("refused at stage ", at($again.failure, "stage"), ", state unchanged")
                    ),
                    "."
                  )
                }
              )
            );
            ok = true;
            at = null;
            accepted = add($checking.accepted, if($again.accepted, 1, 0));
            refused = add($checking.refused, if($again.accepted, 0, 1))
          }
      yield $next → checking
    let result = { ok = false; lines = $checking.lines; at = $checking.at }
    when $checking.ok:
      let summary = concat(
        count($journal),
        " witness",
        if(eq(count($journal), 1), "", "es"),
        " replayed from genesis: ",
        $checking.accepted,
        " accepted, ",
        $checking.refused,
        " refused."
      )
      when eq($checking.temple.root, $eventInput.publishedHead):
        let result = {
          ok = true;
          lines = append(
            $checking.lines,
            list({ ok = true; text = concat($summary, " The final root matches the head.") })
          )
        }
      when not(eq($checking.temple.root, $eventInput.publishedHead)):
        let result = {
          ok = false;
          lines = append(
            $checking.lines,
            list(
              {
                ok = false;
                text = concat(
                  $summary,
                  " Internally consistent — but its head is not the head already witnessed. This is a different history, not a continuation of this Temple."
                )
              }
            )
          );
          forked = true
        }

process lamp.forge:
  let world = $eventInput.world
  fold range(count($world.journal)) as position; found starts -1:
    let entry = at($world.journal, add($position, -1))
    let oilCreation = some($entry.body.delta.create, "cell", eq($cell.key, "lamp.oil"))
    yield if(
    and(eq($found, -1), eq($entry.body.outcome, "accepted"), $oilCreation),
    add($position, -1),
    $found
  ) → index
  let result = null
  when not(eq($index, -1)):
    when eq($eventInput.mode, "edit"):
      fold range(count($world.journal)) as position; journal starts list():
        let entry = at($world.journal, add($position, -1))
        when eq(add($position, -1), $index):
          fold $entry.body.delta.create as cell; created starts { cells = list(); changed = false }:
            let nextCell = $cell
            let changed = $created.changed
            when and(not($changed), eq($cell.key, "lamp.oil")):
              port record.put { record = $cell; key = "value"; value = "9" } → nextCell
              let changed = true
            yield { cells = append($created.cells, list($nextCell)); changed = $changed } → created
          port record.put { record = $entry.body.delta; key = "create"; value = $created.cells } → delta
          port record.put { record = $entry.body; key = "delta"; value = $delta } → body
          port record.put { record = $entry; key = "body"; value = $body } → entry
        yield append($journal, list($entry)) → journal
      let result = {
        journal = $journal;
        index = $index;
        description = concat(
          "Changed witness ",
          add($index, 1),
          " so the lamp kept 9 measures of oil — without touching its hash."
        )
      }
    when not(eq($eventInput.mode, "edit")):
      port kernel.invoke { query = "lamp.freshTemple"; input = { world = $world } } → temple
      port record.put { record = $world; key = "temple"; value = $temple } → shadow
      port record.put { record = $shadow; key = "journal"; value = list() } → shadow
      fold range(count($world.journal)) as position; shadow starts $shadow:
        let recipe = at(at($world.journal, add($position, -1)), "recipe")
        when eq(add($position, -1), $index):
          port record.put { record = $recipe; key = "forgeOil"; value = "9" } → recipe
        port kernel.invoke {
          query = "lamp.propose";
          input = { world = $shadow; recipe = $recipe; configuration = $eventInput.configuration }
        } → proposal
        yield $proposal.world → shadow
      let result = {
        journal = $shadow.journal;
        index = $index;
        description = concat(
          "Rewrote history from witness ",
          add($index, 1),
          ": the lamp kept 9 measures, and every later hash and root was recomputed to match."
        )
      }
