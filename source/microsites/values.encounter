# Authoritative Encounter source for microsite-values.
# JSON is generated by the selected process frontend.
# Executed through the existing lowering, admission and kernel.
process-module "temple/surface-process-module/1"
profile "encounter/module-batch/microsite-values/1"

process canonical.encode:
  let value = $eventInput.value
  port value.describe { value = $value } → kind
  let result = ""
  when or(
    $kind.null,
    eq($kind.type, "string"),
    eq($kind.type, "boolean"),
    and(eq($kind.type, "number"), $eventInput.numbers)
  ):
    port json.stringify { value = $value } → result
  when $kind.array:
    fold $value as item; parts starts list():
      port kernel.invoke { query = "canonical.encode"; input = { value = $item; numbers = $eventInput.numbers } } → part
      yield append($parts, list($part)) → parts
    port text.join { values = $parts; separator = "," } → joined
    let result = concat("[", $joined, "]")
  when and(eq($kind.type, "object"), not($kind.null), not($kind.array)):
    port record.entries { value = $value } → entries
    port value.sort { values = map($entries, "entry", at($entry, 0)); mode = "lexical" } → keys
    fold $keys as key; parts starts list():
      port json.stringify { value = $key } → keyJSON
      port kernel.invoke {
        query = "canonical.encode";
        input = { value = at($value, $key); numbers = $eventInput.numbers }
      } → part
      yield append($parts, list(concat($keyJSON, ":", $part))) → parts
    port text.join { values = $parts; separator = "," } → joined
    let result = concat("{", $joined, "}")
  assert not(eq($result, ""))
    otherwise "Non-canonical value type"

process canonical.identify:
  port kernel.invoke {
    query = "canonical.encode";
    input = { value = { kind = $eventInput.kind; value = $eventInput.value }; numbers = false }
  } → bytes
  port digest.sha256 { text = $bytes } → digest
  let result = concat($eventInput.kind, ":sha256:", $digest)

process canonical.is:
  let result = true
  try:
    port kernel.invoke { query = "canonical.encode"; input = { value = $eventInput.value; numbers = false } } → _
  catch error:
    let result = false

process address.digest:
  port text.split { value = $eventInput.id; pattern = ":" } → parts
  let result = at($parts, add(count($parts), -1))

process address.short:
  port kernel.invoke { query = "address.digest"; input = { id = $eventInput.id } } → digest
  port text.slice { value = $digest; start = 0; end = $eventInput.head } → first
  let result = concat($first, "…")
  port number.calculate { operation = "greater"; values = list($eventInput.tail, 0) } → tailExists
  when $tailExists:
    port number.calculate { operation = "multiply"; values = list($eventInput.tail, -1) } → tailStart
    port text.slice { value = $digest; start = $tailStart } → last
    let result = concat($first, "…", $last)

process record.remove:
  port record.entries { value = $eventInput.record } → entries
  port record.fromEntries { entries = filter($entries, "entry", not(eq(at($entry, 0), $eventInput.key))) } → result

process record.clone:
  port json.stringify { value = $eventInput.value } → text
  port json.parse { text = $text } → result

process lamp.measure:
  let node = $eventInput.node
  let children = or(at($node, "args"), list())
  fold $children as child; metric starts {
    nodes = 1;
    depth = 1;
    closed = includes(list("literal", "read", "eq", "not", "all", "any"), at($node, "op"))
  }:
    port kernel.invoke { query = "lamp.measure"; input = { node = $child } } → childMetric
    port number.calculate { operation = "max"; values = list($metric.depth, add($childMetric.depth, 1)) } → depth
    yield {
    nodes = add($metric.nodes, $childMetric.nodes);
    depth = $depth;
    closed = and($metric.closed, $childMetric.closed)
  } → result

process lamp.readPath:
  port text.indexOf { value = $eventInput.path; search = "." } → dot
  port number.calculate { operation = "greaterEqual"; values = list($dot, 0) } → hasNamespace
  let result = null
  when not($hasNamespace):
    port record.get { record = $eventInput.view; key = $eventInput.path } → result
  when $hasNamespace:
    port text.slice { value = $eventInput.path; start = 0; end = $dot } → namespace
    port text.slice { value = $eventInput.path; start = add($dot, 1) } → key
    port record.get { record = at($eventInput.view, $namespace); key = $key } → result

process lamp.evaluateNode:
  let node = $eventInput.node
  let remaining = add($eventInput.remaining, -1)
  port number.calculate { operation = "greaterEqual"; values = list($remaining, 0) } → hasFuel
  assert $hasFuel
    otherwise "Evaluation fuel exhausted"
  let value = null
  when eq($node.op, "literal"):
    let value = $node.value
  when eq($node.op, "read"):
    port kernel.invoke { query = "lamp.readPath"; input = { view = $eventInput.view; path = $node.path } } → value
  when eq($node.op, "eq"):
    port kernel.invoke {
      query = "lamp.evaluateNode";
      input = { node = at($node.args, 0); view = $eventInput.view; remaining = $remaining }
    } → left
    port kernel.invoke {
      query = "lamp.evaluateNode";
      input = { node = at($node.args, 1); view = $eventInput.view; remaining = $left.remaining }
    } → right
    port kernel.invoke { query = "canonical.encode"; input = { value = $left.value; numbers = false } } → leftJSON
    port kernel.invoke { query = "canonical.encode"; input = { value = $right.value; numbers = false } } → rightJSON
    let value = eq($leftJSON, $rightJSON)
    let remaining = $right.remaining
  when eq($node.op, "not"):
    port kernel.invoke {
      query = "lamp.evaluateNode";
      input = { node = at($node.args, 0); view = $eventInput.view; remaining = $remaining }
    } → child
    let value = not(eq($child.value, true))
    let remaining = $child.remaining
  when or(eq($node.op, "all"), eq($node.op, "any")):
    fold $node.args as childNode; evaluation starts { value = eq($node.op, "all"); remaining = $remaining; done = false }:
      let next = $evaluation
      when not($evaluation.done):
        port kernel.invoke {
          query = "lamp.evaluateNode";
          input = { node = $childNode; view = $eventInput.view; remaining = $evaluation.remaining }
        } → child
        let truth = eq($child.value, true)
        let next = {
          value = $truth;
          remaining = $child.remaining;
          done = if(eq($node.op, "all"), not($truth), $truth)
        }
      yield $next → evaluation
    let value = $evaluation.value
    let remaining = $evaluation.remaining
  assert includes(list("literal", "read", "eq", "not", "all", "any"), $node.op)
    otherwise "Operator outside the closed set"
  let result = { value = $value; remaining = $remaining }

process lamp.evaluate:
  port kernel.invoke {
    query = "lamp.evaluateNode";
    input = { node = $eventInput.node; view = $eventInput.view; remaining = $eventInput.fuel }
  } → evaluation
  port number.calculate { operation = "subtract"; values = list($eventInput.fuel, $evaluation.remaining) } → used
  let result = { value = eq($evaluation.value, true); fuelUsed = $used }

process lamp.render:
  let node = $eventInput.node
  let indent = $eventInput.indent
  let result = ""
  when eq($node.op, "literal"):
    port json.stringify { value = $node.value } → literal
    let result = concat("literal ", $literal)
  when eq($node.op, "read"):
    let result = concat("read ", $node.path)
  when eq($node.op, "eq"):
    port kernel.invoke { query = "lamp.render"; input = { node = at($node.args, 0); indent = "" } } → left
    port kernel.invoke { query = "lamp.render"; input = { node = at($node.args, 1); indent = "" } } → right
    let result = concat("eq(", $left, ", ", $right, ")")
  when eq($node.op, "not"):
    port kernel.invoke { query = "lamp.render"; input = { node = at($node.args, 0); indent = $indent } } → child
    let result = concat("not(", $child, ")")
  when or(eq($node.op, "all"), eq($node.op, "any")):
    let pad = concat($indent, "  ")
    fold $node.args as childNode; parts starts list():
      port kernel.invoke { query = "lamp.render"; input = { node = $childNode; indent = $pad } } → child
      yield append($parts, list(concat($pad, $child))) → parts
    port text.join { values = $parts; separator = ",\n" } → joined
    let result = concat($node.op, "(\n", $joined, "\n", $indent, ")")

process lamp.cellId:
  port kernel.invoke {
    query = "canonical.identify";
    input = {
      kind = "cell";
      value = { key = $eventInput.cell.key; value = $eventInput.cell.value }
    }
  } → result

process lamp.merkle:
  fold $eventInput.ids as id; digests starts list():
    port kernel.invoke { query = "address.digest"; input = { id = $id } } → digest
    yield append($digests, list($digest)) → digests
  port value.sort { values = $digests; mode = "lexical" } → level
  let result = null
  when eq(count($level), 0):
    port digest.sha256 { text = "empty" } → empty
    let result = { root = $empty; levels = list(list()) }
  when not(eq(count($level), 0)):
    port kernel.invoke { query = "lamp.merkleLevel"; input = { level = $level; levels = list($level) } } → result

process lamp.merkleLevel:
  let level = $eventInput.level
  let result = { root = at($level, 0); levels = $eventInput.levels }
  port number.calculate { operation = "greater"; values = list(count($level), 1) } → more
  when $more:
    fold range(count($level)) as position; nextLevel starts list():
      let index = add($position, -1)
      port number.calculate { operation = "remainder"; values = list($index, 2) } → parity
      let next = $nextLevel
      when eq($parity, 0):
        let digest = at($level, $index)
        port number.calculate { operation = "less"; values = list(add($index, 1), count($level)) } → hasRight
        when $hasRight:
          port digest.sha256 { text = concat(at($level, $index), at($level, add($index, 1))) } → digest
        let next = append($nextLevel, list($digest))
      yield $next → nextLevel
    port kernel.invoke {
      query = "lamp.merkleLevel";
      input = { level = $nextLevel; levels = append($eventInput.levels, list($nextLevel)) }
    } → result

process lamp.stateRoot:
  port record.entries { value = $eventInput.state.cells } → entries
  port kernel.invoke { query = "lamp.merkle"; input = { ids = map($entries, "entry", at($entry, 0)) } } → tree
  port kernel.invoke {
    query = "canonical.identify";
    input = {
      kind = "state";
      value = { activePredicateId = $eventInput.state.predicateId; cellSetRoot = $tree.root }
    }
  } → root
  let result = { root = $root; tree = $tree }

process lamp.cellsByKey:
  port record.entries { value = $eventInput.state.cells } → entries
  let result = map(
    $entries,
    "entry",
    {
      id = at($entry, 0);
      key = at(at($entry, 1), "key");
      value = at(at($entry, 1), "value")
    }
  )

process lamp.findCell:
  port kernel.invoke { query = "lamp.cellsByKey"; input = { state = $eventInput.state } } → cells
  let matching = filter($cells, "cell", eq($cell.key, $eventInput.key))
  let result = if(eq(count($matching), 0), null, at($matching, 0))

process lamp.createWorld:
  let configuration = $eventInput.configuration
  fold $configuration.covenants as covenant; registry starts {  }:
    port kernel.invoke { query = "canonical.identify"; input = { kind = "predicate"; value = $covenant.ast } } → id
    port record.put { record = $covenant; key = "id"; value = $id } → identified
    port record.put { record = $registry; key = $id; value = $identified } → registry
    yield $registry → registry
  port record.entries { value = $registry } → covenants
  let original = at($covenants, 0)
  port kernel.invoke {
    query = "canonical.identify";
    input = {
      kind = "ark";
      value = {
        name = "Candidate Ark v0.1 (miniature)";
        operators = $configuration.operators;
        bounds = {
          nodes = concat($configuration.limits.nodes);
          depth = concat($configuration.limits.depth);
          fuel = concat($configuration.limits.fuel);
          contextBytes = concat($configuration.limits.contextBytes)
        }
      }
    }
  } → arkId
  fold $configuration.genesisCells as cell; cells starts {  }:
    port kernel.invoke { query = "lamp.cellId"; input = { cell = $cell } } → id
    port record.put { record = $cells; key = $id; value = $cell } → cells
    yield $cells → cells
  let state = { cells = $cells; predicateId = at($original, 0) }
  port kernel.invoke { query = "lamp.stateRoot"; input = { state = $state } } → commitment
  port kernel.invoke {
    query = "canonical.identify";
    input = {
      kind = "context";
      value = {
        name = "The Temple of the Lamp";
        purpose = "A miniature running in your browser, for illustration."
      }
    }
  } → contextId
  port kernel.invoke {
    query = "canonical.identify";
    input = {
      kind = "temple";
      value = { ark = $arkId; initialStateRoot = $commitment.root; genesisContext = $contextId }
    }
  } → id
  let result = {
    id = $id;
    arkId = $arkId;
    registry = $registry;
    genesis = {
      state = $state;
      root = $commitment.root;
      tree = $commitment.tree;
      id = $id;
      arkId = $arkId
    };
    temple = {
      id = $id;
      arkId = $arkId;
      state = $state;
      root = $commitment.root;
      tree = $commitment.tree;
      predicates = $registry;
      sequence = 0;
      tip = null;
      roots = list($commitment.root)
    };
    journal = list()
  }

