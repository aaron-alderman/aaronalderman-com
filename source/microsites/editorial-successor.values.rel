("v374", "entry", "v379")
("v379", "type", "Entry")
("v379", "key", "beforeText")
("v380", "type", "String")
("v380", "scalar", "Temple is the ground Sourcery stands on — a kernel where every change is proposed, judged against declared law, and witnessed, whether it is accepted or refused.")
("v379", "value", "v380")
("v374", "entry", "v381")
("v381", "type", "Entry")
("v381", "key", "html")
("v382", "type", "String")
("v382", "scalar", "Temple is a small execution kernel: software that checks proposed changes against explicit rules and authority, then records acceptance or refusal. Its philosophy is that power should remain answerable to the people and commitments it affects.")
("v381", "value", "v382")
