# Source descriptions lower into the common projection tree. No local emitter.
process-module "temple/surface-process-module/1"

process source.markup:
  port static.read { text = one($input, "description") } → node
  let kind = $node.kind
  fold or(at($node, "children"), list()) as child; accumulatedChildren starts list():
    let input = $child
    call source.markup
    yield append($accumulatedChildren, list($result)) → children
  let result = null
  when eq($kind, "text"):
    let result = $node.text
  when eq($kind, "document"):
    let result = $children
  when eq($kind, "element"):
    port record.fromEntries { entries = map(or(at($node, "attributes"), list()), "attribute", list($attribute.name, $attribute.value)) } → attrs
    # The newer live Temple reflow repairs are shared palette classes, rather
    # than arbitrary inline layout exceptions.
    when and(eq(one($msDocument, "site"), "temple"), eq(at($attrs, "class"), "nowrap")):
      port record.put { record = $attrs; key = "class"; value = "projection-wrap" } → attrs
    when and(eq(one($msDocument, "site"), "temple"), eq(at($attrs, "id"), "cmd-title")):
      port record.put { record = $attrs; key = "class"; value = "projection-wrap" } → attrs
    when eq($node.tag, "head"):
      call source.metadata
      let children = append($children, list({ tag = "script"; attrs = { type = "module"; src = one($msDocument, "runtime") }; children = list() }, $result))
    let result = { tag = $node.tag; attrs = $attrs; children = $children }
    when and(eq($node.tag, "link"), eq(at($attrs, "rel"), "stylesheet"), eq(one($msDocument, "site"), "temple")):
      let result = list({ tag = "script"; attrs = { src = one($msDocument, "early") }; children = list() }, $result)

process source.css:
  port static.read { text = one($input, "description") } → node
  fold or(at($node, "children"), list()) as child; accumulatedChildren starts list():
    let input = $child
    call source.css
    yield append($accumulatedChildren, list($result)) → children
  let syntax = or(at($node, "syntax"), {})
  let result = { kind = $node.kind; before = or(at($syntax, "before"), ""); after = or(at($syntax, "after"), "") }
  when includes(list("root", "rule"), $node.kind):
    port record.put { record = $result; key = "children"; value = $children } → result
  when eq($node.kind, "comment"):
    let result = { kind = "comment"; before = or(at($syntax, "before"), ""); left = or(at($syntax, "left"), ""); text = $node.text; right = or(at($syntax, "right"), "") }
  when eq($node.kind, "decl"):
    let result = { kind = "decl"; before = or(at($syntax, "before"), ""); property = $node.prop; between = $syntax.between; value = $syntax.value; important = or(at($syntax, "important"), ""); semicolon = if(eq(or(at($syntax, "semicolon"), ""), "true"), ";", "") }
  when eq($node.kind, "rule"):
    port record.put { record = $result; key = "selector"; value = $syntax.selector } → result
    port record.put { record = $result; key = "between"; value = or(at($syntax, "between"), "") } → result
    port record.put { record = $result; key = "ownSemicolon"; value = or(at($syntax, "ownSemicolon"), "") } → result
  when eq($node.kind, "atrule"):
    let result = { kind = "atrule"; before = or(at($syntax, "before"), ""); after = or(at($syntax, "after"), ""); name = $node.name; afterName = or(at($syntax, "afterName"), ""); params = or(at($syntax, "params"), ""); between = or(at($syntax, "between"), ""); semicolon = if(eq(or(at($syntax, "semicolon"), ""), "true"), ";", "") }
    when eq(or(at($node, "hasChildren"), ""), "true"):
      port record.put { record = $result; key = "children"; value = $children } → result

process source.metadata:
  let input = list(
    {
      tag = "link";
      attrs = { rel = "canonical"; href = one($msDocument, "canonical") };
      children = list()
    },
    {
      tag = "meta";
      attrs = { property = "og:type"; content = one($msDocument, "og:type") };
      children = list()
    },
    {
      tag = "meta";
      attrs = {
        property = "og:title";
        content = if(
          optional($msDocument, "sharing"),
          one(one($msDocument, "sharing"), "title"),
          one($msDocument, "og:title")
        )
      };
      children = list()
    },
    {
      tag = "meta";
      attrs = {
        property = "og:description";
        content = if(
          optional($msDocument, "sharing"),
          one(one($msDocument, "sharing"), "description"),
          one($msDocument, "og:description")
        )
      };
      children = list()
    },
    {
      tag = "meta";
      attrs = { property = "og:url"; content = one($msDocument, "og:url") };
      children = list()
    },
    {
      tag = "meta";
      attrs = {
        property = "og:image";
        content = if(
          optional($msDocument, "sharing"),
          one(one($msDocument, "sharing"), "image"),
          one($msDocument, "og:image")
        )
      };
      children = list()
    },
    {
      tag = "meta";
      attrs = {
        property = "og:image:alt";
        content = if(
          optional($msDocument, "sharing"),
          one(one($msDocument, "sharing"), "alt"),
          one($msDocument, "og:image:alt")
        )
      };
      children = list()
    },
    {
      tag = "meta";
      attrs = { name = "twitter:card"; content = one($msDocument, "twitter:card") };
      children = list()
    },
    {
      tag = "meta";
      attrs = {
        name = "twitter:title";
        content = if(
          optional($msDocument, "sharing"),
          one(one($msDocument, "sharing"), "title"),
          one($msDocument, "twitter:title")
        )
      };
      children = list()
    },
    {
      tag = "meta";
      attrs = {
        name = "twitter:description";
        content = if(
          optional($msDocument, "sharing"),
          one(one($msDocument, "sharing"), "description"),
          one($msDocument, "twitter:description")
        )
      };
      children = list()
    },
    {
      tag = "meta";
      attrs = {
        name = "twitter:image";
        content = if(
          optional($msDocument, "sharing"),
          one(one($msDocument, "sharing"), "image"),
          one($msDocument, "twitter:image")
        )
      };
      children = list()
    },
    if(
      optional($msDocument, "sharing"),
      {
        tag = "meta";
        attrs = {
          property = "og:image:secure_url";
          content = one(one($msDocument, "sharing"), "image")
        };
        children = list()
      },
      null
    ),
    if(
      optional($msDocument, "sharing"),
      {
        tag = "meta";
        attrs = { property = "og:image:width"; content = one(one($msDocument, "sharing"), "width") };
        children = list()
      },
      null
    ),
    if(
      optional($msDocument, "sharing"),
      {
        tag = "meta";
        attrs = { property = "og:image:height"; content = one(one($msDocument, "sharing"), "height") };
        children = list()
      },
      null
    ),
    if(
      optional($msDocument, "sharing"),
      {
        tag = "meta";
        attrs = { property = "og:image:type"; content = one(one($msDocument, "sharing"), "type") };
        children = list()
      },
      null
    ),
    if(
      optional($msDocument, "sharing"),
      {
        tag = "meta";
        attrs = { name = "twitter:image:alt"; content = one(one($msDocument, "sharing"), "alt") };
        children = list()
      },
      null
    )
  )
  let result = $input
