("v11427", "type", "String")
("v11427", "scalar", "Open the shared version ↗ FINDING THINGS OUT A record can forget completely.")
("v11424", "item", "v11427")
("v11428", "type", "String")
("v11428", "scalar", "Once a record leaves out a difference, that record may be unable to recover it.")
("v11424", "item", "v11428")
("v11429", "type", "String")
("v11429", "scalar", "The interactive example has its own motion control.")
("v11424", "item", "v11429")
