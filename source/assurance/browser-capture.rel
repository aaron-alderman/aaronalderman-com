("v10630", "item", "v10634")
("v10635", "type", "String")
("v10635", "scalar", "What does a story owe the lives it touches?")
("v10630", "item", "v10635")
("v10636", "type", "String")
("v10636", "scalar", "Read: A world someone else can enter →")
("v10630", "item", "v10636")
("v10637", "type", "String")
("v10637", "scalar", "The same clearing. A different field of attention.")
("v10630", "item", "v10637")
("v10638", "type", "String")
("v10638", "scalar", "What are they trying to do?")
("v10630", "item", "v10638")
("v10639", "type", "String")
("v10639", "scalar", "I trusted the process.")
("v10630", "item", "v10639")
("v10640", "type", "String")
("v10640", "scalar", "What can exist together?")
("v10630", "item", "v10640")
("v10641", "type", "String")
("v10641", "scalar", "Someone else can change the question.")
("v10630", "item", "v10641")
("v10642", "type", "String")
("v10642", "scalar", "What changes when time is short?")
("v10630", "item", "v10642")
("v10643", "type", "String")
("v10643", "scalar", "Let the correction leave a seam.")
("v10630", "item", "v10643")
("v10644", "type", "String")
("v10644", "scalar", "Remember to care.")
("v10630", "item", "v10644")
("v10645", "type", "String")
("v10645", "scalar", "What are they trying to do?")
("v10630", "item", "v10645")
("v10646", "type", "String")
