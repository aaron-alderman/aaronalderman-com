("v16864", "type", "String")
("v16864", "scalar", "A mathematical comparison of three chosen structures The research compares three mathematical structures.")
("v16856", "item", "v16864")
("v16865", "type", "String")
("v16865", "scalar", "One broad measurement makes them look alike.")
("v16856", "item", "v16865")
("v16866", "type", "String")
("v16866", "scalar", "A more detailed count gives three different answers: 744, 24 and 0.")
("v16856", "item", "v16866")
("v16867", "type", "String")
("v16867", "scalar", "Switch the view to see the counts.")
("v16856", "item", "v16867")
("v16868", "type", "String")
("v16868", "scalar", "They separate these three chosen structures.")
("v16856", "item", "v16868")
("v16869", "type", "String")
("v16869", "scalar", "They do not prove that a physical object contains the structure nicknamed the Monster.")
("v16856", "item", "v16869")
("v16870", "type", "String")
("v16870", "scalar", "Compare the broad view with the detailed count.")
("v16856", "item", "v16870")
("v16871", "type", "String")
("v16871", "scalar", "Which view tells the three structures apart?")
