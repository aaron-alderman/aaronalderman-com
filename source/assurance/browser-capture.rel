("v15937", "type", "String")
("v15937", "scalar", "Aaron’s account, in wording open to revision PERSONAL ACCOUNT · WORKING DRAFT When an idea takes up all our attention, we can lose sight of the people living with its consequences.")
("v15930", "item", "v15937")
("v15938", "type", "String")
("v15938", "scalar", "Who is carrying a cost?")
("v15930", "item", "v15938")
