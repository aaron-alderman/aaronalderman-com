("v14975", "item", "v14987")
("v14988", "type", "String")
("v14988", "scalar", "The grid is an example of information loss, not a proof about physics.")
("v14975", "item", "v14988")
("v14989", "type", "String")
("v14989", "scalar", "Combine the cells into bigger blocks.")
("v14975", "item", "v14989")
("v14990", "type", "String")
("v14990", "scalar", "Look for what stays the same and what disappears.")
