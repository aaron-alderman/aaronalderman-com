("v7009", "type", "Sequence")
("v7010", "type", "String")
("v7010", "scalar", "UNDERSTANDING PEOPLE The horse has a few questions.")
("v7009", "item", "v7010")
("v7011", "type", "String")
("v7011", "scalar", "The guide offers a lesson.")
("v7009", "item", "v7011")
("v7012", "type", "String")
("v7012", "scalar", "The horse has noticed something else.")
("v7009", "item", "v7012")
("v7013", "type", "String")
("v7013", "scalar", "The interactive example has its own motion control.")
("v7009", "item", "v7013")
("v7014", "type", "String")
("v7014", "scalar", "Scroll inside it if you need more room.")
("v7009", "item", "v7014")
("v7015", "type", "String")
("v7015", "scalar", "An invented scene for reflection The guide points at the water.")
("v7009", "item", "v7015")
("v7016", "type", "String")
("v7016", "scalar", "The horse looks down.")
("v7009", "item", "v7016")
("v7017", "type", "String")
("v7017", "scalar", "There is already a horse in there, and it seems to have strong opinions about the guide.")
("v7009", "item", "v7017")
("v7018", "type", "String")
("v7018", "scalar", "Nobody mentioned a committee.")
("v7009", "item", "v7018")
("v7019", "type", "String")
("v7019", "scalar", "Perhaps the next explanation can wait.")
("v7009", "item", "v7019")
("v7020", "type", "String")
("v7020", "scalar", "What is the horse being invited into?")
("v7009", "item", "v7020")
("v7021", "type", "String")
("v7021", "scalar", "The guide can look at the reflection too.")
("v7009", "item", "v7021")
("v7022", "type", "String")
("v7022", "scalar", "You can read the little fable your own way—or just enjoy a horse declining a well-prepared presentation.")
("v7009", "item", "v7022")
("v7023", "type", "String")
("v7023", "scalar", "")
("v7009", "item", "v7023")
