("v6050", "item", "v6054")
("v6055", "type", "String")
("v6055", "scalar", "A plan for physical tests Two explanations may agree on one reading and disagree on another.")
("v6050", "item", "v6055")
("v6056", "type", "String")
("v6056", "scalar", "A timing reference, a reversed path or a different waiting time can help reveal the difference.")
("v6050", "item", "v6056")
("v6057", "type", "String")
("v6057", "scalar", "Choose a check at the bench.")
("v6050", "item", "v6057")
("v6058", "type", "String")
("v6058", "scalar", "These are proposed ways to test ideas, not measurements being collected here.")
("v6050", "item", "v6058")
("v6059", "type", "String")
("v6059", "scalar", "Better tools can be useful even when the result agrees with existing physics.")
("v6050", "item", "v6059")
