("v13282", "item", "v13287")
("v13288", "type", "String")
("v13288", "scalar", "The interactive example has its own motion control.")
("v13282", "item", "v13288")
("v13289", "type", "String")
("v13289", "scalar", "Scroll inside it if you need more room.")
("v13282", "item", "v13289")
("v13290", "type", "String")
("v13290", "scalar", "A research overview with uncertain connections marked Try the two views of the clearing.")
("v13282", "item", "v13290")
("v13291", "type", "String")
("v13291", "scalar", "One keeps several details visible.")
("v13282", "item", "v13291")
("v13292", "type", "String")
("v13292", "scalar", "The other brings the leaf forward while the rest recedes.")
("v13282", "item", "v13292")
("v13293", "type", "String")
("v13293", "scalar", "This changes the drawing; it does not test your attention.")
("v13282", "item", "v13293")
("v13294", "type", "String")
("v13294", "scalar", "The research separates noticing, choosing, awareness and action because explaining one does not automatically explain the others.")
("v13282", "item", "v13294")
("v13295", "type", "String")
("v13295", "scalar", "Try the broad view and the close view.")
("v13282", "item", "v13295")
("v13296", "type", "String")
("v13296", "scalar", "Notice what each brings forward.")
("v13282", "item", "v13296")
