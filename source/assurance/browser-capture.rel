("v2848", "type", "String")
("v2848", "scalar", "AARON ALDERMAN / AN ATLAS OF IDEAS The world keeps opening.")
("v2847", "item", "v2848")
("v2849", "type", "String")
("v2849", "scalar", "Forty places.")
("v2847", "item", "v2849")
("v2850", "type", "String")
("v2850", "scalar", "Three territories.")
("v2847", "item", "v2850")
("v2851", "type", "String")
("v2851", "scalar", "More than one way through.")
("v2847", "item", "v2851")
("v2852", "type", "String")
("v2852", "scalar", "Start with a question, follow a connection, and return with a different view.")
("v2847", "item", "v2852")
("v2853", "type", "String")
("v2853", "scalar", "Every light is a place.")
("v2847", "item", "v2853")
("v2854", "type", "String")
("v2854", "scalar", "Hover or use Tab to discover it, then click or press Enter to explore.")
("v2847", "item", "v2854")
("v2855", "type", "String")
("v2855", "scalar", "Swipe or scroll sideways to discover more, or use the full list below.")
("v2847", "item", "v2855")
("v2856", "type", "String")
("v2856", "scalar", "Choose a light on the map.")
("v2847", "item", "v2856")
("v2857", "type", "String")
("v2857", "scalar", "Tap for a preview, then choose Explore to open the place.")
("v2847", "item", "v2857")
("v2858", "type", "String")
("v2858", "scalar", "Your journey is beginning.")
("v2847", "item", "v2858")
("v2859", "type", "String")
("v2859", "scalar", "Seen places are remembered only in this browser.")
("v2847", "item", "v2859")
("v2860", "type", "String")
("v2860", "scalar", "Without JavaScript, each light opens its place directly; visits aren’t remembered.")
("v2847", "item", "v2860")
("v2861", "type", "String")
("v2861", "scalar", "An imagined geography for real questions.")
("v2847", "item", "v2861")
("v2862", "type", "String")
("v2862", "scalar", "The landscape is an illustration; the routes organise themes, not physical locations or scientific equivalences.")
("v2847", "item", "v2862")
("v2863", "type", "String")
("v2863", "scalar", "TERRITORY 01 / 16 PLACES")
