("v18264", "item", "v18282")
("v18283", "type", "String")
("v18283", "scalar", "Kenotic Governance: Tri-Omni Theism and Shared Responsibility in a Lawful World")
("v18264", "item", "v18283")
("v18284", "type", "String")
("v18284", "scalar", "The kenotic-participatory chain is one Christian model family, not the unique reading of Christianity")
("v18264", "item", "v18284")
("v18285", "type", "String")
("v18285", "scalar", "Christian truth cannot be reduced to wellbeing, and Christian fruit cannot be exempted from harm")
("v18264", "item", "v18285")
("v18286", "type", "String")
("v18286", "scalar", "Shared transformation across incompatible traditions identifies common process before religious truth")
("v18264", "item", "v18286")
("v18287", "type", "String")
("v18287", "scalar", "Kenotic hiddenness preserves freedom only by accepting nonresistant nonbelief as adverse evidence")
