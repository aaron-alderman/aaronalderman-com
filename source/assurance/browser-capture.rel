("v18264", "item", "v18272")
("v18273", "type", "String")
("v18273", "scalar", "Matthew 22:34–40 is an important starting point.")
("v18264", "item", "v18273")
("v18274", "type", "String")
("v18274", "scalar", "Read why this remains one Christian reading.")
("v18264", "item", "v18274")
("v18275", "type", "String")
("v18275", "scalar", "Read the distinction between fruit, harm and truth.")
("v18264", "item", "v18275")
("v18276", "type", "String")
("v18276", "scalar", "Read the corpus’s comparative boundary.")
("v18264", "item", "v18276")
("v18277", "type", "String")
