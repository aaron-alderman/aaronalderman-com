    "profiles": [
      {
        "id": "desktop",
        "width": 1280,
        "height": 800,
        "zoomEquivalent": 1,
        "spacing": false
      },
      {
        "id": "zoom-200-equivalent",
        "width": 640,
        "height": 400,
        "zoomEquivalent": 2,
        "spacing": false
      },
      {
        "id": "zoom-400-equivalent",
        "width": 320,
        "height": 200,
        "zoomEquivalent": 4,
        "spacing": false
      },
      {
        "id": "text-spacing",
        "width": 320,
        "height": 800,
        "zoomEquivalent": 4,
        "spacing": true
      }
    ],
    "textSelectors": "h1, .masthead nav a, .footer a, .faith-essay-kicker, .faith-essay-standfirst",
    "blockSelectors": "h1,h2,h3,p,li,a,button,input,select,textarea,summary",
    "maxBlocks": 500,
    "maxTexts": 60,
    "hoverSelector": ".masthead nav a",
    "keyboard": {
      "maxTabs": 120,
      "points": [
        [
          0.5,
          0.5
        ],
        [
          0.15,
          0.15
        ],
        [
          0.85,
          0.15
        ],
        [
          0.15,
          0.85
        ],
        [
          0.85,
          0.85
        ]
      ],
      "returnSelector": "#microsite-return, header a[aria-label=\"Aaron Alderman\"]",
      "tab": {
        "key": "Tab",
        "code": "Tab",
        "windowsVirtualKeyCode": 9
      },
      "enter": {
        "key": "Enter",
        "code": "Enter",
        "windowsVirtualKeyCode": 13
      },
      "homePaths": [
        "/",
        "/index.html",
        "/worlds/christian/index.html",
        "/worlds/dad/index.html",
        "/worlds/sourcerer/index.html",
        "/worlds/author/index.html"
      ]
    },
    "spacingCSS": "*{line-height:1.5!important;letter-spacing:.12em!important;word-spacing:.16em!important}p{margin-block-end:2em!important}",
    "timeoutMs": 20000,
    "settleMs": 250,
    "conditions": {
      "media": [
        {
          "name": "prefers-reduced-motion",
          "value": "reduce"
        }
      ],
      "pointerRest": {
        "x": 0,
        "y": 0
      },
      "keyboardViewport": "desktop"
    }
  },
  "language": {
    "maxBlocks": 12,
    "maxLinks": 40,
    "longSentenceWords": 35,
    "terms": [
      {
        "term": "kenotic",
        "pattern": "\\bkenotic\\b",
        "prompt": "Explain what self-emptying love means in this particular situation."
      },
      {
        "term": "process algebra",
        "pattern": "\\bprocess\\s+algebra\\b",
        "prompt": "Explain the rules for describing and composing changes, with a concrete example."
      },
      {
        "term": "invariant",
        "pattern": "\\binvariant\\b",
        "prompt": "Say which thing remains unchanged, and under which changes."
      },
      {
        "term": "symmetry",
        "pattern": "\\bsymmetry\\b",
        "prompt": "Name the transformation and what it preserves."
      },
      {
        "term": "admission",
        "pattern": "\\badmission\\b",
        "prompt": "Explain what is being accepted and which checks decide."
      },
      {
        "term": "ontology",
        "pattern": "\\bontology\\b",
        "prompt": "Explain the things and relationships being represented."
      },
      {
        "term": "epistemic",
        "pattern": "\\bepistemic\\b",
        "prompt": "Say how this affects what we know or how we know it."
      },
      {
        "term": "corpus",
        "pattern": "\\bcorpus\\b",
        "prompt": "Identify the collection of source material being referred to."
      },
      {
        "term": "provenance",
        "pattern": "\\bprovenance\\b",
        "prompt": "Explain where this statement or result came from."
      }
    ],
    "vagueLinkPattern": "^(click here|here|more|read more|learn more)$",
    "reviewPrompts": [
      "In your own words, what is this page saying?",
      "What is this software or philosophy for, and what could you do next?",
      "Which terms or sentences needed explanation?"
    ],
    "reviews": []
  },
  "requiredPasses": [
    {
      "route": "temple/index.html",
      "profile": "text-spacing",
      "rule": "zoom.document-overflow"
    },
    {
      "route": "claimipedia/index.html",
      "profile": "text-spacing",
      "rule": "zoom.document-overflow"
    }
  ]
}
