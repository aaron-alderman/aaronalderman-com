("v5121", "type", "Entry")
("v5121", "key", "children")
("v5122", "type", "Sequence")
("v5123", "type", "String")
("v5123", "scalar", "For The Field, the next work is to let these assumptions meet evidence and adverse cases: uncertain peer relationships, donor withdrawal, repeated shocks, usable alternatives that arrive too late, and remedies that can be exercised more than once. If those cases defeat the favorable result, the result should change.")
("v5122", "item", "v5123")
("v5121", "value", "v5122")
("v5088", "item", "v5116")
("v5124", "type", "String")
("v5124", "scalar", "\n")
("v5088", "item", "v5124")
("v5125", "type", "Record")
("v5125", "entry", "v5126")
("v5126", "type", "Entry")
("v5126", "key", "tag")
("v5127", "type", "String")
("v5127", "scalar", "p")
("v5126", "value", "v5127")
("v5125", "entry", "v5128")
("v5128", "type", "Entry")
("v5128", "key", "attrs")
("v5129", "type", "Record")
("v5128", "value", "v5129")
("v5125", "entry", "v5130")
("v5130", "type", "Entry")
("v5130", "key", "children")
("v5131", "type", "Sequence")
("v5132", "type", "String")
("v5132", "scalar", "You do not have to accept this framework to question an account of your own life. The person, the relationship, and the claim that something has gone wrong can remain before us even when the model is put down.")
("v5131", "item", "v5132")
("v5130", "value", "v5131")
