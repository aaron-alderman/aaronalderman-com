("v139", "key", "children")
("v140", "type", "Sequence")
("v141", "type", "String")
("v141", "scalar", "This essay proposes a way of studying part of that question through relational dynamics and a correction margin. It draws a political and theological pattern from 1 Samuel 8, then tests authored mechanisms in a small simulation. The biblical reading, the normative commitments, and the numerical results have different kinds of authority. The argument depends on keeping them distinguishable.")
("v140", "item", "v141")
("v139", "value", "v140")
("v16", "item", "v134")
("v142", "type", "String")
("v142", "scalar", "\n")
("v16", "item", "v142")
("v15", "value", "v16")
