("v2859", "type", "String")
("v2859", "scalar", "All four ranges include modeled blockage and modeled enforcement. These are envelopes across the declared design, not confidence intervals or probabilities. Coordination is a separate requirement; money cannot substitute for it.")
("v2858", "item", "v2859")
("v2857", "value", "v2858")
("v2513", "item", "v2852")
("v2512", "value", "v2513")
