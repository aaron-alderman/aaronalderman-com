("v1498", "type", "String")
("v1498", "scalar", "A separate coordination margin compares the least-supported group's modeled ability to participate with the declared coordination threshold. The use of a minimum prevents a well-resourced group's surplus from canceling another group's exclusion within this particular joint route. It does not entitle the least-supported group, or the model speaking for it, to veto another person's independent remedy. Other routes require their own representation.")
("v1497", "item", "v1498")
("v1496", "value", "v1497")
