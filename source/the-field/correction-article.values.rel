("v116", "entry", "v121")
("v121", "type", "Entry")
("v121", "key", "children")
("v122", "type", "Sequence")
("v123", "type", "String")
("v123", "scalar", "A remedy can answer a real injustice and still make the next injustice harder to challenge. A new office may provide needed services while gathering the resources to resist review. A complaint may succeed while exhausting the people who brought it. Even a process designed to listen can reserve the power to decide which objections count.")
("v122", "item", "v123")
("v121", "value", "v122")
("v16", "item", "v116")
("v124", "type", "String")
("v124", "scalar", "\n")
